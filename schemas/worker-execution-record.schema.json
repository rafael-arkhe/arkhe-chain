{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "module_id",
    "module_version",
    "input_digest",
    "output_digest",
    "evidence_refs",
    "execution_id"
  ],
  "properties": {
    "module_id": {
      "type": "string"
    },
    "module_version": {
      "type": "string"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "execution_id": {
      "type": "string"
    }
  }
}
