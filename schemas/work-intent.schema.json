{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "requested_by",
    "intent_type",
    "target",
    "parameters_digest",
    "context_refs",
    "request_identity"
  ],
  "properties": {
    "requested_by": {
      "type": "string"
    },
    "intent_type": {
      "type": "string"
    },
    "target": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parameters_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_refs": {
      "type": "array"
    },
    "request_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
