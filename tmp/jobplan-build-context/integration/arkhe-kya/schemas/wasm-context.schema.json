{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "trusted_principal_did": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "challenge": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "now": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_leaf_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "expected_model_blake3": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "trusted_principal_did",
    "audience",
    "action",
    "challenge",
    "now",
    "expected_root",
    "expected_leaf_count"
  ]
}
