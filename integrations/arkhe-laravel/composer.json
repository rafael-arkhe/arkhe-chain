{
    "name": "arkhe/laravel-run-reports",
    "description": "Reports successful Laravel scheduled task runs to the Arkhe runtime as WorkerExecutionRecords.",
    "type": "library",
    "license": "Apache-2.0 OR MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Arkhe\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arkhe\\Laravel\\ArkheServiceProvider"
            ]
        }
    }
}
