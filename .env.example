# Optional manual binary launch. Orchestrated credentials are generated privately
# in ops/local/live.json by scripts/live_runtime.py; no default DB password is used.
ARKHE_LISTEN=127.0.0.1:8788
ARKHE_ACTOR=local-operator
ARKHE_TENANT_ID=local
# Runtime audit-retention policy. Append-only storage has no automatic purge.
# These minimums do not attest an actual retention history or PCI applicability.
ARKHE_EVIDENCE_RETENTION_DAYS=366
ARKHE_EVIDENCE_IMMEDIATE_DAYS=92
# Set DATABASE_URL and ARKHE_API_TOKEN privately for a manual binary launch.
REDIS_URL=redis://127.0.0.1:6379
MCP_PORT=8787
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# Local Ollama configuration (the launcher reads config/ollama.json by default).
ARKHE_OLLAMA_CONFIG=config/ollama.json
ARKHE_OLLAMA_EXE=C:\Users\Lemes\AppData\Local\Programs\Ollama\ollama.exe

# arkhe-ask: separate chat and embedding deployments (1536 dimensions requested).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=

# Optional jobplan host ports (override when defaults are occupied).
ARKHE_JOBPLAN_POSTGRES_PORT=55433
ARKHE_JOBPLAN_KEYCLOAK_PORT=8180
ARKHE_JOBPLAN_ASK_PORT=3000

# arkhe-ask JWT authentication (default; required for standalone launch).
ARKHE_AUTH_MODE=keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=arkhe
KEYCLOAK_AUDIENCE=arkhe-ask
# Explicit local-only bypass: ARKHE_AUTH_MODE=dev-header

# Optional standalone verified-event journaling; compose enables it.
# KAFKA_BROKERS=127.0.0.1:59092
KAFKA_TOPIC=arkhe.ask.verified.v1
ARKHE_JOBPLAN_KAFKA_PORT=59092

# Optional OTLP trace export; HTTP metrics remain available without it.
OTEL_SERVICE_NAME=arkhe-ask
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:54318/v1/traces
ARKHE_JOBPLAN_OTLP_PORT=54318
ARKHE_JOBPLAN_PROMETHEUS_PORT=59095

# Local Grafana provisioning (anonymous read-only Viewer on loopback).
ARKHE_JOBPLAN_GRAFANA_PORT=59096
# ARKHE_JOBPLAN_GRAFANA_PASSWORD=set-privately-for-non-demo-use
