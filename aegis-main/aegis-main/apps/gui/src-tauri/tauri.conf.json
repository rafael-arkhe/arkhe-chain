{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEGIS",
  "mainBinaryName": "aegis-gui",
  "version": "0.1.0",
  "identifier": "space.safecore.aegis",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "aegis",
        "title": "AEGIS",
        "width": 900,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"]
  }
}
