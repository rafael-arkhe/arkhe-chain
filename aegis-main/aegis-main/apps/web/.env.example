# Ontology backend. Também habilita o terminal interativo do IDE (WS direto ao
# /sandbox/terminal — o catch-all /api strippa o upgrade do WS). Override opcional
# do WS via NEXT_PUBLIC_ONTOLOGY_WS_URL (ws://...).
NEXT_PUBLIC_ONTOLOGY_API_URL=http://localhost:8002
# NEXT_PUBLIC_ONTOLOGY_WS_URL=ws://localhost:8002
NEXT_PUBLIC_INTEL_API_URL=http://localhost:8002
NEXT_PUBLIC_SOCIAL_API_URL=http://localhost:8010
NEXT_PUBLIC_COGNITIVE_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_AGENT_GATEWAY_URL=http://localhost:9100
NEXT_PUBLIC_MAPBOX_TOKEN=
# Cesium Ion token — pegar grátis em https://ion.cesium.com/tokens
# Sem token, /geo cai pra ellipsoid plano e botões Terreno/Prédios 3D
# ficam sem efeito visual.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
