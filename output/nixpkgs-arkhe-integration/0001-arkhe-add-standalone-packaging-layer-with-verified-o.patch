diff --git a/arkhe/source/storage/sql/migrations/20261018000013_payout_witness.sql b/arkhe/source/storage/sql/migrations/20261018000013_payout_witness.sql
new file mode 100644
index 00000000..70660d0b
--- /dev/null
+++ b/arkhe/source/storage/sql/migrations/20261018000013_payout_witness.sql
@@ -0,0 +1,51 @@
+-- Candidate operational payout state and persistent checkpoint witness. No transfer authority.
+CREATE TABLE payout_jobs (
+ tenant_id text NOT NULL,
+ idempotency_key bytea NOT NULL CHECK(octet_length(idempotency_key)=32),
+ vulnerability_id bytea NOT NULL CHECK(octet_length(vulnerability_id)=32),
+ parameters_digest bytea NOT NULL CHECK(octet_length(parameters_digest)=32),
+ payload jsonb NOT NULL,
+ status text NOT NULL DEFAULT 'PENDING' CHECK(status IN ('PENDING','DISPATCHED','COMPLETED')),
+ owner_token uuid, receipt text,
+ created_at timestamptz NOT NULL DEFAULT now(),
+ PRIMARY KEY(tenant_id,idempotency_key), UNIQUE(tenant_id,vulnerability_id),
+ CHECK((status='PENDING' AND owner_token IS NULL AND receipt IS NULL)
+ OR (status='DISPATCHED' AND owner_token IS NOT NULL AND receipt IS NULL)
+ OR (status='COMPLETED' AND owner_token IS NOT NULL AND receipt IS NOT NULL))
+);
+CREATE FUNCTION arkhe_payout_transition() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF ROW(NEW.tenant_id,NEW.idempotency_key,NEW.vulnerability_id,NEW.parameters_digest,NEW.payload,NEW.created_at)
+ IS DISTINCT FROM ROW(OLD.tenant_id,OLD.idempotency_key,OLD.vulnerability_id,OLD.parameters_digest,OLD.payload,OLD.created_at)
+ OR NOT ((OLD.status='PENDING' AND NEW.status='DISPATCHED')
+ OR (OLD.status='DISPATCHED' AND NEW.status='COMPLETED' AND NEW.owner_token=OLD.owner_token)) THEN
+ RAISE EXCEPTION 'invalid payout transition'; END IF; RETURN NEW;
+END $$;
+CREATE TRIGGER payout_transition BEFORE UPDATE ON payout_jobs FOR EACH ROW EXECUTE FUNCTION arkhe_payout_transition();
+CREATE TABLE checkpoint_witness (
+ tenant_id text NOT NULL, log_id bytea NOT NULL CHECK(octet_length(log_id)=32),checkpoint jsonb NOT NULL,
+ PRIMARY KEY(tenant_id,log_id)
+);
+CREATE FUNCTION arkhe_witness_transition() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF ROW(NEW.tenant_id,NEW.log_id) IS DISTINCT FROM ROW(OLD.tenant_id,OLD.log_id)
+ OR (NEW.checkpoint->>'leaf_count')::numeric < (OLD.checkpoint->>'leaf_count')::numeric
+ OR (NEW.checkpoint->>'issued_at')::numeric < (OLD.checkpoint->>'issued_at')::numeric
+ OR ((NEW.checkpoint->>'leaf_count')::numeric = (OLD.checkpoint->>'leaf_count')::numeric AND NEW.checkpoint->'root' IS DISTINCT FROM OLD.checkpoint->'root')
+ THEN RAISE EXCEPTION 'witness rollback or same-size equivocation'; END IF; RETURN NEW;
+END $$;
+CREATE TRIGGER witness_transition BEFORE UPDATE ON checkpoint_witness FOR EACH ROW EXECUTE FUNCTION arkhe_witness_transition();
+DO $$ DECLARE t text; BEGIN
+ FOREACH t IN ARRAY ARRAY['payout_jobs','checkpoint_witness'] LOOP
+ EXECUTE format('ALTER TABLE %I ENABLE ROW LEVEL SECURITY',t);
+ EXECUTE format('ALTER TABLE %I FORCE ROW LEVEL SECURITY',t);
+ EXECUTE format('CREATE POLICY tenant_isolation_%I ON %I USING(tenant_id=arkhe_assert_tenant()) WITH CHECK(tenant_id=arkhe_assert_tenant())',t,t);
+ EXECUTE format('CREATE TRIGGER no_delete_%I BEFORE DELETE ON %I FOR EACH ROW EXECUTE FUNCTION arkhe_reject_mutation()',t,t);
+ EXECUTE format('REVOKE ALL ON %I FROM PUBLIC',t);
+ EXECUTE format('GRANT SELECT,INSERT ON %I TO arkhe_operations',t);
+ EXECUTE format('GRANT SELECT ON %I TO arkhe_read',t);
+ END LOOP;
+END $$;
+GRANT UPDATE(status,owner_token,receipt) ON payout_jobs TO arkhe_operations;
+GRANT UPDATE(checkpoint) ON checkpoint_witness TO arkhe_operations;
+CREATE INDEX payout_pending ON payout_jobs(tenant_id,created_at) WHERE status='PENDING';
diff --git a/arkhe/source/storage/sql/migrations/20261021000014_stripe_billing.sql b/arkhe/source/storage/sql/migrations/20261021000014_stripe_billing.sql
new file mode 100644
index 00000000..b164eea4
--- /dev/null
+++ b/arkhe/source/storage/sql/migrations/20261021000014_stripe_billing.sql
@@ -0,0 +1,18 @@
+-- Cloud schema: tenant ids in Arkhe are text, not UUID references to a tenants table.
+-- The local arkhe-intra adapter uses SQLite; this migration does not bridge it to PostgreSQL.
+CREATE TABLE tenant_billing (
+  tenant_id text PRIMARY KEY,
+  stripe_customer_id text UNIQUE NOT NULL,
+  stripe_subscription_id text UNIQUE,
+  plan_tier text CHECK (plan_tier IN ('starter','pro','enterprise')),
+  status text NOT NULL DEFAULT 'incomplete' CHECK
+    (status IN ('incomplete','incomplete_expired','trialing','active','past_due','canceled','unpaid','paused')),
+  updated_at timestamptz NOT NULL DEFAULT clock_timestamp()
+);
+ALTER TABLE tenant_billing ENABLE ROW LEVEL SECURITY;
+ALTER TABLE tenant_billing FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_isolation_billing ON tenant_billing
+  USING (tenant_id = arkhe_assert_tenant())
+  WITH CHECK (tenant_id = arkhe_assert_tenant());
+-- Runtime privileges are deliberately not granted: only a separately scoped billing
+-- worker should mutate payment state. Never grant arbitrary clients UPDATE here.
diff --git a/arkhe/source/storage/sql/migrations/20261022000015_preview_admission.sql b/arkhe/source/storage/sql/migrations/20261022000015_preview_admission.sql
new file mode 100644
index 00000000..bb89f6d0
--- /dev/null
+++ b/arkhe/source/storage/sql/migrations/20261022000015_preview_admission.sql
@@ -0,0 +1,48 @@
+-- Preview admission/outbox v1: no execution or production-release authority.
+-- Evidence and pending job must be committed in the same application transaction.
+DO $$ BEGIN
+ IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname='arkhe_preview_enqueue') THEN
+  CREATE ROLE arkhe_preview_enqueue NOLOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE NOINHERIT;
+ END IF;
+END $$;
+
+CREATE TABLE preview_admissions (
+ tenant_id text NOT NULL,
+ requested_by text NOT NULL,
+ operation_id bytea NOT NULL CHECK (octet_length(operation_id)=32),
+ bundle_digest bytea NOT NULL CHECK (octet_length(bundle_digest)=32),
+ authorization_ref bytea NOT NULL CHECK (octet_length(authorization_ref)=32),
+ expires_at bigint NOT NULL CHECK (expires_at > 0),
+ intent_cbor bytea NOT NULL,
+ worker_cbor bytea NOT NULL,
+ bundle jsonb NOT NULL CHECK (jsonb_typeof(bundle)='object'),
+ created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+ PRIMARY KEY (tenant_id,requested_by,operation_id),
+ UNIQUE (tenant_id,requested_by,operation_id,bundle_digest)
+);
+
+-- An append-only pending outbox, not a lease/retry/execution journal.
+-- A qualified executor must add a separate operational journal in a later migration.
+CREATE TABLE preview_jobs (
+ tenant_id text NOT NULL,
+ requested_by text NOT NULL,
+ operation_id bytea NOT NULL CHECK (octet_length(operation_id)=32),
+ bundle_digest bytea NOT NULL CHECK (octet_length(bundle_digest)=32),
+ created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+ PRIMARY KEY (tenant_id,requested_by,operation_id),
+ FOREIGN KEY (tenant_id,requested_by,operation_id,bundle_digest)
+  REFERENCES preview_admissions(tenant_id,requested_by,operation_id,bundle_digest)
+);
+
+DO $$ DECLARE t text; BEGIN
+ FOREACH t IN ARRAY ARRAY['preview_admissions','preview_jobs'] LOOP
+  EXECUTE format('ALTER TABLE %I ENABLE ROW LEVEL SECURITY',t);
+  EXECUTE format('ALTER TABLE %I FORCE ROW LEVEL SECURITY',t);
+  EXECUTE format('CREATE POLICY tenant_isolation_%I ON %I USING (tenant_id=arkhe_assert_tenant()) WITH CHECK (tenant_id=arkhe_assert_tenant())',t,t);
+  EXECUTE format('CREATE TRIGGER immutable_%I BEFORE UPDATE OR DELETE ON %I FOR EACH ROW EXECUTE FUNCTION arkhe_reject_mutation()',t,t);
+  EXECUTE format('REVOKE ALL ON %I FROM PUBLIC',t);
+  EXECUTE format('GRANT SELECT,INSERT ON %I TO arkhe_preview_enqueue',t);
+  EXECUTE format('GRANT SELECT ON %I TO arkhe_read',t);
+ END LOOP;
+END $$;
+-- No role memberships, login, credentials, worker dispatch or trust roots granted.
diff --git a/arkhe/source/storage/sql/migrations/20261022000016_preview_dispatch.sql b/arkhe/source/storage/sql/migrations/20261022000016_preview_dispatch.sql
new file mode 100644
index 00000000..7a84263d
--- /dev/null
+++ b/arkhe/source/storage/sql/migrations/20261022000016_preview_dispatch.sql
@@ -0,0 +1,52 @@
+-- Operational dispatch is mutable; admission/evidence remain append-only.
+DO $$ BEGIN
+ IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname='arkhe_preview_execute') THEN
+  CREATE ROLE arkhe_preview_execute NOLOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE NOINHERIT;
+ END IF;
+END $$;
+CREATE TABLE preview_dispatches (
+ tenant_id text NOT NULL, requested_by text NOT NULL, operation_id bytea NOT NULL,
+ state text NOT NULL DEFAULT 'READY' CHECK(state IN ('READY','LEASED','RUNNING','RETRY','SUCCEEDED','FAILED','DEAD','UNKNOWN')),
+ attempts integer NOT NULL DEFAULT 0 CHECK(attempts BETWEEN 0 AND 3),
+ fence bigint NOT NULL DEFAULT 0 CHECK(fence >= 0),
+ owner_token uuid, lease_until timestamptz, available_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+ result jsonb, updated_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+ PRIMARY KEY(tenant_id,requested_by,operation_id),
+ FOREIGN KEY(tenant_id,requested_by,operation_id) REFERENCES preview_jobs(tenant_id,requested_by,operation_id),
+ CHECK ((state IN ('LEASED','RUNNING')) = (owner_token IS NOT NULL AND lease_until IS NOT NULL))
+);
+CREATE TABLE preview_execution_events (
+ tenant_id text NOT NULL, requested_by text NOT NULL, operation_id bytea NOT NULL,
+ event_id uuid NOT NULL, fence bigint NOT NULL, state text NOT NULL, details jsonb NOT NULL,
+ created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+ PRIMARY KEY(tenant_id,event_id),
+ FOREIGN KEY(tenant_id,requested_by,operation_id) REFERENCES preview_jobs(tenant_id,requested_by,operation_id)
+);
+CREATE FUNCTION arkhe_preview_dispatch_transition() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF ROW(NEW.tenant_id,NEW.requested_by,NEW.operation_id) IS DISTINCT FROM ROW(OLD.tenant_id,OLD.requested_by,OLD.operation_id)
+ OR NOT (
+  (OLD.state IN ('READY','RETRY','LEASED') AND NEW.state='LEASED' AND NEW.attempts=OLD.attempts+1 AND NEW.fence=OLD.fence+1
+   AND (OLD.state<>'LEASED' OR OLD.lease_until<=clock_timestamp()) AND NEW.available_at<=clock_timestamp())
+  OR (OLD.state IN ('LEASED','RUNNING') AND NEW.state=OLD.state AND NEW.attempts=OLD.attempts AND NEW.fence=OLD.fence AND NEW.owner_token=OLD.owner_token AND OLD.lease_until>clock_timestamp())
+  OR (OLD.state='LEASED' AND NEW.state='RUNNING' AND NEW.attempts=OLD.attempts AND NEW.fence=OLD.fence AND NEW.owner_token=OLD.owner_token AND OLD.lease_until>clock_timestamp())
+  OR (OLD.state IN ('LEASED','RUNNING') AND NEW.state IN ('FAILED','SUCCEEDED','UNKNOWN','DEAD','RETRY') AND NEW.attempts=OLD.attempts AND NEW.fence=OLD.fence
+      AND (NEW.state<>'RETRY' OR OLD.state='LEASED') AND (NEW.state<>'SUCCEEDED' OR OLD.state='RUNNING'))
+ ) THEN RAISE EXCEPTION 'invalid preview dispatch transition'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER preview_dispatch_transition BEFORE UPDATE ON preview_dispatches FOR EACH ROW EXECUTE FUNCTION arkhe_preview_dispatch_transition();
+CREATE TRIGGER preview_dispatch_no_delete BEFORE DELETE ON preview_dispatches FOR EACH ROW EXECUTE FUNCTION arkhe_reject_mutation();
+CREATE TRIGGER preview_execution_immutable BEFORE UPDATE OR DELETE ON preview_execution_events FOR EACH ROW EXECUTE FUNCTION arkhe_reject_mutation();
+DO $$ DECLARE t text; BEGIN
+ FOREACH t IN ARRAY ARRAY['preview_dispatches','preview_execution_events'] LOOP
+  EXECUTE format('ALTER TABLE %I ENABLE ROW LEVEL SECURITY',t);
+  EXECUTE format('ALTER TABLE %I FORCE ROW LEVEL SECURITY',t);
+  EXECUTE format('CREATE POLICY tenant_isolation_%I ON %I USING (tenant_id=arkhe_assert_tenant()) WITH CHECK (tenant_id=arkhe_assert_tenant())',t,t);
+  EXECUTE format('REVOKE ALL ON %I FROM PUBLIC',t);
+  EXECUTE format('GRANT SELECT,INSERT ON %I TO arkhe_preview_execute',t);
+  EXECUTE format('GRANT SELECT ON %I TO arkhe_preview_enqueue,arkhe_read',t);
+ END LOOP;
+END $$;
+GRANT UPDATE(state,attempts,fence,owner_token,lease_until,available_at,result,updated_at) ON preview_dispatches TO arkhe_preview_execute;
+GRANT SELECT ON preview_admissions,preview_jobs TO arkhe_preview_execute;
diff --git a/arkhe/source/storage/sql/migrations/20261023000017_memo_observations.sql b/arkhe/source/storage/sql/migrations/20261023000017_memo_observations.sql
