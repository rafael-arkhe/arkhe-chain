+    t.abort();
+}
+#[tokio::test]
+async fn disagreement_and_malformed_output_create_no_worker_record() {
+    for value in [
+        json!({"supports_proposal":false,"reason":"insufficient evidence","confidence_bps":1}),
+        json!({"supports_proposal":true,"reason":"x","confidence_bps":10001}),
