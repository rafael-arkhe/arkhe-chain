@@ -0,0 +1,39 @@
+//! Adapter for existing evidence ports. Proof bytes remain untrusted; all
+//! original evidence/formal/budget lookups are retained and forwarded unchanged.
+use arkhe_core::{
+    evidence::{EvidenceEnvelope, EvidenceReader},
+    Digest32,
+};
+use async_trait::async_trait;
+pub struct AuthenticatedEvidence<'a, E> {
+    pub source: &'a E,
+    pub worker: Digest32,
+    pub request: &'a [u8],
+}
+#[async_trait]
+impl<E: EvidenceReader> EvidenceReader for AuthenticatedEvidence<'_, E> {
+    async fn get(&self, h: Digest32) -> Result<Option<EvidenceEnvelope>, String> {
+        self.source.get(h).await
+    }
+    async fn authenticated_policy_request(&self, h: Digest32) -> Result<Option<Vec<u8>>, String> {
+        if h != self.worker {
+            return Ok(None);
+        }
+        if self.request.len() > 1_048_576 {
+            return Err("authenticated proof too large".into());
+        }
+        Ok(Some(self.request.to_vec()))
+    }
+    async fn formal_proof(
+        &self,
+        h: Digest32,
+    ) -> Result<Option<arkhe_core::formal_proof::ProofCarryingOutput>, String> {
+        self.source.formal_proof(h).await
+    }
+    async fn budget_proof(
+        &self,
+        h: Digest32,
+    ) -> Result<Option<arkhe_core::output_proof::BudgetProof>, String> {
+        self.source.budget_proof(h).await
+    }
+}
diff --git a/arkhe/source/kernel/arkhe-kernel/src/broker.rs b/arkhe/source/kernel/arkhe-kernel/src/broker.rs
new file mode 100644
index 00000000..eba944e9
--- /dev/null
+++ b/arkhe/source/kernel/arkhe-kernel/src/broker.rs
@@ -0,0 +1,286 @@
+//! Host-side effect boundary. Agent processes must not possess the executor or
+//! its credentials. OS isolation and durable storage are deployment obligations.
+use crate::{AuthorizationDecision, ContainmentGate};
+use arkhe_core::{
+    evidence::EvidenceReader, work::WorkIntent, worker::WorkerExecutionRecord, Digest32,
+};
+use arkhe_governance::{PolicyBinding, PolicyResolver};
+use arkhe_verify_core::action_proof::{self, ActionProof, Trust};
+
+pub enum Reservation {
+    Acquired,
+    Replay(Vec<u8>),
+    Uncertain,
+}
+
+/// Implementations MUST atomically reserve (caller, operation), comparing the
+/// complete binding, persist before dispatch, and never take over uncertain work.
+/// An acquired entry remains uncertain after cancellation, panic or storage error.
+/// No in-memory implementation is installed as a production default.
+pub trait DispatchJournal {
+    /// Atomically consumes a caller nonce and reserves dispatch. No fallback to
+    /// an old journal that lacks nonce uniqueness is permitted.
+    fn reserve_authenticated(
+        &mut self,
+        _caller: &str,
+        _operation: Digest32,
+        _binding: Digest32,
+        _nonce: Digest32,
+    ) -> Result<Reservation, String> {
+        Err("journal lacks atomic authenticated nonce consumption".into())
+    }
+    /// Atomic reservation plus unique closed-mandate consumption across operations.
+    /// Older journals fail closed until this capability is explicitly implemented.
+    fn reserve_payment(
+        &mut self,
+        _caller: &str,
+        _operation: Digest32,
+        _binding: Digest32,
+        _closed_mandate: Digest32,
+    ) -> Result<Reservation, String> {
+        Err("journal lacks atomic closed-mandate consumption".into())
+    }
+    fn reserve(
+        &mut self,
+        caller: &str,
+        operation: Digest32,
+        binding: Digest32,
+    ) -> Result<Reservation, String>;
+    fn complete(
+        &mut self,
+        caller: &str,
+        operation: Digest32,
+        binding: Digest32,
+        receipt: &[u8],
+    ) -> Result<(), String>;
+}
+
+/// A trusted host implements this against one configured capability. The agent
+/// cannot select executable paths, URLs or credentials through a broker parameter.
+pub trait CapabilityExecutor {
+    fn execute(&mut self, intent: &WorkIntent) -> Result<Vec<u8>, String>;
+    /// Migrated capability consumes exactly the authenticated action. Old
+    /// executors must explicitly adapt their parameter schema before dispatch.
+    fn execute_authenticated(
+        &mut self,
+        _intent: &WorkIntent,
+        _action: &arkhe_verify_core::policy::Action,
+    ) -> Result<Vec<u8>, String> {
+        Err("executor lacks authenticated parameter adapter".into())
+    }
+}
+
+#[cfg(feature = "sqlite-broker")]
+impl<R: PolicyResolver, X: CapabilityExecutor>
+    CapabilityBroker<R, crate::broker_sqlite::SqliteDispatchJournal, X>
+{
+    /// Local SQLite effects only. External effects must use reserve-before-send
+    /// and preserve uncertainty, or an actual provider idempotency contract.
+    #[allow(clippy::too_many_arguments)]
+    pub async fn execute_authenticated_local<E: EvidenceReader, F>(
+        &mut self,
+        intent: &WorkIntent,
+        worker: &WorkerExecutionRecord,
+        policy: &PolicyBinding,
+        evidence: &E,
+        proof: &ActionProof,
+        trust: &Trust,
+        effect: F,
+    ) -> Result<crate::broker_sqlite::TransactionalResult, String>
+    where
+        F: FnOnce(
+            &rusqlite::Transaction<'_>,
+            &arkhe_verify_core::policy::Action,
+        ) -> Result<Vec<u8>, String>,
+    {
+        if self
+            .gate
+            .resolver
+            .required_formal_predicate(intent, policy)
+            .is_some()
+            || policy.policy_digest != trust.policy_digest
+        {
+            return Err("local transaction profile/mandate mismatch".into());
+        }
+        let request = self
+            .gate
+            .authenticated_request(intent, worker, policy, evidence)
+            .await?
+            .ok_or("local transaction requires authenticated policy")?;
+        let mandate = action_proof::verify(proof, intent, trust).map_err(str::to_owned)?;
+        if let AuthorizationDecision::Reject { reason } = self
+            .gate
+            .authorize_admitted(intent, worker, policy, evidence)
+            .await
+        {
+            return Err(reason);
+        }
+        let mut bytes = intent.parameters_digest.0.to_vec();
+        bytes.extend_from_slice(&mandate.0);
+        bytes.extend_from_slice(&policy.policy_digest.0);
+        bytes.extend_from_slice(&request.signed_intent.intent.policy_digest);
+        let binding = Digest32::blake3(b"AKG:BROKER:DISPATCH:v1\0", &bytes);
+        let mut nonce = intent.requested_by.as_bytes().to_vec();
+        nonce.extend_from_slice(&intent.request_identity.0 .0);
+        let nonce = Digest32::blake3(b"AKG:BROKER:AUTH-NONCE:v1\0", &nonce);
+        self.journal.transact_authenticated(
+            &intent.requested_by,
+            intent.operation_id(),
+            binding,
+            nonce,
+            |tx| effect(tx, &request.action),
+        )
+    }
+}
+
+pub struct CapabilityBroker<R: PolicyResolver, J: DispatchJournal, X: CapabilityExecutor> {
+    gate: ContainmentGate<R>,
+    journal: J,
+    executor: X,
+}
+impl<R: PolicyResolver, J: DispatchJournal, X: CapabilityExecutor> CapabilityBroker<R, J, X> {
+    pub fn new(gate: ContainmentGate<R>, journal: J, executor: X) -> Self {
+        Self {
+            gate,
+            journal,
+            executor,
+        }
+    }
+    pub fn set_emergency_stop(&mut self, enabled: bool) {
+        self.gate.set_emergency_stop(enabled);
+    }
+    /// AP2-role-validated path. The required Payment predicate is checked by the
+    /// gate; no local mandate is substituted for AP2 protocol validation.
+    pub async fn execute_payment<E: EvidenceReader>(
+        &mut self,
+        intent: &WorkIntent,
+        worker: &WorkerExecutionRecord,
+        policy: &PolicyBinding,
+        evidence: &E,
+    ) -> Result<Vec<u8>, String> {
+        if self
+            .gate
+            .resolver
+            .authenticated_context(intent, policy)
+            .is_some()
+        {
+            return Err("AP2 needs combined mandate/nonce journal support; authenticated profile cannot bypass it".into());
+        }
+        if !matches!(
+            self.gate.resolver.required_formal_predicate(intent, policy),
+            Some(arkhe_core::formal_proof::FormalPredicate::PaymentMandate(_))
+        ) {
+            return Err("payment capability requires AP2 formal predicate".into());
+        }
+        // The same credential may have multiple SD-JWT presentations. Never use
+        // raw presentation bytes as its single-use identity. A later gate read
+        // must authenticate the SAME role digest bound by this worker record.
+        let consumption = match evidence.formal_proof(worker.digest()).await? {
+            Some(arkhe_core::formal_proof::ProofCarryingOutput::PaymentMandate(proof))
+                if proof.role.digest() == worker.input_digest =>
+            {
+                proof.role.closed_mandate_id
+            }
+            _ => return Err("payment consumption identity unavailable or unbound".into()),
+        };
+        match self
+            .gate
+            .authorize_admitted(intent, worker, policy, evidence)
+            .await
+        {
+            AuthorizationDecision::Allow { .. } => {}
+            AuthorizationDecision::Reject { reason } => return Err(reason),
+        }
+        let mut bytes = intent.parameters_digest.0.to_vec();
+        bytes.extend_from_slice(&intent.target.0);
+        bytes.extend_from_slice(&policy.policy_digest.0);
+        let binding = Digest32::blake3(b"AKG:BROKER:AP2:DISPATCH:v1\0", &bytes);
+        let id = intent.operation_id();
+        match self
+            .journal
+            .reserve_payment(&intent.requested_by, id, binding, consumption)?
+        {
+            Reservation::Replay(receipt) => return Ok(receipt),
+            Reservation::Uncertain => {
+                return Err("manual reconciliation required; payment not repeated".into())
+            }
+            Reservation::Acquired => {}
+        }
+        let receipt = self.executor.execute(intent)?;
+        self.journal
+            .complete(&intent.requested_by, id, binding, &receipt)?;
+        Ok(receipt)
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub async fn execute<E: EvidenceReader>(
+        &mut self,
+        intent: &WorkIntent,
+        worker: &WorkerExecutionRecord,
+        policy: &PolicyBinding,
+        evidence: &E,
+        proof: &ActionProof,
+        trust: &Trust,
+    ) -> Result<Vec<u8>, String> {
+        if matches!(
+            self.gate.resolver.required_formal_predicate(intent, policy),
+            Some(arkhe_core::formal_proof::FormalPredicate::PaymentMandate(_))
+        ) {
+            return Err("payment predicates require atomic closed-mandate consumption path".into());
+        }
+        if policy.policy_digest != trust.policy_digest {
+            return Err("broker policy does not match mandate trust".into());
+        }
+        let mandate = action_proof::verify(proof, intent, trust).map_err(str::to_owned)?;
+        let authenticated = self
+            .gate
+            .authenticated_request(intent, worker, policy, evidence)
+            .await?;
+        let authorization = match self
+            .gate
+            .authorize_admitted(intent, worker, policy, evidence)
+            .await
+        {
+            AuthorizationDecision::Allow { authorization_ref } => authorization_ref,
+            AuthorizationDecision::Reject { reason } => return Err(reason),
+        };
+        // Context/worker evidence may be refreshed on a retry. The immutable
+        // dispatch binding instead fixes principal, parameters, mandate and policy.
+        let mut bytes = intent.parameters_digest.0.to_vec();
+        bytes.extend_from_slice(&mandate.0);
+        bytes.extend_from_slice(&policy.policy_digest.0);
+        if let Some(request) = &authenticated {
+            bytes.extend_from_slice(&request.signed_intent.intent.policy_digest);
+        }
+        let binding = Digest32::blake3(b"AKG:BROKER:DISPATCH:v1\0", &bytes);
+        let _checked_authorization = authorization;
+        let id = intent.operation_id();
+        let reservation = if authenticated.is_some() {
+            // Consumption is global across targets/types for the same caller's
+            // request nonce; changing the operation ID cannot reuse that nonce.
+            let mut nonce = intent.requested_by.as_bytes().to_vec();
+            nonce.extend_from_slice(&intent.request_identity.0 .0);
+            let nonce = Digest32::blake3(b"AKG:BROKER:AUTH-NONCE:v1\0", &nonce);
+            self.journal
+                .reserve_authenticated(&intent.requested_by, id, binding, nonce)?
+        } else {
+            self.journal.reserve(&intent.requested_by, id, binding)?
+        };
+        match reservation {
+            Reservation::Replay(receipt) => return Ok(receipt),
+            Reservation::Uncertain => {
+                return Err("manual reconciliation required; dispatch not repeated".into())
+            }
+            Reservation::Acquired => {}
+        }
+        // Failure and cancellation intentionally leave the reservation uncertain.
+        let receipt = match &authenticated {
+            Some(request) => self
+                .executor
+                .execute_authenticated(intent, &request.action)?,
+            None => self.executor.execute(intent)?,
+        };
+        self.journal
+            .complete(&intent.requested_by, id, binding, &receipt)?;
+        Ok(receipt)
+    }
+}
diff --git a/arkhe/source/kernel/arkhe-kernel/src/broker_sqlite.rs b/arkhe/source/kernel/arkhe-kernel/src/broker_sqlite.rs
new file mode 100644
index 00000000..81cf6a64
--- /dev/null
+++ b/arkhe/source/kernel/arkhe-kernel/src/broker_sqlite.rs
@@ -0,0 +1,202 @@
+//! Optional standalone durable broker journal. Does not replace PostgreSQL.
+use crate::broker::{DispatchJournal, Reservation};
+use arkhe_core::Digest32;
+use rusqlite::{params, Connection, OptionalExtension, TransactionBehavior};
+use std::{collections::HashMap, path::Path, time::Duration};
+
+pub struct SqliteDispatchJournal {
+    connection: Connection,
+    owners: HashMap<(String, Digest32), String>,
+}
+#[derive(Debug, PartialEq, Eq)]
+pub enum TransactionalResult {
+    Executed(Vec<u8>),
+    Replay(Vec<u8>),
+    Uncertain,
+}
+
+impl SqliteDispatchJournal {
+    /// Atomic only for effects written through this same SQLite transaction.
+    /// The trusted callback MUST NOT perform network/filesystem/provider effects.
+    /// On callback error/panic the local effect, nonce and reservation roll back.
+    pub fn transact_authenticated<F>(
+        &mut self,
+        caller: &str,
+        operation: Digest32,
+        binding: Digest32,
+        nonce: Digest32,
+        effect: F,
+    ) -> Result<TransactionalResult, String>
+    where
+        F: FnOnce(&rusqlite::Transaction<'_>) -> Result<Vec<u8>, String>,
+    {
+        let tx = self
+            .connection
+            .transaction_with_behavior(TransactionBehavior::Immediate)
+            .map_err(|e| e.to_string())?;
+        let old:Option<(Vec<u8>,String,Option<Vec<u8>>)>=tx.query_row("SELECT binding,status,receipt FROM broker_dispatch WHERE caller=?1 AND operation=?2",params![caller,&operation.0[..]],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional().map_err(|e|e.to_string())?;
+        if let Some((old, status, receipt)) = old {
+            if old != binding.0 {
+                return Err("broker parameter/policy conflict".into());
+            }
+            let same:bool=tx.query_row("SELECT EXISTS(SELECT 1 FROM broker_authenticated_consumption WHERE caller=?1 AND nonce=?2 AND operation=?3)",params![caller,&nonce.0[..],&operation.0[..]],|r|r.get(0)).map_err(|e|e.to_string())?;
+            if !same {
+                return Err("authenticated nonce binding missing".into());
+            }
+            return match (status.as_str(), receipt) {
+                ("COMPLETED", Some(r)) => Ok(TransactionalResult::Replay(r)),
+                ("UNCERTAIN", None) => Ok(TransactionalResult::Uncertain),
+                _ => Err("invalid persisted broker state".into()),
+            };
+        }
+        let owner = uuid::Uuid::new_v4().to_string();
+        tx.execute("INSERT INTO broker_dispatch(caller,operation,binding,owner,status) VALUES(?1,?2,?3,?4,'UNCERTAIN')",params![caller,&operation.0[..],&binding.0[..],owner]).map_err(|e|e.to_string())?;
+        tx.execute(
+            "INSERT INTO broker_authenticated_consumption(caller,nonce,operation) VALUES(?1,?2,?3)",
+            params![caller, &nonce.0[..], &operation.0[..]],
+        )
+        .map_err(|_| "authenticated nonce already consumed".to_owned())?;
+        let receipt = effect(&tx)?;
+        let n=tx.execute("UPDATE broker_dispatch SET status='COMPLETED',receipt=?4 WHERE caller=?1 AND operation=?2 AND binding=?3 AND status='UNCERTAIN'",params![caller,&operation.0[..],&binding.0[..],&receipt]).map_err(|e|e.to_string())?;
+        if n != 1 {
+            return Err("invalid transactional completion".into());
+        }
+        tx.commit().map_err(|e| e.to_string())?;
+        Ok(TransactionalResult::Executed(receipt))
+    }
+}
+impl SqliteDispatchJournal {
+    pub fn open(path: &Path) -> Result<Self, String> {
+        if path == Path::new(":memory:") || path.as_os_str().is_empty() {
+            return Err("durable broker requires a filesystem database".into());
+        }
+        let connection = Connection::open(path).map_err(|e| e.to_string())?;
+        connection
+            .busy_timeout(Duration::from_secs(5))
+            .map_err(|e| e.to_string())?;
+        connection
+            .execute_batch(
+                "PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL;
+          CREATE TABLE IF NOT EXISTS broker_dispatch(
+            caller TEXT NOT NULL, operation BLOB NOT NULL, binding BLOB NOT NULL,
+            owner TEXT NOT NULL, status TEXT NOT NULL CHECK(status IN ('UNCERTAIN','COMPLETED')),
+            receipt BLOB, PRIMARY KEY(caller,operation),
+            CHECK((status='COMPLETED')=(receipt IS NOT NULL)));
+          CREATE TABLE IF NOT EXISTS broker_closed_consumption(
+            closed BLOB PRIMARY KEY NOT NULL, caller TEXT NOT NULL, operation BLOB NOT NULL);
+          CREATE TABLE IF NOT EXISTS broker_authenticated_consumption(
+            caller TEXT NOT NULL, nonce BLOB NOT NULL, operation BLOB NOT NULL, PRIMARY KEY(caller,nonce));",
+            )
+            .map_err(|e| e.to_string())?;
+        Ok(Self {
+            connection,
+            owners: HashMap::new(),
+        })
+    }
+    fn reserve_inner(
+        &mut self,
+        caller: &str,
+        operation: Digest32,
+        binding: Digest32,
+        closed: Option<Digest32>,
+        nonce: Option<Digest32>,
+    ) -> Result<Reservation, String> {
+        let tx = self
+            .connection
+            .transaction_with_behavior(TransactionBehavior::Immediate)
+            .map_err(|e| e.to_string())?;
+        let old: Option<(Vec<u8>,String,Option<Vec<u8>>)> = tx.query_row(
+            "SELECT binding,status,receipt FROM broker_dispatch WHERE caller=?1 AND operation=?2",
+            params![caller,&operation.0[..]], |r| Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional().map_err(|e|e.to_string())?;
+        if let Some((old, status, receipt)) = old {
+            if old != binding.0 {
+                return Err("broker parameter/policy conflict".into());
+            }
+            if let Some(closed) = closed {
+                let same:bool=tx.query_row("SELECT EXISTS(SELECT 1 FROM broker_closed_consumption WHERE closed=?1 AND caller=?2 AND operation=?3)",
+                    params![&closed.0[..],caller,&operation.0[..]],|r|r.get(0)).map_err(|e|e.to_string())?;
+                if !same {
+                    return Err("closed-mandate consumption binding missing".into());
+                }
+            }
+            if let Some(nonce) = nonce {
+                let same:bool=tx.query_row("SELECT EXISTS(SELECT 1 FROM broker_authenticated_consumption WHERE caller=?1 AND nonce=?2 AND operation=?3)",params![caller,&nonce.0[..],&operation.0[..]],|r|r.get(0)).map_err(|e|e.to_string())?;
+                if !same {
+                    return Err("authenticated nonce binding missing".into());
+                }
+            }
+            let result = match (status.as_str(), receipt) {
+                ("COMPLETED", Some(receipt)) => Reservation::Replay(receipt),
+                ("UNCERTAIN", None) => Reservation::Uncertain,
+                _ => return Err("invalid persisted broker state".into()),
+            };
+            tx.commit().map_err(|e| e.to_string())?;
+            return Ok(result);
+        }
+        let owner = uuid::Uuid::new_v4().to_string();
+        tx.execute("INSERT INTO broker_dispatch(caller,operation,binding,owner,status) VALUES(?1,?2,?3,?4,'UNCERTAIN')",
+            params![caller,&operation.0[..],&binding.0[..],owner]).map_err(|e|e.to_string())?;
+        if let Some(closed) = closed {
+            tx.execute(
+                "INSERT INTO broker_closed_consumption(closed,caller,operation) VALUES(?1,?2,?3)",
+                params![&closed.0[..], caller, &operation.0[..]],
+            )
+            .map_err(|_| "closed mandate already consumed".to_owned())?;
+        }
+        if let Some(nonce) = nonce {
+            tx.execute("INSERT INTO broker_authenticated_consumption(caller,nonce,operation) VALUES(?1,?2,?3)",params![caller,&nonce.0[..],&operation.0[..]])
+                .map_err(|_|"authenticated nonce already consumed".to_owned())?;
+        }
+        tx.commit().map_err(|e| e.to_string())?;
+        self.owners.insert((caller.into(), operation), owner);
+        Ok(Reservation::Acquired)
+    }
+}
+impl DispatchJournal for SqliteDispatchJournal {
+    fn reserve_authenticated(
+        &mut self,
+        caller: &str,
+        operation: Digest32,
+        binding: Digest32,
+        nonce: Digest32,
+    ) -> Result<Reservation, String> {
+        self.reserve_inner(caller, operation, binding, None, Some(nonce))
+    }
+    fn reserve(
+        &mut self,
+        caller: &str,
+        operation: Digest32,
+        binding: Digest32,
+    ) -> Result<Reservation, String> {
+        self.reserve_inner(caller, operation, binding, None, None)
+    }
+    fn reserve_payment(
+        &mut self,
+        caller: &str,
+        operation: Digest32,
+        binding: Digest32,
+        closed: Digest32,
+    ) -> Result<Reservation, String> {
+        self.reserve_inner(caller, operation, binding, Some(closed), None)
+    }
+    fn complete(
+        &mut self,
+        caller: &str,
+        operation: Digest32,
+        binding: Digest32,
+        receipt: &[u8],
+    ) -> Result<(), String> {
+        let slot = (caller.into(), operation);
+        let owner = self
+            .owners
+            .get(&slot)
+            .ok_or("journal handle does not own reservation")?;
+        let n=self.connection.execute("UPDATE broker_dispatch SET status='COMPLETED',receipt=?5 WHERE caller=?1 AND operation=?2 AND binding=?3 AND owner=?4 AND status='UNCERTAIN'",
+            params![caller,&operation.0[..],&binding.0[..],owner,receipt]).map_err(|e|e.to_string())?;
+        if n != 1 {
+            return Err("invalid broker completion transition".into());
+        }
+        self.owners.remove(&slot);
+        Ok(())
+    }
+}
diff --git a/arkhe/source/kernel/arkhe-kernel/src/lib.rs b/arkhe/source/kernel/arkhe-kernel/src/lib.rs
new file mode 100644
index 00000000..bce679d0
--- /dev/null
+++ b/arkhe/source/kernel/arkhe-kernel/src/lib.rs
@@ -0,0 +1,466 @@
+use arkhe_core::{
+    work::{WorkIntent, WorkIntentType},
+    worker::WorkerExecutionRecord,
+    Digest32,
+};
+use arkhe_governance::{PolicyBinding, PolicyResolver, PolicyVerdict};
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Classification {
+    Protected,
+    Unprotected,
+}
+
+pub fn classify(t: &WorkIntentType) -> Classification {
+    use WorkIntentType::*;
+    match t {
+        DraftDocument | QueryKnowledgeBase | Simulate => Classification::Unprotected,
+        _ => Classification::Protected,
+    }
+}
+
+#[derive(Debug, Clone)]
+pub enum AuthorizationDecision {
+    Allow { authorization_ref: Digest32 },
+    Reject { reason: String },
+}
+
+pub struct ContainmentGate<R: PolicyResolver> {
+    resolver: R,
+    emergency_stop: bool,
+}
+
+impl<R: PolicyResolver> ContainmentGate<R> {
+    pub fn new(resolver: R) -> Self {
+        Self {
+            resolver,
+            emergency_stop: false,
+        }
+    }
+
+    pub fn set_emergency_stop(&mut self, enabled: bool) {
+        self.emergency_stop = enabled;
+    }
+    pub(crate) async fn authenticated_request<E: arkhe_core::evidence::EvidenceReader>(
+        &self,
+        intent: &WorkIntent,
+        worker: &WorkerExecutionRecord,
+        policy: &PolicyBinding,
+        evidence: &E,
+    ) -> Result<Option<arkhe_verify_core::policy::Request>, String> {
+        let Some(ctx) = self.resolver.authenticated_context(intent, policy) else {
+            return Ok(None);
+        };
+        let bytes = evidence
+            .authenticated_policy_request(worker.digest())
+            .await?
+            .ok_or("required authenticated policy proof unavailable")?;
+        if bytes.len() > 1_048_576 {
+            return Err("authenticated proof too large".into());
+        }
+        let request =
+            serde_json::from_slice(&bytes).map_err(|_| "invalid authenticated policy JSON")?;
+        arkhe_verify_core::policy::verify_legacy(
+            &request,
+            &ctx,
+            intent,
+            worker,
+            policy.policy_digest,
+        )?;
+        Ok(Some(request))
+    }
+    /// Read-only governance signal for escalation; it never grants authorization.
+    pub fn policy_verdict(&self, intent: &WorkIntent, policy: &PolicyBinding) -> PolicyVerdict {
+        self.resolver.resolve(intent, policy)
+    }
+
+    pub fn authorize(
+        &self,
+        intent: &WorkIntent,
+        worker_record: Option<&WorkerExecutionRecord>,
+        policy: &PolicyBinding,
+    ) -> AuthorizationDecision {
+        if self
+            .resolver
+            .authenticated_context(intent, policy)
+            .is_some()
+        {
+            return AuthorizationDecision::Reject {
+                reason: "authenticated policy requires admitted proof transport".into(),
+            };
+        }
+        if self.emergency_stop {
+            return AuthorizationDecision::Reject {
+                reason: "emergency stop".into(),
+            };
+        }
+        // A caller-supplied record is not proof of admission. All protected
+        // intent types must use the evidence-reader path, including future types.
+        if classify(&intent.intent_type) == Classification::Protected {
+            if worker_record.is_none() {
+                return AuthorizationDecision::Reject {
+                    reason: "protected intent missing WorkerExecutionRecord".into(),
+                };
+            }
+            return AuthorizationDecision::Reject {
+                reason: "integration requires admitted evidence lookup".into(),
+            };
+        }
+        self.authorize_checked(intent, worker_record, policy)
+    }
+
+    pub async fn authorize_admitted<E: arkhe_core::evidence::EvidenceReader>(
+        &self,
+        intent: &WorkIntent,
+        worker: &WorkerExecutionRecord,
+        policy: &PolicyBinding,
+        evidence: &E,
+    ) -> AuthorizationDecision {
+        if self.resolver.review_routing_required(intent, policy) {
+            return AuthorizationDecision::Reject {
+                reason: "policy requires review routing".into(),
+            };
+        }
+        self.authorize_admitted_inner(intent, worker, policy, evidence)
+            .await
+    }
+
+    /// Routing never overrides the existing admission and governance checks.
+    #[allow(clippy::too_many_arguments)]
+    pub async fn authorize_routed_admitted<E: arkhe_core::evidence::EvidenceReader>(
+        &self,
+        intent: &WorkIntent,
+        worker: &WorkerExecutionRecord,
+        policy: &PolicyBinding,
+        evidence: &E,
+        decision: &arkhe_core::review::ReviewDecision,
+        human: Option<&arkhe_core::review::HumanReviewEvidence>,
+        now: i64,
+    ) -> AuthorizationDecision {
+        use arkhe_core::{
+            review::{HumanVerdict, ReviewVerdict},
+            worker::CognitiveOperation,
+        };
+        let reject = |reason: &str| AuthorizationDecision::Reject {
+            reason: reason.into(),
+        };
+        if decision.verdict == ReviewVerdict::AutoReject {
+            return reject("review router rejected proposal");
+        }
+        if decision.verdict == ReviewVerdict::AutoAccept
+            && self.resolver.review_routing_required(intent, policy)
+            && !self.resolver.automatic_review_approved(intent, policy)
+        {
+            return reject("automatic review routing not approved by governance");
+        }
+        let mut routes = intent
+            .context
+            .iter()
+            .filter(|e| e.kind == arkhe_core::work::ContextKind::ReviewDecision);
+        if routes.next().map(|e| e.hash) != Some(decision.digest()) || routes.next().is_some() {
+            return reject("missing or ambiguous review route binding");
+        }
+        if decision.verdict == ReviewVerdict::ReviewRequired {
+            let Some(human) = human else {
+                return reject("human review required");
+            };
+            let r = &human.review;
+            let w = &human.attestation;
+            let h = w.digest();
+            if now < 0
+                || r.verdict != HumanVerdict::Approve
+                || r.reviewed_at < 0
+                || r.reviewed_at > now
+                || r.expires_at <= now
+                || r.reviewer.trim().is_empty()
+                || r.requested_by != intent.requested_by
+                || r.operation_id != intent.operation_id()
+                || r.parameters_digest != intent.parameters_digest
+                || r.analysis_digest != worker.digest()
+                || r.policy_digest != policy.policy_digest
+                || r.routing_digest != decision.digest()
+                || w.input_digest != worker.digest()
+                || w.output_digest != r.digest()
+                || !w.evidence_refs.contains(&worker.digest())
+                || w.operation != Some(CognitiveOperation::Decide)
+                || !self
+                    .resolver
+                    .human_review_modules(intent, policy)
+                    .contains(&w.module_id)
+            {
+                return reject("invalid, stale or unauthorized human review");
+            }
+            let mut refs = intent
+                .context
+                .iter()
+                .filter(|e| e.kind == arkhe_core::work::ContextKind::HumanReview);
+            if refs.next().map(|e| e.hash) != Some(h) || refs.next().is_some() {
+                return reject("missing or ambiguous human review context");
+            }
+            match evidence.get(h).await {
+                Ok(Some(e))
+                    if e.record_hash == h
+                        && e.payload_digest == h
+                        && e.kind == "WorkerExecutionRecord"
+                        && e.subject == worker.digest() => {}
+                _ => return reject("human review attestation not admitted"),
+            }
+        }
+        self.authorize_admitted_inner(intent, worker, policy, evidence)
+            .await
+    }
+
+    async fn authorize_admitted_inner<E: arkhe_core::evidence::EvidenceReader>(
+        &self,
+        intent: &WorkIntent,
+        worker: &WorkerExecutionRecord,
+        policy: &PolicyBinding,
+        evidence: &E,
+    ) -> AuthorizationDecision {
+        let reject = |reason: &str| AuthorizationDecision::Reject {
+            reason: reason.into(),
+        };
+        if self.emergency_stop {
+            return reject("emergency stop");
+        }
+        if let Err(reason) = self
+            .authenticated_request(intent, worker, policy, evidence)
+            .await
+        {
+            return reject(&reason);
+        }
+        let hash = match intent.analysis_record() {
+            Ok(h) => h,
+            Err(e) => return reject(e),
+        };
+        let envelope = match evidence.get(hash).await {
+            Ok(Some(e)) => e,
+            _ => return reject("missing admitted analysis evidence"),
+        };
+        let mut sources = intent
+            .context
+            .iter()
+            .filter(|e| e.kind == arkhe_core::work::ContextKind::SourceReport);
+        let source = match sources.next() {
+            Some(e) => e.hash,
+            None => return reject("missing source report"),
+        };
+        if sources.next().is_some() {
+            return reject("ambiguous source report");
+        }
+        if worker.digest() != hash
+            || envelope.record_hash != hash
+            || envelope.kind != "WorkerExecutionRecord"
+            || envelope.payload_digest != hash
+            || envelope.subject != source
+            || worker.input_digest != source
+            || worker.output_digest != intent.parameters_digest
+        {
+            return reject("analysis evidence does not bind this proposal");
+        }
+        let requirement = match self.resolver.required_worker_evidence(intent, policy) {
+            Some(r) => r,
+            None => return reject("missing worker evidence policy"),
+        };
+        if !requirement.allowed_modules.contains(&worker.module_id) {
+            return reject("module not allowed");
+        }
+        if !worker
+            .operation
+            .is_some_and(|op| requirement.allowed_operations.contains(&op))
+        {
+            return reject("operation not allowed");
+        }
+        if let Some(expected_policy) = self.resolver.required_classification_policy(intent, policy)
+        {
+            let Some(binding) = worker.classification else {
+                return reject("missing typed classification binding");
+            };
+            if binding.policy_digest != expected_policy
+                || binding.classification_digest == Digest32::ZERO
+            {
+                return reject("classification policy mismatch");
+            }
+            for (kind, expected) in [
+                (
+                    arkhe_core::work::ContextKind::SeverityClassification,
+                    binding.classification_digest,
+                ),
+                (
+                    arkhe_core::work::ContextKind::ClassificationPolicy,
+                    expected_policy,
+                ),
+            ] {
+                let mut entries = intent.context.iter().filter(|entry| entry.kind == kind);
+                if entries.next().map(|entry| entry.hash) != Some(expected)
+                    || entries.next().is_some()
+                {
+                    return reject("missing, ambiguous or mismatched classification context");
+                }
+            }
+        }
+        let proof_digest = if let Some(spec) = self.resolver.required_budget_proof(intent, policy) {
+            let proof = match evidence.budget_proof(worker.digest()).await {
+                Ok(Some(p)) => p,
+                _ => return reject("required budget proof unavailable"),
+            };
+            match arkhe_verify_core::output_proof::verify_budget_proof(
+                &proof,
+                &spec,
+                policy.policy_digest,
+                intent,
+                worker,
+            ) {
+                Ok(digest) => {
+                    match evidence.get(digest).await {
+                        Ok(Some(e))
+                            if e.record_hash == digest
+                                && e.payload_digest == digest
+                                && e.kind == "BudgetProof"
+                                && e.subject == worker.digest()
+                                && e.policy_digest == Some(policy.policy_digest)
+                                && e.causal_parents
+                                    == vec![worker.digest(), worker.input_digest] => {}
+                        _ => return reject("budget proof not admitted with expected provenance"),
+                    }
+                    Some((spec.digest(), digest))
+                }
+                Err(reason) => return reject(reason),
+            }
+        } else {
+            None
+        };
+        let formal_digest =
+            if let Some(spec) = self.resolver.required_formal_predicate(intent, policy) {
+                use arkhe_core::formal_proof::{FormalPredicate, ProofCarryingOutput};
+                let proof = match evidence.formal_proof(worker.digest()).await {
+                    Ok(Some(p)) => p,
+                    _ => return reject("required formal proof unavailable"),
+                };
+                let checked = match (&spec, &proof) {
+                    (FormalPredicate::License(spec), ProofCarryingOutput::License(proof)) => {
+                        arkhe_verify_core::license::verify(
+                            proof,
+                            spec,
+                            policy.policy_digest,
+                            intent,
+                            worker,
+                        )
+                    }
+                    (
+                        FormalPredicate::PaymentMandate(spec),
+                        ProofCarryingOutput::PaymentMandate(proof),
+                    ) => arkhe_verify_core::payment::verify(
+                        proof,
+                        spec,
+                        policy.policy_digest,
+                        intent,
+                        worker,
+                    ),
+                    _ => Err("formal proof kind does not match required predicate"),
+                };
+                if let Err(reason) = checked {
+                    return reject(reason);
+                }
+                let digest = proof.digest();
+                match evidence.get(digest).await {
+                    Ok(Some(e))
+                        if e.record_hash == digest
+                            && e.payload_digest == digest
+                            && e.kind == "FormalProof"
+                            && e.subject == worker.digest()
+                            && e.policy_digest == Some(policy.policy_digest)
+                            && e.causal_parents == vec![worker.digest(), worker.input_digest] => {}
+                    _ => return reject("formal proof not admitted with expected provenance"),
+                }
+                Some((spec.digest(), digest))
+            } else {
+                None
+            };
+        self.authorize_checked_with_proof(intent, Some(worker), policy, proof_digest, formal_digest)
+    }
+
+    fn authorize_checked(
+        &self,
+        intent: &WorkIntent,
+        worker_record: Option<&WorkerExecutionRecord>,
+        policy: &PolicyBinding,
+    ) -> AuthorizationDecision {
+        self.authorize_checked_with_proof(intent, worker_record, policy, None, None)
+    }
+
+    fn authorize_checked_with_proof(
+        &self,
+        intent: &WorkIntent,
+        worker_record: Option<&WorkerExecutionRecord>,
+        policy: &PolicyBinding,
+        checked_proof: Option<(Digest32, Digest32)>,
+        checked_formal: Option<(Digest32, Digest32)>,
+    ) -> AuthorizationDecision {
+        let required_formal = self
+            .resolver
+            .required_formal_predicate(intent, policy)
+            .map(|spec| spec.digest());
+        if required_formal != checked_formal.map(|(spec, _)| spec) {
+            return AuthorizationDecision::Reject {
+                reason: "required formal proof not checked or specification changed".into(),
+            };
+        }
+        let required_spec = self
+            .resolver
+            .required_budget_proof(intent, policy)
+            .map(|spec| spec.digest());
+        if required_spec != checked_proof.map(|(spec, _)| spec) {
+            return AuthorizationDecision::Reject {
+                reason: "required budget proof not checked or specification changed".into(),
+            };
+        }
+        let proof_digest = checked_proof.map(|(_, proof)| proof);
+        if self.emergency_stop {
+            return AuthorizationDecision::Reject {
+                reason: "emergency stop".into(),
+            };
+        }
+
+        if classify(&intent.intent_type) == Classification::Protected && worker_record.is_none() {
+            return AuthorizationDecision::Reject {
+                reason: "protected intent missing WorkerExecutionRecord".into(),
+            };
+        }
+
+        match self.resolver.resolve(intent, policy) {
+            PolicyVerdict::Allow => {
+                let mut bytes = intent.digest().0.to_vec();
+                bytes.extend_from_slice(&policy.policy_digest.0);
+                if let Some(w) = worker_record {
+                    bytes.extend_from_slice(&w.digest().0);
+                }
+                if let Some(proof) = proof_digest {
+                    bytes.extend_from_slice(&proof.0);
+                }
+                if let Some((_, proof)) = checked_formal {
+                    bytes.extend_from_slice(&proof.0);
+                }
+                AuthorizationDecision::Allow {
+                    authorization_ref: Digest32::blake3(
+                        if checked_formal.is_some() {
+                            b"AKG:AUTHZ:FORMAL:v1\0"
+                        } else if proof_digest.is_some() {
+                            b"AKG:AUTHZ:PCO:v1\0"
+                        } else {
+                            b"AKG:AUTHZ:v0-REF\0"
+                        },
+                        &bytes,
+                    ),
+                }
+            }
+            PolicyVerdict::Deny(r) | PolicyVerdict::Inconclusive(r) => {
+                AuthorizationDecision::Reject { reason: r }
+            }
+        }
+    }
+}
+pub mod authenticated_transport;
+pub mod broker;
+#[cfg(feature = "sqlite-broker")]
+pub mod broker_sqlite;
