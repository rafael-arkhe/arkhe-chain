@@ -0,0 +1,483 @@
+//! Persistent, tenant-scoped implementation. Callers own evidence admission;
+//! this store does not convert untrusted input into verified evidence.
+use crate::regenerate::{
+    anchor_checkpoint, AnchoredCheckpoint, CheckpointAnchor, CheckpointBinding,
+    OrderedRecordSource, SequencedRecord, SourceError, DEFAULT_STREAM_ID,
+};
+use arkhe_core::{
+    evidence::{EvidenceCommitter, EvidenceEnvelope, EvidenceReader, WorkEvidenceCommitter},
+    work::WorkIntent,
+    worker::WorkerExecutionRecord,
+    CanonicalEncode, Digest32,
+};
+use async_trait::async_trait;
+use sqlx::{postgres::PgPoolOptions, postgres::PgRow, PgPool, Postgres, Row, Transaction};
+
+pub mod memo;
+pub mod replica;
+
+pub struct PgWormGraph {
+    pool: PgPool,
+    tenant: String,
+    stream_id: String,
+    writer_epoch: Option<u64>,
+}
+impl PgWormGraph {
+    /// Deployment-only entry point. Runtime requests never run migrations.
+    pub async fn migrate(url: &str) -> Result<(), String> {
+        let pool = PgPoolOptions::new()
+            .max_connections(1)
+            .connect(url)
+            .await
+            .map_err(|e| e.to_string())?;
+        sqlx::migrate!("../../storage/sql/migrations")
+            .run(&pool)
+            .await
+            .map_err(|e| e.to_string())?;
+        pool.close().await;
+        Ok(())
+    }
+    pub async fn connect(url: &str, tenant: &str) -> Result<Self, String> {
+        Self::connect_with_stream(url, tenant, DEFAULT_STREAM_ID).await
+    }
+
+    pub async fn connect_with_stream(
+        url: &str,
+        tenant: &str,
+        stream_id: &str,
+    ) -> Result<Self, String> {
+        if tenant.trim().is_empty() {
+            return Err("tenant is required".into());
+        }
+        if stream_id.trim().is_empty() {
+            return Err("stream is required".into());
+        }
+        let pool = PgPoolOptions::new()
+            .max_connections(5)
+            .acquire_timeout(std::time::Duration::from_secs(5))
+            .connect(url)
+            .await
+            .map_err(|e| e.to_string())?;
+        let privileged: bool = sqlx::query_scalar(
+            "SELECT rolsuper OR rolbypassrls OR rolcreaterole OR rolcreatedb FROM pg_roles WHERE rolname = current_user"
+        ).fetch_one(&pool).await.map_err(|e| e.to_string())?;
+        if privileged {
+            return Err(
+                "runtime database role must not have administrative or RLS-bypass privileges"
+                    .into(),
+            );
+        }
+        let graph = Self {
+            pool,
+            tenant: tenant.into(),
+            stream_id: stream_id.into(),
+            writer_epoch: match std::env::var("ARKHE_WRITER_EPOCH") {
+                Ok(value) => {
+                    let epoch: u64 = value.parse().map_err(|_| "invalid ARKHE_WRITER_EPOCH")?;
+                    if epoch == 0 || epoch > i64::MAX as u64 {
+                        return Err("invalid ARKHE_WRITER_EPOCH".into());
+                    }
+                    Some(epoch)
+                }
+                Err(std::env::VarError::NotPresent) => None,
+                Err(_) => return Err("invalid ARKHE_WRITER_EPOCH encoding".into()),
+            },
+        };
+        // Check role memberships, schema availability, and tenant context before serving.
+        for role in ["arkhe_append", "arkhe_read"] {
+            let mut tx = graph.begin(role).await?;
+            sqlx::query("SELECT record_hash FROM wormgraph_records LIMIT 0")
+                .execute(&mut *tx)
+                .await
+                .map_err(|e| e.to_string())?;
+            tx.commit().await.map_err(|e| e.to_string())?;
+        }
+        Ok(graph)
+    }
+    /// Opt-in writer identity. SQL additionally binds the database session login
+    /// to the fence owner, so claiming another epoch alone cannot impersonate it.
+    pub async fn connect_fenced(
+        url: &str,
+        tenant: &str,
+        stream: &str,
+        epoch: u64,
+    ) -> Result<Self, String> {
+        if epoch == 0 || epoch > i64::MAX as u64 {
+            return Err("invalid writer epoch".into());
+        }
+        let mut graph = Self::connect_with_stream(url, tenant, stream).await?;
+        graph.writer_epoch = Some(epoch);
+        Ok(graph)
+    }
+    async fn begin(&self, role: &str) -> Result<Transaction<'_, Postgres>, String> {
+        let mut tx = self.pool.begin().await.map_err(|e| e.to_string())?;
+        let stmt = match role {
+            "arkhe_append" => "SET LOCAL ROLE arkhe_append",
+            "arkhe_read" => "SET LOCAL ROLE arkhe_read",
+            _ => return Err("invalid storage role".into()),
+        };
+        sqlx::query(stmt)
+            .execute(&mut *tx)
+            .await
+            .map_err(|e| e.to_string())?;
+        arkhe_sql::tenant::set_tenant(&mut tx, &self.tenant)
+            .await
+            .map_err(|e| e.to_string())?;
+        if role == "arkhe_append" {
+            sqlx::query("SELECT set_config('arkhe.writer_epoch', $1, true)")
+                .bind(self.writer_epoch.map(|v| v.to_string()).unwrap_or_default())
+                .execute(&mut *tx)
+                .await
+                .map_err(|e| e.to_string())?;
+        }
+        Ok(tx)
+    }
+    pub async fn health(&self) -> Result<(), String> {
+        let mut tx = self.begin("arkhe_read").await?;
+        sqlx::query("SELECT record_hash FROM wormgraph_records LIMIT 0")
+            .execute(&mut *tx)
+            .await
+            .map_err(|e| e.to_string())?;
+        tx.commit().await.map_err(|e| e.to_string())
+    }
+
+    pub async fn load_checkpoint(
+        &self,
+        stream_id: &str,
+        leaf_count: u64,
+    ) -> Result<Option<CheckpointBinding>, String> {
+        if stream_id != self.stream_id {
+            return Err("checkpoint stream does not match configured stream".into());
+        }
+        let leaf_count = i64::try_from(leaf_count)
+            .map_err(|_| "checkpoint leaf_count exceeds bigint".to_string())?;
+        let mut tx = self.begin("arkhe_read").await?;
+        let row = sqlx::query(
+            "SELECT leaf_count, mmr_size, mmr_root, peaks, profile_digest, covered_up_to_hash
+             FROM mmr_checkpoints
+             WHERE tenant_id=$1 AND stream_id=$2 AND leaf_count=$3",
+        )
+        .bind(&self.tenant)
+        .bind(stream_id)
+        .bind(leaf_count)
+        .fetch_optional(&mut *tx)
+        .await
+        .map_err(|e| e.to_string())?;
+        tx.commit().await.map_err(|e| e.to_string())?;
+
+        row.map(|row| checkpoint_from_row(&row, &self.tenant, stream_id))
+            .transpose()
+    }
+
+    pub async fn load_latest_checkpoint(
+        &self,
+        stream_id: &str,
+    ) -> Result<Option<CheckpointBinding>, String> {
+        if stream_id != self.stream_id {
+            return Err("checkpoint stream does not match configured stream".into());
+        }
+        let mut tx = self.begin("arkhe_read").await?;
+        let row = sqlx::query(
+            "SELECT leaf_count, mmr_size, mmr_root, peaks, profile_digest, covered_up_to_hash
+             FROM mmr_checkpoints
+             WHERE tenant_id=$1 AND stream_id=$2
+             ORDER BY leaf_count DESC
+             LIMIT 1",
+        )
+        .bind(&self.tenant)
+        .bind(stream_id)
+        .fetch_optional(&mut *tx)
+        .await
+        .map_err(|e| e.to_string())?;
+        tx.commit().await.map_err(|e| e.to_string())?;
+
+        row.map(|row| checkpoint_from_row(&row, &self.tenant, stream_id))
+            .transpose()
+    }
+
+    pub async fn load_anchored_checkpoint<A: CheckpointAnchor + ?Sized>(
+        &self,
+        stream_id: &str,
+        leaf_count: u64,
+        anchor: &A,
+    ) -> Result<AnchoredCheckpoint, String> {
+        let checkpoint = self
+            .load_checkpoint(stream_id, leaf_count)
+            .await?
+            .ok_or_else(|| "checkpoint not found".to_string())?;
+        anchor_checkpoint(checkpoint, anchor)
+            .await
+            .map_err(|error| error.0)
+    }
+
+    pub async fn load_latest_anchored_checkpoint<A: CheckpointAnchor + ?Sized>(
+        &self,
+        stream_id: &str,
+        anchor: &A,
+    ) -> Result<AnchoredCheckpoint, String> {
+        let checkpoint = self
+            .load_latest_checkpoint(stream_id)
+            .await?
+            .ok_or_else(|| "checkpoint not found".to_string())?;
+        anchor_checkpoint(checkpoint, anchor)
+            .await
+            .map_err(|error| error.0)
+    }
+
+    pub async fn canonical_object(
+        &self,
+        kind: &str,
+        digest: Digest32,
+    ) -> Result<Option<Vec<u8>>, String> {
+        let mut tx = self.begin("arkhe_read").await?;
+        let result = sqlx::query_scalar("SELECT canonical_bytes FROM work_objects WHERE tenant_id=$1 AND object_type=$2 AND object_digest=$3")
+            .bind(&self.tenant).bind(kind).bind(digest.0.to_vec())
+            .fetch_optional(&mut *tx).await.map_err(|e| e.to_string())?;
+        tx.commit().await.map_err(|e| e.to_string())?;
+        Ok(result)
+    }
+    async fn require_parents(
+        &self,
+        tx: &mut Transaction<'_, Postgres>,
+        refs: &[Digest32],
+    ) -> Result<(), String> {
+        for parent in refs {
+            let exists: bool = sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM wormgraph_records WHERE tenant_id=$1 AND record_hash=$2)")
+                .bind(&self.tenant).bind(parent.0.to_vec()).fetch_one(&mut **tx)
+                .await.map_err(|e| e.to_string())?;
+            if !exists {
+                return Err("evidence parent is not readable in this tenant".into());
+            }
+        }
+        Ok(())
+    }
+    async fn insert_envelope(
+        &self,
+        tx: &mut Transaction<'_, Postgres>,
+        evidence: &EvidenceEnvelope,
+    ) -> Result<(), String> {
+        sqlx::query("SELECT pg_advisory_xact_lock(hashtextextended($1,0))")
+            .bind(format!("arkhe:wormgraph:{}", self.tenant))
+            .execute(&mut **tx)
+            .await
+            .map_err(|e| e.to_string())?;
+        self.require_parents(tx, &evidence.causal_parents).await?;
+        let json = serde_json::to_value(evidence).map_err(|e| e.to_string())?;
+        sqlx::query("INSERT INTO wormgraph_records(tenant_id,record_hash,envelope) VALUES($1,$2,$3) ON CONFLICT (tenant_id,record_hash) DO NOTHING")
+            .bind(&self.tenant).bind(evidence.record_hash.0.to_vec()).bind(&json)
+            .execute(&mut **tx).await.map_err(|e| e.to_string())?;
+        let stored: serde_json::Value = sqlx::query_scalar(
+            "SELECT envelope FROM wormgraph_records WHERE tenant_id=$1 AND record_hash=$2",
+        )
+        .bind(&self.tenant)
+        .bind(evidence.record_hash.0.to_vec())
+        .fetch_one(&mut **tx)
+        .await
+        .map_err(|e| e.to_string())?;
+        if stored != json {
+            return Err("same record_hash bound to different envelope".into());
+        }
+        Ok(())
+    }
+    /// Only a trusted admission verifier may call this after provenance checks.
+    /// Canonical WER and envelope commit atomically and idempotently.
+    pub async fn commit_verified_worker(
+        &self,
+        worker: &WorkerExecutionRecord,
+    ) -> Result<Digest32, String> {
+        let hash = worker.digest();
+        let evidence = EvidenceEnvelope {
+            record_hash: hash,
+            kind: "WorkerExecutionRecord".into(),
+            subject: worker.input_digest,
+            payload_digest: hash,
+            policy_digest: None,
+            causal_parents: worker.evidence_refs.clone(),
+        };
+        let mut tx = self.begin("arkhe_append").await?;
+        self.insert_object(&mut tx, "WorkerExecutionRecord", worker)
+            .await?;
+        self.insert_envelope(&mut tx, &evidence).await?;
+        tx.commit().await.map_err(|e| e.to_string())?;
+        Ok(hash)
+    }
+    async fn insert_object<T: CanonicalEncode>(
+        &self,
+        tx: &mut Transaction<'_, Postgres>,
+        kind: &str,
+        object: &T,
+    ) -> Result<(), String> {
+        let bytes = object.canonical_bytes();
+        let digest = object.object_digest();
+        sqlx::query("INSERT INTO work_objects(tenant_id,object_type,object_digest,canonical_bytes) VALUES($1,$2,$3,$4) ON CONFLICT (tenant_id,object_type,object_digest) DO NOTHING")
+            .bind(&self.tenant).bind(kind).bind(digest.0.to_vec()).bind(&bytes)
+            .execute(&mut **tx).await.map_err(|e| e.to_string())?;
+        let stored: Vec<u8> = sqlx::query_scalar("SELECT canonical_bytes FROM work_objects WHERE tenant_id=$1 AND object_type=$2 AND object_digest=$3")
+            .bind(&self.tenant).bind(kind).bind(digest.0.to_vec())
+            .fetch_one(&mut **tx).await.map_err(|e| e.to_string())?;
+        if stored != bytes {
+            return Err("object digest already bound to different canonical bytes".into());
+        }
+        Ok(())
+    }
+}
+
+#[async_trait]
+impl OrderedRecordSource for PgWormGraph {
+    async fn prefix(
+        &self,
+        tenant_id: &str,
+        stream_id: &str,
+        limit: u64,
+    ) -> Result<Vec<SequencedRecord>, SourceError> {
+        if tenant_id != self.tenant {
+            return Err(SourceError("tenant does not match store".into()));
+        }
+        if stream_id != self.stream_id {
+            return Err(SourceError(
+                "wormgraph_records has no stream dimension; configured stream does not match"
+                    .into(),
+            ));
+        }
+        let limit =
+            i64::try_from(limit).map_err(|_| SourceError("record limit exceeds bigint".into()))?;
+        let mut tx = self.begin("arkhe_read").await.map_err(SourceError)?;
+        let rows = sqlx::query(
+            "SELECT append_sequence, record_hash
+             FROM wormgraph_records
+             WHERE tenant_id=$1
+             ORDER BY append_sequence ASC
+             LIMIT $2",
+        )
+        .bind(&self.tenant)
+        .bind(limit)
+        .fetch_all(&mut *tx)
+        .await
+        .map_err(|error| SourceError(error.to_string()))?;
+        tx.commit()
+            .await
+            .map_err(|error| SourceError(error.to_string()))?;
+
+        rows.iter()
+            .map(|row| {
+                let sequence: i64 = row
+                    .try_get("append_sequence")
+                    .map_err(|error| SourceError(error.to_string()))?;
+                let sequence = u64::try_from(sequence)
+                    .map_err(|_| SourceError("negative append_sequence".into()))?;
+                let hash: Vec<u8> = row
+                    .try_get("record_hash")
+                    .map_err(|error| SourceError(error.to_string()))?;
+                let record_hash = digest_from_bytes(&hash, "record_hash").map_err(SourceError)?;
+                Ok(SequencedRecord {
+                    append_sequence: sequence,
+                    record_hash,
+                })
+            })
+            .collect()
+    }
+}
+
+fn checkpoint_from_row(
+    row: &PgRow,
+    tenant_id: &str,
+    stream_id: &str,
+) -> Result<CheckpointBinding, String> {
+    let leaf_count: i64 = row.try_get("leaf_count").map_err(|e| e.to_string())?;
+    let mmr_size: i64 = row.try_get("mmr_size").map_err(|e| e.to_string())?;
+    let root: Vec<u8> = row.try_get("mmr_root").map_err(|e| e.to_string())?;
+    let raw_peaks: Vec<Vec<u8>> = row.try_get("peaks").map_err(|e| e.to_string())?;
+    let profile_digest: Vec<u8> = row.try_get("profile_digest").map_err(|e| e.to_string())?;
+    let covered_up_to: Vec<u8> = row
+        .try_get("covered_up_to_hash")
+        .map_err(|e| e.to_string())?;
+
+    let checkpoint = CheckpointBinding {
+        tenant_id: tenant_id.into(),
+        stream_id: stream_id.into(),
+        leaf_count: non_negative_u64(leaf_count, "leaf_count")?,
+        mmr_size: non_negative_u64(mmr_size, "mmr_size")?,
+        root: digest_from_bytes(&root, "mmr_root")?,
+        peaks: raw_peaks
+            .iter()
+            .map(|peak| digest_from_bytes(peak, "peaks"))
+            .collect::<Result<Vec<_>, _>>()?,
+        profile_digest: digest_from_bytes(&profile_digest, "profile_digest")?,
+        covered_up_to: digest_from_bytes(&covered_up_to, "covered_up_to_hash")?,
+    };
+    checkpoint
+        .validate()
+        .map_err(|reason| format!("invalid checkpoint: {reason:?}"))?;
+    Ok(checkpoint)
+}
+
+fn non_negative_u64(value: i64, field: &str) -> Result<u64, String> {
+    u64::try_from(value).map_err(|_| format!("negative {field}"))
+}
+
+fn digest_from_bytes(bytes: &[u8], field: &str) -> Result<Digest32, String> {
+    let bytes: [u8; 32] = bytes
+        .try_into()
+        .map_err(|_| format!("{field} must be 32 bytes"))?;
+    Ok(Digest32(bytes))
+}
+
+#[async_trait]
+impl EvidenceReader for PgWormGraph {
+    async fn get(&self, hash: Digest32) -> Result<Option<EvidenceEnvelope>, String> {
+        let mut tx = self.begin("arkhe_read").await?;
+        let value: Option<serde_json::Value> = sqlx::query_scalar(
+            "SELECT envelope FROM wormgraph_records WHERE tenant_id=$1 AND record_hash=$2",
+        )
+        .bind(&self.tenant)
+        .bind(hash.0.to_vec())
+        .fetch_optional(&mut *tx)
+        .await
+        .map_err(|e| e.to_string())?;
+        tx.commit().await.map_err(|e| e.to_string())?;
+        let envelope: Option<EvidenceEnvelope> = value
+            .map(serde_json::from_value)
+            .transpose()
+            .map_err(|e| e.to_string())?;
+        if envelope.as_ref().is_some_and(|e| e.record_hash != hash) {
+            return Err("stored envelope has inconsistent record hash".into());
+        }
+        Ok(envelope)
+    }
+}
+#[async_trait]
+impl EvidenceCommitter for PgWormGraph {
+    async fn append_verified(&self, evidence: EvidenceEnvelope) -> Result<Digest32, String> {
+        let mut tx = self.begin("arkhe_append").await?;
+        self.insert_envelope(&mut tx, &evidence).await?;
+        tx.commit().await.map_err(|e| e.to_string())?;
+        Ok(evidence.record_hash)
+    }
+}
+#[async_trait]
+impl WorkEvidenceCommitter for PgWormGraph {
+    async fn commit_work(
+        &self,
+        intent: &WorkIntent,
+        worker: &WorkerExecutionRecord,
+        evidence: EvidenceEnvelope,
+    ) -> Result<Digest32, String> {
+        if worker.input_digest != intent.digest()
+            || evidence.kind != "work-authorization"
+            || evidence.subject != intent.digest()
+            || evidence.payload_digest != worker.digest()
+            || evidence.policy_digest.is_none()
+            || evidence.causal_parents != worker.evidence_refs
+        {
+            return Err("inconsistent work admission".into());
+        }
+        let mut tx = self.begin("arkhe_append").await?;
+        self.require_parents(&mut tx, &intent.context_refs).await?;
+        self.insert_object(&mut tx, "WorkIntent", intent).await?;
+        self.insert_object(&mut tx, "WorkerExecutionRecord", worker)
+            .await?;
+        self.insert_envelope(&mut tx, &evidence).await?;
+        tx.commit().await.map_err(|e| e.to_string())?;
+        Ok(evidence.record_hash)
+    }
+}
diff --git a/arkhe/source/evidence/arkhe-wormgraph/src/postgres/memo.rs b/arkhe/source/evidence/arkhe-wormgraph/src/postgres/memo.rs
new file mode 100644
index 00000000..9b0dc3f0
--- /dev/null
+++ b/arkhe/source/evidence/arkhe-wormgraph/src/postgres/memo.rs
@@ -0,0 +1,292 @@
+//! Durable, tenant-scoped storage of memo observation packages. Consistency is
+//! verified locally; these records do not establish payment authority or truth.
+use super::PgWormGraph;
+use crate::regenerate::{rebuild, OrderedRecordSource};
+use arkhe_core::{
+    evidence::{EvidenceEnvelope, EvidenceReader},
+    Digest32,
+};
+use arkhe_verify_core::{
+    memo_reconciliation::{self, MemoBundle},
+    mmr::{build_root_and_proof, profile::PROFILE_DIGEST_HEX, verify_proof_at, ProofStep},
+    reconciliation::{Decision, Trust},
+};
+use serde::{Deserialize, Serialize};
+use sqlx::Row;
+
+const MAX_BYTES: usize = 20_000_000;
+const KIND: &str = "MemoObservationPackage/v1";
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct MemoPackage {
+    pub bundle: MemoBundle,
+    /// Retained original local trust, not an independently authenticated anchor.
+    pub local_trust: Trust,
+}
+fn package_hash(raw: &[u8]) -> Digest32 {
+    Digest32::blake3(b"AKG:MEMO:STORED-PACKAGE:v1\0", raw)
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct MemoStorageReceipt {
+    pub record_hash: Digest32,
+    pub operation_id: Digest32,
+    pub graph_leaf_count: u64,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct MemoGraphTrust {
+    pub tenant_id: String,
+    pub stream_id: String,
+    pub root: [u8; 32],
+    pub leaf_count: u64,
+    pub profile_digest: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct DurableMemoExport {
+    pub package_bytes: Vec<u8>,
+    pub record_hash: Digest32,
+    pub graph: MemoGraphTrust,
+    pub leaf_index: u64,
+    pub steps: Vec<ProofStep>,
+}
+
+/// Pure offline check against a separately supplied graph pin. No database or
+/// network access. Pin issuance, source authenticity and external anchoring are
+/// outside this function.
+pub fn verify_export(
+    export: &DurableMemoExport,
+    trust: &MemoGraphTrust,
+) -> Result<Decision, String> {
+    if export.package_bytes.is_empty()
+        || export.package_bytes.len() > MAX_BYTES
+        || &export.graph != trust
+        || trust.tenant_id.is_empty()
+        || trust.stream_id.is_empty()
+        || trust.leaf_count == 0
+        || trust.leaf_count > 1_000_000
+        || export.leaf_index >= trust.leaf_count
+        || trust.profile_digest != PROFILE_DIGEST_HEX
+        || export.steps.len() > 64
+        || package_hash(&export.package_bytes) != export.record_hash
+    {
+        return Err("invalid package or untrusted graph checkpoint".into());
+    }
+    if !verify_proof_at(
+        &export.record_hash.0,
+        trust.leaf_count as usize,
+        export.leaf_index as usize,
+        &export.steps,
+        &trust.root,
+    )
+    .map_err(|e| e.to_string())?
+    {
+        return Err("stored package absent from graph checkpoint".into());
+    }
+    let package: MemoPackage =
+        serde_json::from_slice(&export.package_bytes).map_err(|e| e.to_string())?;
+    memo_reconciliation::verify(&package.bundle, &package.local_trust).map_err(str::to_string)
+}
+
+impl PgWormGraph {
+    /// Atomic package + observation envelope + tenant-stream checkpoint.
+    /// Caller authenticates who may submit observations; this is not admission
+    /// of an externally authenticated invoice or a work authorization.
+    pub async fn commit_memo_observation(
+        &self,
+        package: &MemoPackage,
+    ) -> Result<MemoStorageReceipt, String> {
+        memo_reconciliation::verify(&package.bundle, &package.local_trust)
+            .map_err(str::to_string)?;
+        let raw = serde_json::to_vec(package).map_err(|e| e.to_string())?;
+        if raw.is_empty() || raw.len() > MAX_BYTES {
+            return Err("package too large".into());
+        }
+        let hash = package_hash(&raw);
+        let operation = package.bundle.reconciliation.record.intent.operation_id();
+        let mut tx = self.begin("arkhe_append").await?;
+        // Same lock as insert_envelope. Serializes tenant append/checkpoint order.
+        sqlx::query("SELECT pg_advisory_xact_lock(hashtextextended($1,0))")
+            .bind(format!("arkhe:wormgraph:{}", self.tenant))
+            .execute(&mut *tx)
+            .await
+            .map_err(|e| e.to_string())?;
+        sqlx::query("SET LOCAL synchronous_commit = on")
+            .execute(&mut *tx)
+            .await
+            .map_err(|e| e.to_string())?;
+        let existing = sqlx::query("SELECT record_hash,package_bytes,graph_leaf_count,stream_id FROM memo_observation_packages WHERE tenant_id=$1 AND operation_id=$2")
+            .bind(&self.tenant).bind(operation.0.to_vec()).fetch_optional(&mut *tx).await.map_err(|e| e.to_string())?;
+        if let Some(row) = existing {
+            let old_hash: Vec<u8> = row.try_get("record_hash").map_err(|e| e.to_string())?;
+            let old_bytes: Vec<u8> = row.try_get("package_bytes").map_err(|e| e.to_string())?;
+            let stream: String = row.try_get("stream_id").map_err(|e| e.to_string())?;
+            let count: i64 = row.try_get("graph_leaf_count").map_err(|e| e.to_string())?;
+            if old_hash != hash.0 || old_bytes != raw || stream != self.stream_id {
+                return Err("operation already bound to a different memo package".into());
+            }
+            tx.commit().await.map_err(|e| e.to_string())?;
+            return Ok(MemoStorageReceipt {
+                record_hash: hash,
+                operation_id: operation,
+                graph_leaf_count: count as u64,
+            });
+        }
+        let envelope = EvidenceEnvelope {
+            record_hash: hash,
+            kind: KIND.into(),
+            subject: operation,
+            payload_digest: hash,
+            policy_digest: None,
+            causal_parents: vec![],
+        };
+        self.insert_envelope(&mut tx, &envelope).await?;
+        let raw_hashes: Vec<Vec<u8>> = sqlx::query_scalar("SELECT record_hash FROM wormgraph_records WHERE tenant_id=$1 ORDER BY append_sequence LIMIT 1000001")
+            .bind(&self.tenant).fetch_all(&mut *tx).await.map_err(|e| e.to_string())?;
+        if raw_hashes.len() > 1_000_000 {
+            return Err("graph checkpoint limit exceeded".into());
+        }
+        let hashes: Vec<Digest32> = raw_hashes
+            .into_iter()
+            .map(|v| {
+                v.try_into()
+                    .map(Digest32)
+                    .map_err(|_| "invalid stored hash".to_string())
+            })
+            .collect::<Result<_, _>>()?;
+        let snapshot = rebuild(&hashes).map_err(|e| format!("checkpoint rebuild failed: {e:?}"))?;
+        let profile = hex::decode(PROFILE_DIGEST_HEX).map_err(|e| e.to_string())?;
+        let peaks: Vec<Vec<u8>> = snapshot.peaks.iter().map(|p| p.0.to_vec()).collect();
+        let covered = hashes
+            .last()
+            .ok_or("missing checkpoint coverage")?
+            .0
+            .to_vec();
+        sqlx::query("INSERT INTO mmr_checkpoints(tenant_id,stream_id,leaf_count,mmr_size,mmr_root,peaks,profile_digest,covered_up_to_hash) VALUES($1,$2,$3,$4,$5,$6,$7,$8) ON CONFLICT(tenant_id,stream_id,leaf_count) DO NOTHING")
+            .bind(&self.tenant).bind(&self.stream_id).bind(snapshot.leaf_count as i64).bind(snapshot.mmr_size as i64)
+            .bind(snapshot.root.0.to_vec()).bind(&peaks).bind(&profile).bind(&covered)
+            .execute(&mut *tx).await.map_err(|e| e.to_string())?;
+        let row = sqlx::query("SELECT mmr_root,peaks,profile_digest,covered_up_to_hash,mmr_size FROM mmr_checkpoints WHERE tenant_id=$1 AND stream_id=$2 AND leaf_count=$3")
+            .bind(&self.tenant).bind(&self.stream_id).bind(snapshot.leaf_count as i64).fetch_one(&mut *tx).await.map_err(|e| e.to_string())?;
+        if row
+            .try_get::<Vec<u8>, _>("mmr_root")
+            .map_err(|e| e.to_string())?
+            != snapshot.root.0
+            || row
+                .try_get::<Vec<Vec<u8>>, _>("peaks")
+                .map_err(|e| e.to_string())?
+                != peaks
+            || row
+                .try_get::<Vec<u8>, _>("profile_digest")
+                .map_err(|e| e.to_string())?
+                != profile
+            || row
+                .try_get::<Vec<u8>, _>("covered_up_to_hash")
+                .map_err(|e| e.to_string())?
+                != covered
+            || row
+                .try_get::<i64, _>("mmr_size")
+                .map_err(|e| e.to_string())?
+                != snapshot.mmr_size as i64
+        {
+            return Err("conflicting graph checkpoint".into());
+        }
+        sqlx::query("INSERT INTO memo_observation_packages(tenant_id,record_hash,operation_id,package_bytes,stream_id,graph_leaf_count) VALUES($1,$2,$3,$4,$5,$6)")
+            .bind(&self.tenant).bind(hash.0.to_vec()).bind(operation.0.to_vec()).bind(raw)
+            .bind(&self.stream_id).bind(snapshot.leaf_count as i64).execute(&mut *tx).await.map_err(|e| e.to_string())?;
+        tx.commit().await.map_err(|e| e.to_string())?;
+        Ok(MemoStorageReceipt {
+            record_hash: hash,
+            operation_id: operation,
+            graph_leaf_count: snapshot.leaf_count,
+        })
+    }
+
+    pub async fn export_memo_observation(
+        &self,
+        hash: Digest32,
+    ) -> Result<DurableMemoExport, String> {
+        let mut tx = self.begin("arkhe_read").await?;
+        let row = sqlx::query("SELECT package_bytes,graph_leaf_count,operation_id,stream_id FROM memo_observation_packages WHERE tenant_id=$1 AND record_hash=$2")
+            .bind(&self.tenant).bind(hash.0.to_vec()).fetch_optional(&mut *tx).await.map_err(|e| e.to_string())?.ok_or("memo package not found in tenant")?;
+        let raw: Vec<u8> = row.try_get("package_bytes").map_err(|e| e.to_string())?;
+        let count: i64 = row.try_get("graph_leaf_count").map_err(|e| e.to_string())?;
+        let operation: Vec<u8> = row.try_get("operation_id").map_err(|e| e.to_string())?;
+        let stream: String = row.try_get("stream_id").map_err(|e| e.to_string())?;
+        tx.commit().await.map_err(|e| e.to_string())?;
+        if raw.len() > MAX_BYTES
+            || count <= 0
+            || count > 1_000_000
+            || stream != self.stream_id
+            || package_hash(&raw) != hash
+        {
+            return Err("corrupt memo package metadata".into());
+        }
+        let envelope = self.get(hash).await?.ok_or("memo envelope missing")?;
+        let package: MemoPackage = serde_json::from_slice(&raw).map_err(|e| e.to_string())?;
+        if package
+            .bundle
+            .reconciliation
+            .record
+            .intent
+            .operation_id()
+            .0
+            .as_slice()
+            != operation
+            || envelope.kind != KIND
+            || envelope.subject.0.as_slice() != operation
+            || envelope.payload_digest != hash
+            || envelope.policy_digest.is_some()
+            || !envelope.causal_parents.is_empty()
+        {
+            return Err("memo envelope/package mismatch".into());
+        }
+        let checkpoint = self
+            .load_checkpoint(&self.stream_id, count as u64)
+            .await?
+            .ok_or("memo checkpoint missing")?;
+        let records = self
+            .prefix(&self.tenant, &self.stream_id, count as u64)
+            .await
+            .map_err(|e| e.0)?;
+        if records.len() != count as usize {
+            return Err("incomplete graph prefix".into());
+        }
+        let hashes: Vec<_> = records.iter().map(|r| r.record_hash).collect();
+        let snapshot = rebuild(&hashes).map_err(|e| format!("graph rebuild failed: {e:?}"))?;
+        if snapshot.root != checkpoint.root
+            || snapshot.peaks != checkpoint.peaks
+            || hashes.last() != Some(&checkpoint.covered_up_to)
+        {
+            return Err("graph prefix differs from retained checkpoint".into());
+        }
+        let index = hashes
+            .iter()
+            .position(|h| *h == hash)
+            .ok_or("memo record not covered")?;
+        let leaves: Vec<Vec<u8>> = hashes.iter().map(|h| h.0.to_vec()).collect();
+        let (root, steps) = build_root_and_proof(&leaves, index).map_err(|e| e.to_string())?;
+        let export = DurableMemoExport {
+            package_bytes: raw,
+            record_hash: hash,
+            graph: MemoGraphTrust {
+                tenant_id: self.tenant.clone(),
+                stream_id: self.stream_id.clone(),
+                root,
+                leaf_count: count as u64,
+                profile_digest: PROFILE_DIGEST_HEX.into(),
+            },
+            leaf_index: index as u64,
+            steps,
+        };
+        if root != checkpoint.root.0 {
+            return Err("graph proof root mismatch".into());
+        }
+        verify_export(&export, &export.graph)?;
+        Ok(export)
+    }
+}
diff --git a/arkhe/source/evidence/arkhe-wormgraph/src/postgres/replica.rs b/arkhe/source/evidence/arkhe-wormgraph/src/postgres/replica.rs
new file mode 100644
index 00000000..4eeea118
--- /dev/null
+++ b/arkhe/source/evidence/arkhe-wormgraph/src/postgres/replica.rs
@@ -0,0 +1,105 @@
+use super::{checkpoint_from_row, PgWormGraph};
+use crate::{
+    anchor::SignedCheckpoint,
+    replica::{ReplicaBundle, ReplicaObject, ReplicaRecord},
+};
+use arkhe_core::evidence::EvidenceEnvelope;
+use sqlx::Row;
+
+impl PgWormGraph {
+    /// One repeatable-read snapshot of checkpoint, journal, envelopes and contents.
+    /// Caller signs the returned bundle; an empty signature is not ready.
+    pub async fn export_replica_snapshot(
+        &self,
+        checkpoint: SignedCheckpoint,
+    ) -> Result<ReplicaBundle, String> {
+        let mut tx = self.pool.begin().await.map_err(|e| e.to_string())?;
+        sqlx::query("SET TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY")
+            .execute(&mut *tx)
+            .await
+            .map_err(|e| e.to_string())?;
+        sqlx::query("SET LOCAL ROLE arkhe_read")
+            .execute(&mut *tx)
+            .await
+            .map_err(|e| e.to_string())?;
+        arkhe_sql::tenant::set_tenant(&mut tx, &self.tenant)
+            .await
+            .map_err(|e| e.to_string())?;
+        let epoch: i64 = sqlx::query_scalar("SELECT arkhe_writer_epoch($1)")
+            .bind(&self.tenant)
+            .fetch_one(&mut *tx)
+            .await
+            .map_err(|e| e.to_string())?;
+        if checkpoint.tenant_id != self.tenant
+            || checkpoint.stream_id != self.stream_id
+            || checkpoint.leaf_count == 0
+            || checkpoint.leaf_count > 1_000_000
+        {
+            return Err("export checkpoint scope or size mismatch".into());
+        }
+        let row = sqlx::query("SELECT leaf_count,mmr_size,mmr_root,peaks,profile_digest,covered_up_to_hash FROM mmr_checkpoints WHERE tenant_id=$1 AND stream_id=$2 AND leaf_count=$3")
+            .bind(&self.tenant).bind(&self.stream_id).bind(checkpoint.leaf_count as i64)
+            .fetch_one(&mut *tx).await.map_err(|e|e.to_string())?;
+        if checkpoint_from_row(&row, &self.tenant, &self.stream_id)? != checkpoint.binding() {
+            return Err("signed checkpoint differs from transactional checkpoint".into());
+        }
+        let rows = sqlx::query("SELECT append_sequence,record_hash,envelope,writer_epoch FROM wormgraph_records WHERE tenant_id=$1 ORDER BY append_sequence LIMIT $2")
+            .bind(&self.tenant).bind(checkpoint.leaf_count as i64).fetch_all(&mut *tx).await.map_err(|e|e.to_string())?;
+        let mut records = Vec::new();
+        for row in rows {
+            let envelope: EvidenceEnvelope =
+                serde_json::from_value(row.try_get("envelope").map_err(|e| e.to_string())?)
+                    .map_err(|e| e.to_string())?;
+            let stored_hash: Vec<u8> = row.try_get("record_hash").map_err(|e| e.to_string())?;
+            if stored_hash != envelope.record_hash.0 {
+                return Err("journal/envelope hash mismatch".into());
+            }
+            let mut contents = Vec::new();
+            if envelope.kind == "MemoObservationPackage/v1" {
+                let bytes: Vec<u8> = sqlx::query_scalar("SELECT package_bytes FROM memo_observation_packages WHERE tenant_id=$1 AND record_hash=$2 AND stream_id=$3")
+                    .bind(&self.tenant).bind(&stored_hash).bind(&self.stream_id).fetch_one(&mut *tx).await.map_err(|e|e.to_string())?;
+                contents.push(ReplicaObject {
+                    kind: envelope.kind.clone(),
+                    digest: envelope.payload_digest,
+                    bytes,
+                });
+            } else {
+                let mut needed = vec![("WorkerExecutionRecord", envelope.payload_digest)];
+                if envelope.kind == "work-authorization" {
+                    needed.push(("WorkIntent", envelope.subject));
+                }
+                for (kind, digest) in needed {
+                    let bytes: Vec<u8> = sqlx::query_scalar("SELECT canonical_bytes FROM work_objects WHERE tenant_id=$1 AND object_type=$2 AND object_digest=$3")
+                        .bind(&self.tenant).bind(kind).bind(digest.0.to_vec()).fetch_one(&mut *tx).await.map_err(|e|e.to_string())?;
+                    contents.push(ReplicaObject {
+                        kind: kind.into(),
+                        digest,
+                        bytes,
+                    });
+                }
+            }
+            let sequence: i64 = row.try_get("append_sequence").map_err(|e| e.to_string())?;
+            records.push(ReplicaRecord {
+                append_sequence: sequence.try_into().map_err(|_| "invalid append sequence")?,
+                envelope,
+                contents,
+                writer_epoch: row
+                    .try_get::<Option<i64>, _>("writer_epoch")
+                    .map_err(|e| e.to_string())?
+                    .ok_or("legacy record without verified writer epoch")?
+                    .try_into()
+                    .map_err(|_| "invalid record epoch")?,
+            });
+        }
+        let bundle = ReplicaBundle {
+            schema: "arkhe-replica-bundle-v1".into(),
+            writer_epoch: epoch.try_into().map_err(|_| "invalid epoch")?,
+            checkpoint,
+            records,
+            signature_hex: String::new(),
+        };
+        bundle.verify_contents()?;
+        tx.commit().await.map_err(|e| e.to_string())?;
+        Ok(bundle)
+    }
+}
diff --git a/arkhe/source/evidence/arkhe-wormgraph/src/regenerate.rs b/arkhe/source/evidence/arkhe-wormgraph/src/regenerate.rs
new file mode 100644
index 00000000..8decab0b
--- /dev/null
+++ b/arkhe/source/evidence/arkhe-wormgraph/src/regenerate.rs
@@ -0,0 +1,679 @@
+use arkhe_core::Digest32;
+use arkhe_sql::mmr::profile::{mmr_size as profile_mmr_size, PROFILE_DIGEST_HEX};
+use async_trait::async_trait;
+use std::collections::HashSet;
+
+pub const DEFAULT_STREAM_ID: &str = "wormgraph";
+
+const LEAF_DOMAIN: &[u8] = &[0x00];
+const NODE_DOMAIN: &[u8] = &[0x01];
+const BAG_DOMAIN: &[u8] = &[0x02];
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CheckpointBinding {
+    pub tenant_id: String,
+    pub stream_id: String,
+    pub leaf_count: u64,
+    pub mmr_size: u64,
+    pub root: Digest32,
+    pub peaks: Vec<Digest32>,
+    pub profile_digest: Digest32,
+    pub covered_up_to: Digest32,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct SequencedRecord {
+    pub append_sequence: u64,
+    pub record_hash: Digest32,
+}
+
+#[async_trait]
+pub trait OrderedRecordSource {
+    async fn prefix(
+        &self,
+        tenant_id: &str,
+        stream_id: &str,
+        limit: u64,
+    ) -> Result<Vec<SequencedRecord>, SourceError>;
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SourceError(pub String);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct RegenerationLimits {
+    pub max_leaf_count: u64,
+}
+
+impl Default for RegenerationLimits {
+    fn default() -> Self {
+        Self {
+            max_leaf_count: 1_000_000,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MmrSnapshot {
+    pub leaf_count: u64,
+    pub mmr_size: u64,
+    pub root: Digest32,
+    pub peaks: Vec<Digest32>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Divergence {
+    LeafCount {
+        expected: u64,
+        actual: u64,
+    },
+    MmrSize {
+        expected: u64,
+        actual: u64,
+    },
+    Root {
+        expected: Digest32,
+        actual: Digest32,
+    },
+    Peak {
+        index: usize,
+        expected: Digest32,
+        actual: Digest32,
+    },
+    CoveredUpTo {
+        expected: Digest32,
+        actual: Digest32,
+    },
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum IncompleteReason {
+    MissingLeaves { expected: u64, actual: u64 },
+    SequenceNotIncreasing { index: usize },
+    DuplicateRecordHash { index: usize },
+    Source(String),
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RefusalReason {
+    EmptyCheckpoint,
+    ProfileMismatch,
+    MmrSizeMismatch,
+    PeakCountMismatch,
+    LimitExceeded,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RegenerationStatus {
+    Verified,
+    Mismatch(Divergence),
+    Incomplete(IncompleteReason),
+    Refused(RefusalReason),
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RegenerationReport {
+    pub status: RegenerationStatus,
+    pub actual: Option<MmrSnapshot>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AnchorError(pub String);
+
+#[async_trait]
+pub trait CheckpointAnchor {
+    async fn verify(&self, checkpoint: &CheckpointBinding) -> Result<(), AnchorError>;
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AnchoredCheckpoint {
+    checkpoint: CheckpointBinding,
+}
+
+impl AnchoredCheckpoint {
+    pub fn binding(&self) -> &CheckpointBinding {
+        &self.checkpoint
+    }
+
+    pub fn into_binding(self) -> CheckpointBinding {
+        self.checkpoint
+    }
+}
+
+pub async fn anchor_checkpoint<A: CheckpointAnchor + ?Sized>(
+    checkpoint: CheckpointBinding,
+    anchor: &A,
+) -> Result<AnchoredCheckpoint, AnchorError> {
+    anchor.verify(&checkpoint).await?;
+    Ok(AnchoredCheckpoint { checkpoint })
+}
+
+impl CheckpointBinding {
+    pub fn validate(&self) -> Result<(), RefusalReason> {
+        if self.leaf_count == 0 {
+            return Err(RefusalReason::EmptyCheckpoint);
+        }
+        if self.profile_digest.to_hex() != PROFILE_DIGEST_HEX {
+            return Err(RefusalReason::ProfileMismatch);
+        }
+        if self.mmr_size != profile_mmr_size(self.leaf_count) {
+            return Err(RefusalReason::MmrSizeMismatch);
+        }
+        if self.peaks.len() != self.leaf_count.count_ones() as usize {
+            return Err(RefusalReason::PeakCountMismatch);
+        }
+        Ok(())
+    }
+}
+
+fn leaf_hash(record_hash: &Digest32) -> Digest32 {
+    Digest32::blake3(LEAF_DOMAIN, &record_hash.0)
+}
+
+fn node_hash(left: &Digest32, right: &Digest32) -> Digest32 {
+    let mut payload = Vec::with_capacity(64);
+    payload.extend_from_slice(&left.0);
+    payload.extend_from_slice(&right.0);
+    Digest32::blake3(NODE_DOMAIN, &payload)
+}
+
+fn bag_hash(left: &Digest32, right: &Digest32, mmr_size: u64) -> Digest32 {
+    let mut payload = Vec::with_capacity(72);
+    payload.extend_from_slice(&mmr_size.to_be_bytes());
+    payload.extend_from_slice(&left.0);
+    payload.extend_from_slice(&right.0);
+    Digest32::blake3(BAG_DOMAIN, &payload)
+}
+
+fn peak_widths(leaf_count: u64) -> Vec<u64> {
+    let mut widths = Vec::new();
+    let mut remaining = leaf_count;
+    while remaining > 0 {
+        let width = 1u64 << (63 - remaining.leading_zeros());
+        widths.push(width);
+        remaining -= width;
+    }
+    widths
+}
+
+fn perfect_root(hashes: &[Digest32]) -> Digest32 {
+    debug_assert!(!hashes.is_empty());
+    debug_assert!(hashes.len().is_power_of_two());
+
+    let mut level = hashes.to_vec();
+    while level.len() > 1 {
+        level = level
+            .chunks_exact(2)
+            .map(|pair| node_hash(&pair[0], &pair[1]))
+            .collect();
+    }
+    level[0]
+}
+
+fn root_from_peaks(peaks: &[Digest32], leaf_count: u64) -> Digest32 {
+    debug_assert!(!peaks.is_empty());
+
+    let mut root = *peaks.last().expect("non-empty peaks");
+    for peak in peaks[..peaks.len() - 1].iter().rev() {
+        root = bag_hash(peak, &root, profile_mmr_size(leaf_count));
+    }
+    root
+}
+
+pub fn rebuild(record_hashes: &[Digest32]) -> Result<MmrSnapshot, RegenerationStatus> {
+    if record_hashes.is_empty() {
+        return Err(RegenerationStatus::Refused(RefusalReason::EmptyCheckpoint));
+    }
+
+    let leaf_hashes: Vec<Digest32> = record_hashes.iter().map(leaf_hash).collect();
+    let leaf_count = record_hashes.len() as u64;
+    let mut peaks = Vec::new();
+    let mut start = 0usize;
+
+    for width in peak_widths(leaf_count) {
+        let end = start + width as usize;
+        peaks.push(perfect_root(&leaf_hashes[start..end]));
+        start = end;
+    }
+
+    let mmr_size = profile_mmr_size(leaf_count);
+    Ok(MmrSnapshot {
+        leaf_count,
+        mmr_size,
+        root: root_from_peaks(&peaks, leaf_count),
+        peaks,
+    })
+}
+
+pub fn verify_checkpoint(
+    checkpoint: &CheckpointBinding,
+    records: &[SequencedRecord],
+) -> RegenerationReport {
+    if let Err(reason) = checkpoint.validate() {
+        return RegenerationReport {
+            status: RegenerationStatus::Refused(reason),
+            actual: None,
+        };
+    }
+
+    if (records.len() as u64) < checkpoint.leaf_count {
+        return RegenerationReport {
+            status: RegenerationStatus::Incomplete(IncompleteReason::MissingLeaves {
+                expected: checkpoint.leaf_count,
+                actual: records.len() as u64,
+            }),
+            actual: None,
+        };
+    }
+
+    if (records.len() as u64) > checkpoint.leaf_count {
+        return RegenerationReport {
+            status: RegenerationStatus::Mismatch(Divergence::LeafCount {
+                expected: checkpoint.leaf_count,
+                actual: records.len() as u64,
+            }),
+            actual: None,
+        };
+    }
+
+    let mut seen = HashSet::with_capacity(records.len());
+    for (index, record) in records.iter().enumerate() {
+        if index > 0 && record.append_sequence <= records[index - 1].append_sequence {
+            return RegenerationReport {
+                status: RegenerationStatus::Incomplete(IncompleteReason::SequenceNotIncreasing {
+                    index,
+                }),
+                actual: None,
+            };
+        }
+        if !seen.insert(record.record_hash) {
+            return RegenerationReport {
+                status: RegenerationStatus::Incomplete(IncompleteReason::DuplicateRecordHash {
+                    index,
+                }),
+                actual: None,
+            };
+        }
+    }
+
+    let actual_covered = records
+        .last()
+        .expect("non-empty prefix after length check")
+        .record_hash;
+    if actual_covered != checkpoint.covered_up_to {
+        return RegenerationReport {
+            status: RegenerationStatus::Mismatch(Divergence::CoveredUpTo {
+                expected: checkpoint.covered_up_to,
+                actual: actual_covered,
+            }),
+            actual: None,
+        };
+    }
+
+    let record_hashes: Vec<Digest32> = records.iter().map(|r| r.record_hash).collect();
+    let actual = match rebuild(&record_hashes) {
+        Ok(snapshot) => snapshot,
+        Err(status) => {
+            return RegenerationReport {
+                status,
+                actual: None,
+            }
+        }
+    };
+
+    if actual.mmr_size != checkpoint.mmr_size {
+        return RegenerationReport {
+            status: RegenerationStatus::Mismatch(Divergence::MmrSize {
+                expected: checkpoint.mmr_size,
+                actual: actual.mmr_size,
+            }),
+            actual: Some(actual),
+        };
+    }
+    if actual.root != checkpoint.root {
+        return RegenerationReport {
+            status: RegenerationStatus::Mismatch(Divergence::Root {
+                expected: checkpoint.root,
+                actual: actual.root,
+            }),
+            actual: Some(actual),
+        };
+    }
+    for (index, (expected, found)) in checkpoint.peaks.iter().zip(actual.peaks.iter()).enumerate() {
+        if expected != found {
+            return RegenerationReport {
+                status: RegenerationStatus::Mismatch(Divergence::Peak {
+                    index,
+                    expected: *expected,
+                    actual: *found,
+                }),
+                actual: Some(actual),
+            };
+        }
+    }
+
+    RegenerationReport {
+        status: RegenerationStatus::Verified,
+        actual: Some(actual),
+    }
+}
+
+pub async fn regenerate<S: OrderedRecordSource + ?Sized>(
+    source: &S,
+    checkpoint: &CheckpointBinding,
+    limits: &RegenerationLimits,
+) -> RegenerationReport {
+    if let Err(reason) = checkpoint.validate() {
+        return RegenerationReport {
+            status: RegenerationStatus::Refused(reason),
+            actual: None,
+        };
+    }
+    if checkpoint.leaf_count > limits.max_leaf_count {
+        return RegenerationReport {
+            status: RegenerationStatus::Refused(RefusalReason::LimitExceeded),
+            actual: None,
+        };
+    }
+
+    let records = match source
+        .prefix(
+            &checkpoint.tenant_id,
+            &checkpoint.stream_id,
+            checkpoint.leaf_count,
+        )
+        .await
+    {
+        Ok(records) => records,
+        Err(error) => {
+            return RegenerationReport {
+                status: RegenerationStatus::Incomplete(IncompleteReason::Source(error.0)),
+                actual: None,
+            }
+        }
+    };
+
+    verify_checkpoint(checkpoint, &records)
+}
+
+pub async fn regenerate_anchored<S: OrderedRecordSource + ?Sized>(
+    source: &S,
+    checkpoint: &AnchoredCheckpoint,
+    limits: &RegenerationLimits,
+) -> RegenerationReport {
+    regenerate(source, checkpoint.binding(), limits).await
+}
