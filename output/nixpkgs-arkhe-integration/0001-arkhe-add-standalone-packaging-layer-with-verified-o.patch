+++ b/arkhe/source/cognition/arkhe-metacognition/src/lib.rs
@@ -0,0 +1,35 @@
+use arkhe_cognition_sdk::{worker::WorkerExecutionRecord, Digest32};
+
+pub mod self_model;
+
+pub struct SelfAssessment {
+    pub confidence_bps: Option<u16>,
+    pub evidence_coverage_bps: Option<u16>,
+    pub uncertainty: String,
+}
+
+pub fn assess(
+    input_digest: Digest32,
+    output_digest: Digest32,
+    evidence_refs: Vec<Digest32>,
+) -> (SelfAssessment, WorkerExecutionRecord) {
+    let assessment = SelfAssessment {
+        confidence_bps: None,
+        evidence_coverage_bps: None,
+        uncertainty: "uncalibrated: references alone establish neither correctness nor coverage"
+            .into(),
+    };
+    let record = WorkerExecutionRecord {
+        classification: None,
+        operation: None,
+        module_id: "arkhe-metacognition".into(),
+        module_version: env!("CARGO_PKG_VERSION").into(),
+        input_digest,
+        output_digest,
+        evidence_refs,
+        confidence_bps: assessment.confidence_bps,
+        uncertainty_note: Some(assessment.uncertainty.clone()),
+        execution_id: format!("meta:{}", output_digest.to_hex()),
+    };
+    (assessment, record)
+}
diff --git a/arkhe/source/cognition/arkhe-metacognition/src/self_model.rs b/arkhe/source/cognition/arkhe-metacognition/src/self_model.rs
new file mode 100644
index 00000000..31d882a3
--- /dev/null
+++ b/arkhe/source/cognition/arkhe-metacognition/src/self_model.rs
@@ -0,0 +1,262 @@
+//! Descriptive calibration of host-authenticated, resolved binary predictions.
+//! No signing, persistence, network, clock reads or authorization capability.
+use arkhe_cognition_sdk::{
+    worker::WorkerExecutionRecord, CanonicalEncode, Digest32, EvidenceReader,
+};
+use serde::Serialize;
+use serde_json::{json, Value};
+use std::collections::HashSet;
+
+pub const PREDICTION_KIND: &str = "arkhe/calibration-prediction/v1";
+pub const OUTCOME_KIND: &str = "arkhe/calibration-outcome/v1";
+pub const MAX_RESOLUTIONS: usize = 100_000;
+
+/// A cohort identifies module/version, task population and policy outside this
+/// module. The host must authenticate that scope and admission of each envelope.
+#[derive(Debug, Clone)]
+pub struct ResolvedPrediction {
+    pub prediction_ref: Digest32,
+    pub outcome_ref: Digest32,
+    pub predicted_bps: u16,
+    pub observed: bool,
+    pub predicted_at: i64,
+    pub resolved_at: i64,
+}
+
+struct Projection(Value);
+impl CanonicalEncode for Projection {
+    const DOMAIN_OBJECT: &'static [u8] = b"AKG:METACOG:PAYLOAD:v1\0";
+    fn unsigned_projection(&self) -> Value {
+        self.0.clone()
+    }
+}
+
+pub fn prediction_payload_digest(
+    cohort: Digest32,
+    predicted_bps: u16,
+    predicted_at: i64,
+) -> Result<Digest32, &'static str> {
+    if cohort == Digest32::ZERO || predicted_bps > 10_000 || predicted_at < 0 {
+        return Err("invalid prediction payload");
+    }
+    Ok(
+        Projection(json!({"type":PREDICTION_KIND,"input_digest":cohort,
+        "predicted_bps":predicted_bps,"predicted_at":predicted_at}))
+        .object_digest(),
+    )
+}
+
+pub fn outcome_payload_digest(
+    prediction_ref: Digest32,
+    observed: bool,
+    resolved_at: i64,
+) -> Result<Digest32, &'static str> {
+    if prediction_ref == Digest32::ZERO || resolved_at < 0 {
+        return Err("invalid outcome payload");
+    }
+    Ok(
+        Projection(json!({"type":OUTCOME_KIND,"input_digest":prediction_ref,
+        "observed":u8::from(observed),"resolved_at":resolved_at}))
+        .object_digest(),
+    )
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+pub enum HistoryStatus {
+    InsufficientHistory,
+    DescriptiveMetricsAvailable,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct CalibrationBin {
+    pub lower_bps: u16,
+    pub upper_bps_inclusive: u16,
+    pub count: u32,
+    pub successes: u32,
+    pub mean_prediction_bps: Option<u16>,
+    pub observed_success_bps: Option<u16>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct CalibrationReport {
+    status: HistoryStatus,
+    cohort: Digest32,
+    history_digest: Digest32,
+    count: u32,
+    minimum_samples: u32,
+    brier_score_ppm: Option<u32>,
+    expected_calibration_error_bps: Option<u16>,
+    mean_prediction_bps: Option<u16>,
+    observed_success_bps: Option<u16>,
+    bins: Vec<CalibrationBin>,
+}
+
+impl CalibrationReport {
+    pub fn status(&self) -> HistoryStatus {
+        self.status
+    }
+    pub fn count(&self) -> u32 {
+        self.count
+    }
+    pub fn cohort(&self) -> Digest32 {
+        self.cohort
+    }
+    pub fn history_digest(&self) -> Digest32 {
+        self.history_digest
+    }
+    pub fn brier_score_ppm(&self) -> Option<u32> {
+        self.brier_score_ppm
+    }
+    pub fn expected_calibration_error_bps(&self) -> Option<u16> {
+        self.expected_calibration_error_bps
+    }
+    pub fn mean_prediction_bps(&self) -> Option<u16> {
+        self.mean_prediction_bps
+    }
+    pub fn observed_success_bps(&self) -> Option<u16> {
+        self.observed_success_bps
+    }
+    pub fn bins(&self) -> &[CalibrationBin] {
+        &self.bins
+    }
+}
+
+impl CanonicalEncode for CalibrationReport {
+    const DOMAIN_OBJECT: &'static [u8] = b"AKG:METACOG:CALIBRATION:v1\0";
+    fn unsigned_projection(&self) -> Value {
+        // Reuse typed digest field projections of AKG-CBOR-v1, rather than a
+        // JSON serialization preimage. The names map cohort/history explicitly.
+        json!({"schema":1,"input_digest":self.cohort,"output_digest":self.history_digest,
+            "status":self.status,"count":self.count,"minimum_samples":self.minimum_samples,
+            "brier_score_ppm":self.brier_score_ppm,
+            "expected_calibration_error_bps":self.expected_calibration_error_bps,
+            "mean_prediction_bps":self.mean_prediction_bps,
+            "observed_success_bps":self.observed_success_bps,"bins":self.bins})
+    }
+}
+
+/// The snapshot is passive, not proof of authentication. The host must verify
+/// signatures, scope and historical ordering before construction. All fields
+/// used by these statistics are checked against the admitted payload digests.
+pub fn calibrate_history(
+    cohort: Digest32,
+    minimum_samples: u32,
+    samples: &[ResolvedPrediction],
+    evidence: &EvidenceReader,
+) -> Result<(CalibrationReport, WorkerExecutionRecord), &'static str> {
+    if cohort == Digest32::ZERO
+        || minimum_samples == 0
+        || minimum_samples as usize > MAX_RESOLUTIONS
+    {
+        return Err("invalid cohort or minimum sample count");
+    }
+    if samples.len() > MAX_RESOLUTIONS {
+        return Err("calibration input exceeds budget");
+    }
+    let mut ordered: Vec<_> = samples.iter().collect();
+    ordered.sort_by_key(|sample| sample.prediction_ref.0);
+    let mut predictions = HashSet::new();
+    let mut outcomes = HashSet::new();
+    let mut history = Vec::with_capacity(samples.len());
+    let mut refs = Vec::with_capacity(samples.len() * 2);
+    let mut counts = [0u32; 10];
+    let mut successes = [0u32; 10];
+    let mut sums = [0u64; 10];
+    let mut squared_error = 0u64;
+    for sample in ordered {
+        if sample.prediction_ref == Digest32::ZERO
+            || sample.outcome_ref == Digest32::ZERO
+            || !predictions.insert(sample.prediction_ref)
+            || !outcomes.insert(sample.outcome_ref)
+        {
+            return Err("duplicate or empty prediction/outcome identity");
+        }
+        if sample.predicted_at < 0 || sample.resolved_at <= sample.predicted_at {
+            return Err("outcome must be recorded after its prediction");
+        }
+        let prediction = evidence
+            .get(sample.prediction_ref)
+            .ok_or("prediction evidence missing")?;
+        let outcome = evidence
+            .get(sample.outcome_ref)
+            .ok_or("outcome evidence missing")?;
+        if prediction.kind != PREDICTION_KIND
+            || prediction.subject != cohort
+            || prediction.payload_digest
+                != prediction_payload_digest(cohort, sample.predicted_bps, sample.predicted_at)?
+            || outcome.kind != OUTCOME_KIND
+            || outcome.subject != sample.prediction_ref
+            || !outcome.causal_parents.contains(&sample.prediction_ref)
+            || outcome.payload_digest
+                != outcome_payload_digest(
+                    sample.prediction_ref,
+                    sample.observed,
+                    sample.resolved_at,
+                )?
+            || prediction.policy_digest != outcome.policy_digest
+        {
+            return Err("calibration evidence binding mismatch");
+        }
+        let bin = usize::from(sample.predicted_bps / 1000).min(9);
+        counts[bin] += 1;
+        successes[bin] += u32::from(sample.observed);
+        sums[bin] += u64::from(sample.predicted_bps);
+        let error = i64::from(sample.predicted_bps) - if sample.observed { 10_000 } else { 0 };
+        squared_error += (error * error) as u64;
+        refs.extend([sample.prediction_ref, sample.outcome_ref]);
+        history.push(
+            json!({"input_digest":sample.prediction_ref,"output_digest":sample.outcome_ref,
+            "predicted_bps":sample.predicted_bps,"observed":u8::from(sample.observed),
+            "predicted_at":sample.predicted_at,"resolved_at":sample.resolved_at}),
+        );
+    }
+    let history_digest = Projection(json!({"type":"calibration-history/v1",
+        "input_digest":cohort,"samples":history}))
+    .object_digest();
+    let count = samples.len() as u32;
+    let n = u64::from(count);
+    let bins: Vec<_> = (0..10)
+        .map(|i| CalibrationBin {
+            lower_bps: i as u16 * 1000,
+            upper_bps_inclusive: if i == 9 {
+                10_000
+            } else {
+                i as u16 * 1000 + 999
+            },
+            count: counts[i],
+            successes: successes[i],
+            mean_prediction_bps: (counts[i] > 0).then(|| (sums[i] / u64::from(counts[i])) as u16),
+            observed_success_bps: (counts[i] > 0)
+                .then(|| (u64::from(successes[i]) * 10_000 / u64::from(counts[i])) as u16),
+        })
+        .collect();
+    let gap: u64 = (0..10)
+        .map(|i| sums[i].abs_diff(u64::from(successes[i]) * 10_000))
+        .sum();
+    let report = CalibrationReport {
+        status: if count < minimum_samples {
+            HistoryStatus::InsufficientHistory
+        } else {
+            HistoryStatus::DescriptiveMetricsAvailable
+        },
+        cohort,
+        history_digest,
+        count,
+        minimum_samples,
+        brier_score_ppm: (n > 0).then(|| (squared_error / (n * 100)) as u32),
+        expected_calibration_error_bps: (n > 0).then(|| (gap / n) as u16),
+        mean_prediction_bps: (n > 0).then(|| (sums.iter().sum::<u64>() / n) as u16),
+        observed_success_bps: (n > 0)
+            .then(|| (u64::from(successes.iter().sum::<u32>()) * 10_000 / n) as u16),
+        bins,
+    };
+    let output_digest = report.object_digest();
+    let record = WorkerExecutionRecord {
+        classification: None, operation: None,
+        module_id: "arkhe-metacognition".into(), module_version: env!("CARGO_PKG_VERSION").into(),
+        input_digest: history_digest, output_digest, evidence_refs: refs, confidence_bps: None,
+        uncertainty_note: Some("descriptive cohort history only; no confidence for a new prediction, signature verification or execution authority".into()),
+        execution_id: format!("calibration:{}", output_digest.to_hex()),
+    };
+    Ok((report, record))
+}
diff --git a/arkhe/source/cognition/arkhe-metacognition/tests/calibration.rs b/arkhe/source/cognition/arkhe-metacognition/tests/calibration.rs
new file mode 100644
index 00000000..c41c749c
--- /dev/null
+++ b/arkhe/source/cognition/arkhe-metacognition/tests/calibration.rs
@@ -0,0 +1,179 @@
+use arkhe_cognition_sdk::{CanonicalEncode, Digest32, EvidenceEnvelope, EvidenceReader};
+use arkhe_metacognition::self_model::{
+    calibrate_history, outcome_payload_digest, prediction_payload_digest, HistoryStatus,
+    ResolvedPrediction, OUTCOME_KIND, PREDICTION_KIND,
+};
+
+fn cohort() -> Digest32 {
+    Digest32::blake3(b"test:cohort", b"model-v1/task-family/policy-v1")
+}
+fn fixture(probabilities: &[(u16, bool)]) -> (Vec<ResolvedPrediction>, Vec<EvidenceEnvelope>) {
+    let mut samples = Vec::new();
+    let mut records = Vec::new();
+    for (i, &(predicted_bps, observed)) in probabilities.iter().enumerate() {
+        let prediction_ref = Digest32::blake3(b"prediction", &(i as u64).to_be_bytes());
+        let outcome_ref = Digest32::blake3(b"outcome", &(i as u64).to_be_bytes());
+        samples.push(ResolvedPrediction {
+            prediction_ref,
+            outcome_ref,
+            predicted_bps,
+            observed,
+            predicted_at: 10,
+            resolved_at: 20,
+        });
+        records.push(EvidenceEnvelope {
+            record_hash: prediction_ref,
+            kind: PREDICTION_KIND.into(),
+            subject: cohort(),
+            payload_digest: prediction_payload_digest(cohort(), predicted_bps, 10).unwrap(),
+            policy_digest: None,
+            causal_parents: vec![],
+        });
+        records.push(EvidenceEnvelope {
+            record_hash: outcome_ref,
+            kind: OUTCOME_KIND.into(),
+            subject: prediction_ref,
+            payload_digest: outcome_payload_digest(prediction_ref, observed, 20).unwrap(),
+            policy_digest: None,
+            causal_parents: vec![prediction_ref],
+        });
+    }
+    (samples, records)
+}
+
+#[test]
+fn references_are_not_confidence_or_coverage() {
+    for refs in [vec![], vec![cohort()]] {
+        let (assessment, record) = arkhe_metacognition::assess(cohort(), cohort(), refs);
+        assert_eq!(assessment.confidence_bps, None);
+        assert_eq!(assessment.evidence_coverage_bps, None);
+        assert_eq!(record.confidence_bps, None);
+    }
+}
+
+#[test]
+fn empty_history_has_no_invented_metrics() {
+    let reader = EvidenceReader::from_snapshot(vec![]).unwrap();
+    let (report, record) = calibrate_history(cohort(), 20, &[], &reader).unwrap();
+    assert_eq!(report.status(), HistoryStatus::InsufficientHistory);
+    assert_eq!(report.count(), 0);
+    assert_eq!(report.brier_score_ppm(), None);
+    assert_eq!(report.expected_calibration_error_bps(), None);
+    assert_eq!(record.confidence_bps, None);
+}
+
+#[test]
+fn perfect_and_completely_wrong_predictions_have_expected_scores() {
+    for (rows, brier, ece) in [
+        (vec![(0, false), (10_000, true)], 0, 0),
+        (vec![(10_000, false), (0, true)], 1_000_000, 10_000),
+    ] {
+        let (samples, records) = fixture(&rows);
+        let reader = EvidenceReader::from_snapshot(records).unwrap();
+        let (report, record) = calibrate_history(cohort(), 2, &samples, &reader).unwrap();
+        assert_eq!(report.brier_score_ppm(), Some(brier));
+        assert_eq!(report.expected_calibration_error_bps(), Some(ece));
+        assert_eq!(report.status(), HistoryStatus::DescriptiveMetricsAvailable);
+        assert_eq!(record.output_digest, report.object_digest());
+        assert_eq!(record.input_digest, report.history_digest());
+        assert_eq!(record.confidence_bps, None);
+        assert_eq!(report.bins()[0].count, 1);
+        assert_eq!(report.bins()[9].count, 1);
+    }
+}
+
+#[test]
+fn balanced_half_probability_history_is_calibrated_but_uncertain() {
+    let (samples, records) = fixture(&[(5000, true), (5000, false)]);
+    let (report, _) = calibrate_history(
+        cohort(),
+        20,
+        &samples,
+        &EvidenceReader::from_snapshot(records).unwrap(),
+    )
+    .unwrap();
+    assert_eq!(report.brier_score_ppm(), Some(250_000));
+    assert_eq!(report.expected_calibration_error_bps(), Some(0));
+    assert_eq!(report.observed_success_bps(), Some(5000));
+    assert_eq!(report.mean_prediction_bps(), Some(5000));
+    assert_eq!(report.status(), HistoryStatus::InsufficientHistory);
+}
+
+#[test]
+fn changing_order_preserves_history_and_report_digests() {
+    let (mut samples, records) = fixture(&[(1250, true), (8750, false), (10_000, true)]);
+    let reader = EvidenceReader::from_snapshot(records).unwrap();
+    let (a, ar) = calibrate_history(cohort(), 3, &samples, &reader).unwrap();
+    samples.reverse();
+    let (b, br) = calibrate_history(cohort(), 3, &samples, &reader).unwrap();
+    assert_eq!(a, b);
+    assert_eq!(ar.digest(), br.digest());
+    let (c, _) = calibrate_history(cohort(), 4, &samples, &reader).unwrap();
+    assert_eq!(a.history_digest(), c.history_digest());
+    assert_ne!(a.object_digest(), c.object_digest());
+}
+
+#[test]
+fn missing_prediction_or_outcome_fails_closed() {
+    for drop in [0, 1] {
+        let (samples, mut records) = fixture(&[(5000, true)]);
+        records.remove(drop);
+        let reader = EvidenceReader::from_snapshot(records).unwrap();
+        assert!(calibrate_history(cohort(), 1, &samples, &reader).is_err());
+    }
+}
+
+#[test]
+fn duplicate_prediction_or_reused_outcome_cannot_inflate_sample_count() {
+    let (samples, records) = fixture(&[(5000, true), (5000, false)]);
+    let reader = EvidenceReader::from_snapshot(records).unwrap();
+    let repeated = vec![samples[0].clone(), samples[0].clone()];
+    assert!(calibrate_history(cohort(), 2, &repeated, &reader).is_err());
+    let mut reused = samples;
+    reused[1].outcome_ref = reused[0].outcome_ref;
+    assert!(calibrate_history(cohort(), 2, &reused, &reader).is_err());
+}
+
+#[test]
+fn altered_predictions_outcomes_and_timestamps_cannot_reuse_payload_bindings() {
+    let (samples, records) = fixture(&[(5000, true)]);
+    let reader = EvidenceReader::from_snapshot(records).unwrap();
+    for mutation in 0..4 {
+        let mut changed = samples.clone();
+        match mutation {
+            0 => changed[0].predicted_bps = 9000,
+            1 => changed[0].observed = false,
+            2 => changed[0].predicted_at = 9,
+            _ => changed[0].resolved_at = 21,
+        }
+        assert!(calibrate_history(cohort(), 1, &changed, &reader).is_err());
+    }
+}
+
+#[test]
+fn wrong_cohort_kind_subject_or_policy_is_rejected() {
+    let (samples, records) = fixture(&[(5000, true)]);
+    for mutation in 0..5 {
+        let mut changed = records.clone();
+        match mutation {
+            0 => changed[0].subject = Digest32::ZERO,
+            1 => changed[1].kind = "other".into(),
+            2 => changed[1].subject = Digest32::ZERO,
+            3 => changed[1].policy_digest = Some(cohort()),
+            _ => changed[1].causal_parents.clear(),
+        }
+        let reader = EvidenceReader::from_snapshot(changed).unwrap();
+        assert!(calibrate_history(cohort(), 1, &samples, &reader).is_err());
+    }
+}
+
+#[test]
+fn invalid_probability_time_or_threshold_is_rejected() {
+    assert!(prediction_payload_digest(cohort(), 10_001, 10).is_err());
+    let (mut samples, records) = fixture(&[(5000, true)]);
+    let reader = EvidenceReader::from_snapshot(records).unwrap();
+    assert!(calibrate_history(cohort(), 0, &samples, &reader).is_err());
+    assert!(calibrate_history(Digest32::ZERO, 1, &samples, &reader).is_err());
+    samples[0].resolved_at = samples[0].predicted_at;
+    assert!(calibrate_history(cohort(), 1, &samples, &reader).is_err());
+}
