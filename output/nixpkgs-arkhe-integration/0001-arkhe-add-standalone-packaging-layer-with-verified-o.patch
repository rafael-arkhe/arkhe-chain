diff --git a/arkhe/source/apps/arkhe-ask/src/auth.rs b/arkhe/source/apps/arkhe-ask/src/auth.rs
new file mode 100644
index 00000000..17b5bb4a
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/src/auth.rs
@@ -0,0 +1,149 @@
+//! Keycloak authentication. Never derive a JWT tenant from caller headers.
+use axum::{
+    extract::{Request, State},
+    middleware::Next,
+    response::Response,
+};
+use axum_keycloak_auth::{
+    instance::{KeycloakAuthInstance, KeycloakConfig},
+    layer::KeycloakAuthLayer,
+    PassthroughMode, Url,
+};
+use serde::Deserialize;
+use std::{
+    sync::Arc,
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+
+#[derive(Clone)]
+pub struct Tenant(pub String);
+
+#[derive(Clone, Deserialize)]
+struct TenantClaims {
+    tenant_id: Option<String>,
+    nbf: Option<u64>,
+}
+
+#[derive(Clone)]
+pub struct KeycloakAuth {
+    validator: Arc<KeycloakAuthLayer<String, TenantClaims>>,
+    issuer: String,
+}
+
+impl KeycloakAuth {
+    pub async fn connect(server: &str, realm: &str, audience: &str) -> Result<Self, String> {
+        if realm.trim().is_empty() || audience.trim().is_empty() {
+            return Err("Keycloak realm and audience are required".into());
+        }
+        let server = Url::parse(server).map_err(|_| "invalid KEYCLOAK_URL")?;
+        if !matches!(server.scheme(), "http" | "https") || server.host_str().is_none() {
+            return Err("KEYCLOAK_URL must be an HTTP(S) base URL".into());
+        }
+        let issuer = format!("{}/realms/{realm}", server.as_str().trim_end_matches('/'));
+        let instance = Arc::new(KeycloakAuthInstance::new(
+            KeycloakConfig::builder()
+                .server(server)
+                .realm(realm.to_string())
+                .retry((2, 1))
+                .build(),
+        ));
+        tokio::time::timeout(Duration::from_secs(15), async {
+            while !instance.is_operational().await {
+                tokio::time::sleep(Duration::from_millis(50)).await;
+            }
+        })
+        .await
+        .map_err(|_| "Keycloak discovery did not become operational")?;
+        let validator = KeycloakAuthLayer::<String, TenantClaims>::builder()
+            .instance(instance)
+            .passthrough_mode(PassthroughMode::Block)
+            .persist_raw_claims(true)
+            .expected_audiences(vec![audience.to_string()])
+            .build();
+        Ok(Self {
+            validator: Arc::new(validator),
+            issuer,
+        })
+    }
+
+    pub async fn from_env() -> Result<Self, String> {
+        let required = |name| {
+            std::env::var(name)
+                .ok()
+                .filter(|v| !v.trim().is_empty())
+                .ok_or_else(|| format!("{name} is required"))
+        };
+        Self::connect(
+            &required("KEYCLOAK_URL")?,
+            &required("KEYCLOAK_REALM")?,
+            &required("KEYCLOAK_AUDIENCE")?,
+        )
+        .await
+    }
+}
+
+pub async fn authenticate(
+    State(auth): State<KeycloakAuth>,
+    mut request: Request,
+    next: Next,
+) -> Response {
+    let unauthorized = || {
+        use axum::response::IntoResponse;
+        (
+            axum::http::StatusCode::UNAUTHORIZED,
+            [(axum::http::header::WWW_AUTHENTICATE, "Bearer")],
+            axum::Json(serde_json::json!({"error": "unauthorized"})),
+        )
+            .into_response()
+    };
+    let Some(raw) = request
+        .headers()
+        .get(axum::http::header::AUTHORIZATION)
+        .and_then(|v| v.to_str().ok())
+        .and_then(|v| v.strip_prefix("Bearer "))
+        .filter(|v| !v.is_empty())
+    else {
+        return unauthorized();
+    };
+    let Ok(Ok((claims, token))) = tokio::time::timeout(
+        Duration::from_secs(10),
+        auth.validator.validate_raw_token(raw),
+    )
+    .await
+    else {
+        return unauthorized();
+    };
+    // 0.8.1 verifies signature/audience/expiry, but does not enforce issuer or nbf.
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs();
+    if token.issuer != auth.issuer
+        || token.subject.trim().is_empty()
+        || token.extra.nbf.is_some_and(|nbf| nbf > now)
+        || claims
+            .as_ref()
+            .and_then(|c| c.get("typ"))
+            .and_then(|v| v.as_str())
+            != Some("Bearer")
+    {
+        return unauthorized();
+    }
+    let Some(tenant) = token.extra.tenant_id.filter(|t| !t.trim().is_empty()) else {
+        return unauthorized();
+    };
+    request.extensions_mut().insert(Tenant(tenant));
+    next.run(request).await
+}
+
+/// Explicitly opted-in development/test identity only.
+pub async fn dev_identity(mut request: Request, next: Next) -> Response {
+    let tenant = request
+        .headers()
+        .get("x-tenant-id")
+        .and_then(|v| v.to_str().ok())
+        .unwrap_or("")
+        .to_string();
+    request.extensions_mut().insert(Tenant(tenant));
+    next.run(request).await
+}
diff --git a/arkhe/source/apps/arkhe-ask/src/events.rs b/arkhe/source/apps/arkhe-ask/src/events.rs
new file mode 100644
index 00000000..eab4f67f
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/src/events.rs
@@ -0,0 +1,318 @@
+//! At-least-once outbox transport with a durable idempotent proof projection.
+//! No answer, query or claim text is sent to Kafka.
+use crate::pipeline::CitationProof;
+use arkhe_core::{
+    evidence::{EvidenceCommitter, EvidenceEnvelope},
+    Digest32,
+};
+use arkhe_wormgraph::WormGraph;
+use async_trait::async_trait;
+use rskafka::{
+    client::{
+        partition::{Compression, OffsetAt, PartitionClient, UnknownTopicHandling},
+        ClientBuilder,
+    },
+    record::Record,
+};
+use serde::{Deserialize, Serialize};
+use sqlx::{PgPool, Postgres, Transaction};
+use std::{collections::HashMap, sync::Arc, time::Duration};
+use tracing::Instrument;
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct VerifiedEvent {
+    pub version: u8,
+    pub event_id: String,
+    pub proof: CitationProof,
+}
+impl VerifiedEvent {
+    pub fn new(proof: CitationProof) -> Self {
+        Self {
+            version: 1,
+            event_id: uuid::Uuid::new_v4().to_string(),
+            proof,
+        }
+    }
+    pub fn envelope(&self) -> Result<EvidenceEnvelope, String> {
+        if self.version != 1
+            || uuid::Uuid::parse_str(&self.event_id).is_err()
+            || self.proof.tenant_id.trim().is_empty()
+            || self.proof.evidence_ids.is_empty()
+        {
+            return Err("invalid verified event".into());
+        }
+        let bytes = serde_json::to_vec(self).map_err(|e| e.to_string())?;
+        let hash = Digest32::blake3(b"AKG:ASK:EVENT:v1\0", &bytes);
+        Ok(EvidenceEnvelope {
+            record_hash: hash,
+            kind: "ask.citation.verified.v1".into(),
+            subject: self.proof.record_digest,
+            payload_digest: hash,
+            policy_digest: None,
+            causal_parents: vec![],
+        })
+    }
+}
+
+#[async_trait]
+pub trait ProofJournal: Send + Sync {
+    async fn record(&self, proof: &CitationProof) -> Result<(), String>;
+}
+#[async_trait]
+pub trait EventPublisher: Send + Sync {
+    async fn publish(&self, event: &VerifiedEvent) -> Result<(), String>;
+}
+
+pub struct PgProofJournal {
+    pool: PgPool,
+    pub graph: Arc<WormGraph>,
+}
+impl PgProofJournal {
+    pub async fn connect(pool: PgPool) -> Result<Self, String> {
+        sqlx::migrate!("./migrations")
+            .run(&pool)
+            .await
+            .map_err(|e| e.to_string())?;
+        let graph = Arc::new(WormGraph::new());
+        let envelopes: Vec<(serde_json::Value,)> =
+            sqlx::query_as("SELECT envelope FROM ask_proof_anchors")
+                .fetch_all(&pool)
+                .await
+                .map_err(|e| e.to_string())?;
+        for (value,) in envelopes {
+            graph
+                .append_verified(serde_json::from_value(value).map_err(|e| e.to_string())?)
+                .await?;
+        }
+        Ok(Self { pool, graph })
+    }
+    pub fn pool(&self) -> &PgPool {
+        &self.pool
+    }
+
+    pub async fn enqueue(&self, event: &VerifiedEvent) -> Result<(), String> {
+        event.envelope()?;
+        let payload = serde_json::to_value(event).map_err(|e| e.to_string())?;
+        let result = sqlx::query(
+            "INSERT INTO ask_verified_outbox(event_id,tenant_id,payload,trace_context)
+            VALUES($1,$2,$3,$4) ON CONFLICT(event_id) DO UPDATE SET event_id=EXCLUDED.event_id
+            WHERE ask_verified_outbox.payload=EXCLUDED.payload
+                AND ask_verified_outbox.tenant_id=EXCLUDED.tenant_id",
+        )
+        .bind(&event.event_id)
+        .bind(&event.proof.tenant_id)
+        .bind(payload)
+        .bind(serde_json::to_value(crate::telemetry::capture_context()).map_err(|e| e.to_string())?)
+        .execute(&self.pool)
+        .await
+        .map_err(|e| e.to_string())?;
+        if result.rows_affected() != 1 {
+            return Err("event id bound to different payload".into());
+        }
+        Ok(())
+    }
+
+    /// The database row stays locked until Kafka acknowledges or the bounded attempt fails.
+    #[tracing::instrument(skip_all, name = "arkhe.ask.proof.relay")]
+    pub async fn relay_once(&self, publisher: &dyn EventPublisher) -> Result<bool, String> {
+        let mut tx = self.pool.begin().await.map_err(|e| e.to_string())?;
+        let row: Option<(String, serde_json::Value,serde_json::Value)> = sqlx::query_as(
+            "SELECT event_id,payload,trace_context FROM ask_verified_outbox WHERE published_at IS NULL
+             ORDER BY created_at,event_id FOR UPDATE SKIP LOCKED LIMIT 1",
+        )
+        .fetch_optional(&mut *tx)
+        .await
+        .map_err(|e| e.to_string())?;
+        let Some((id, value, context)) = row else {
+            tx.commit().await.map_err(|e| e.to_string())?;
+            return Ok(false);
+        };
+        let event: VerifiedEvent = serde_json::from_value(value).map_err(|e| e.to_string())?;
+        let context: HashMap<String, String> =
+            serde_json::from_value(context).map_err(|e| e.to_string())?;
+        let span = tracing::info_span!(
+            "arkhe.ask.proof.publish",
+            otel.kind = "producer",
+            messaging.system = "kafka"
+        );
+        crate::telemetry::restore_parent(&span, &context);
+        tokio::time::timeout(
+            Duration::from_secs(10),
+            publisher.publish(&event).instrument(span),
+        )
+        .await
+        .map_err(|_| "Kafka publish timed out")??;
+        sqlx::query("UPDATE ask_verified_outbox SET published_at=now() WHERE event_id=$1")
+            .bind(id)
+            .execute(&mut *tx)
+            .await
+            .map_err(|e| e.to_string())?;
+        tx.commit().await.map_err(|e| e.to_string())?;
+        Ok(true)
+    }
+
+    async fn apply(
+        &self,
+        tx: &mut Transaction<'_, Postgres>,
+        event: &VerifiedEvent,
+    ) -> Result<EvidenceEnvelope, String> {
+        let expected: Option<(String, serde_json::Value)> =
+            sqlx::query_as("SELECT tenant_id,payload FROM ask_verified_outbox WHERE event_id=$1")
+                .bind(&event.event_id)
+                .fetch_optional(&mut **tx)
+                .await
+                .map_err(|e| e.to_string())?;
+        let value = serde_json::to_value(event).map_err(|e| e.to_string())?;
+        if expected != Some((event.proof.tenant_id.clone(), value.clone())) {
+            return Err("Kafka event is not admitted by the verified outbox".into());
+        }
+        let envelope = event.envelope()?;
+        let result = sqlx::query("INSERT INTO ask_proof_anchors(event_id,payload,envelope) VALUES($1,$2,$3)
+            ON CONFLICT(event_id) DO UPDATE SET event_id=EXCLUDED.event_id
+            WHERE ask_proof_anchors.payload=EXCLUDED.payload AND ask_proof_anchors.envelope=EXCLUDED.envelope")
+            .bind(&event.event_id).bind(value).bind(serde_json::to_value(&envelope).map_err(|e| e.to_string())?)
+            .execute(&mut **tx).await.map_err(|e| e.to_string())?;
+        if result.rows_affected() != 1 {
+            return Err("anchor id collision".into());
+        }
+        Ok(envelope)
+    }
+
+    /// Durable cursor and projection commit in the same PostgreSQL transaction.
+    /// Poison messages or retention gaps stop this partition; never silently skip.
+    #[tracing::instrument(skip_all, name = "arkhe.ask.proof.poll")]
+    pub async fn consume_once(&self, bus: &KafkaBus) -> Result<usize, String> {
+        sqlx::query(
+            "INSERT INTO ask_kafka_cursors(topic,next_offset) VALUES($1,0) ON CONFLICT DO NOTHING",
+        )
+        .bind(&bus.topic)
+        .execute(&self.pool)
+        .await
+        .map_err(|e| e.to_string())?;
+        let mut tx = self.pool.begin().await.map_err(|e| e.to_string())?;
+        let (offset,): (i64,) =
+            sqlx::query_as("SELECT next_offset FROM ask_kafka_cursors WHERE topic=$1 FOR UPDATE")
+                .bind(&bus.topic)
+                .fetch_one(&mut *tx)
+                .await
+                .map_err(|e| e.to_string())?;
+        let earliest = tokio::time::timeout(
+            Duration::from_secs(10),
+            bus.partition.get_offset(OffsetAt::Earliest),
+        )
+        .await
+        .map_err(|_| "Kafka offset timed out")?
+        .map_err(|e| e.to_string())?;
+        if offset < earliest {
+            return Err("Kafka retention gap; manual replay required".into());
+        }
+        let (records, _) = tokio::time::timeout(
+            Duration::from_secs(10),
+            bus.partition.fetch_records(offset, 1..1_048_576, 100),
+        )
+        .await
+        .map_err(|_| "Kafka fetch timed out")?
+        .map_err(|e| e.to_string())?;
+        let mut next = offset;
+        let mut envelopes = Vec::new();
+        for record in &records {
+            let raw = record
+                .record
+                .value
+                .as_ref()
+                .ok_or("Kafka tombstone is not a proof event")?;
+            let event: VerifiedEvent = serde_json::from_slice(raw).map_err(|e| e.to_string())?;
+            if record.record.key.as_deref() != Some(event.event_id.as_bytes()) {
+                return Err("Kafka key and event id differ".into());
+            }
+            let context: HashMap<String, String> = record
+                .record
+                .headers
+                .iter()
+                .filter(|(k, v)| {
+                    matches!(k.as_str(), "traceparent" | "tracestate") && v.len() <= 512
+                })
+                .filter_map(|(k, v)| String::from_utf8(v.clone()).ok().map(|v| (k.clone(), v)))
+                .collect();
+            let consumer = tracing::info_span!(
+                "arkhe.ask.proof.consume",
+                otel.kind = "consumer",
+                messaging.system = "kafka"
+            );
+            crate::telemetry::restore_parent(&consumer, &context);
+            let anchor = tracing::info_span!(parent:&consumer,"arkhe.ask.proof.anchor");
+            let envelope = self
+                .apply(&mut tx, &event)
+                .instrument(anchor.clone())
+                .await?;
+            envelopes.push((envelope, consumer, anchor));
+            next = record
+                .offset
+                .checked_add(1)
+                .ok_or("Kafka offset overflow")?;
+        }
+        sqlx::query("UPDATE ask_kafka_cursors SET next_offset=$2 WHERE topic=$1")
+            .bind(&bus.topic)
+            .bind(next)
+            .execute(&mut *tx)
+            .await
+            .map_err(|e| e.to_string())?;
+        tx.commit().await.map_err(|e| e.to_string())?;
+        for (envelope, _consumer, _anchor) in envelopes {
+            self.graph.append_verified(envelope).await?;
+        }
+        Ok(records.len())
+    }
+}
+#[async_trait]
+impl ProofJournal for PgProofJournal {
+    async fn record(&self, proof: &CitationProof) -> Result<(), String> {
+        self.enqueue(&VerifiedEvent::new(proof.clone())).await
+    }
+}
+
+pub struct KafkaBus {
+    pub topic: String,
+    pub partition: Arc<PartitionClient>,
+}
+impl KafkaBus {
+    /// Topic provisioning is deployment-owned: one partition, no consumer-group offsets.
+    pub async fn connect(brokers: Vec<String>, topic: String) -> Result<Self, String> {
+        let partition = tokio::time::timeout(Duration::from_secs(10), async {
+            let client = ClientBuilder::new(brokers)
+                .build()
+                .await
+                .map_err(|e| e.to_string())?;
+            client
+                .partition_client(topic.clone(), 0, UnknownTopicHandling::Error)
+                .await
+                .map_err(|e| e.to_string())
+        })
+        .await
+        .map_err(|_| "Kafka connection timed out")??;
+        Ok(Self {
+            topic,
+            partition: Arc::new(partition),
+        })
+    }
+}
+#[async_trait]
+impl EventPublisher for KafkaBus {
+    async fn publish(&self, event: &VerifiedEvent) -> Result<(), String> {
+        let record = Record {
+            key: Some(event.event_id.as_bytes().to_vec()),
+            value: Some(serde_json::to_vec(event).map_err(|e| e.to_string())?),
+            headers: crate::telemetry::capture_context()
+                .into_iter()
+                .map(|(k, v)| (k, v.into_bytes()))
+                .collect(),
+            timestamp: rskafka::chrono::Utc::now(),
+        };
+        self.partition
+            .produce(vec![record], Compression::NoCompression)
+            .await
+            .map_err(|e| e.to_string())?;
+        Ok(())
+    }
+}
diff --git a/arkhe/source/apps/arkhe-ask/src/lib.rs b/arkhe/source/apps/arkhe-ask/src/lib.rs
new file mode 100644
index 00000000..6a96a02a
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/src/lib.rs
@@ -0,0 +1,155 @@
+//! arkhe-ask — job-plan endpoint: `POST /v1/ask`.
+//!
+//! retrieve (chunk store) → generate (LLM) → verify citations (real, from
+//! arkhe-rag) → answer + citation proof, or 422 with nothing.
+//!
+//! Every external frontier is a trait with an in-memory default (see
+//! `pipeline` and `providers`); the verification layer is the real one.
+
+pub mod auth;
+pub mod events;
+pub mod pipeline;
+pub mod providers;
+pub mod telemetry;
+
+use auth::{KeycloakAuth, Tenant};
+use axum::extract::State;
+use axum::http::StatusCode;
+use axum::response::{IntoResponse, Response};
+use axum::routing::{get, post};
+use axum::{middleware, Extension};
+use axum::{Json, Router};
+use pipeline::{AskError, AskPipeline, ChunkStore, LlmProvider};
+use serde::Deserialize;
+use serde_json::json;
+use std::sync::Arc;
+use tracing::Instrument;
+
+#[derive(Clone)]
+struct AppState {
+    journal: Option<Arc<dyn events::ProofJournal>>,
+    pipeline: Arc<AskPipeline<Box<dyn ChunkStore>, Box<dyn LlmProvider>>>,
+}
+
+#[derive(Deserialize)]
+struct AskRequest {
+    query: String,
+}
+
+async fn ask(
+    State(state): State<AppState>,
+    Extension(Tenant(tenant)): Extension<Tenant>,
+    Json(req): Json<AskRequest>,
+) -> Response {
+    match state.pipeline.ask(&tenant, &req.query).await {
+        Ok(response) => {
+            metrics::counter!("arkhe_gate_decisions_total","decision"=>"accepted").increment(1);
+            if let Some(journal) = &state.journal {
+                if let Err(err) = journal
+                    .record(&response.citation_proof)
+                    .instrument(tracing::info_span!("arkhe.ask.proof.enqueue"))
+                    .await
+                {
+                    eprintln!("verified outbox persistence failed: {err}");
+                    return (
+                        StatusCode::SERVICE_UNAVAILABLE,
+                        Json(json!({"error":"proof_journal_unavailable"})),
+                    )
+                        .into_response();
+                }
+            }
+            (StatusCode::OK, Json(response)).into_response()
+        }
+        Err(err) => {
+            if matches!(err, AskError::UnsupportedClaim(_)) {
+                metrics::counter!("arkhe_gate_decisions_total","decision"=>"refused").increment(1);
+            }
+            err.into_response()
+        }
+    }
+}
+
+impl IntoResponse for AskError {
+    fn into_response(self) -> Response {
+        use AskError::*;
+        let (status, body) = match self {
+            EmptyQuery => (StatusCode::BAD_REQUEST, json!({"error": "empty_query"})),
+            Unauthorized => (StatusCode::UNAUTHORIZED, json!({"error": "unauthorized"})),
+            Store(detail) => (
+                StatusCode::BAD_GATEWAY,
+                json!({"error": "store", "detail": detail}),
+            ),
+            Llm(detail) => (
+                StatusCode::BAD_GATEWAY,
+                json!({"error": "llm", "detail": detail}),
+            ),
+            UnsupportedClaim(pipeline::CitationError::EntityNotInEvidence { entity, chunk }) => (
+                StatusCode::UNPROCESSABLE_ENTITY,
+                json!({"error": "unsupported_claim", "entity": entity, "chunk": chunk}),
+            ),
+            UnsupportedClaim(pipeline::CitationError::InsufficientSupport { claim, score }) => (
+                StatusCode::UNPROCESSABLE_ENTITY,
+                json!({"error": "insufficient_support", "claim": claim, "score": score}),
+            ),
+            UnsupportedClaim(pipeline::CitationError::UnknownEvidence(id)) => (
+                StatusCode::UNPROCESSABLE_ENTITY,
+                json!({"error": "unknown_evidence", "evidence_id": id}),
+            ),
+        };
+        (status, Json(body)).into_response()
+    }
+}
+
+/// Explicit development/test router using the X-Tenant-Id placeholder.
+pub fn router(store: Box<dyn ChunkStore>, llm: Box<dyn LlmProvider>) -> Router {
+    telemetry::instrument(
+        routes(store, llm, None)
+            .route_layer(middleware::from_fn(auth::dev_identity))
+            .merge(public_routes()),
+    )
+}
+
+/// Production router: only verified bearer tokens provide tenant identity.
+pub fn router_with_auth(
+    store: Box<dyn ChunkStore>,
+    llm: Box<dyn LlmProvider>,
+    auth: KeycloakAuth,
+) -> Router {
+    telemetry::instrument(
+        routes(store, llm, None)
+            .route_layer(middleware::from_fn_with_state(auth, auth::authenticate))
+            .merge(public_routes()),
+    )
+}
+
+fn public_routes() -> Router {
+    Router::new().route("/healthz", get(|| async { "ok" }))
+}
+
+pub fn router_with_journal(
+    store: Box<dyn ChunkStore>,
+    llm: Box<dyn LlmProvider>,
+    auth: Option<KeycloakAuth>,
+    journal: Arc<dyn events::ProofJournal>,
+) -> Router {
+    let app = routes(store, llm, Some(journal));
+    let app = if let Some(auth) = auth {
+        app.route_layer(middleware::from_fn_with_state(auth, auth::authenticate))
+    } else {
+        app.route_layer(middleware::from_fn(auth::dev_identity))
+    };
+    telemetry::instrument(app.merge(public_routes()))
+}
+
+fn routes(
+    store: Box<dyn ChunkStore>,
+    llm: Box<dyn LlmProvider>,
+    journal: Option<Arc<dyn events::ProofJournal>>,
+) -> Router {
+    Router::new()
+        .route("/v1/ask", post(ask))
+        .with_state(AppState {
+            journal,
+            pipeline: Arc::new(AskPipeline::new(store, llm)),
+        })
+}
diff --git a/arkhe/source/apps/arkhe-ask/src/main.rs b/arkhe/source/apps/arkhe-ask/src/main.rs
new file mode 100644
index 00000000..4a0e238c
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/src/main.rs
@@ -0,0 +1,191 @@
+//! arkhe-ask binary — env-selected wiring behind the real router.
+//!
+//! - LLM: `AZURE_OPENAI_ENDPOINT/_DEPLOYMENT/_API_KEY` select the real
+//!   provider (reqwest, no SDK); anything missing falls back to the
+//!   grounded echo (logged, never silent).
+//! - Store: `DATABASE_URL` selects pgvector (sqlx) when an embedder is
+//!   available; otherwise falls back to the in-memory corpus (logged).
+//! - Identity defaults to Keycloak JWT; dev-header mode requires explicit opt-in.
+
+use arkhe_ask::pipeline::{ChunkStore, Embedder, LlmProvider, StoredChunk};
+use arkhe_ask::providers::azure::AzureOpenAiProvider;
+use arkhe_ask::providers::pgvector::PgVectorStore;
+use arkhe_ask::providers::{EchoProvider, InMemoryStore};
+use std::sync::Arc;
+
+fn dev_corpus() -> Vec<StoredChunk> {
+    vec![StoredChunk {
+        tenant_id: "tenant-a".into(),
+        id: "e1".into(),
+        text: "Sydney is the capital of Australia.".into(),
+    }]
+}
+
+fn select_llm() -> (Box<dyn LlmProvider>, Option<Arc<dyn Embedder>>) {
+    match AzureOpenAiProvider::from_env() {
+        Ok(provider) => {
+            eprintln!("llm: azure-openai");
+            let embedder: Arc<dyn Embedder> = Arc::new(provider.clone());
+            (Box::new(provider), Some(embedder))
+        }
+        Err(reason) => {
+            eprintln!("llm: grounded echo ({reason})");
+            (Box::new(EchoProvider), None)
+        }
+    }
+}
+
+fn select_store(embedder: Option<Arc<dyn Embedder>>) -> Box<dyn ChunkStore> {
+    let database_url = std::env::var("DATABASE_URL").unwrap_or_default();
+    match std::env::var("ARKHE_RETRIEVER")
+        .as_deref()
+        .unwrap_or("default")
+    {
+        "default" => {}
+        "hybrid-invariants" => {
+            use arkhe_ask::providers::invariant::InvariantRetriever;
+            use std::io::Read;
+            assert!(
+                !database_url.trim().is_empty(),
+                "hybrid-invariants requires DATABASE_URL"
+            );
+            let embedder = embedder.expect("hybrid-invariants requires AZURE_OPENAI_* embedder");
+            let path = std::env::var("ARKHE_INVARIANT_CORPUS")
+                .expect("hybrid-invariants requires ARKHE_INVARIANT_CORPUS");
+            let mut bytes = Vec::new();
+            std::fs::File::open(path)
+                .expect("open invariant snapshot")
+                .take(33_554_433)
+                .read_to_end(&mut bytes)
+                .expect("read invariant snapshot");
+            assert!(
+                bytes.len() <= 33_554_432,
+                "invariant snapshot exceeds 32 MiB"
+            );
+            let corpus: Vec<StoredChunk> =
+                serde_json::from_slice(&bytes).expect("invariant snapshot JSON");
+            let store = InvariantRetriever::new(
+                PgVectorStore::lazy(database_url, embedder),
+                corpus,
+                1.2,
+                0.75,
+                60,
+                32,
+            )
+            .expect("valid invariant snapshot");
+            eprintln!("store: hybrid-invariants (BM25 + pgvector + RRF + overlap; immutable local snapshot)");
+            return Box::new(store);
+        }
+        mode => panic!("unknown ARKHE_RETRIEVER: {mode}"),
+    }
+    if database_url.is_empty() {
+        eprintln!("store: in-memory dev corpus");
+        return Box::new(InMemoryStore {
+            chunks: dev_corpus(),
+        });
+    }
+    let Some(embedder) = embedder else {
+        // No embedder means no way to index or search vectors: fail loudly
+        // into the dev store rather than silently mis-answering.
+        eprintln!(
+            "store: DATABASE_URL is set but no AZURE_OPENAI_* embedder; \
+             falling back to in-memory (pgvector needs embeddings)"
+        );
+        return Box::new(InMemoryStore {
+            chunks: dev_corpus(),
+        });
+    };
+    eprintln!("store: pgvector");
+    Box::new(PgVectorStore::lazy(database_url, embedder))
+}
+
+#[tokio::main]
+async fn main() {
+    let telemetry = arkhe_ask::telemetry::init()
+        .await
+        .expect("telemetry initialization");
+    let listen = std::env::var("ARKHE_LISTEN").unwrap_or_else(|_| "127.0.0.1:3000".into());
+    let (llm, embedder) = select_llm();
+    let store = select_store(embedder);
+    let auth = match std::env::var("ARKHE_AUTH_MODE")
+        .as_deref()
+        .unwrap_or("keycloak")
+    {
+        "keycloak" => {
+            let auth = arkhe_ask::auth::KeycloakAuth::from_env()
+                .await
+                .unwrap_or_else(|e| panic!("Keycloak authentication configuration: {e}"));
+            eprintln!("auth: keycloak JWT");
+            Some(auth)
+        }
+        "dev-header" => {
+            eprintln!("auth: explicit development X-Tenant-Id mode");
+            None
+        }
+        mode => panic!("unknown ARKHE_AUTH_MODE: {mode}"),
+    };
+    let brokers = std::env::var("KAFKA_BROKERS").unwrap_or_default();
+    let app = if !brokers.trim().is_empty() {
+        use arkhe_ask::events::{KafkaBus, PgProofJournal};
+        let pool = sqlx::postgres::PgPoolOptions::new()
+            .max_connections(5)
+            .connect(&std::env::var("DATABASE_URL").expect("DATABASE_URL required by outbox"))
+            .await
+            .expect("outbox database connection");
+        let journal = Arc::new(
+            PgProofJournal::connect(pool)
+                .await
+                .expect("outbox migrations"),
+        );
+        let worker = Arc::clone(&journal);
+        let topic = std::env::var("KAFKA_TOPIC").unwrap_or_else(|_| "arkhe.ask.verified.v1".into());
+        tokio::spawn(async move {
+            loop {
+                match KafkaBus::connect(
+                    brokers.split(',').map(str::to_string).collect(),
+                    topic.clone(),
+                )
+                .await
+                {
+                    Ok(bus) => loop {
+                        let result = async {
+                            worker.relay_once(&bus).await?;
+                            worker.consume_once(&bus).await?;
+                            Ok::<_, String>(())
+                        }
+                        .await;
+                        if let Err(err) = result {
+                            eprintln!("proof worker retry: {err}");
+                            break;
+                        }
+                        tokio::time::sleep(std::time::Duration::from_millis(250)).await;
+                    },
+                    Err(err) => eprintln!("Kafka connect retry: {err}"),
+                }
+                tokio::time::sleep(std::time::Duration::from_secs(1)).await;
+            }
+        });
+        eprintln!("proof journal: PostgreSQL outbox + Kafka");
+        arkhe_ask::router_with_journal(store, llm, auth, journal)
+    } else {
+        eprintln!("proof journal: disabled (KAFKA_BROKERS absent)");
+        match auth {
+            Some(auth) => arkhe_ask::router_with_auth(store, llm, auth),
+            None => arkhe_ask::router(store, llm),
+        }
+    };
+    let listener = tokio::net::TcpListener::bind(&listen)
+        .await
+        .unwrap_or_else(|e| panic!("cannot bind {listen}: {e}"));
+    eprintln!("arkhe-ask listening on {listen}");
+    axum::serve(listener, app)
+        .with_graceful_shutdown(arkhe_ask::telemetry::shutdown_signal())
+        .await
+        .expect("server error");
+    if let Some(provider) = telemetry {
+        tokio::task::spawn_blocking(move || provider.shutdown())
+            .await
+            .expect("telemetry shutdown task")
+            .expect("telemetry export shutdown");
+    }
+}
diff --git a/arkhe/source/apps/arkhe-ask/src/pipeline.rs b/arkhe/source/apps/arkhe-ask/src/pipeline.rs
new file mode 100644
index 00000000..76ccf3e1
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/src/pipeline.rs
@@ -0,0 +1,261 @@
+//! AKG-ASK-0001 — the `/v1/ask` pipeline: retrieve → generate → REFUSE the
+//! unsupported.
+//!
+//! Job-plan skeleton: every external dependency (LLM, vector store, identity
+//! provider) is a trait with an in-memory default, and the one component
+//! that is real today is the differential — the `CitationVerifier` from
+//! arkhe-rag (AKG-CITE-0001). A claim is returned only when every entity in
+//! it occurs literally in the chunk it cites; otherwise the endpoint refuses
+//! with 422 and returns nothing. A RAG pipeline that refuses to return
+//! unsupported claims.
+//!
+//! Week map (see `ops/jobplan/docker-compose.yml`):
+//! - Week 2: `AzureOpenAiProvider` (reqwest) and `PgVectorStore` (sqlx)
+//!   replace the in-memory defaults behind these same traits.
+//! - Week 3: Keycloak JWT middleware authenticates tenant identity by default;
+//!   header identity remains an explicit development option.
+//! - Week 4: the proof digest is anchored through the outbox (Kafka relay).
+//! - Week 5: OTel spans + `/metrics`.
+
+use arkhe_cognition_sdk::Digest32;
+use arkhe_rag::citation::{CitationVerifier, Claim, Evidence, OverlapVerifier};
+use arkhe_rag::ncm_harness::ClaimData;
+use async_trait::async_trait;
+use tracing::Instrument;
+
+pub use arkhe_rag::citation::CitationError;
+
+#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
+pub struct StoredChunk {
+    pub tenant_id: String,
+    pub id: String,
+    pub text: String,
+}
+
+#[async_trait]
+pub trait ChunkStore: Send + Sync {
+    async fn retrieve(
+        &self,
+        tenant_id: &str,
+        query: &str,
+        k: usize,
+    ) -> Result<Vec<StoredChunk>, String>;
+
+    async fn retrieve_evidenced(
+        &self,
+        tenant_id: &str,
+        query: &str,
+        k: usize,
+    ) -> Result<RetrievalBatch, String> {
+        Ok(RetrievalBatch {
+            chunks: self.retrieve(tenant_id, query, k).await?,
+            evidence: vec![],
+        })
+    }
+}
+
+pub struct RetrievalBatch {
+    pub chunks: Vec<StoredChunk>,
+    pub evidence: Vec<crate::providers::invariant::ChunkEvidence>,
+}
+
+#[derive(Debug, Clone)]
+pub struct GeneratedAnswer {
+    pub answer: String,
+    pub claims: Vec<ClaimData>,
+}
+
+#[async_trait]
+pub trait LlmProvider: Send + Sync {
+    async fn answer(&self, query: &str, chunks: &[StoredChunk]) -> Result<GeneratedAnswer, String>;
+}
+
+/// Embeds text into the vector space the chunk store indexes. Implemented
+/// by the real provider (Azure OpenAI) and by test doubles.
+#[async_trait]
+pub trait Embedder: Send + Sync {
+    async fn embed(&self, text: &str) -> Result<Vec<f32>, String>;
+}
+
+#[async_trait]
+impl<T: ChunkStore + ?Sized> ChunkStore for Box<T> {
+    async fn retrieve_evidenced(
+        &self,
+        tenant_id: &str,
+        query: &str,
+        k: usize,
+    ) -> Result<RetrievalBatch, String> {
+        (**self).retrieve_evidenced(tenant_id, query, k).await
+    }
+    async fn retrieve(
+        &self,
+        tenant_id: &str,
+        query: &str,
+        k: usize,
+    ) -> Result<Vec<StoredChunk>, String> {
+        (**self).retrieve(tenant_id, query, k).await
+    }
+}
+
+#[async_trait]
+impl<T: LlmProvider + ?Sized> LlmProvider for Box<T> {
+    async fn answer(&self, query: &str, chunks: &[StoredChunk]) -> Result<GeneratedAnswer, String> {
+        (**self).answer(query, chunks).await
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+pub struct CitationProof {
+    pub tenant_id: String,
+    /// Evidence ids the returned claims cite, in first-citation order.
+    pub evidence_ids: Vec<String>,
+    /// BLAKE3 over the claims and their cited evidence, domain-separated.
+    pub record_digest: Digest32,
+}
+
+#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+pub struct AskResponse {
+    pub answer: String,
+    pub claims: Vec<ClaimData>,
+    pub citation_proof: CitationProof,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub chunk_evidence: Vec<crate::providers::invariant::ChunkEvidence>,
+}
+
+#[derive(Debug, PartialEq)]
+pub enum AskError {
+    EmptyQuery,
+    Unauthorized,
+    Store(String),
+    Llm(String),
+    /// The differential: a claim cites an entity that does not occur
+    /// literally in the cited chunk (or with insufficient overlap). Nothing
+    /// is returned to the caller.
+    UnsupportedClaim(CitationError),
+}
+
+pub struct AskPipeline<S, L> {
+    store: S,
+    llm: L,
+    verifier: OverlapVerifier,
+}
+
+impl<S: ChunkStore, L: LlmProvider> AskPipeline<S, L> {
+    pub fn new(store: S, llm: L) -> Self {
+        Self {
+            store,
+            llm,
+            verifier: OverlapVerifier::default(),
+        }
+    }
+
+    pub async fn ask(&self, tenant: &str, query: &str) -> Result<AskResponse, AskError> {
+        if tenant.trim().is_empty() {
+            return Err(AskError::Unauthorized);
+        }
+        if query.trim().is_empty() {
+            return Err(AskError::EmptyQuery);
+        }
+        let retrieved = self
+            .store
+            .retrieve_evidenced(tenant, query, 4)
+            .instrument(tracing::info_span!("arkhe.ask.rag.retrieve"))
+            .await
+            .map_err(AskError::Store)?;
+        let chunks = retrieved.chunks;
+        if !retrieved.evidence.is_empty()
+            && (retrieved.evidence.len() != chunks.len()
+                || retrieved.evidence.iter().zip(&chunks).any(|(e, c)| {
+                    e.id != c.id || e.text != c.text || !e.verify(tenant, &e.inclusion_proof.root)
+                }))
+        {
+            return Err(AskError::Store(
+                "invalid retrieval inclusion evidence".into(),
+            ));
+        }
+        if chunks.iter().any(|chunk| chunk.tenant_id != tenant) {
+            return Err(AskError::Store(
+                "store returned evidence outside tenant scope".into(),
+            ));
+        }
+        if chunks.is_empty() {
+            return Err(AskError::Store("no evidence retrieved".into()));
+        }
+        let generated = self
+            .llm
+            .answer(query, &chunks)
+            .instrument(tracing::info_span!("arkhe.ask.rag.generate"))
+            .await
+            .map_err(AskError::Llm)?;
+
+        // The layer that makes this more than a RAG tutorial.
+        let evidence: Vec<Evidence<'_>> = chunks
+            .iter()
+            .map(|c| Evidence {
+                id: c.id.as_str(),
+                text: c.text.as_str(),
+            })
+            .collect();
+        let claims: Vec<Claim<'_>> = generated
+            .claims
+            .iter()
+            .map(|c| Claim {
+                text: c.text.as_str(),
+                evidence_id: c.evidence_id.as_str(),
+            })
+            .collect();
+        tracing::info_span!("arkhe.ask.rag.verify")
+            .in_scope(|| self.verifier.verify(&claims, &evidence))
+            .map_err(AskError::UnsupportedClaim)?;
+
+        // Proof digest: cited evidence ids then claims, length-prefixed,
+        // under the ask domain.
+        let mut evidence_ids: Vec<String> = Vec::new();
+        let mut buf = Vec::new();
+        buf.extend_from_slice(&(tenant.len() as u64).to_be_bytes());
+        buf.extend_from_slice(tenant.as_bytes());
+        for claim in &generated.claims {
+            if !evidence_ids.contains(&claim.evidence_id) {
+                evidence_ids.push(claim.evidence_id.clone());
+            }
+        }
+        for id in &evidence_ids {
+            buf.extend_from_slice(&(id.len() as u64).to_be_bytes());
+            buf.extend_from_slice(id.as_bytes());
+        }
+        for claim in &generated.claims {
+            buf.extend_from_slice(&(claim.text.len() as u64).to_be_bytes());
+            buf.extend_from_slice(claim.text.as_bytes());
+            buf.extend_from_slice(&(claim.evidence_id.len() as u64).to_be_bytes());
+            buf.extend_from_slice(claim.evidence_id.as_bytes());
+        }
+        let chunk_evidence: Vec<_> = retrieved
+            .evidence
+            .into_iter()
+            .filter(|e| evidence_ids.contains(&e.id))
+            .collect();
+        let record_digest = if chunk_evidence.is_empty() {
+            Digest32::blake3(b"AKG:ASK:PROOF:v2\0", &buf)
+        } else {
+            // The opt-in v3 commitment also binds the cited content and snapshot
+            // proofs. Legacy providers preserve their v2 bytes and domain.
+            let encoded = arkhe_core::canonical::encode_value(
+                &serde_json::to_value(&chunk_evidence)
+                    .map_err(|e| AskError::Store(format!("evidence encoding: {e}")))?,
+            );
+            buf.extend_from_slice(&(encoded.len() as u64).to_be_bytes());
+            buf.extend_from_slice(&encoded);
+            Digest32::blake3(b"AKG:ASK:PROOF:v3\0", &buf)
+        };
+        Ok(AskResponse {
+            answer: generated.answer,
+            claims: generated.claims,
+            chunk_evidence,
+            citation_proof: CitationProof {
+                tenant_id: tenant.to_string(),
+                evidence_ids,
+                record_digest,
+            },
+        })
+    }
+}
diff --git a/arkhe/source/apps/arkhe-ask/src/providers.rs b/arkhe/source/apps/arkhe-ask/src/providers.rs
new file mode 100644
index 00000000..494f1f84
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/src/providers.rs
@@ -0,0 +1,66 @@
+//! Dev-default and production providers for the `/v1/ask` frontiers.
+//!
+//! - `InMemoryStore` / `EchoProvider`: dev defaults (week 1).
+//! - `azure::AzureOpenAiProvider`: real LLM over reqwest, no SDK (week 2).
+//! - `pgvector::PgVectorStore`: real vector store over sqlx + pgvector
+//!   (week 2).
+
+pub mod azure;
+pub mod invariant;
+pub mod pgvector;
+
+use crate::pipeline::{ChunkStore, GeneratedAnswer, LlmProvider, StoredChunk};
+use arkhe_rag::ncm_harness::ClaimData;
+use async_trait::async_trait;
+
+/// In-memory corpus; `retrieve` ignores the query (no embeddings yet) and
+/// returns the first `k` chunks.
+pub struct InMemoryStore {
+    pub chunks: Vec<StoredChunk>,
+}
+
+#[async_trait]
+impl ChunkStore for InMemoryStore {
+    async fn retrieve(
+        &self,
+        tenant_id: &str,
+        _query: &str,
+        k: usize,
+    ) -> Result<Vec<StoredChunk>, String> {
+        if tenant_id.trim().is_empty() {
+            return Err("tenant_id is required".into());
+        }
+        Ok(self
+            .chunks
+            .iter()
+            .filter(|c| c.tenant_id == tenant_id)
+            .take(k)
+            .cloned()
+            .collect())
+    }
+}
+
+/// Deterministic, grounded-by-construction provider: echoes the first chunk
+/// as both the answer and its single claim. The verifier passes by
+/// construction, so tests against it exercise the plumbing, not the
+/// verification. Verification itself is exercised by injecting a
+/// hallucinating provider (see `tests/ask_e2e.rs`).
+pub struct EchoProvider;
+
+#[async_trait]
+impl LlmProvider for EchoProvider {
+    async fn answer(
+        &self,
+        _query: &str,
+        chunks: &[StoredChunk],
+    ) -> Result<GeneratedAnswer, String> {
+        let chunk = chunks.first().ok_or("no chunks")?;
+        Ok(GeneratedAnswer {
+            answer: chunk.text.clone(),
+            claims: vec![ClaimData {
+                text: chunk.text.clone(),
+                evidence_id: chunk.id.clone(),
+            }],
+        })
+    }
+}
diff --git a/arkhe/source/apps/arkhe-ask/src/providers/azure.rs b/arkhe/source/apps/arkhe-ask/src/providers/azure.rs
new file mode 100644
index 00000000..19034a92
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/src/providers/azure.rs
@@ -0,0 +1,244 @@
+//! Azure OpenAI provider — plain reqwest, no SDK.
+//!
+//! The Rust Azure OpenAI SDKs are early versions (`azure-openai-rs 0.1.0`);
+//! the trait is the frontier, so the implementation talks HTTP directly and
+//! stays replaceable. Conventions: `api-key` header (not Bearer), URL
+//! `{endpoint}/openai/deployments/{deployment}/{path}?api-version={version}`.
+//!
+//! `answer` asks for a JSON object (`response_format: json_object`,
+//! temperature 0) and refuses to return a `GeneratedAnswer` with zero
+//! claims — an unverifiable answer is not returned.
+
+use crate::pipeline::{GeneratedAnswer, LlmProvider, StoredChunk};
+use arkhe_rag::ncm_harness::ClaimData;
+use async_trait::async_trait;
+use reqwest::Client;
+use serde::{Deserialize, Serialize};
+use std::time::Duration;
+
+#[derive(Clone)]
+pub struct AzureOpenAiProvider {
+    client: Client,
+    endpoint: String,
+    deployment: String,
+    embedding_deployment: String,
+    api_version: String,
+    api_key: String,
+}
+
+#[derive(Serialize)]
+struct ChatRequest<'a> {
+    messages: Vec<Message<'a>>,
+    temperature: f32,
+    max_tokens: u32,
+    response_format: ResponseFormat,
+}
+
+#[derive(Serialize)]
+struct ResponseFormat {
+    #[serde(rename = "type")]
+    kind: &'static str,
+}
+
+#[derive(Serialize)]
+struct Message<'a> {
+    role: &'a str,
+    content: String,
+}
+
+#[derive(Deserialize)]
+struct ChatResponse {
+    choices: Vec<Choice>,
+}
+
+#[derive(Deserialize)]
+struct Choice {
+    message: ResponseMessage,
+}
+
+#[derive(Deserialize)]
+struct ResponseMessage {
+    content: String,
+}
+
+#[derive(Serialize)]
+struct EmbeddingRequest<'a> {
+    input: &'a str,
+    dimensions: u32,
+}
+
+#[derive(Deserialize)]
+struct EmbeddingResponse {
+    data: Vec<EmbeddingData>,
+}
+
+#[derive(Deserialize)]
+struct EmbeddingData {
+    embedding: Vec<f32>,
+}
+
+#[derive(Deserialize)]
+struct AnswerJson {
+    answer: String,
+    claims: Vec<ClaimData>,
+}
+
+impl AzureOpenAiProvider {
+    /// Test/tooling constructor with explicit configuration.
+    pub fn new(
+        endpoint: &str,
+        deployment: &str,
+        api_version: &str,
+        api_key: &str,
+    ) -> Result<Self, String> {
+        Ok(Self {
+            client: Client::builder()
+                .timeout(Duration::from_secs(30))
+                .build()
+                .map_err(|e| format!("http client: {e}"))?,
+            endpoint: endpoint.trim_end_matches('/').to_string(),
+            deployment: deployment.into(),
+            embedding_deployment: deployment.into(),
+            api_version: api_version.into(),
+            api_key: api_key.into(),
+        })
+    }
+
+    /// From AZURE_OPENAI_ENDPOINT / _DEPLOYMENT / _API_VERSION (default
+    /// 2024-10-21) / _API_KEY.
+    pub fn from_env() -> Result<Self, String> {
+        let missing = |var: &str| format!("{var} not set or empty");
+        let required = |var: &str| {
+            std::env::var(var)
+                .ok()
+                .filter(|v| !v.trim().is_empty())
+                .ok_or_else(|| missing(var))
+        };
+        let endpoint = required("AZURE_OPENAI_ENDPOINT")?;
+        let deployment = required("AZURE_OPENAI_DEPLOYMENT")?;
+        let api_key = required("AZURE_OPENAI_API_KEY")?;
+        let api_version =
+            std::env::var("AZURE_OPENAI_API_VERSION").unwrap_or_else(|_| "2024-10-21".into());
+        let embedding_deployment = required("AZURE_OPENAI_EMBEDDING_DEPLOYMENT")?;
+        Ok(Self::new(&endpoint, &deployment, &api_version, &api_key)?
+            .with_embedding_deployment(&embedding_deployment))
+    }
+
+    /// Select a separate embedding model deployment.
+    pub fn with_embedding_deployment(mut self, deployment: &str) -> Self {
+        self.embedding_deployment = deployment.into();
+        self
+    }
+
+    fn url(&self, path: &str) -> String {
+        let deployment = if path == "embeddings" {
+            &self.embedding_deployment
+        } else {
+            &self.deployment
+        };
+        format!(
+            "{}/openai/deployments/{}/{}?api-version={}",
+            self.endpoint, deployment, path, self.api_version
+        )
+    }
+
+    async fn post_json<T: for<'de> Deserialize<'de>>(
+        &self,
+        url: &str,
+        body: &impl Serialize,
+    ) -> Result<T, String> {
+        let resp = self
+            .client
+            .post(url)
+            .header("api-key", &self.api_key)
+            .json(body)
+            .send()
+            .await
+            .map_err(|e| format!("transport: {e}"))?;
+        let status = resp.status();
+        if !status.is_success() {
+            return Err(format!("upstream status {status}"));
+        }
+        resp.json().await.map_err(|e| format!("parse: {e}"))
+    }
+}
+
+#[async_trait]
+impl LlmProvider for AzureOpenAiProvider {
+    async fn answer(&self, query: &str, chunks: &[StoredChunk]) -> Result<GeneratedAnswer, String> {
+        let context = chunks
+            .iter()
+            .map(|c| format!("[{}] {}", c.id, c.text))
+            .collect::<Vec<_>>()
+            .join("\n");
+        let system = "Answer ONLY with a JSON object {\"answer\": string, \"claims\": \
+                      [{\"text\": string, \"evidence_id\": string}]}. Every claim must cite one of \
+                      the provided chunk ids. Use only facts present in the context.";
+        let user = format!("Context:\n{context}\n\nQuestion: {query}");
+        let body = ChatRequest {
+            messages: vec![
+                Message {
+                    role: "system",
+                    content: system.into(),
+                },
+                Message {
+                    role: "user",
+                    content: user,
+                },
+            ],
+            temperature: 0.0,
+            max_tokens: 512,
+            response_format: ResponseFormat {
+                kind: "json_object",
+            },
+        };
+        let parsed: ChatResponse = self.post_json(&self.url("chat/completions"), &body).await?;
+        let content = parsed
+            .choices
+            .into_iter()
+            .next()
+            .ok_or("no choices")?
+            .message
+            .content;
+        let answer: AnswerJson =
+            serde_json::from_str(&content).map_err(|e| format!("answer json: {e}"))?;
+        if answer.claims.is_empty() {
+            return Err("model returned no claims; refusing unverifiable answer".into());
+        }
+        Ok(GeneratedAnswer {
+            answer: answer.answer,
+            claims: answer.claims,
+        })
+    }
+}
+
+#[async_trait]
+impl crate::pipeline::Embedder for AzureOpenAiProvider {
+    async fn embed(&self, text: &str) -> Result<Vec<f32>, String> {
+        let parsed: EmbeddingResponse = self
+            .post_json(
+                &self.url("embeddings"),
+                &EmbeddingRequest {
+                    input: text,
+                    dimensions: 1536,
+                },
+            )
+            .await?;
+        let embedding = parsed
+            .data
+            .into_iter()
+            .next()
+            .map(|d| d.embedding)
+            .ok_or_else(|| "no embedding".to_string())?;
+        if embedding.len() != 1536 {
+            return Err(format!(
+                "embedding dimension: expected 1536, got {}",
+                embedding.len()
+            ));
+        }
+        if embedding.iter().any(|v| !v.is_finite()) {
+            return Err("embedding contains non-finite values".into());
+        }
+        Ok(embedding)
+    }
+}
diff --git a/arkhe/source/apps/arkhe-ask/src/providers/invariant.rs b/arkhe/source/apps/arkhe-ask/src/providers/invariant.rs
new file mode 100644
index 00000000..59143c1d
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/src/providers/invariant.rs
@@ -0,0 +1,220 @@
+//! Hybrid search over an explicit immutable invariant-text snapshot.
+//! Dense hits must match that snapshot exactly. Roots are local commitments,
+//! not authenticated ontology versions or externally anchored checkpoints.
+use crate::pipeline::{ChunkStore, RetrievalBatch, StoredChunk};
+use arkhe_core::{canonical::encode_value, Digest32};
+use arkhe_rag::retrieval::{Bm25Index, Document, HybridRetriever, OverlapReranker, Reranker};
+use arkhe_verify_core::mmr::{build_root_and_proof, verify_proof_at, ProofStep};
+use async_trait::async_trait;
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeMap;
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct InclusionProof {
+    pub root: [u8; 32],
+    pub leaf_index: usize,
+    pub leaf_count: usize,
+    pub steps: Vec<ProofStep>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ChunkEvidence {
+    pub tenant_id: String,
+    pub id: String,
+    pub text: String,
+    pub content_digest: Digest32,
+    pub inclusion_proof: InclusionProof,
+}
+
+fn leaf(tenant: &str, id: &str, text: &str) -> Vec<u8> {
+    let mut bytes = b"AKG:INVARIANT:RETRIEVAL-CHUNK:v1\0".to_vec();
+    bytes.extend(encode_value(
+        &serde_json::json!({"tenant_id": tenant, "id": id, "text": text}),
+    ));
+    bytes
+}
+
+impl ChunkEvidence {
+    /// Caller must obtain the expected root through an independently trusted channel.
+    pub fn verify(&self, tenant: &str, expected_root: &[u8; 32]) -> bool {
+        let bytes = leaf(&self.tenant_id, &self.id, &self.text);
+        self.tenant_id == tenant
+            && &self.inclusion_proof.root == expected_root
+            && self.content_digest == Digest32::blake3(b"AKG:INVARIANT:CHUNK-DIGEST:v1\0", &bytes)
+            && verify_proof_at(
+                &bytes,
+                self.inclusion_proof.leaf_count,
+                self.inclusion_proof.leaf_index,
+                &self.inclusion_proof.steps,
+                expected_root,
+            )
+            .unwrap_or(false)
+    }
+}
+
+struct TenantSnapshot {
+    retriever: HybridRetriever,
+    leaves: Vec<Vec<u8>>,
+    positions: BTreeMap<String, usize>,
+    root: [u8; 32],
+}
+
+pub struct InvariantRetriever<S> {
+    dense: S,
+    snapshots: BTreeMap<String, TenantSnapshot>,
+}
+
+impl<S: ChunkStore> InvariantRetriever<S> {
+    pub fn new(
+        dense: S,
+        corpus: Vec<StoredChunk>,
+        k1: f64,
+        b: f64,
+        rrf_constant: u32,
+        candidates: usize,
+    ) -> Result<Self, String> {
+        // Validate configuration even when the snapshot is empty.
+        HybridRetriever::new(Bm25Index::new(vec![], k1, b)?, rrf_constant, candidates)?;
+        if corpus.len() > 10_000 {
+            return Err("invariant snapshot exceeds 10000 chunks".into());
+        }
+        let mut tenants = BTreeMap::<String, Vec<Document>>::new();
+        for chunk in corpus {
+            if chunk.tenant_id.trim().is_empty() || chunk.text.len() > 1_048_576 {
+                return Err("invalid tenant or chunk exceeds 1 MiB".into());
+            }
+            tenants.entry(chunk.tenant_id).or_default().push(Document {
+                id: chunk.id,
+                text: chunk.text,
+            });
+        }
+        let mut snapshots = BTreeMap::new();
+        for (tenant, documents) in tenants {
+            let index = Bm25Index::new(documents, k1, b)?;
+            let positions = index
+                .documents()
+                .enumerate()
+                .map(|(i, d)| (d.id.clone(), i))
+                .collect();
+            let leaves: Vec<_> = index
+                .documents()
+                .map(|d| leaf(&tenant, &d.id, &d.text))
+                .collect();
+            let (root, _) =
+                build_root_and_proof(&leaves, 0).map_err(|e| format!("snapshot MMR: {e:?}"))?;
+            snapshots.insert(
+                tenant,
+                TenantSnapshot {
+                    retriever: HybridRetriever::new(index, rrf_constant, candidates)?,
+                    leaves,
+                    positions,
+                    root,
+                },
+            );
+        }
+        Ok(Self { dense, snapshots })
+    }
+
+    pub fn snapshot_root(&self, tenant: &str) -> Option<[u8; 32]> {
+        self.snapshots.get(tenant).map(|s| s.root)
+    }
+
+    async fn search(&self, tenant: &str, query: &str, k: usize) -> Result<RetrievalBatch, String> {
+        if tenant.trim().is_empty() {
+            return Err("tenant_id is required".into());
+        }
+        let mut batch = RetrievalBatch {
+            chunks: vec![],
+            evidence: vec![],
+        };
+        if k == 0 || query.trim().is_empty() {
+            return Ok(batch);
+        }
+        let Some(snapshot) = self.snapshots.get(tenant) else {
+            return Ok(batch);
+        };
+        let dense = match tokio::time::timeout(
+            std::time::Duration::from_secs(5),
+            self.dense
+                .retrieve(tenant, query, snapshot.retriever.candidate_limit()),
+        )
+        .await
+        {
+            Ok(result) => result,
+            Err(_) => Err("dense retrieval timed out".into()),
+        };
+        if let Ok(chunks) = &dense {
+            if chunks.len() > snapshot.retriever.candidate_limit() {
+                return Err("dense ranker exceeded candidate limit".into());
+            }
+            for chunk in chunks {
+                if chunk.tenant_id != tenant
+                    || snapshot
+                        .retriever
+                        .lexical
+                        .document(&chunk.id)
+                        .is_none_or(|d| d.text != chunk.text)
+                {
+                    return Err("dense evidence differs from tenant invariant snapshot".into());
+                }
+            }
+        } else {
+            tracing::warn!("invariant retrieval degraded to lexical: dense ranker unavailable");
+        }
+        let dense_ids = dense.map(|chunks| chunks.into_iter().map(|c| c.id).collect());
+        let fused = snapshot.retriever.retrieve(query, dense_ids)?;
+        let mut ranked = OverlapReranker.rerank(query, fused, &snapshot.retriever.lexical)?;
+        ranked.truncate(k);
+        for hit in ranked {
+            let document = snapshot
+                .retriever
+                .lexical
+                .document(&hit.id)
+                .ok_or("unknown fused document")?;
+            let position = snapshot.positions[&hit.id];
+            let (root, steps) = build_root_and_proof(&snapshot.leaves, position)
+                .map_err(|e| format!("inclusion: {e:?}"))?;
+            batch.chunks.push(StoredChunk {
+                tenant_id: tenant.into(),
+                id: hit.id.clone(),
+                text: document.text.clone(),
+            });
+            batch.evidence.push(ChunkEvidence {
+                tenant_id: tenant.into(),
+                id: hit.id,
+                text: document.text.clone(),
+                content_digest: Digest32::blake3(
+                    b"AKG:INVARIANT:CHUNK-DIGEST:v1\0",
+                    &snapshot.leaves[position],
+                ),
+                inclusion_proof: InclusionProof {
+                    root,
+                    leaf_index: position,
+                    leaf_count: snapshot.leaves.len(),
+                    steps,
+                },
+            });
+        }
+        Ok(batch)
+    }
+}
+
+#[async_trait]
+impl<S: ChunkStore> ChunkStore for InvariantRetriever<S> {
+    async fn retrieve(
+        &self,
+        tenant: &str,
+        query: &str,
+        k: usize,
+    ) -> Result<Vec<StoredChunk>, String> {
+        Ok(self.search(tenant, query, k).await?.chunks)
+    }
+    async fn retrieve_evidenced(
+        &self,
+        tenant: &str,
+        query: &str,
+        k: usize,
+    ) -> Result<RetrievalBatch, String> {
+        self.search(tenant, query, k).await
+    }
+}
diff --git a/arkhe/source/apps/arkhe-ask/src/providers/pgvector.rs b/arkhe/source/apps/arkhe-ask/src/providers/pgvector.rs
new file mode 100644
index 00000000..ff783fec
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/src/providers/pgvector.rs
@@ -0,0 +1,161 @@
+//! pgvector chunk store — sqlx + pgvector 0.4.
+//!
+//! The query is embedded with the injected `Embedder` (the same Azure
+//! provider), then matched with cosine distance (`<=>`) over an HNSW index.
+//! `vector(1536)` matches the explicitly requested 1536 dimensions; a different embedding
+//! dimension requires recreating the table.
+
+use crate::pipeline::{ChunkStore, Embedder, StoredChunk};
+use async_trait::async_trait;
+use pgvector::Vector;
+use sqlx::PgPool;
+use std::sync::Arc;
+
+pub struct PgVectorStore {
+    pool: PgPool,
+    embedder: Arc<dyn Embedder>,
+}
+
+impl PgVectorStore {
+    /// Store that connects (and migrates) on first use, so the synchronous
+    /// startup wiring can be built before an async pool exists. Connection
+    /// or migration failure on first use surfaces as a store error.
+    pub fn lazy(database_url: String, embedder: Arc<dyn Embedder>) -> LazyPgVectorStore {
+        LazyPgVectorStore {
+            database_url,
+            embedder,
+            pool: tokio::sync::OnceCell::new(),
+        }
+    }
+
+    pub fn new(pool: PgPool, embedder: Arc<dyn Embedder>) -> Self {
+        Self { pool, embedder }
+    }
+
+    /// Idempotent: safe on every boot, with or without the initdb script.
+    pub async fn migrate(&self) -> Result<(), String> {
+        sqlx::migrate!("./migrations")
+            .run(&self.pool)
+            .await
+            .map_err(|e| format!("tenant migration: {e}"))?;
+        Ok(())
+    }
+
+    /// Upsert one chunk; embedding comes from the injected embedder.
+    pub async fn insert(&self, tenant_id: &str, id: &str, text: &str) -> Result<(), String> {
+        if tenant_id.trim().is_empty() {
+            return Err("tenant_id is required".into());
+        }
+        let embedding = self.embedder.embed(text).await?;
+        let vector = Vector::from(embedding);
+        sqlx::query(
+            "INSERT INTO chunks (tenant_id, id, text, embedding) VALUES ($1, $2, $3, $4)
+             ON CONFLICT (tenant_id, id) DO UPDATE SET text = EXCLUDED.text, embedding = EXCLUDED.embedding",
+        )
+        .bind(tenant_id)
+        .bind(id)
+        .bind(text)
+        .bind(vector)
+        .execute(&self.pool)
+        .await
+        .map_err(|e| format!("insert: {e}"))?;
+        Ok(())
+    }
+
+    pub fn pool(&self) -> &PgPool {
+        &self.pool
+    }
+}
+
+#[async_trait]
+impl ChunkStore for PgVectorStore {
+    async fn retrieve(
+        &self,
+        tenant_id: &str,
+        query: &str,
+        k: usize,
+    ) -> Result<Vec<StoredChunk>, String> {
+        if tenant_id.trim().is_empty() {
+            return Err("tenant_id is required".into());
+        }
+        let embedding = self.embedder.embed(query).await?;
+        let vector = Vector::from(embedding);
+        let mut tx = self
+            .pool
+            .begin()
+            .await
+            .map_err(|e| format!("query begin: {e}"))?;
+        sqlx::query("SET LOCAL hnsw.iterative_scan = relaxed_order")
+            .execute(&mut *tx)
+            .await
+            .map_err(|e| format!("iterative scan: {e}"))?;
+        let rows: Vec<(String, String, String)> = sqlx::query_as(
+            "WITH nearest AS MATERIALIZED (
+                SELECT tenant_id, id, text, embedding <=> $2 AS distance
+                FROM chunks WHERE tenant_id = $1 ORDER BY embedding <=> $2 LIMIT $3
+             ) SELECT tenant_id, id, text FROM nearest ORDER BY distance + 0",
+        )
+        .bind(tenant_id)
+        .bind(vector)
+        .bind(i64::try_from(k).map_err(|_| "k exceeds database limit")?)
+        .fetch_all(&mut *tx)
+        .await
+        .map_err(|e| format!("query: {e}"))?;
+        tx.commit()
+            .await
+            .map_err(|e| format!("query commit: {e}"))?;
+        Ok(rows
+            .into_iter()
+            .map(|(tenant_id, id, text)| StoredChunk {
+                tenant_id,
+                id,
+                text,
+            })
+            .collect())
+    }
+}
+
+/// First-use-connecting chunk store over pgvector.
+pub struct LazyPgVectorStore {
+    database_url: String,
+    embedder: Arc<dyn Embedder>,
+    pool: tokio::sync::OnceCell<PgPool>,
+}
+
+impl LazyPgVectorStore {
+    async fn connected(&self) -> Result<PgPool, String> {
+        let pool = self
+            .pool
+            .get_or_try_init(|| async {
+                let pool = sqlx::postgres::PgPoolOptions::new()
+                    .max_connections(5)
+                    .connect(&self.database_url)
+                    .await
+                    .map_err(|e| format!("connect: {e}"))?;
+                PgVectorStore::new(pool.clone(), Arc::clone(&self.embedder))
+                    .migrate()
+                    .await?;
+                Ok::<PgPool, String>(pool)
+            })
+            .await?;
+        Ok(pool.clone())
+    }
+}
+
+#[async_trait]
+impl ChunkStore for LazyPgVectorStore {
+    async fn retrieve(
+        &self,
+        tenant_id: &str,
+        query: &str,
+        k: usize,
+    ) -> Result<Vec<StoredChunk>, String> {
+        if tenant_id.trim().is_empty() {
+            return Err("tenant_id is required".into());
+        }
+        let pool = self.connected().await?;
+        PgVectorStore::new(pool, Arc::clone(&self.embedder))
+            .retrieve(tenant_id, query, k)
+            .await
+    }
+}
diff --git a/arkhe/source/apps/arkhe-ask/src/telemetry.rs b/arkhe/source/apps/arkhe-ask/src/telemetry.rs
new file mode 100644
index 00000000..e3a660f1
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/src/telemetry.rs
@@ -0,0 +1,181 @@
+//! Public low-cardinality HTTP metrics and OTLP request/pipeline spans.
+//! Query strings, bodies, JWTs and tenant identifiers are not telemetry attributes.
+use axum::{
+    extract::{MatchedPath, Request},
+    middleware::{self, Next},
+    response::Response,
+    routing::get,
+    Router,
+};
+use axum_prometheus::{EndpointLabel, PrometheusMetricLayerBuilder};
+use metrics_exporter_prometheus::{PrometheusBuilder, PrometheusHandle};
+use opentelemetry::{global, propagation::Extractor, trace::TracerProvider};
+use opentelemetry_sdk::{propagation::TraceContextPropagator, trace::SdkTracerProvider, Resource};
+use std::{collections::HashMap, sync::OnceLock};
+use tracing::Instrument;
+use tracing_opentelemetry::OpenTelemetrySpanExt;
+use tracing_subscriber::{layer::SubscriberExt, util::SubscriberInitExt, EnvFilter};
+
+fn metrics() -> &'static PrometheusHandle {
+    static HANDLE: OnceLock<PrometheusHandle> = OnceLock::new();
+    HANDLE.get_or_init(|| {
+        let handle = PrometheusBuilder::new()
+            .set_buckets_for_metric(
+                metrics_exporter_prometheus::Matcher::Full(
+                    "axum_http_requests_duration_seconds".into(),
+                ),
+                &[
+                    0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0, 30.0,
+                ],
+            )
+            .expect("valid metric buckets")
+            .install_recorder()
+            .expect("metrics recorder already installed");
+        metrics::describe_counter!(
+            "arkhe_gate_decisions_total",
+            "Citation support gate outcomes, independent of HTTP journal success"
+        );
+        handle
+    })
+}
+pub fn instrument(app: Router) -> Router {
+    let handle = metrics().clone();
+    let layer = PrometheusMetricLayerBuilder::new()
+        .with_endpoint_label_type(EndpointLabel::MatchedPathWithFallbackFn(|_| {
+            "unmatched".into()
+        }))
+        .build();
+    app.route(
+        "/metrics",
+        get(move || {
+            let handle = handle.clone();
+            async move {
+                handle.run_upkeep();
+                (
+                    [(
+                        axum::http::header::CONTENT_TYPE,
+                        "text/plain; version=0.0.4; charset=utf-8",
+                    )],
+                    handle.render(),
+                )
+            }
+        }),
+    )
+    .layer(layer)
+    .layer(middleware::from_fn(http_span))
+}
+struct Headers<'a>(&'a axum::http::HeaderMap);
+impl Extractor for Headers<'_> {
+    fn get(&self, key: &str) -> Option<&str> {
+        self.0.get(key).and_then(|v| v.to_str().ok())
+    }
+    fn keys(&self) -> Vec<&str> {
+        self.0.keys().map(|k| k.as_str()).collect()
+    }
+}
+async fn http_span(request: Request, next: Next) -> Response {
+    let route = request
+        .extensions()
+        .get::<MatchedPath>()
+        .map(MatchedPath::as_str)
+        .unwrap_or("unmatched");
+    let method = match request.method().as_str() {
+        "GET" | "HEAD" | "POST" | "PUT" | "DELETE" | "CONNECT" | "OPTIONS" | "TRACE" | "PATCH" => {
+            request.method().as_str()
+        }
+        _ => "_OTHER",
+    };
+    let span_method = if method == "_OTHER" { "HTTP" } else { method };
+    let name = if route == "unmatched" {
+        span_method.to_string()
+    } else {
+        format!("{span_method} {route}")
+    };
+    let span = tracing::info_span!("http.server",
+        otel.name=%name, otel.kind="server", http.request.method=method, http.route=route,
+        http.response.status_code=tracing::field::Empty, otel.status_code=tracing::field::Empty);
+    let parent = global::get_text_map_propagator(|p| p.extract(&Headers(request.headers())));
+    let _ = span.set_parent(parent);
+    let response = next.run(request).instrument(span.clone()).await;
+    span.record(
+        "http.response.status_code",
+        response.status().as_u16() as i64,
+    );
+    if response.status().is_server_error() {
+        span.record("otel.status_code", "ERROR");
+    }
+    response
+}
+pub async fn init() -> Result<Option<SdkTracerProvider>, String> {
+    let filter =
+        EnvFilter::try_from_default_env().unwrap_or_else(|_| EnvFilter::new("arkhe_ask=info"));
+    let fmt = tracing_subscriber::fmt::layer()
+        .json()
+        .with_current_span(false)
+        .with_span_list(false);
+    let endpoint = std::env::var("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT")
+        .ok()
+        .filter(|s| !s.trim().is_empty());
+    if let Some(endpoint) = endpoint {
+        use opentelemetry_otlp::WithExportConfig;
+        let exporter = tokio::task::spawn_blocking(move || {
+            opentelemetry_otlp::SpanExporter::builder()
+                .with_http()
+                .with_endpoint(endpoint)
+                .with_timeout(std::time::Duration::from_secs(5))
+                .build()
+                .map_err(|e| e.to_string())
+        })
+        .await
+        .map_err(|e| e.to_string())??;
+        let service = std::env::var("OTEL_SERVICE_NAME").unwrap_or_else(|_| "arkhe-ask".into());
+        let provider = SdkTracerProvider::builder()
+            .with_batch_exporter(exporter)
+            .with_resource(Resource::builder().with_service_name(service).build())
+            .build();
+        let tracer = provider.tracer("arkhe-ask");
+        global::set_tracer_provider(provider.clone());
+        global::set_text_map_propagator(TraceContextPropagator::new());
+        tracing_subscriber::registry()
+            .with(filter)
+            .with(fmt)
+            .with(tracing_opentelemetry::layer().with_tracer(tracer))
+            .try_init()
+            .map_err(|e| e.to_string())?;
+        Ok(Some(provider))
+    } else {
+        tracing_subscriber::registry()
+            .with(filter)
+            .with(fmt)
+            .try_init()
+            .map_err(|e| e.to_string())?;
+        Ok(None)
+    }
+}
+pub async fn shutdown_signal() {
+    #[cfg(unix)]
+    {
+        let mut terminate =
+            tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
+                .expect("SIGTERM handler");
+        tokio::select! {_=tokio::signal::ctrl_c()=>{},_=terminate.recv()=>{}}
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = tokio::signal::ctrl_c().await;
+    }
+}
+
+/// Whitelisted W3C metadata only; it is persisted independently of proof commitments.
+pub fn capture_context() -> HashMap<String, String> {
+    let mut context = HashMap::new();
+    global::get_text_map_propagator(|p| {
+        p.inject_context(&tracing::Span::current().context(), &mut context)
+    });
+    context.retain(|k, v| matches!(k.as_str(), "traceparent" | "tracestate") && v.len() <= 512);
+    context
+}
+pub fn restore_parent(span: &tracing::Span, context: &HashMap<String, String>) {
+    let parent = global::get_text_map_propagator(|p| p.extract(context));
+    let _ = span.set_parent(parent);
+}
diff --git a/arkhe/source/apps/arkhe-ask/tests/ask_e2e.rs b/arkhe/source/apps/arkhe-ask/tests/ask_e2e.rs
new file mode 100644
index 00000000..ffebbd2c
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/tests/ask_e2e.rs
@@ -0,0 +1,187 @@
+//! AKG-ASK-0001 e2e — the real router over the real pipeline, with trait
+//! doubles at the two external frontiers (store, LLM) and the real
+//! `CitationVerifier` in between.
+//!
+//! The two tests that matter for the portfolio story:
+//! - a grounded answer passes with a citation proof;
+//! - a hallucinating LLM is REFUSED with 422 and returns nothing.
+
+use arkhe_ask::pipeline::{GeneratedAnswer, LlmProvider, StoredChunk};
+use arkhe_ask::providers::{EchoProvider, InMemoryStore};
+use arkhe_ask::router;
+use arkhe_rag::ncm_harness::ClaimData;
+use async_trait::async_trait;
+use axum::body::Body;
+use axum::http::{header, Request, StatusCode};
+use axum::response::Response;
+use http_body_util::BodyExt;
+use tower::ServiceExt;
+
+/// Always claims "Sydney is the capital of Australia" citing e1, whatever
+/// the evidence actually says — the hallucination the verifier exists to
+/// catch.
+struct HallucinatingProvider;
+
+#[async_trait]
+impl LlmProvider for HallucinatingProvider {
+    async fn answer(
+        &self,
+        _query: &str,
+        _chunks: &[StoredChunk],
+    ) -> Result<GeneratedAnswer, String> {
+        Ok(GeneratedAnswer {
+            answer: "Sydney is the capital of Australia.".into(),
+            claims: vec![ClaimData {
+                text: "Sydney is the capital of Australia".into(),
+                evidence_id: "e1".into(),
+            }],
+        })
+    }
+}
+
+async fn body_json(response: Response) -> serde_json::Value {
+    let bytes = response
+        .into_body()
+        .collect()
+        .await
+        .expect("read body")
+        .to_bytes();
+    serde_json::from_slice(&bytes).expect("json body")
+}
+
+fn ask_request(query: &str, tenant: Option<&str>) -> Request<Body> {
+    let mut builder = Request::post("/v1/ask").header(header::CONTENT_TYPE, "application/json");
+    if let Some(tenant) = tenant {
+        builder = builder.header("x-tenant-id", tenant);
+    }
+    builder
+        .body(Body::from(serde_json::json!({"query": query}).to_string()))
+        .unwrap()
+}
+
+fn store_with(chunk_text: &str) -> InMemoryStore {
+    InMemoryStore {
+        chunks: vec![StoredChunk {
+            tenant_id: "demo-tenant".into(),
+            id: "e1".into(),
+            text: chunk_text.into(),
+        }],
+    }
+}
+
+#[tokio::test]
+async fn grounded_answer_returns_with_citation_proof() {
+    let app = router(
+        Box::new(store_with("Sydney is the capital of Australia.")),
+        Box::new(EchoProvider),
+    );
+    let response = app
+        .oneshot(ask_request("capital of Australia", Some("demo-tenant")))
+        .await
+        .unwrap();
+    assert_eq!(response.status(), StatusCode::OK);
+    let body = body_json(response).await;
+    assert_eq!(
+        body["citation_proof"]["evidence_ids"],
+        serde_json::json!(["e1"])
+    );
+    assert_eq!(
+        body["citation_proof"]["record_digest"]
+            .as_array()
+            .map(|a| a.len()),
+        Some(32)
+    );
+    assert_eq!(body["claims"][0]["evidence_id"], "e1");
+}
+
+#[tokio::test]
+async fn hallucinated_entity_is_refused_with_nothing() {
+    // Evidence says Melbourne; the LLM claims Sydney citing it.
+    let app = router(
+        Box::new(store_with("Melbourne is the capital of Australia.")),
+        Box::new(HallucinatingProvider),
+    );
+    let response = app
+        .oneshot(ask_request("capital of Australia", Some("demo-tenant")))
+        .await
+        .unwrap();
+    assert_eq!(response.status(), StatusCode::UNPROCESSABLE_ENTITY);
+    let body = body_json(response).await;
+    assert_eq!(body["error"], "unsupported_claim");
+    assert_eq!(body["entity"], "Sydney");
+    assert!(body.get("claims").is_none(), "no claims may be returned");
+    assert!(body.get("answer").is_none(), "no answer may be returned");
+}
+
+#[tokio::test]
+async fn missing_tenant_is_unauthorized() {
+    let app = router(
+        Box::new(store_with("Sydney is the capital of Australia.")),
+        Box::new(EchoProvider),
+    );
+    let response = app
+        .oneshot(ask_request("capital of Australia", None))
+        .await
+        .unwrap();
+    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
+}
+
+#[tokio::test]
+async fn empty_query_is_bad_request() {
+    let app = router(
+        Box::new(store_with("Sydney is the capital of Australia.")),
+        Box::new(EchoProvider),
+    );
+    let response = app
+        .oneshot(ask_request("   ", Some("demo-tenant")))
+        .await
+        .unwrap();
+    assert_eq!(response.status(), StatusCode::BAD_REQUEST);
+}
+
+#[tokio::test]
+async fn pipeline_refuses_a_store_that_returns_another_tenants_chunk() {
+    struct LeakingStore;
+    #[async_trait]
+    impl arkhe_ask::pipeline::ChunkStore for LeakingStore {
+        async fn retrieve(&self, _: &str, _: &str, _: usize) -> Result<Vec<StoredChunk>, String> {
+            Ok(vec![StoredChunk {
+                tenant_id: "other".into(),
+                id: "secret".into(),
+                text: "Secret evidence.".into(),
+            }])
+        }
+    }
+    let result = arkhe_ask::pipeline::AskPipeline::new(LeakingStore, EchoProvider)
+        .ask("demo-tenant", "evidence")
+        .await;
+    assert!(matches!(
+        result,
+        Err(arkhe_ask::pipeline::AskError::Store(_))
+    ));
+}
+
+#[tokio::test]
+async fn tenant_scoping_changes_proof_digest_even_for_identical_claims() {
+    let pipeline = arkhe_ask::pipeline::AskPipeline::new(
+        InMemoryStore {
+            chunks: ["tenant-a", "tenant-b"]
+                .into_iter()
+                .map(|tenant| StoredChunk {
+                    tenant_id: tenant.into(),
+                    id: "e1".into(),
+                    text: "Melbourne is in Victoria.".into(),
+                })
+                .collect(),
+        },
+        EchoProvider,
+    );
+    let a = pipeline.ask("tenant-a", "evidence").await.unwrap();
+    let b = pipeline.ask("tenant-b", "evidence").await.unwrap();
+    assert_eq!(a.citation_proof.tenant_id, "tenant-a");
+    assert_eq!(b.citation_proof.tenant_id, "tenant-b");
+    assert_ne!(
+        a.citation_proof.record_digest,
+        b.citation_proof.record_digest
+    );
+}
diff --git a/arkhe/source/apps/arkhe-ask/tests/auth.rs b/arkhe/source/apps/arkhe-ask/tests/auth.rs
new file mode 100644
index 00000000..22c9df59
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/tests/auth.rs
@@ -0,0 +1,218 @@
+use arkhe_ask::{
+    auth::{self, KeycloakAuth, Tenant},
+    pipeline::StoredChunk,
+    providers::{EchoProvider, InMemoryStore},
+    router_with_auth,
+};
+use axum::{
+    body::Body,
+    extract::Extension,
+    http::{Request, StatusCode},
+    middleware,
+    routing::get,
+    Json, Router,
+};
+use http_body_util::BodyExt;
+use jsonwebtoken::{encode, Algorithm, EncodingKey, Header};
+use serde_json::{json, Value};
+use std::time::{SystemTime, UNIX_EPOCH};
+use tower::ServiceExt;
+
+async fn setup() -> (Router, String) {
+    setup_with_store(Box::new(InMemoryStore {
+        chunks: vec![StoredChunk {
+            tenant_id: "tenant-a".into(),
+            id: "e1".into(),
+            text: "Melbourne is in Victoria.".into(),
+        }],
+    }))
+    .await
+}
+
+async fn setup_with_store(store: Box<dyn arkhe_ask::pipeline::ChunkStore>) -> (Router, String) {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let server = format!("http://{}", listener.local_addr().unwrap());
+    let issuer = format!("{server}/realms/test");
+    let metadata = json!({"issuer": issuer, "authorization_endpoint": format!("{server}/auth"),
+        "jwks_uri": format!("{server}/keys"), "response_types_supported": ["code"],
+        "subject_types_supported": ["public"], "id_token_signing_alg_values_supported": ["RS256"]});
+    let keys: Value = serde_json::from_str(include_str!("fixtures/jwks.json")).unwrap();
+    let oidc = Router::new()
+        .route(
+            "/realms/test/.well-known/openid-configuration",
+            get(move || async move { Json(metadata) }),
+        )
+        .route("/keys", get(move || async move { Json(keys) }));
+    tokio::spawn(async move {
+        axum::serve(listener, oidc).await.unwrap();
+    });
+    let auth = KeycloakAuth::connect(&server, "test", "arkhe-ask")
+        .await
+        .unwrap();
+    let app = router_with_auth(store, Box::new(EchoProvider), auth.clone());
+    // Test-only probe proves the exact tenant placed in request extensions.
+    let probe = Router::new()
+        .route(
+            "/tenant",
+            get(|Extension(Tenant(tenant)): Extension<Tenant>| async move { tenant }),
+        )
+        .route_layer(middleware::from_fn_with_state(auth, auth::authenticate));
+    (app.merge(probe), issuer)
+}
+
+fn claims(issuer: &str) -> Value {
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_secs();
+    json!({"iss":issuer,"aud":"arkhe-ask","sub":"service-account","jti":"test",
+        "iat":now,"exp":now+300,"typ":"Bearer","azp":"test-client","tenant_id":"tenant-a"})
+}
+
+fn sign(claims: &Value) -> String {
+    let mut header = Header::new(Algorithm::RS256);
+    header.kid = Some("test".into());
+    encode(
+        &header,
+        claims,
+        &EncodingKey::from_rsa_pem(include_bytes!("fixtures/test-only-rsa.pem")).unwrap(),
+    )
+    .unwrap()
+}
+
+fn request(token: Option<&str>, path: &str) -> Request<Body> {
+    let mut req = Request::builder()
+        .method(if path == "/v1/ask" { "POST" } else { "GET" })
+        .uri(path)
+        .header("content-type", "application/json")
+        .header("x-tenant-id", "spoofed");
+    if let Some(token) = token {
+        req = req.header("authorization", format!("Bearer {token}"));
+    }
+    req.body(Body::from(r#"{"query":"evidence"}"#)).unwrap()
+}
+
+#[tokio::test]
+async fn jwt_tenant_overrides_untrusted_header_and_health_is_public() {
+    let (app, issuer) = setup().await;
+    let token = sign(&claims(&issuer));
+    let response = app
+        .clone()
+        .oneshot(request(Some(&token), "/tenant"))
+        .await
+        .unwrap();
+    assert_eq!(response.status(), StatusCode::OK);
+    assert_eq!(
+        response.into_body().collect().await.unwrap().to_bytes(),
+        "tenant-a"
+    );
+    assert_eq!(
+        app.clone()
+            .oneshot(request(Some(&token), "/v1/ask"))
+            .await
+            .unwrap()
+            .status(),
+        StatusCode::OK
+    );
+    assert_eq!(
+        app.oneshot(request(None, "/healthz"))
+            .await
+            .unwrap()
+            .status(),
+        StatusCode::OK
+    );
+}
+
+#[tokio::test]
+async fn invalid_tokens_never_reach_the_pipeline() {
+    let (app, issuer) = setup().await;
+    let base = claims(&issuer);
+    let mut cases = vec![("missing", None), ("malformed", Some("not-a-jwt".into()))];
+    for (name, field, value) in [
+        ("issuer", "iss", json!("https://other/realms/test")),
+        ("audience", "aud", json!("other-service")),
+        ("expired", "exp", json!(1)),
+        ("future", "nbf", json!(u64::MAX / 2)),
+        ("tenant-empty", "tenant_id", json!(" ")),
+        ("tenant-type", "tenant_id", json!(123)),
+        ("id-token", "typ", json!("ID")),
+        ("subject", "sub", json!("")),
+    ] {
+        let mut altered = base.clone();
+        altered[field] = value;
+        cases.push((name, Some(sign(&altered))));
+    }
+    let mut missing = base.clone();
+    missing.as_object_mut().unwrap().remove("tenant_id");
+    cases.push(("tenant-missing", Some(sign(&missing))));
+    let valid = sign(&base);
+    let parts: Vec<_> = valid.split('.').collect();
+    cases.push((
+        "signature",
+        Some(format!(
+            "{}.{}.{}",
+            parts[0],
+            parts[1],
+            "a".repeat(parts[2].len())
+        )),
+    ));
+    for (name, token) in cases {
+        let response = app
+            .clone()
+            .oneshot(request(token.as_deref(), "/v1/ask"))
+            .await
+            .unwrap();
+        assert_eq!(response.status(), StatusCode::UNAUTHORIZED, "case {name}");
+        let body = response.into_body().collect().await.unwrap().to_bytes();
+        let json: Value = serde_json::from_slice(&body).unwrap();
+        assert_eq!(json, json!({"error":"unauthorized"}), "case {name}");
+    }
+}
+
+#[tokio::test]
+#[ignore = "requires a live pgvector Postgres"]
+async fn jwt_tenant_scopes_real_pgvector_evidence_despite_spoofed_header() {
+    use arkhe_ask::{pipeline::Embedder, providers::pgvector::PgVectorStore};
+    use std::sync::Arc;
+    struct Fixed;
+    #[async_trait::async_trait]
+    impl Embedder for Fixed {
+        async fn embed(&self, _: &str) -> Result<Vec<f32>, String> {
+            let mut vector = vec![0.0; 1536];
+            vector[0] = 1.0;
+            Ok(vector)
+        }
+    }
+    let pool = sqlx::postgres::PgPoolOptions::new()
+        .max_connections(1)
+        .connect(&std::env::var("DATABASE_URL").expect("DATABASE_URL"))
+        .await
+        .unwrap();
+    sqlx::query("CREATE TEMP TABLE chunks (tenant_id TEXT NOT NULL, id TEXT NOT NULL, text TEXT NOT NULL, embedding vector(1536) NOT NULL, PRIMARY KEY(tenant_id,id))")
+        .execute(&pool).await.unwrap();
+    let store = PgVectorStore::new(pool.clone(), Arc::new(Fixed));
+    store
+        .insert("tenant-a", "same", "Melbourne is in Victoria.")
+        .await
+        .unwrap();
+    store
+        .insert("tenant-b", "same", "Sydney is in Australia.")
+        .await
+        .unwrap();
+    let (app, issuer) = setup_with_store(Box::new(store)).await;
+    for (tenant, expected) in [("tenant-a", "Melbourne"), ("tenant-b", "Sydney")] {
+        let mut payload = claims(&issuer);
+        payload["tenant_id"] = json!(tenant);
+        let response = app
+            .clone()
+            .oneshot(request(Some(&sign(&payload)), "/v1/ask"))
+            .await
+            .unwrap();
+        assert_eq!(response.status(), StatusCode::OK);
+        let bytes = response.into_body().collect().await.unwrap().to_bytes();
+        let body: Value = serde_json::from_slice(&bytes).unwrap();
+        assert!(body["answer"].as_str().unwrap().starts_with(expected));
+        assert_eq!(body["citation_proof"]["tenant_id"], tenant);
+    }
+    pool.close().await;
+}
diff --git a/arkhe/source/apps/arkhe-ask/tests/crash_recovery.rs b/arkhe/source/apps/arkhe-ask/tests/crash_recovery.rs
new file mode 100644
index 00000000..28c377f2
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/tests/crash_recovery.rs
@@ -0,0 +1,201 @@
+mod support;
+use arkhe_ask::{
+    events::{KafkaBus, PgProofJournal},
+    pipeline::StoredChunk,
+    providers::{EchoProvider, InMemoryStore},
+    router_with_journal,
+};
+use axum::{
+    body::Body,
+    http::{Request, StatusCode},
+};
+use http_body_util::BodyExt;
+use opentelemetry::{global, trace::TracerProvider};
+use opentelemetry_sdk::{
+    propagation::TraceContextPropagator,
+    trace::{InMemorySpanExporter, SdkTracerProvider},
+};
+use std::sync::Arc;
+use tower::ServiceExt;
+use tracing_subscriber::layer::SubscriberExt;
+
+const TRACE: &str = "11112222333344445555666677778888";
+const TEST: &str = "crash_between_enqueue_and_publish_keeps_trace_context";
+
+fn tracing_setup() -> (SdkTracerProvider, InMemorySpanExporter) {
+    global::set_text_map_propagator(TraceContextPropagator::new());
+    let exporter = InMemorySpanExporter::default();
+    let provider = SdkTracerProvider::builder()
+        .with_simple_exporter(exporter.clone())
+        .build();
+    let subscriber = tracing_subscriber::registry()
+        .with(tracing_opentelemetry::layer().with_tracer(provider.tracer("process-crash-test")));
+    tracing::subscriber::set_global_default(subscriber).unwrap();
+    (provider, exporter)
+}
+
+#[tokio::test]
+#[ignore = "requires Postgres, real Kafka and a fresh KAFKA_CRASH_TEST_TOPIC; terminates only its own helper subprocess"]
+async fn crash_between_enqueue_and_publish_keeps_trace_context() {
+    if std::env::var("ARKHE_CRASH_CHILD").as_deref() == Ok("enqueue-then-exit") {
+        let schema = std::env::var("ARKHE_TEST_SCHEMA").unwrap();
+        assert!(
+            schema.starts_with("ask_event_test_")
+                && schema
+                    .bytes()
+                    .all(|c| c.is_ascii_alphanumeric() || c == b'_')
+        );
+        let (_provider, _exporter) = tracing_setup();
+        let path = format!("SET search_path TO {schema}, public");
+        let pool = sqlx::postgres::PgPoolOptions::new()
+            .max_connections(2)
+            .after_connect(move |conn, _| {
+                let path = path.clone();
+                Box::pin(async move {
+                    sqlx::query(&path).execute(conn).await?;
+                    Ok(())
+                })
+            })
+            .connect(&std::env::var("DATABASE_URL").unwrap())
+            .await
+            .unwrap();
+        let journal = Arc::new(PgProofJournal::connect(pool).await.unwrap());
+        let app = router_with_journal(
+            Box::new(InMemoryStore {
+                chunks: vec![StoredChunk {
+                    tenant_id: "tenant-a".into(),
+                    id: "e1".into(),
+                    text: "Melbourne is in Victoria.".into(),
+                }],
+            }),
+            Box::new(EchoProvider),
+            None,
+            journal.clone(),
+        );
+        let request = Request::post("/v1/ask")
+            .header("content-type", "application/json")
+            .header("x-tenant-id", "tenant-a")
+            .header("traceparent", format!("00-{TRACE}-0123456789abcdef-01"))
+            .body(Body::from(r#"{"query":"evidence"}"#))
+            .unwrap();
+        let response = app.oneshot(request).await.unwrap();
+        assert_eq!(response.status(), StatusCode::OK);
+        response.into_body().collect().await.unwrap();
+        // The HTTP handler awaited the outbox INSERT. No relay exists in this
+        // process. Deliberately bypass Rust drops, runtime and SDK shutdown.
+        std::process::exit(73);
+    }
+
+    let (journal, admin, schema) = support::fixture().await;
+    let executable = std::env::current_exe().unwrap();
+    let child_schema = schema.clone();
+    let output = tokio::task::spawn_blocking(move || {
+        std::process::Command::new(executable)
+            .args(["--exact", TEST, "--ignored", "--nocapture"])
+            .env("ARKHE_CRASH_CHILD", "enqueue-then-exit")
+            .env("ARKHE_TEST_SCHEMA", child_schema)
+            .output()
+            .unwrap()
+    })
+    .await
+    .unwrap();
+    assert_eq!(
+        output.status.code(),
+        Some(73),
+        "helper did not reach the crash point: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let (pending,): (i64,) =
+        sqlx::query_as("SELECT count(*) FROM ask_verified_outbox WHERE published_at IS NULL")
+            .fetch_one(journal.pool())
+            .await
+            .unwrap();
+    let (context,): (serde_json::Value,) =
+        sqlx::query_as("SELECT trace_context FROM ask_verified_outbox")
+            .fetch_one(journal.pool())
+            .await
+            .unwrap();
+    let parent = context["traceparent"]
+        .as_str()
+        .unwrap()
+        .split('-')
+        .nth(2)
+        .unwrap()
+        .to_string();
+    assert!(context["traceparent"].as_str().unwrap().contains(TRACE));
+    assert_eq!(pending, 1);
+    let (pool, old_graph) = (journal.pool().clone(), journal.graph.clone());
+    drop(journal);
+    drop(old_graph);
+    let (provider, exporter) = tracing_setup();
+    let recovered = PgProofJournal::connect(pool).await.unwrap();
+    let bus = KafkaBus::connect(
+        std::env::var("KAFKA_BROKERS")
+            .unwrap()
+            .split(',')
+            .map(str::to_string)
+            .collect(),
+        std::env::var("KAFKA_CRASH_TEST_TOPIC").expect("fresh crash topic"),
+    )
+    .await
+    .unwrap();
+    let before = bus
+        .partition
+        .get_offset(rskafka::client::partition::OffsetAt::Latest)
+        .await
+        .unwrap();
+    assert_eq!(before, 0, "topic must be empty before recovery");
+    assert!(recovered.relay_once(&bus).await.unwrap());
+    assert_eq!(recovered.consume_once(&bus).await.unwrap(), 1);
+    let (anchors,): (i64,) = sqlx::query_as("SELECT count(*) FROM ask_proof_anchors")
+        .fetch_one(recovered.pool())
+        .await
+        .unwrap();
+    assert_eq!(anchors, 1);
+    let (records, _) = bus
+        .partition
+        .fetch_records(0, 1..1_048_576, 100)
+        .await
+        .unwrap();
+    assert_eq!(records.len(), 1);
+    let header = String::from_utf8(records[0].record.headers["traceparent"].clone()).unwrap();
+    assert!(header.contains(TRACE));
+    provider.force_flush().unwrap();
+    let spans = exporter.get_finished_spans().unwrap();
+    let find = |name: &str| {
+        spans
+            .iter()
+            .find(|s| s.name == name && s.span_context.trace_id().to_string() == TRACE)
+            .unwrap()
+    };
+    let publish = find("arkhe.ask.proof.publish");
+    let consume = find("arkhe.ask.proof.consume");
+    let anchor = find("arkhe.ask.proof.anchor");
+    assert_eq!(publish.parent_span_id.to_string(), parent);
+    assert_eq!(consume.parent_span_id, publish.span_context.span_id());
+    assert_eq!(anchor.parent_span_id, consume.span_context.span_id());
+    let tree: Vec<_> = [publish, consume, anchor]
+        .iter()
+        .map(|s| {
+            serde_json::json!({
+                "name":s.name,"span_id":s.span_context.span_id().to_string(),
+                "parent_span_id":s.parent_span_id.to_string()
+            })
+        })
+        .collect();
+    let evidence = serde_json::json!({
+        "scenario":"helper process exits after committed HTTP enqueue and before any publish",
+        "child_exit_code":73,"rust_destructors_and_sdk_shutdown_bypassed":true,
+        "pending_after_child_exit":pending,"kafka_records_before_recovery":before,
+        "kafka_records_after_recovery":records.len(),"durable_anchors_after_recovery":anchors,
+        "trace_id":TRACE,"persisted_enqueue_span_id":parent,"kafka_traceparent":header,
+        "recovered_span_tree":tree,
+        "limits":"process termination with database and broker kept running; not broker outage, power failure or guaranteed export of pre-crash spans"
+    });
+    if let Ok(path) = std::env::var("ARKHE_CRASH_EVIDENCE_PATH") {
+        std::fs::write(path, serde_json::to_vec_pretty(&evidence).unwrap()).unwrap();
+    }
+    support::cleanup(&recovered, admin, schema).await;
+    provider.shutdown().unwrap();
+    eprintln!("Process crash recovery verified: {evidence}");
+}
