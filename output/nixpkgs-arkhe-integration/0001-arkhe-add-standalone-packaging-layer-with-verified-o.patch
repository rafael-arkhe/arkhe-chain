@@ -0,0 +1,45 @@
+# Core golden vectors v1
+
+From the workspace root, run:
+
+```powershell
+cargo run --offline -p arkhe-core --example golden-vectors-v1 | Set-Content -Encoding utf8 golden-vectors-v1.json
+cargo test --offline -p arkhe-core --test golden_vectors
+python scripts/generate_core_conformance_vectors.py --check
+cargo test --offline -p arkhe-core --example golden-vectors-v1
+```
+
+The exporter computes canonical CBOR and domain-separated object digests with
+`arkhe-core`. Before emitting any JSON, it compares every result against the
+independent Python fixtures in `tests/golden_vectors.json` and
+`tests/classification_vectors.json`, plus `tests/core_conformance_vectors.json`.
+The last file is reproducible with `scripts/generate_core_conformance_vectors.py`.
+Unknown components, duplicate IDs, and
+reference mismatches abort the export. The independent fixtures are not updated.
+Output is deterministic and contains no generation timestamp.
+
+Scope: WorkIntent, WorkerExecutionRecord (including optional classification and
+10,000 evidence references), and the proposed Unity MatchSummary v1. Every row
+has `expected: ACCEPT|REJECT` and `status: READY` after successful validation.
+Rejections have a descriptive `rejection_reason` and no `expected_output`.
+The exporter checks rejection via typed deserialization and, for MatchSummary,
+explicit version/survival bounds validation before encoding. It does not use a
+panic from the generic CBOR encoder as a rejection result.
+
+WorkIntent and WER now reject unknown top-level JSON fields. WER JSON parsing
+rejects confidence outside 0..10000 (null/missing remain accepted). Rust code
+constructing WER directly must still enforce the semantic range itself; this
+change validates deserialization, not every possible in-memory construction.
+
+MatchSummary mirrors the fields in Unity `MatchSubmissionGate.cs`, with snake_case
+JSON names and all five 32-byte commitments encoded as CBOR byte strings. Domain:
+`AKG:MATCH_SUMMARY:v1\0`. This defines a proposed core encoding reference; it does
+not implement Unity's `ICanonicalMatchCodec` or align the separate backend replay
+summary. Summary fields have fixed size; no events field or large-payload summary
+is introduced. `WER-large-refs-10k` supplies the array stress reference instead.
+No C#↔WASM marshaling or heap execution is established by these Rust/Python checks.
+
+These vectors check serialization and digest compatibility for concrete
+inputs. They do not establish executor identity, authorization, runtime policy
+enforcement, or correct execution. This core export does not claim conformance to
+the separate MMR vector schema, which requires an MMR profile reference.
diff --git a/arkhe/source/kernel/arkhe-core/examples/golden-vectors-v1.rs b/arkhe/source/kernel/arkhe-core/examples/golden-vectors-v1.rs
new file mode 100644
index 00000000..458f4421
--- /dev/null
+++ b/arkhe/source/kernel/arkhe-core/examples/golden-vectors-v1.rs
@@ -0,0 +1,137 @@
+//! Export core vectors only after checking the independent reference.
+//! cargo run -p arkhe-core --example golden-vectors-v1 > golden-vectors-v1.json
+use arkhe_core::{
+    match_summary::MatchSummary, work::WorkIntent, worker::WorkerExecutionRecord, CanonicalEncode,
+};
+use serde::de::DeserializeOwned;
+use serde_json::Value;
+
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+fn generate<T: CanonicalEncode + DeserializeOwned>(
+    row: &mut Value,
+    validate: impl Fn(&T) -> Result<(), String>,
+) {
+    assert_eq!(hex(T::DOMAIN_OBJECT), row["domain_hex"], "domain mismatch");
+    let parsed = serde_json::from_value::<T>(row["input"].clone())
+        .map_err(|error| error.to_string())
+        .and_then(|object| validate(&object).map(|()| object));
+    if row["expected"] == "REJECT" {
+        assert!(parsed.is_err(), "accepted rejection vector: {}", row["id"]);
+        assert!(
+            row.get("expected_output").is_none(),
+            "rejection must not have encoded output"
+        );
+        row["status"] = "READY".into();
+        return;
+    }
+    assert_eq!(row["expected"], "ACCEPT", "unknown vector expectation");
+    let object = parsed.expect("valid reference input");
+    let expected = serde_json::json!({
+        "canonical_cbor_hex": hex(&object.canonical_bytes()),
+        "object_digest_hex": object.object_digest().to_hex(),
+    });
+    for key in ["canonical_cbor_hex", "object_digest_hex"] {
+        assert_eq!(
+            expected[key], row["expected_output"][key],
+            "reference mismatch: {} / {key}",
+            row["id"]
+        );
+    }
+    row["expected_output"] = expected;
+    row["status"] = "READY".into();
+}
+
+fn main() {
+    let mut document: Value =
+        serde_json::from_str(include_str!("../../../tests/golden_vectors.json")).unwrap();
+    let classifications: Value =
+        serde_json::from_str(include_str!("../../../tests/classification_vectors.json")).unwrap();
+    let rows = document["vectors"].as_array_mut().unwrap();
+    rows.extend(
+        classifications["vectors"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .cloned(),
+    );
+    let conformance: Value =
+        serde_json::from_str(include_str!("../../../tests/core_conformance_vectors.json")).unwrap();
+    rows.extend(conformance["vectors"].as_array().unwrap().iter().cloned());
+    assert!(!rows.is_empty(), "empty reference corpus");
+    let mut ids = std::collections::BTreeSet::new();
+    for row in rows {
+        if row.get("expected").is_none() {
+            row["expected"] = "ACCEPT".into();
+        }
+        assert!(
+            ids.insert(row["id"].as_str().unwrap().to_owned()),
+            "duplicate vector ID"
+        );
+        match row["component"].as_str().unwrap() {
+            "WorkIntent" => generate::<WorkIntent>(row, |_| Ok(())),
+            "WorkerExecutionRecord" => generate::<WorkerExecutionRecord>(row, |_| Ok(())),
+            "MatchSummary" => {
+                generate::<MatchSummary>(row, |summary| summary.validate().map_err(str::to_owned))
+            }
+            component => panic!("unsupported component: {component}"),
+        }
+    }
+    document["generated_by"] = "arkhe-core; checked against independent Python vectors".into();
+    document["validated_by"] =
+        "arkhe-core::golden-vectors-v1 (asserted against independent reference; ACCEPT and REJECT)"
+            .into();
+    println!("{}", serde_json::to_string_pretty(&document).unwrap());
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn reference(id: &str) -> Value {
+        let data: Value =
+            serde_json::from_str(include_str!("../../../tests/core_conformance_vectors.json"))
+                .unwrap();
+        data["vectors"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|row| row["id"] == id)
+            .unwrap()
+            .clone()
+    }
+
+    #[test]
+    fn all_references_and_rejections_match() {
+        main();
+    }
+
+    #[test]
+    #[should_panic(expected = "reference mismatch")]
+    fn altered_expected_digest_fails() {
+        let mut row = reference("MatchSummary-minimal");
+        row["expected_output"]["object_digest_hex"] = "00".repeat(32).into();
+        generate::<MatchSummary>(&mut row, |s| s.validate().map_err(str::to_owned));
+    }
+
+    #[test]
+    #[should_panic(expected = "accepted rejection vector")]
+    fn falsely_labelled_rejection_fails() {
+        let mut row = reference("MatchSummary-minimal");
+        row["expected"] = "REJECT".into();
+        row.as_object_mut().unwrap().remove("expected_output");
+        generate::<MatchSummary>(&mut row, |s| s.validate().map_err(str::to_owned));
+    }
+
+    #[test]
+    fn large_array_has_exactly_ten_thousand_references() {
+        let mut row = reference("WER-large-refs-10k");
+        assert_eq!(
+            row["input"]["evidence_refs"].as_array().unwrap().len(),
+            10000
+        );
+        generate::<WorkerExecutionRecord>(&mut row, |_| Ok(()));
+    }
+}
diff --git a/arkhe/source/kernel/arkhe-core/examples/intra_draft.rs b/arkhe/source/kernel/arkhe-core/examples/intra_draft.rs
new file mode 100644
index 00000000..563c9779
--- /dev/null
+++ b/arkhe/source/kernel/arkhe-core/examples/intra_draft.rs
@@ -0,0 +1,80 @@
+//! Local adapter: binds an exact Intra content envelope to native AKG identities.
+use arkhe_core::{
+    work::{RequestIdentity, WorkIntent, WorkIntentType},
+    worker::WorkerExecutionRecord,
+    CanonicalEncode, Digest32,
+};
+use serde::Deserialize;
+use serde_json::json;
+use std::io::{self, Read};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Input {
+    actor: String,
+    content: String,
+    created_at: i64,
+}
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mut bytes = Vec::new();
+    io::stdin().take(262145).read_to_end(&mut bytes)?;
+    if bytes.len() > 262144 {
+        return Err("input too large".into());
+    }
+    let input: Input = serde_json::from_slice(&bytes)?;
+    if input.actor.trim().is_empty() || input.actor.len() > 256 || input.created_at < 0 {
+        return Err("invalid actor or timestamp".into());
+    }
+    let content: serde_json::Value = serde_json::from_str(&input.content)?;
+    if content["domain"] != "arkhe-intra/document/v1"
+        || content["revision"].as_u64().is_none_or(|v| v == 0)
+        || ["id", "title", "department", "body", "authorId"]
+            .iter()
+            .any(|key| content[key].as_str().is_none_or(|v| v.is_empty()))
+    {
+        return Err("invalid Intra content envelope".into());
+    }
+    // Preserve the application's raw BLAKE3 identity. Do not relabel it as AKG CBOR.
+    let target = Digest32::blake3(b"", input.content.as_bytes());
+    let binding = serde_json::to_vec(&json!({
+        "domain": "arkhe-intra/native-draft/v1", "actor": input.actor,
+        "document_id": content["id"], "revision": content["revision"],
+        "content_digest": target.to_hex()
+    }))?;
+    let intent = WorkIntent {
+        requested_by: input.actor,
+        intent_type: WorkIntentType::DraftDocument,
+        target,
+        parameters_digest: Digest32::blake3(b"ARKHE:INTRA:DRAFT:v1\0", &binding),
+        context: vec![],
+        context_refs: vec![],
+        request_identity: RequestIdentity::new(&binding),
+        claimed_created_at: input.created_at,
+    };
+    let worker = WorkerExecutionRecord {
+        classification: None,
+        operation: None,
+        module_id: "arkhe-intra/document-snapshot".into(),
+        module_version: "1".into(),
+        input_digest: intent.digest(),
+        output_digest: target,
+        evidence_refs: vec![],
+        confidence_bps: None,
+        uncertainty_note: Some(
+            "Local document snapshot; no publication authorization or external effect.".into(),
+        ),
+        execution_id: intent.request_identity.0.to_hex(),
+    };
+    println!(
+        "{}",
+        json!({
+            "proposal": {"intent": intent, "worker_record": worker},
+            "intent_digest": intent.digest().to_hex(), "worker_digest": worker.digest().to_hex(),
+            "intent_cbor": hex(&intent.canonical_bytes()), "worker_cbor": hex(&worker.canonical_bytes())
+        })
+    );
+    Ok(())
+}
diff --git a/arkhe/source/kernel/arkhe-core/src/canonical.rs b/arkhe/source/kernel/arkhe-core/src/canonical.rs
new file mode 100644
index 00000000..6359d0fe
--- /dev/null
+++ b/arkhe/source/kernel/arkhe-core/src/canonical.rs
@@ -0,0 +1,168 @@
+//! AKG-CBOR-v1: RFC 8949 core deterministic encoding, definite lengths,
+//! shortest integers, UTF-8 unchanged, byte digests, encoded-key ordered maps.
+//! Unsigned projections contain all current fields (neither type has signatures).
+use crate::{work::WorkIntent, worker::WorkerExecutionRecord, Digest32};
+use serde_json::Value;
+
+pub trait CanonicalEncode {
+    const DOMAIN_OBJECT: &'static [u8];
+    fn unsigned_projection(&self) -> Value;
+    fn canonical_bytes(&self) -> Vec<u8> {
+        encode(&self.unsigned_projection(), None)
+    }
+    fn object_digest(&self) -> Digest32 {
+        Digest32::blake3(Self::DOMAIN_OBJECT, &self.canonical_bytes())
+    }
+}
+fn head(major: u8, n: u64, out: &mut Vec<u8>) {
+    let base = major << 5;
+    match n {
+        0..=23 => out.push(base | n as u8),
+        24..=255 => out.extend([base | 24, n as u8]),
+        256..=65535 => {
+            out.push(base | 25);
+            out.extend((n as u16).to_be_bytes());
+        }
+        65536..=4294967295 => {
+            out.push(base | 26);
+            out.extend((n as u32).to_be_bytes());
+        }
+        _ => {
+            out.push(base | 27);
+            out.extend(n.to_be_bytes());
+        }
+    }
+}
+pub fn encode_value(value: &Value) -> Vec<u8> {
+    encode(value, None)
+}
+
+/// Encode a top-level map with explicitly typed byte strings, without treating
+/// ordinary JSON arrays as bytes. Existing `encode_value` encodings are unchanged.
+/// Byte keys must be unique and must not occur in `fields`.
+pub fn encode_map_with_bytes(
+    fields: &serde_json::Map<String, Value>,
+    bytes: &[(&str, &[u8])],
+) -> Result<Vec<u8>, &'static str> {
+    let mut pairs: Vec<_> = fields
+        .iter()
+        .map(|(k, v)| (encode(&Value::String(k.clone()), None), encode(v, Some(k))))
+        .collect();
+    for (key, value) in bytes {
+        let key = encode(&Value::String((*key).into()), None);
+        if pairs.iter().any(|(existing, _)| *existing == key) {
+            return Err("duplicate canonical map key");
+        }
+        let mut encoded = Vec::new();
+        head(2, value.len() as u64, &mut encoded);
+        encoded.extend_from_slice(value);
+        pairs.push((key, encoded));
+    }
+    pairs.sort_by(|a, b| a.0.cmp(&b.0));
+    let mut out = Vec::new();
+    head(5, pairs.len() as u64, &mut out);
+    for (key, value) in pairs {
+        out.extend(key);
+        out.extend(value);
+    }
+    Ok(out)
+}
+
+fn encode(v: &Value, field: Option<&str>) -> Vec<u8> {
+    let mut out = Vec::new();
+    match v {
+        Value::Null => out.push(0xf6),
+        Value::Bool(false) => out.push(0xf4),
+        Value::Bool(true) => out.push(0xf5),
+        Value::String(s) => {
+            head(3, s.len() as u64, &mut out);
+            out.extend(s.as_bytes());
+        }
+        Value::Number(n) => {
+            if let Some(n) = n.as_u64() {
+                head(0, n, &mut out);
+            } else {
+                head(
+                    1,
+                    (-1 - n.as_i64().expect("integer projection")) as u64,
+                    &mut out,
+                );
+            }
+        }
+        Value::Array(a)
+            if matches!(
+                field,
+                Some(
+                    "hash"
+                        | "target"
+                        | "parameters_digest"
+                        | "request_identity"
+                        | "input_digest"
+                        | "output_digest"
+                        | "digest_element"
+                        | "classification_digest"
+                        | "policy_digest"
+                        // AKG-IDENTITY-0001: digests and verifier key/signature
+                        // material as byte strings; no existing field changes.
+                        | "armored_key_digest"
+                        | "bidirectional_digest"
+                        | "value_digest"
+                        | "proof_digest"
+                        | "verifier_public_key"
+                        | "verifier_signature"
+                )
+            ) =>
+        {
+            head(2, a.len() as u64, &mut out);
+            out.extend(a.iter().map(|v| v.as_u64().expect("digest byte") as u8));
+        }
+        Value::Array(a) => {
+            head(4, a.len() as u64, &mut out);
+            let child = if matches!(field, Some("context_refs" | "evidence_refs")) {
+                Some("digest_element")
+            } else {
+                None
+            };
+            for v in a {
+                out.extend(encode(v, child));
+            }
+        }
+        Value::Object(m) => {
+            let mut pairs: Vec<_> = m
+                .iter()
+                .map(|(k, v)| (encode(&Value::String(k.clone()), None), encode(v, Some(k))))
+                .collect();
+            pairs.sort_by(|a, b| a.0.cmp(&b.0));
+            head(5, pairs.len() as u64, &mut out);
+            for (k, v) in pairs {
+                out.extend(k);
+                out.extend(v);
+            }
+        }
+    }
+    out
+}
+impl CanonicalEncode for WorkIntent {
+    const DOMAIN_OBJECT: &'static [u8] = b"AKG:WORKINTENT:v1\0";
+    fn unsigned_projection(&self) -> Value {
+        let mut projection = serde_json::json!({"requested_by": self.requested_by, "intent_type": self.intent_type, "target": self.target, "parameters_digest": self.parameters_digest, "context_refs": self.context_refs, "request_identity": self.request_identity, "claimed_created_at": self.claimed_created_at});
+        if !self.context.is_empty() {
+            projection["context"] = serde_json::to_value(&self.context).expect("typed context");
+        }
+        projection
+    }
+}
+impl CanonicalEncode for WorkerExecutionRecord {
+    const DOMAIN_OBJECT: &'static [u8] = b"AKG:WER:v1\0";
+    fn unsigned_projection(&self) -> Value {
+        let mut projection = serde_json::json!({"module_id": self.module_id, "module_version": self.module_version, "input_digest": self.input_digest, "output_digest": self.output_digest, "evidence_refs": self.evidence_refs, "confidence_bps": self.confidence_bps, "uncertainty_note": self.uncertainty_note, "execution_id": self.execution_id});
+        if let Some(operation) = self.operation {
+            projection["operation"] = serde_json::to_value(operation).expect("operation");
+        }
+        if let Some(binding) = self.classification {
+            projection["classification"] =
+                serde_json::to_value(binding).expect("classification binding");
+        }
+        projection
+    }
+}
diff --git a/arkhe/source/kernel/arkhe-core/src/digest.rs b/arkhe/source/kernel/arkhe-core/src/digest.rs
new file mode 100644
index 00000000..737e1841
--- /dev/null
+++ b/arkhe/source/kernel/arkhe-core/src/digest.rs
@@ -0,0 +1,19 @@
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub struct Digest32(pub [u8; 32]);
+
+impl Digest32 {
+    pub const ZERO: Self = Self([0u8; 32]);
+
+    pub fn blake3(domain: &[u8], payload: &[u8]) -> Self {
+        let mut h = blake3::Hasher::new();
+        h.update(domain);
+        h.update(payload);
+        Self(*h.finalize().as_bytes())
+    }
+
+    pub fn to_hex(self) -> String {
+        self.0.iter().map(|b| format!("{b:02x}")).collect()
+    }
+}
