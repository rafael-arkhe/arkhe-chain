+#[tokio::test]
+async fn all_gate_entry_points_reject_proof_bypass_and_review_still_applies() {
+    let (i, w, mut p, s) = fixture();
+    let gate = ContainmentGate::new(p.clone());
+    rejected(gate.authorize(&i, Some(&w), &p.binding));
