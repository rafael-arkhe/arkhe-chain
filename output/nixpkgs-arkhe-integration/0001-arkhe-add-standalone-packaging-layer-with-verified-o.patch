+async fn begin<'a>(pool: &'a PgPool, tenant: &str) -> Transaction<'a, Postgres> {
+    let mut tx = pool.begin().await.unwrap();
+    sqlx::query("SET LOCAL ROLE arkhe_preview_enqueue")
+        .execute(&mut *tx)
+        .await
+        .unwrap();
+    arkhe_sql::tenant::set_tenant(&mut tx, tenant)
+        .await
+        .unwrap();
+    tx
