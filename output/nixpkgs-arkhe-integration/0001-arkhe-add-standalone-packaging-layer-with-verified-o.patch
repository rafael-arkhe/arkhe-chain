@@ -0,0 +1,185 @@
+use arkhe_rag::citation::{
+    extract_entities, keyword_overlap, CitationError, CitationVerifier, Claim, EntityKind,
+    Evidence, OverlapVerifier,
+};
+
+#[test]
+fn sydney_not_melbourne() {
+    let evidence = [Evidence {
+        id: "e1",
+        text: "Melbourne is the capital of Australia.",
+    }];
+    let claims = [Claim {
+        text: "Sydney is the capital",
+        evidence_id: "e1",
+    }];
+    let v = OverlapVerifier::default();
+    match v.verify(&claims, &evidence) {
+        Err(CitationError::EntityNotInEvidence { entity, .. }) => assert_eq!(entity, "Sydney"),
+        other => panic!("expected EntityNotInEvidence, got {other:?}"),
+    }
+}
+
+#[test]
+fn generic_claim_without_entity_passes() {
+    let evidence = [Evidence {
+        id: "e1",
+        text: "The capital city is large and populated.",
+    }];
+    let claims = [Claim {
+        text: "the capital city is large",
+        evidence_id: "e1",
+    }];
+    let v = OverlapVerifier {
+        min_keyword_overlap: 0.5,
+    };
+    assert!(v.verify(&claims, &evidence).is_ok());
+}
+
+#[test]
+fn numeral_mismatch_is_rejected() {
+    let evidence = [Evidence {
+        id: "e1",
+        text: "The treaty was signed in 1957.",
+    }];
+    let claims = [Claim {
+        text: "The treaty was signed in 1956",
+        evidence_id: "e1",
+    }];
+    let v = OverlapVerifier::default();
+    match v.verify(&claims, &evidence) {
+        Err(CitationError::EntityNotInEvidence { entity, .. }) => assert_eq!(entity, "1956"),
+        other => panic!("expected EntityNotInEvidence, got {other:?}"),
+    }
+}
+
+#[test]
+fn entity_present_in_evidence_passes() {
+    let evidence = [Evidence {
+        id: "e1",
+        text: "Sydney is the capital of New South Wales.",
+    }];
+    let claims = [Claim {
+        text: "Sydney is a city in New South Wales",
+        evidence_id: "e1",
+    }];
+    let v = OverlapVerifier::default();
+    assert!(v.verify(&claims, &evidence).is_ok());
+}
+
+#[test]
+fn unknown_evidence_id_is_rejected() {
+    let evidence = [Evidence {
+        id: "e1",
+        text: "anything",
+    }];
+    let claims = [Claim {
+        text: "anything",
+        evidence_id: "e2",
+    }];
+    let v = OverlapVerifier::default();
+    assert!(matches!(
+        v.verify(&claims, &evidence),
+        Err(CitationError::UnknownEvidence(id)) if id == "e2"
+    ));
+}
+
+#[test]
+fn extract_entities_classifies_kinds() {
+    let ents = extract_entities("Sydney signed the 1956 treaty with NASA");
+    let kinds: Vec<_> = ents.iter().map(|e| (e.kind, e.text.as_str())).collect();
+    assert!(kinds.contains(&(EntityKind::ProperNoun, "Sydney")));
+    assert!(kinds.contains(&(EntityKind::Numeral, "1956")));
+    assert!(kinds.contains(&(EntityKind::Acronym, "NASA")));
+}
+
+#[test]
+fn keyword_overlap_is_jaccard() {
+    // "alpha beta" vs "alpha beta" → 1.0
+    assert!((keyword_overlap("alpha beta", "alpha beta") - 1.0).abs() < 1e-9);
+    // "alpha beta" vs "alpha gamma" → 1/3
+    assert!((keyword_overlap("alpha beta", "alpha gamma") - 1.0 / 3.0).abs() < 1e-9);
+    // stopwords only → 0.0
+    assert_eq!(keyword_overlap("the a an", "the a an"), 0.0);
+}
+
+// ---- Seeded corruption: every mutated entity is rejected ----
+
+struct SplitMix64(u64);
+
+impl SplitMix64 {
+    fn new(seed: u64) -> Self {
+        Self(seed)
+    }
+    fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E3779B97F4A7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB);
+        z ^ (z >> 31)
+    }
+    fn byte(&mut self) -> u8 {
+        (self.next() & 0xff) as u8
+    }
+}
+
+#[test]
+fn corrupted_entities_are_always_rejected() {
+    let evidence = [Evidence {
+        id: "e1",
+        text: "Sydney is the capital of Australia.",
+    }];
+    let v = OverlapVerifier::default();
+    let mut rng = SplitMix64::new(42);
+    let original: Vec<char> = "Sydney".chars().collect();
+    for _ in 0..256 {
+        let pos = (rng.next() as usize) % original.len();
+        let orig = original[pos];
+        let mut repl = orig;
+        while repl == orig {
+            repl = (b'a' + (rng.byte() % 26)) as char;
+        }
+        let mut mutated = original.clone();
+        mutated[pos] = repl;
+        let claim_text: String = mutated.into_iter().collect();
+        let claims = [Claim {
+            text: &claim_text,
+            evidence_id: "e1",
+        }];
+        assert!(
+            v.verify(&claims, &evidence).is_err(),
+            "mutation at {pos} to {repl:?} produced {claim_text:?}, which should be rejected",
+        );
+    }
+}
+
+/// Documented limitation of the exact-entity layer: extraction requires an
+/// uppercase first letter, so a fully lower-cased claim escapes entity
+/// verification and is judged by keyword overlap alone — which is
+/// case-insensitive, so "sydney is the capital" is still supported by a
+/// chunk that says "Sydney is the capital of Australia". The tokenizer
+/// swap the exact layer exists for ("Sydney" → "sydney" → chunk "Sydney")
+/// is a *match* here, not a miss: lowercasing an entity that IS in the
+/// chunk must not be rejected. The uncovered case is a lowercased entity
+/// that is NOT in the chunk while its keywords overlap — the overlap floor
+/// is the only guard there.
+#[test]
+fn lowercased_entity_is_matched_by_overlap_not_by_the_exact_layer() {
+    let evidence = [Evidence {
+        id: "e1",
+        text: "Sydney is the capital of Australia.",
+    }];
+    // "sydney" (lowercase) is not an extracted entity; overlap carries it.
+    let supported = [Claim {
+        text: "sydney is the capital",
+        evidence_id: "e1",
+    }];
+    let v = OverlapVerifier::default();
+    assert!(v.verify(&supported, &evidence).is_ok());
+    // But a lowercased *wrong* city still fails the overlap floor.
+    let wrong = [Claim {
+        text: "melbourne is the capital",
+        evidence_id: "e1",
+    }];
+    assert!(v.verify(&wrong, &evidence).is_err());
+}
diff --git a/arkhe/source/cognition/arkhe-rag/tests/decoder_shared_prefix.rs b/arkhe/source/cognition/arkhe-rag/tests/decoder_shared_prefix.rs
new file mode 100644
index 00000000..8c587adc
--- /dev/null
+++ b/arkhe/source/cognition/arkhe-rag/tests/decoder_shared_prefix.rs
@@ -0,0 +1,119 @@
+//! AKG-NCM-0002 tests — backend selection and the anyOf discrimination.
+//!
+//! The xgrammar fast path is behind the `server` feature (C++ toolchain) and
+//! additionally requires a real tokenizer info, so these default-build tests
+//! cover: selection, the shared-prefix advisory (including nested schemas),
+//! and llguidance's loud acceptance/rejection behavior at byte level.
+
+use arkhe_rag::decoder::{has_shared_prefix_alternatives, ConstrainedDecoder, Target};
+use llguidance::toktrie::ApproximateTokEnv;
+
+fn tok_env() -> llguidance::toktrie::TokEnv {
+    // Byte-level env, no download. Production builds this from the
+    // deployment's NCM tokenizer.
+    ApproximateTokEnv::single_byte_env()
+}
+
+#[test]
+fn anyof_integer_number_is_llguidance_on_both_targets() {
+    let schema = serde_json::json!({
+        "anyOf": [{"type": "integer"}, {"type": "number"}]
+    });
+    let env = tok_env();
+
+    let wasm = ConstrainedDecoder::for_schema(&schema, Target::Wasm, &env).unwrap();
+    assert!(matches!(wasm, ConstrainedDecoder::LlGuidance(_)));
+
+    let server = ConstrainedDecoder::for_schema(&schema, Target::Server, &env).unwrap();
+    assert!(matches!(server, ConstrainedDecoder::LlGuidance(_)));
+}
+
+#[test]
+fn plain_object_schema_selects_llguidance_in_default_build() {
+    let schema = serde_json::json!({
+        "type": "object",
+        "properties": {
+            "name": {"type": "string"},
+            "age": {"type": "integer"}
+        },
+        "required": ["name", "age"]
+    });
+    let env = tok_env();
+    let server = ConstrainedDecoder::for_schema(&schema, Target::Server, &env).unwrap();
+    assert!(matches!(server, ConstrainedDecoder::LlGuidance(_)));
+}
+
+#[test]
+fn nested_anyof_is_detected() {
+    let schema = serde_json::json!({
+        "type": "object",
+        "properties": {
+            "value": {
+                "anyOf": [{"type": "integer"}, {"type": "number"}]
+            }
+        }
+    });
+    assert!(has_shared_prefix_alternatives(&schema));
+}
+
+#[test]
+fn shared_prefix_advisory_matches_the_schema_shape() {
+    // The shape that triggers XGrammar's over-rejection bug.
+    assert!(has_shared_prefix_alternatives(&serde_json::json!({
+        "anyOf": [{"type": "integer"}, {"type": "number"}]
+    })));
+    // Two same-type branches also share a first byte.
+    assert!(has_shared_prefix_alternatives(&serde_json::json!({
+        "oneOf": [{"type": "string"}, {"type": "string"}]
+    })));
+    // Disjoint types (string vs integer) do not share a first byte.
+    assert!(!has_shared_prefix_alternatives(&serde_json::json!({
+        "anyOf": [{"type": "string"}, {"type": "integer"}]
+    })));
+    // Plain objects and nested disjoint types are clean.
+    assert!(!has_shared_prefix_alternatives(&serde_json::json!({
+        "type": "object",
+        "properties": {"name": {"type": "string"}}
+    })));
+}
+
+#[test]
+fn llguidance_accepts_1_5_for_anyof_integer_number() {
+    let schema = serde_json::json!({
+        "anyOf": [{"type": "integer"}, {"type": "number"}]
+    });
+    let env = tok_env();
+    let decoder = ConstrainedDecoder::for_schema(&schema, Target::Wasm, &env).unwrap();
+    let ConstrainedDecoder::LlGuidance(mut matcher) = decoder else {
+        panic!("expected LlGuidance")
+    };
+    // Byte-level env: tokenize "1.5" and consume it. This is exactly the
+    // input XGrammar rejects at byte 1 in the over-rejection bug; llguidance
+    // must accept it.
+    let tokens = env.tokenize_bytes(b"1.5");
+    matcher
+        .consume_tokens(&tokens)
+        .expect("llguidance accepts 1.5 for anyOf integer/number");
+    assert!(matcher.is_accepting().unwrap());
+}
+
+#[test]
+fn llguidance_rejects_invalid_input_loudly() {
+    let schema = serde_json::json!({
+        "type": "object",
+        "properties": {"name": {"type": "string"}},
+        "required": ["name"]
+    });
+    let env = tok_env();
+    let decoder = ConstrainedDecoder::for_schema(&schema, Target::Wasm, &env).unwrap();
+    let ConstrainedDecoder::LlGuidance(mut matcher) = decoder else {
+        panic!("expected LlGuidance")
+    };
+    // "xyz" is not a valid value for this schema: consumption must error,
+    // not pass silently.
+    let tokens = env.tokenize_bytes(b"xyz");
+    assert!(
+        matcher.consume_tokens(&tokens).is_err(),
+        "llguidance must fail loudly on invalid input"
+    );
+}
diff --git a/arkhe/source/cognition/arkhe-rag/tests/e2e_xsum.rs b/arkhe/source/cognition/arkhe-rag/tests/e2e_xsum.rs
new file mode 100644
index 00000000..88e7acd2
--- /dev/null
+++ b/arkhe/source/cognition/arkhe-rag/tests/e2e_xsum.rs
@@ -0,0 +1,236 @@
+//! AKG-NCM e2e — the full four-layer cycle against an XSum-style fixture:
+//!
+//! policy (real `SignedPolicyBundle` from arkhe-governance)
+//! → structure (real llguidance matcher over the level schema)
+//! → support (real `CitationVerifier`)
+//! → execution (mock generator/anchor — the real NCM checkpoint stays
+//!   PENDING on the VQ-VAE `TokenizerEnv` extraction, AKG-NCM-0003).
+//!
+//! The mock generator stands for the XSum checkpoint: same claims shape the
+//! real checkpoint would emit for a summarization level.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+use arkhe_cognition_sdk::Digest32;
+use arkhe_governance::policy_bundle::{
+    sign_policy_bundle, PolicyBundleError, PolicyPayload, SignaturePolicy, TrustStore,
+};
+use arkhe_rag::citation::{Evidence, OverlapVerifier};
+use arkhe_rag::decoder::{ConstrainedDecoder, Target};
+use arkhe_rag::ncm_harness::{
+    compute_level_digest, AnchorProof, ClaimData, NcmError, NcmGenerator, NcmHarness, NcmLevel,
+    NcmOutput, ProofAnchor,
+};
+use ed25519_dalek::SigningKey;
+use llguidance::toktrie::ApproximateTokEnv;
+
+const NOW: i64 = 1_800_000_000;
+
+fn level_schema() -> serde_json::Value {
+    serde_json::json!({
+        "type": "object",
+        "properties": {
+            "claims": {
+                "type": "array",
+                "items": {
+                    "type": "object",
+                    "properties": {
+                        "text": {"type": "string"},
+                        "evidence_id": {"type": "string"}
+                    },
+                    "required": ["text", "evidence_id"]
+                }
+            }
+        },
+        "required": ["claims"]
+    })
+}
+
+fn xsum_claims() -> Vec<ClaimData> {
+    vec![ClaimData {
+        text: "Sydney is the capital of Australia".into(),
+        evidence_id: "e1".into(),
+    }]
+}
+
+// ---- Mocks (execution layer stand-ins) ----
+
+struct MockNcmGenerator {
+    responses: HashMap<String, NcmOutput>,
+}
+
+impl MockNcmGenerator {
+    fn new() -> Self {
+        let claims = xsum_claims();
+        let level = NcmLevel {
+            level: 1,
+            content_digest: compute_level_digest(&claims),
+            claims,
+        };
+        let mut responses = HashMap::new();
+        responses.insert(
+            "capital of Australia".into(),
+            NcmOutput {
+                levels: vec![level],
+            },
+        );
+        Self { responses }
+    }
+}
+
+impl NcmGenerator for MockNcmGenerator {
+    fn generate(&self, prompt: &str) -> Result<NcmOutput, NcmError> {
+        self.responses
+            .get(prompt)
+            .cloned()
+            .ok_or_else(|| NcmError::GeneratorFailed(format!("no mock for {prompt:?}")))
+    }
+
+    fn model_digest(&self) -> Digest32 {
+        // In production: BLAKE3 over generator.pt + config.yaml + tokenizer.pt.
+        Digest32([0x42; 32])
+    }
+}
+
+struct MockAnchor {
+    log: Arc<Mutex<Vec<Digest32>>>,
+}
+
+impl MockAnchor {
+    fn new() -> (Self, Arc<Mutex<Vec<Digest32>>>) {
+        let log = Arc::new(Mutex::new(Vec::new()));
+        (
+            Self {
+                log: Arc::clone(&log),
+            },
+            log,
+        )
+    }
+}
+
+impl ProofAnchor for MockAnchor {
+    fn anchor(&self, record_hash: Digest32) -> Result<AnchorProof, NcmError> {
+        self.log.lock().unwrap().push(record_hash);
+        Ok(AnchorProof {
+            record_hash,
+            anchored_at: 0,
+        })
+    }
+}
+
+// ---- Tests ----
+
+#[test]
+fn xsum_full_cycle_policy_structure_support_execution() {
+    // 1. Policy layer: a real signed bundle, verified against a real trust
+    //    store. The binding's digest is what everything downstream cites.
+    let signer = SigningKey::from_bytes(&[9u8; 32]);
+    let mut store = TrustStore::new();
+    store.insert_signing("ncm-policy", &signer).expect("anchor");
+    let bundle = sign_policy_bundle(
+        PolicyPayload {
+            policy_id: "ncm.xsum.level".into(),
+            statements: serde_json::json!({"max_levels": 3, "entity_check": "exact"}),
+        },
+        7,
+        7,
+        "arkhe-governance",
+        "ncm-policy",
+        NOW - 1000,
+        NOW + 1000,
+        &signer,
+    );
+    let binding = bundle
+        .verify(&store, 7, SignaturePolicy::Required, NOW)
+        .expect("policy bundle verifies");
+
+    // 2. Structure layer: the level payload must conform to the level
+    //    schema under a real llguidance matcher.
+    let env = ApproximateTokEnv::single_byte_env();
+    let decoder = ConstrainedDecoder::for_schema(&level_schema(), Target::Server, &env)
+        .expect("decoder builds");
+    let ConstrainedDecoder::LlGuidance(mut matcher) = decoder else {
+        panic!("expected LlGuidance")
+    };
+    let payload_json =
+        serde_json::to_string(&serde_json::json!({ "claims": xsum_claims() })).unwrap();
+    matcher
+        .consume_tokens(&env.tokenize_bytes(payload_json.as_bytes()))
+        .expect("level payload conforms to schema");
+    assert!(matcher.is_accepting().unwrap());
+
+    // 3+4. Support and execution: the harness runs with the *verified*
+    //    policy digest — the one line of glue between governance and the
+    //    NCM cycle that was still a conjecture.
+    let (anchor, log) = MockAnchor::new();
+    let harness = NcmHarness::new(
+        MockNcmGenerator::new(),
+        OverlapVerifier::default(),
+        anchor,
+        binding.policy_digest,
+    );
+    let evidence = [Evidence {
+        id: "e1",
+        text: "Sydney is the capital of Australia.",
+    }];
+
+    let out = harness
+        .generate_and_verify("capital of Australia", &evidence)
+        .expect("cycle closes");
+
+    assert_eq!(out.levels.len(), 1);
+    assert_eq!(out.policy_digest, binding.policy_digest);
+    assert_ne!(out.record_hash, Digest32::ZERO);
+    assert_eq!(out.anchor_proof.record_hash, out.record_hash);
+    assert_eq!(log.lock().unwrap().len(), 1);
+}
+
+#[test]
+fn invalid_policies_never_reach_the_harness() {
+    let signer = SigningKey::from_bytes(&[9u8; 32]);
+    let mut store = TrustStore::new();
+    store.insert_signing("ncm-policy", &signer).unwrap();
+    let payload = PolicyPayload {
+        policy_id: "ncm.xsum.level".into(),
+        statements: serde_json::json!({"max_levels": 3}),
+    };
+
+    // Expired bundle: refused at verification, so the harness never runs.
+    let expired = sign_policy_bundle(
+        payload.clone(),
+        8,
+        7,
+        "arkhe-governance",
+        "ncm-policy",
+        NOW - 2000,
+        NOW - 1000,
+        &signer,
+    );
+    assert_eq!(
+        expired
+            .verify(&store, 8, SignaturePolicy::Required, NOW)
+            .err(),
+        Some(PolicyBundleError::Expired)
+    );
+
+    // Rolled-back bundle: version above its own floor but below the
+    // deployment's current (6 with floor 7 would be MalformedVersion —
+    // below its own floor — and is covered in policy_bundle's own tests).
+    let rolled_back = sign_policy_bundle(
+        payload,
+        7,
+        7,
+        "arkhe-governance",
+        "ncm-policy",
+        NOW - 1000,
+        NOW + 1000,
+        &signer,
+    );
+    assert_eq!(
+        rolled_back
+            .verify(&store, 8, SignaturePolicy::Required, NOW)
+            .err(),
+        Some(PolicyBundleError::RollbackDetected)
+    );
+}
diff --git a/arkhe/source/cognition/arkhe-rag/tests/hybrid_retrieval.rs b/arkhe/source/cognition/arkhe-rag/tests/hybrid_retrieval.rs
new file mode 100644
index 00000000..a0b72358
--- /dev/null
+++ b/arkhe/source/cognition/arkhe-rag/tests/hybrid_retrieval.rs
@@ -0,0 +1,189 @@
+use arkhe_rag::retrieval::{reciprocal_rank_fusion, HybridRetriever};
+use arkhe_rag::retrieval::{tokenize, Bm25Index, Document};
+use arkhe_rag::retrieval::{Hit, OverlapReranker, Reranker};
+
+#[test]
+fn overlap_improves_synthetic_mrr_and_ndcg_when_dense_ranks_wrong_pair_first() {
+    let index = Bm25Index::new(corpus(), 1.2, 0.75).unwrap();
+    let pairs = [
+        ("pagamento aprovação", "logs", "pay"),
+        ("consentimento exportação", "pay", "export"),
+        ("logs evidência", "export", "logs"),
+    ];
+    let mut before = 0.0;
+    let mut after = 0.0;
+    let mut ndcg_before = 0.0;
+    let mut ndcg_after = 0.0;
+    for (query, wrong, relevant) in pairs {
+        let hits = vec![
+            Hit {
+                id: wrong.into(),
+                score: 0.02,
+            },
+            Hit {
+                id: relevant.into(),
+                score: 0.01,
+            },
+        ];
+        let ranked = OverlapReranker.rerank(query, hits.clone(), &index).unwrap();
+        let rank_before = hits.iter().position(|h| h.id == relevant).unwrap() + 1;
+        let rank_after = ranked.iter().position(|h| h.id == relevant).unwrap() + 1;
+        before += 1.0 / rank_before as f64;
+        after += 1.0 / rank_after as f64;
+        ndcg_before += 1.0 / ((rank_before + 1) as f64).log2();
+        ndcg_after += 1.0 / ((rank_after + 1) as f64).log2();
+    }
+    assert_eq!(before / 3.0, 0.5);
+    assert_eq!(after / 3.0, 1.0);
+    assert!(ndcg_after > ndcg_before);
+    let hits = vec![
+        Hit {
+            id: "logs".into(),
+            score: 0.01,
+        },
+        Hit {
+            id: "pay".into(),
+            score: 0.01,
+        },
+    ];
+    assert_eq!(
+        OverlapReranker
+            .rerank("unmatched", hits.clone(), &index)
+            .unwrap(),
+        hits
+    );
+    assert!(OverlapReranker
+        .rerank(
+            "x",
+            vec![Hit {
+                id: "unknown".into(),
+                score: 0.0
+            }],
+            &index
+        )
+        .is_err());
+}
+
+fn ids(values: &[&str]) -> Vec<String> {
+    values.iter().map(|s| (*s).into()).collect()
+}
+
+#[test]
+fn rrf_preserves_surviving_ranker_order_and_rejects_total_failure() {
+    for constant in [0, 60] {
+        for (a, b) in [
+            (Ok(ids(&["z", "a", "b"])), Err("offline".into())),
+            (Err("offline".into()), Ok(ids(&["z", "a", "b"]))),
+        ] {
+            let hits = reciprocal_rank_fusion(a, b, constant, 3).unwrap();
+            assert_eq!(
+                hits.iter().map(|h| h.id.as_str()).collect::<Vec<_>>(),
+                ["z", "a", "b"]
+            );
+        }
+    }
+    assert!(reciprocal_rank_fusion(Err("a".into()), Err("b".into()), 60, 3).is_err());
+    let hits =
+        reciprocal_rank_fusion(Ok(ids(&["a", "a", "b"])), Ok(ids(&["b", "c"])), 60, 3).unwrap();
+    assert_eq!(hits[0].id, "b");
+    assert!((hits[0].score - (1.0 / 62.0 + 1.0 / 61.0)).abs() < 1e-12);
+}
+
+#[test]
+fn hybrid_recovers_lexical_hit_and_rejects_unknown_dense_ids() {
+    let hybrid =
+        HybridRetriever::new(Bm25Index::new(corpus(), 1.2, 0.75).unwrap(), 60, 10).unwrap();
+    let hits = hybrid
+        .retrieve("pagamento", Ok(ids(&["logs", "pay"])))
+        .unwrap();
+    assert_eq!(hits[0].id, "pay");
+    assert_eq!(
+        hybrid
+            .retrieve("pagamento", Err("dense offline".into()))
+            .unwrap()[0]
+            .id,
+        "pay"
+    );
+    assert!(hybrid.retrieve("pagamento", Ok(ids(&["unknown"]))).is_err());
+}
+
+fn corpus() -> Vec<Document> {
+    [
+        ("pay", "pagamento exige aprovação humana"),
+        ("export", "exportação exige consentimento explícito"),
+        ("logs", "logs devem preservar evidência"),
+        ("empty", ""),
+    ]
+    .into_iter()
+    .map(|(id, text)| Document {
+        id: id.into(),
+        text: text.into(),
+    })
+    .collect()
+}
+
+#[test]
+fn bm25_synthetic_recall_at_one_and_tokenization() {
+    let index = Bm25Index::new(corpus(), 1.2, 0.75).unwrap();
+    let judgments = [
+        ("Quem aprova PAGAMENTO?", "pay"),
+        ("consentimento para exportação", "export"),
+        ("preservar logs", "logs"),
+    ];
+    let recalled = judgments
+        .iter()
+        .filter(|(q, relevant)| index.search(q, 1)[0].id == *relevant)
+        .count();
+    assert_eq!(recalled as f64 / judgments.len() as f64, 1.0);
+    assert_eq!(
+        tokenize("APROVAÇÃO, humana_42!"),
+        ["aprovação", "humana", "42"]
+    );
+    assert!(index.search("desconhecido", 4).is_empty());
+    assert!(index.search("", 4).is_empty());
+    assert!(index.search("pagamento", 0).is_empty());
+}
+
+#[test]
+fn bm25_formula_parameters_and_stable_identity() {
+    let docs = vec![
+        Document {
+            id: "b".into(),
+            text: "x x".into(),
+        },
+        Document {
+            id: "a".into(),
+            text: "x".into(),
+        },
+    ];
+    let index = Bm25Index::new(docs.clone(), 1.2, 0.0).unwrap();
+    for extreme in [f64::MAX, f64::MIN_POSITIVE, f64::from_bits(1)] {
+        assert!(Bm25Index::new(docs.clone(), extreme, 0.75)
+            .unwrap()
+            .search("x", 4)
+            .iter()
+            .all(|h| h.score.is_finite() && h.score > 0.0));
+    }
+    let hits = index.search("x x", 4);
+    let expected = (1.0_f64 + 0.5 / 2.5).ln() * 2.0 * 2.2 / 3.2;
+    assert!((hits[0].score - expected).abs() < 1e-12);
+    let mut reverse = docs.clone();
+    reverse.reverse();
+    assert_eq!(
+        hits,
+        Bm25Index::new(reverse, 1.2, 0.0).unwrap().search("x", 4)
+    );
+    for (k1, b) in [
+        (0.0, 0.5),
+        (f64::NAN, 0.5),
+        (1.0, f64::INFINITY),
+        (1.0, -0.1),
+    ] {
+        assert!(Bm25Index::new(docs.clone(), k1, b).is_err());
+    }
+    assert!(Bm25Index::new(vec![docs[0].clone(), docs[0].clone()], 1.2, 0.75).is_err());
+    assert!(Bm25Index::new(vec![], 1.2, 0.75)
+        .unwrap()
+        .search("x", 1)
+        .is_empty());
+}
diff --git a/arkhe/source/cognition/arkhe-rag/tests/ncm_e2e.rs b/arkhe/source/cognition/arkhe-rag/tests/ncm_e2e.rs
new file mode 100644
index 00000000..f63287b0
--- /dev/null
+++ b/arkhe/source/cognition/arkhe-rag/tests/ncm_e2e.rs
@@ -0,0 +1,201 @@
+//! AKG-NCM-0001 e2e — the generate → verify → anchor cycle, mocked at both
+//! ends: the generator is a static checkpoint and the anchor is an in-memory
+//! log. Production swaps in the real NCM checkpoint and the WormGraph.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+use arkhe_cognition_sdk::Digest32;
+use arkhe_rag::citation::{CitationError, Evidence, OverlapVerifier};
+use arkhe_rag::ncm_harness::{
+    compute_level_digest, AnchorProof, ClaimData, NcmError, NcmGenerator, NcmHarness, NcmLevel,
+    NcmOutput, ProofAnchor,
+};
+
+fn policy_digest_from_signed_bundle() -> Digest32 {
+    // In production: the digest from the `PolicyBinding` that
+    // `SignedPolicyBundle::verify()` returns in `arkhe-governance`.
+    // Here: a stable constant, because this test targets the NCM cycle.
+    Digest32([0xAA; 32])
+}
+
+// ---- Mocks ----
+
+struct MockNcmGenerator {
+    responses: HashMap<String, NcmOutput>,
+}
+
+impl MockNcmGenerator {
+    fn new() -> Self {
+        let mut responses = HashMap::new();
+        let claims = vec![ClaimData {
+            text: "Sydney is the capital of Australia".into(),
+            evidence_id: "e1".into(),
+        }];
+        let level = NcmLevel {
+            level: 1,
+            content_digest: compute_level_digest(&claims),
+            claims,
+        };
+        responses.insert(
+            "capital of Australia".into(),
+            NcmOutput {
+                levels: vec![level],
+            },
+        );
+        Self { responses }
+    }
+
+    /// Inject a tampered output for a prompt. Used by negative tests.
+    fn inject(&mut self, prompt: &str, output: NcmOutput) {
+        self.responses.insert(prompt.to_string(), output);
+    }
+}
+
+impl NcmGenerator for MockNcmGenerator {
+    fn generate(&self, prompt: &str) -> Result<NcmOutput, NcmError> {
+        self.responses
+            .get(prompt)
+            .cloned()
+            .ok_or_else(|| NcmError::GeneratorFailed(format!("no mock for {prompt:?}")))
+    }
+
+    fn model_digest(&self) -> Digest32 {
+        Digest32([0x42; 32])
+    }
+}
+
+/// In-memory anchor whose log is shared, so a test can still count what was
+/// anchored after the harness takes ownership of the anchor itself.
+struct MockAnchor {
+    log: Arc<Mutex<Vec<Digest32>>>,
+}
+
+impl MockAnchor {
+    fn new() -> (Self, Arc<Mutex<Vec<Digest32>>>) {
+        let log = Arc::new(Mutex::new(Vec::new()));
+        (
+            Self {
+                log: Arc::clone(&log),
+            },
+            log,
+        )
+    }
+}
+
+impl ProofAnchor for MockAnchor {
+    fn anchor(&self, record_hash: Digest32) -> Result<AnchorProof, NcmError> {
+        self.log.lock().unwrap().push(record_hash);
+        Ok(AnchorProof {
+            record_hash,
+            anchored_at: 0,
+        })
+    }
+}
+
+// ---- Tests ----
+
+#[test]
+fn generate_verify_anchor_happy_path() {
+    let (anchor, log) = MockAnchor::new();
+    let harness = NcmHarness::new(
+        MockNcmGenerator::new(),
+        OverlapVerifier::default(),
+        anchor,
+        policy_digest_from_signed_bundle(),
+    );
+
+    let evidence = [Evidence {
+        id: "e1",
+        text: "Sydney is the capital of Australia.",
+    }];
+
+    let out = harness
+        .generate_and_verify("capital of Australia", &evidence)
+        .expect("should pass");
+
+    assert_eq!(out.levels.len(), 1);
+    assert_eq!(out.levels[0].level, 1);
+    assert_eq!(out.model_digest, Digest32([0x42; 32]));
+    assert_eq!(out.policy_digest, policy_digest_from_signed_bundle());
+    assert_ne!(out.record_hash, Digest32::ZERO);
+    assert_eq!(out.anchor_proof.record_hash, out.record_hash);
+    assert_eq!(log.lock().unwrap().len(), 1);
+}
+
+#[test]
+fn generate_verify_anchor_rejects_wrong_entity() {
+    let (anchor, log) = MockAnchor::new();
+    let harness = NcmHarness::new(
+        MockNcmGenerator::new(),
+        OverlapVerifier::default(),
+        anchor,
+        Digest32([0xAA; 32]),
+    );
+
+    let evidence = [Evidence {
+        id: "e1",
+        text: "Melbourne is the capital of Australia.",
+    }];
+
+    let err = harness
+        .generate_and_verify("capital of Australia", &evidence)
+        .expect_err("should reject");
+
+    match err {
+        NcmError::CitationRejected(CitationError::EntityNotInEvidence { entity, .. }) => {
+            assert_eq!(entity, "Sydney");
+        }
+        other => panic!("expected CitationRejected(EntityNotInEvidence), got {other:?}"),
+    }
+    // A rejected output is never anchored.
+    assert!(log.lock().unwrap().is_empty());
+}
+
+#[test]
+fn tampered_digest_is_rejected_before_citation() {
+    // Level with correct claims but a tampered digest: refused before any
+    // citation check, even against evidence that would satisfy the claims.
+    let mut generator = MockNcmGenerator::new();
+    let mut out = generator
+        .generate("capital of Australia")
+        .expect("mock has the prompt");
+    out.levels[0].content_digest = Digest32([0xFF; 32]);
+    generator.inject("capital of Australia", out);
+
+    let harness = NcmHarness::new(
+        generator,
+        OverlapVerifier::default(),
+        MockAnchor::new().0,
+        Digest32([0xAA; 32]),
+    );
+    let evidence = [Evidence {
+        id: "e1",
+        text: "Sydney is the capital.",
+    }];
+
+    let err = harness
+        .generate_and_verify("capital of Australia", &evidence)
+        .expect_err("digest mismatch");
+
+    assert_eq!(err, NcmError::DigestMismatch { level: 1 });
+}
+
+#[test]
+fn record_hash_binds_policy_and_levels() {
+    // Same levels, different policy digest → different record hash: the
+    // anchor cannot be replayed across policies.
+    let claims = vec![ClaimData {
+        text: "Sydney is the capital of Australia".into(),
+        evidence_id: "e1".into(),
+    }];
+    let level = NcmLevel {
+        level: 1,
+        content_digest: compute_level_digest(&claims),
+        claims,
+    };
+    let levels = vec![level];
+    let a = arkhe_rag::ncm_harness::compute_record_hash(&levels, &Digest32([0xAA; 32]));
+    let b = arkhe_rag::ncm_harness::compute_record_hash(&levels, &Digest32([0xBB; 32]));
+    assert_ne!(a, b);
+}
