diff --git a/arkhe/flake.nix b/arkhe/flake.nix
new file mode 100644
index 00000000..5002c3bb
--- /dev/null
+++ b/arkhe/flake.nix
@@ -0,0 +1,116 @@
+{
+  description = "Pacotes Arkhe para Nix: builds reprodutíveis e endereçados por conteúdo";
+
+  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
+
+  outputs =
+    { nixpkgs, ... }:
+    let
+      inherit (nixpkgs) lib;
+
+      systems = [
+        "x86_64-linux"
+        "aarch64-linux"
+      ];
+
+      forAllSystems = lib.genAttrs systems;
+
+      pkgsFor = system: import nixpkgs { inherit system; };
+
+      packagesFor = system: import ./default.nix { pkgs = pkgsFor system; };
+
+      contentAddressedFor =
+        system:
+        import ./default.nix {
+          pkgs = pkgsFor system;
+          contentAddressed = true;
+        };
+    in
+    {
+      overlays.default = import ./overlay.nix { };
+      overlays.contentAddressed = import ./overlay.nix { contentAddressed = true; };
+
+      packages = forAllSystems (
+        system:
+        let
+          p = packagesFor system;
+        in
+        (lib.filterAttrs (name: value: lib.isDerivation value && name != "arkhe-verify-wasm") p) // { default = p.arkhe-verify; }
+      );
+
+      # `ca` fica fora de `packages` de propósito: instanciar uma derivação
+      # endereçada por conteúdo exige `ca-derivations`, que ainda é
+      # experimental. Assim `nix flake check` continua funcionando em uma
+      # instalação padrão.
+      legacyPackages = forAllSystems (
+        system:
+        let
+          p = packagesFor system;
+          ca = contentAddressedFor system;
+        in
+        p // { ca = lib.filterAttrs (name: value: lib.isDerivation value && name != "arkhe-verify-wasm") ca; }
+      );
+
+      checks = forAllSystems (
+        system:
+        import ./checks/default.nix {
+          pkgs = pkgsFor system;
+          packages = packagesFor system;
+        }
+      );
+
+      apps = forAllSystems (system: {
+        arkhe-verify = {
+          type = "app";
+          meta.description = "Verificador offline Arkhe";
+          program = "${(packagesFor system).arkhe-verify}/bin/arkhe-verify";
+        };
+      });
+
+      devShells = forAllSystems (
+        system:
+        let
+          pkgs = pkgsFor system;
+        in
+        {
+          default = pkgs.mkShell {
+            packages = with pkgs; [
+              cargo
+              clippy
+              gnumake
+              jq
+              nix
+              rustc
+              rustfmt
+            ];
+          };
+        }
+      );
+
+      # API para consumidores que trazem a própria fonte (por exemplo um
+      # tarball de release fixado por hash).
+      lib = {
+        mkPackages =
+          {
+            pkgs,
+            src,
+            contentAddressed ? false,
+            rustPlatform ? pkgs.rustPlatform,
+          }:
+          import ./default.nix { inherit pkgs src contentAddressed rustPlatform; };
+
+        mkOverlay = args: import ./overlay.nix args;
+      };
+
+      nixosModules = {
+        default = {
+          imports = [
+            ./modules/arkhe-node.nix
+            ./modules/arkhe-audit.nix
+          ];
+        };
+        arkhe-node = ./modules/arkhe-node.nix;
+        arkhe-audit = ./modules/arkhe-audit.nix;
+      };
+    };
+}
diff --git a/arkhe/modules/arkhe-audit.nix b/arkhe/modules/arkhe-audit.nix
new file mode 100644
index 00000000..ae272f98
--- /dev/null
+++ b/arkhe/modules/arkhe-audit.nix
@@ -0,0 +1,48 @@
+# Perfil `arkhe-audit`: estação de verificação offline.
+#
+# Não habilita nenhum serviço de rede: o perfil de auditoria é offline por
+# definição. Apenas instala o verificador e prepara um diretório de trabalho.
+{ config, lib, pkgs, ... }:
+
+let
+  cfg = config.services.arkheAudit;
+in
+{
+  options.services.arkheAudit = {
+    enable = lib.mkEnableOption "estação de auditoria Arkhe (perfil arkhe-audit)";
+
+    package = lib.mkOption {
+      type = lib.types.package;
+      default = pkgs.arkhe.arkhe-verify;
+      defaultText = lib.literalExpression "pkgs.arkhe.arkhe-verify";
+      description = ''
+        Pacote do verificador. Exige o overlay do nixpkgs-arkhe
+        (`nixpkgs.overlays = [ inputs.nixpkgs-arkhe.overlays.default ];`).
+      '';
+    };
+
+    workspace = lib.mkOption {
+      type = lib.types.str;
+      default = "/var/lib/arkhe-audit";
+      description = "Diretório para bundles, provas e checkpoints recebidos.";
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    environment.systemPackages = [
+      cfg.package
+    ];
+
+    users.groups.arkhe-audit = { };
+
