+        Ok(self.0.clone())
+    }
+}
+fn key() -> SigningKey {
+    let mut seed = [0; 32];
+    OsRng.fill_bytes(&mut seed);
+    SigningKey::from_bytes(&seed)
+}
+fn record() -> WorkerExecutionRecord {
+    WorkerExecutionRecord {
+        classification: None,
+        module_id: "trusted-analysis".into(),
+        module_version: "1".into(),
+        operation: Some(CognitiveOperation::Decide),
