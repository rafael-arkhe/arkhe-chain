@@ -0,0 +1,36 @@
+//! Generate an untrusted triage assessment from a local report; no external write.
+use arkhe_bugbounty::{
+    classification::{ClassificationPolicy, TriageAnalysis},
+    ollama::OllamaAnalyzer,
+    ReportDetails, TriageParams,
+};
+use arkhe_ollama::{Config, OllamaClient};
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args = std::env::args().skip(1).collect::<Vec<_>>();
+    if args.len() != 3 && args.len() != 5 {
+        return Err("usage: ollama_triage <report.json> <Critical|High|Medium|Low|Info> <Triaged|Rejected|Duplicate> [analysis.json trusted-policy.json]".into());
+    }
+    let report: ReportDetails = serde_json::from_slice(&std::fs::read(&args[0])?)?;
+    let params = TriageParams {
+        severity: serde_json::from_value(serde_json::json!(args[1]))?,
+        state: serde_json::from_value(serde_json::json!(args[2]))?,
+    };
+    let path = std::env::var("ARKHE_OLLAMA_CONFIG").unwrap_or_else(|_| "config/ollama.json".into());
+    let mut analyzer = OllamaAnalyzer::new(OllamaClient::new(Config::load(path)?)?);
+    let mut cvss = None;
+    if args.len() == 5 {
+        let analysis: TriageAnalysis = serde_json::from_slice(&std::fs::read(&args[3])?)?;
+        let policy: ClassificationPolicy = serde_json::from_slice(&std::fs::read(&args[4])?)?;
+        cvss = analysis.cvss_presentation()?;
+        analyzer = analyzer.with_classification(analysis, policy)?;
+    }
+    let (assessment, completion) = analyzer.assess(&report, params).await?;
+    println!(
+        "{}",
+        serde_json::to_string_pretty(
+            &serde_json::json!({"status":"UNTRUSTED_PROPOSAL","report_digest":report.digest().to_hex(),"parameters_digest":params.digest().to_hex(),"cvss":cvss,"assessment":assessment,"provider":completion})
+        )?
+    );
+    Ok(())
+}
diff --git a/arkhe/source/integration/arkhe-bugbounty/src/bin/review_queue.rs b/arkhe/source/integration/arkhe-bugbounty/src/bin/review_queue.rs
new file mode 100644
index 00000000..4bbbc2c2
--- /dev/null
+++ b/arkhe/source/integration/arkhe-bugbounty/src/bin/review_queue.rs
@@ -0,0 +1,99 @@
+//! Read-only listing or explicit historical seeding. No human approval or external write.
+use arkhe_bugbounty::{
+    review::{FileReviewQueue, ReviewItem, ReviewPolicy, ReviewRouter, ReviewSignals},
+    ReportDetails, Severity, State, TriageParams,
+};
+use arkhe_core::{
+    work::{RequestIdentity, WorkIntent, WorkIntentType},
+    Digest32,
+};
+use std::path::PathBuf;
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    if args.len() < 2 {
+        return Err(
+            "usage: review_queue list|metrics <queue.json> | shadow <queue.json> <candidate-policy.json> | seed-origin <queue.json> <run-01-directory>"
+                .into(),
+        );
+    }
+    let queue = FileReviewQueue::new(&args[1]);
+    match args[0].as_str() {
+        "list" if args.len() == 2 => (),
+        "metrics" if args.len() == 2 => {
+            println!("{}", serde_json::to_string_pretty(&queue.metrics()?)?);
+            return Ok(());
+        }
+        "shadow" if args.len() == 3 => {
+            let policy: ReviewPolicy = serde_json::from_slice(&std::fs::read(&args[2])?)?;
+            let candidate = ReviewRouter::new(policy)?;
+            println!(
+                "{}",
+                serde_json::to_string_pretty(&arkhe_bugbounty::review::telemetry::compare_shadow(
+                    &queue.observations()?,
+                    &candidate
+                ))?
+            );
+            return Ok(());
+        }
+        "seed-origin" if args.len() == 3 => {
+            let run = PathBuf::from(&args[2]);
+            let report_bytes = std::fs::read(run.join("origin-corrected/report.json"))?;
+            let report: ReportDetails = serde_json::from_slice(&report_bytes)?;
+            let output_bytes = std::fs::read(run.join("origin-corrected/stdout.txt"))?;
+            let output: serde_json::Value = serde_json::from_slice(&output_bytes)?;
+            let assessment = &output["assessment"];
+            let confidence = assessment["confidence_bps"]
+                .as_u64()
+                .filter(|n| *n <= 10000)
+                .ok_or("invalid historical confidence")? as u16;
+            let supports = assessment["supports_proposal"]
+                .as_bool()
+                .ok_or("invalid historical decision")?;
+            let params = TriageParams {
+                severity: Severity::High,
+                state: State::Triaged,
+            };
+            if report.report_id != "origin-corrected"
+                || output["report_digest"].as_str() != Some(report.digest().to_hex().as_str())
+                || output["parameters_digest"].as_str() != Some(params.digest().to_hex().as_str())
+            {
+                return Err(
+                    "historical report/proposal digests do not match retained stdout".into(),
+                );
+            }
+            let request = WorkIntent {
+                requested_by: "HISTORICAL-RUN-01-REVIEW".into(),
+                intent_type: WorkIntentType::TriageReport,
+                target: report.target(),
+                parameters_digest: params.digest(),
+                context: vec![],
+                context_refs: vec![],
+                request_identity: RequestIdentity::new(
+                    b"review-queue-seed:run-01:origin-corrected",
+                ),
+                claimed_created_at: 0,
+            };
+            let signals = ReviewSignals {
+                supports_proposal: supports,
+                confidence_bps: Some(confidence),
+                ambiguous: None,
+                text_decision_disagreement: Some(true),
+                policy_exception: false,
+                irreversible: false,
+            };
+            let model_version = format!(
+                "historical-cli:{}",
+                output["provider"]["model_digest"]
+                    .as_str()
+                    .ok_or("missing historical model pin")?
+            );
+            let router = ReviewRouter::new(ReviewPolicy::default())?;
+            let decision = router.decide(Severity::High, &model_version, &signals);
+            queue.enqueue(ReviewItem { completed_execution:None, review_evidence:None, case_id:report.report_id.clone(),requested_by:request.requested_by.clone(),operation_id:request.operation_id(),report_digest:report.digest(),parameters_digest:params.digest(),governance_policy_digest:Digest32::ZERO,severity:Severity::High,model_version,signals,decision,analysis:None,source:format!("Historical run-01; suspected text/decision disagreement flagged by user audit, NOT a human verdict; report_ref={}; stdout_ref={}; no admitted WER or authority",Digest32::blake3(b"AKG:REVIEW:SOURCE:v1\0",&report_bytes).to_hex(),Digest32::blake3(b"AKG:REVIEW:SOURCE:v1\0",&output_bytes).to_hex()) })?;
+        }
+        _ => return Err("invalid command or arguments".into()),
+    }
+    println!("{}", serde_json::to_string_pretty(&queue.list()?)?);
+    Ok(())
+}
diff --git a/arkhe/source/integration/arkhe-bugbounty/src/bin/triage_policy.rs b/arkhe/source/integration/arkhe-bugbounty/src/bin/triage_policy.rs
new file mode 100644
index 00000000..e1dce28b
--- /dev/null
+++ b/arkhe/source/integration/arkhe-bugbounty/src/bin/triage_policy.rs
@@ -0,0 +1,64 @@
+//! Review artifacts and signature verification only; never creates an approval or a root.
+use arkhe_bugbounty::{
+    classification::ClassificationPolicy,
+    governance::{
+        now_ms, GovernanceTrustRegistry, RequiredTriageEvidence, SignedTriagePolicyProfile,
+        TriagePolicyProfile, VerifiedTriagePolicy,
+    },
+};
+use arkhe_core::Digest32;
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct DetachedApprovals {
+    registry_digest: Digest32,
+    approvals: Vec<arkhe_bugbounty::governance::GovernanceApproval>,
+}
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    match args.first().map(String::as_str) {
+        Some("prepare") if args.len()==5 => {
+            let classification_policy:ClassificationPolicy = serde_json::from_slice(&std::fs::read(&args[1])?)?;
+            let seconds:i64=args[4].parse()?;
+            if !(1..=86400).contains(&seconds) { return Err("validity must be 1..86400 seconds".into()); }
+            let now=now_ms();
+            let profile=TriagePolicyProfile {version:1,policy_id:format!("triage:{}",classification_policy.policy_id),policy_version:1,requested_by:args[2].clone(),classification_policy,allowed_modules:vec![args[3].clone()],required_evidence:vec![RequiredTriageEvidence::ClassificationDigest,RequiredTriageEvidence::ClassificationPolicyDigest],valid_from_ms:now,valid_until_ms:now+seconds*1000};
+            profile.validate()?;
+            let candidate=SignedTriagePolicyProfile {profile,registry_digest:Digest32::ZERO,approvals:vec![]};
+            println!("{}",serde_json::to_string_pretty(&serde_json::json!({"status":"UNSIGNED_CANDIDATE_NOT_ACTIVE","profile_digest":candidate.profile.digest().to_hex(),"approval":candidate}))?);
+        }
+        Some("verify" | "verify-files") if (args[0]=="verify" && args.len()==4) || (args[0]=="verify-files" && args.len()==5) => {
+            let (signed,registry_path,pin_index) = if args[0]=="verify" {
+                (serde_json::from_slice::<SignedTriagePolicyProfile>(&std::fs::read(&args[1])?)?, &args[2],3)
+            } else {
+                let profile: TriagePolicyProfile=serde_json::from_slice(&std::fs::read(&args[1])?)?;
+                let detached: DetachedApprovals=serde_json::from_slice(&std::fs::read(&args[2])?)?;
+                (SignedTriagePolicyProfile {profile,registry_digest:detached.registry_digest,approvals:detached.approvals}, &args[3],4)
+            };
+            let registry:GovernanceTrustRegistry=serde_json::from_slice(&std::fs::read(registry_path)?)?;
+            let raw=hex::decode(&args[pin_index])?;
+            let pinned=Digest32(raw.try_into().map_err(|_|"expected a 32-byte independently pinned registry digest")?);
+            let policy=VerifiedTriagePolicy::verify(signed,&registry,pinned)?;
+            let binding=policy.binding();
+            println!("{}",serde_json::to_string_pretty(&serde_json::json!({"status":"QUORUM_VERIFIED_AGAINST_SUPPLIED_PIN","policy_id":binding.policy_id,"version":binding.version,"profile_digest":binding.policy_digest.to_hex(),"classification_policy_digest":policy.classification_policy().digest().to_hex()}))?);
+        }
+        Some("registry-digest") if args.len()==2 => {
+            let registry:GovernanceTrustRegistry=serde_json::from_slice(&std::fs::read(&args[1])?)?;
+            println!("{}",serde_json::to_string_pretty(&serde_json::json!({"status":"CONTENT_IDENTITY_ONLY_NOT_APPROVAL_OR_ANCHOR","registry_digest":registry.digest().to_hex()}))?);
+        }
+        Some("profile-digest") if args.len()==2 => {
+            let profile:TriagePolicyProfile=serde_json::from_slice(&std::fs::read(&args[1])?)?;
+            profile.validate()?;
+            println!("{}",serde_json::to_string_pretty(&serde_json::json!({"status":"CONTENT_IDENTITY_ONLY_NOT_APPROVAL","profile_digest":profile.digest().to_hex()}))?);
+        }
+        Some("signing-bytes") if args.len()==4 => {
+            let profile:TriagePolicyProfile=serde_json::from_slice(&std::fs::read(&args[1])?)?;
+            let registry:GovernanceTrustRegistry=serde_json::from_slice(&std::fs::read(&args[2])?)?;
+            profile.validate()?;registry.validate()?;
+            if !registry.keys.iter().any(|key|key.key_id==args[3]) {return Err("signer is not present in the candidate registry".into());}
+            let signed=SignedTriagePolicyProfile {profile,registry_digest:registry.digest(),approvals:vec![]};
+            println!("{}",serde_json::to_string_pretty(&serde_json::json!({"status":"BYTES_ONLY_NOT_APPROVAL","key_id":args[3],"profile_digest":signed.profile.digest().to_hex(),"registry_digest":signed.registry_digest.to_hex(),"signing_bytes_hex":hex::encode(signed.signing_bytes(&args[3]))}))?);
+        }
+        _=>return Err("usage: triage_policy prepare <classification-policy.json> <caller> <module> <valid-seconds> | verify <signed-profile.json> <registry.json> <independent-registry-digest-hex> | verify-files <profile.json> <profile.sig> <registry.json> <independent-registry-digest-hex> | registry-digest <registry.json>".into())
+    }
+    Ok(())
+}
diff --git a/arkhe/source/integration/arkhe-bugbounty/src/bin/validate_triage.rs b/arkhe/source/integration/arkhe-bugbounty/src/bin/validate_triage.rs
