+      "description": "SCITT architecture (RFC 9943); listed fields describe an Arkhe adapter plan, not a normative SCITT wire receipt. Native signed statements/receipts need a dedicated verifier.",
+      "required_fields": [
+        "transparency_service_id",
+        "statement_digest",
+        "registration_time",
+        "ledger_index_or_checkpoint",
+        "service_signature"
+      ],
+      "binding": "statement_digest MUST bind the DSSE envelope or statement digest that was registered.",
+      "scope": "A SCITT receipt does not assert that the statement is true; it asserts that the statement was notarized. It MUST be evaluated together with the underlying signed statement.",
+      "evaluator_status": "PENDING"
+    },
+    {
+      "family_id": "predicate:rekor:inclusion:v1",
+      "description": "Sigstore Rekor inclusion proof + checkpoint. Proves an entry is part of a tamper-evident Merkle tree at a given tree size.",
+      "required_fields": [
+        "log_index",
+        "log_id",
+        "integrated_time",
+        "inclusion_proof",
+        "checkpoint",
+        "checkpoint_signature"
+      ],
+      "binding": "The leaf hash MUST bind the signature or DSSE envelope under evaluation.",
+      "verification": "Verifier MUST check the checkpoint signature against a trusted Rekor key and MUST require a consistency proof or witness quorum when the checkpoint is newer than the entry's witness.",
+      "evaluator_status": "PENDING"
+    },
+    {
+      "family_id": "predicate:dice:evidence:v1",
+      "description": "DICE is an attestation architecture with profile-specific certificate/claim encodings. No universal RISC-V CoVE quote format is asserted here; vendor/profile verification remains pending.",
+      "required_fields": [
+        "x509_der_chain",
+        "dice_tcb_info",
+        "firmware_measurements",
+        "alias_key_signature_over_quote_body"
+      ],
+      "binding": "The Alias key signature MUST cover the quote body containing measurements and freshness/report data. The chain MUST anchor in a trusted RoT public key.",
+      "evaluator_status": "PENDING"
+    },
+    {
+      "family_id": "predicate:zkvm:stark-receipt:v1",
+      "description": "Verifiable computation receipt from a zkVM/STARK prover. Proves that a computation was executed correctly without revealing private inputs.",
+      "required_fields": [
+        "program_digest",
+        "public_inputs_digest",
+        "output_digest",
+        "proof_system",
+        "verifier_key_digest",
+        "proof_bytes_digest"
+      ],
+      "binding": "output_digest MUST bind the execution output being claimed; program_digest MUST bind the exact program/ circuit under evaluation.",
+      "note": "The verifier MUST know the allowed verifier_key_digest and proof_system ahead of time; a proof alone does not establish which circuit it proves.",
+      "evaluator_status": "PENDING",
+      "privacy_limit": "Verifiable execution does not automatically imply zero knowledge; privacy depends on the selected proof system and its configuration."
+    },
+    {
+      "family_id": "predicate:agent-tool-contract:v1",
+      "description": "Cryptographically signed, content-addressed tool contract for AI agents (e.g. Glyph Protocol or an equivalent signed MCP tool card).",
+      "required_fields": [
+        "tool_schema_digest",
+        "intent",
+        "cost",
+        "risk",
+        "reversibility",
+        "signature",
+        "canonical_digest"
+      ],
+      "binding": "canonical_digest MUST bind the full contract; tool_schema_digest MUST bind the executable schema. Runtime execution receipts MUST reference this digest.",
+      "evaluator_status": "PENDING",
+      "standardization": "Arkhe proposed profile, not a normative MCP or external industry standard."
+    },
+    {
+      "family_id": "predicate:agent-runtime-evidence:v1",
+      "description": "Sealed runtime evidence from an agent runtime (e.g. AgentHook runtime attestation).",
+      "required_fields": [
+        "session_id",
+        "nonce",
+        "gated_events",
+        "fail_mode",
+        "issued_at",
+        "signature"
+      ],
+      "binding": "nonce MUST be verifier-supplied or session-bound; gated_events MUST cover PreToolUse and PostToolUse for any tool execution claim.",
+      "fail_closed": "Runtime evidence MUST fail closed on missing gates or invalid signatures.",
+      "evaluator_status": "PENDING",
+      "standardization": "Arkhe proposed profile, not a normative MCP or external industry standard."
+    }
+  ],
+  "research_sources": [
+    "https://slsa.dev/spec/v1.2/build-provenance",
+    "https://github.com/secure-systems-lab/dsse/blob/master/protocol.md",
+    "https://github.com/in-toto/attestation/blob/main/spec/v1/statement.md",
+    "https://www.rfc-editor.org/rfc/rfc9943.html",
+    "https://docs.sigstore.dev/about/bundle/",
+    "https://cyclonedx.org/specification/overview/",
+    "https://trustedcomputinggroup.org/wp-content/uploads/DICE-Attestation-Architecture-Version-1.1-Revision-18_pub.pdf"
+  ]
+}
