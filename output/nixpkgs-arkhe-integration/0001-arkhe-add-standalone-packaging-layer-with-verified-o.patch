+//! Proposed Unity transport summary v1; not the backend replay summary or verifier ABI.
+use crate::{CanonicalEncode, Digest32};
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct MatchSummary {
+    pub version: u8,
+    pub session_id: Digest32,
+    pub player_id: Digest32,
+    pub stage_seed: Digest32,
+    pub input_digest: Digest32,
+    pub state_hash: Digest32,
+    pub survival_ms: u32,
+    pub projectiles_absorbed: u32,
+    pub waves_cleared: u16,
+    pub bosses_defeated: u16,
+    pub final_score: u64,
+}
+
+impl MatchSummary {
+    /// Envelope constraints mirrored from Unity's MatchSubmissionGate.
+    pub fn validate(&self) -> Result<(), &'static str> {
+        if self.version != 1 {
+            return Err("unsupported MatchSummary version");
+        }
+        if self.survival_ms == 0 || self.survival_ms > 1_800_000 {
+            return Err("survival_ms outside Unity envelope bounds");
+        }
+        Ok(())
+    }
+}
+
+impl CanonicalEncode for MatchSummary {
+    const DOMAIN_OBJECT: &'static [u8] = b"AKG:MATCH_SUMMARY:v1\0";
+
+    fn unsigned_projection(&self) -> serde_json::Value {
+        serde_json::to_value(self).expect("typed MatchSummary")
+    }
+
+    fn canonical_bytes(&self) -> Vec<u8> {
+        let mut fields = self.unsigned_projection().as_object().unwrap().clone();
+        for name in [
+            "session_id",
+            "player_id",
+            "stage_seed",
+            "input_digest",
+            "state_hash",
+        ] {
+            fields.remove(name);
+        }
+        crate::canonical::encode_map_with_bytes(
+            &fields,
+            &[
+                ("session_id", &self.session_id.0),
+                ("player_id", &self.player_id.0),
+                ("stage_seed", &self.stage_seed.0),
+                ("input_digest", &self.input_digest.0),
+                ("state_hash", &self.state_hash.0),
+            ],
+        )
+        .expect("unique typed digest fields")
+    }
+}
diff --git a/arkhe/source/kernel/arkhe-core/src/output_proof.rs b/arkhe/source/kernel/arkhe-core/src/output_proof.rs
new file mode 100644
index 00000000..ff0227f0
--- /dev/null
+++ b/arkhe/source/kernel/arkhe-core/src/output_proof.rs
@@ -0,0 +1,69 @@
+//! Bounded arithmetic certificate data. No authority, proof checking or effects.
+use crate::{canonical::encode_value, Digest32};
+use serde::{Deserialize, Serialize};
+
+pub const BUDGET_CHECKER: &str = "arkhe/budget-sum-checker/v1";
+pub const MAX_BUDGET_ITEMS: usize = 256;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct BudgetSpec {
+    pub version: u16,
+    pub limit: u64,
+    pub max_items: u16,
+}
+impl BudgetSpec {
+    pub fn digest(&self) -> Digest32 {
+        digest(b"AKG:PCO:BUDGET-SPEC:v1\0", &(BUDGET_CHECKER, self))
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct BudgetInput {
+    /// Integer minor units. The host authenticates their provenance separately.
+    pub costs: Vec<u64>,
+}
+impl BudgetInput {
+    pub fn digest(&self) -> Digest32 {
+        digest(b"AKG:PCO:BUDGET-INPUT:v1\0", self)
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct BudgetOutput {
+    pub total: u64,
+}
+impl BudgetOutput {
+    pub fn digest(&self) -> Digest32 {
+        digest(b"AKG:PCO:BUDGET-OUTPUT:v1\0", self)
+    }
+}
+
+/// A finite arithmetic derivation: s[0]=0, s[i+1]=s[i]+cost[i], total=s[n]<=limit.
+/// Bindings prevent transplanting a valid derivation to a different authorization.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct BudgetProof {
+    pub checker: String,
+    pub spec_digest: Digest32,
+    pub policy_digest: Digest32,
+    pub intent_digest: Digest32,
+    pub worker_digest: Digest32,
+    pub input: BudgetInput,
+    pub output: BudgetOutput,
+    pub prefix_totals: Vec<u64>,
+}
+impl BudgetProof {
+    pub fn digest(&self) -> Digest32 {
+        digest(b"AKG:PCO:BUDGET-PROOF:v1\0", self)
+    }
+}
+
+fn digest(domain: &[u8], value: &impl Serialize) -> Digest32 {
+    Digest32::blake3(
+        domain,
+        &encode_value(&serde_json::to_value(value).expect("typed integer proof data")),
+    )
+}
