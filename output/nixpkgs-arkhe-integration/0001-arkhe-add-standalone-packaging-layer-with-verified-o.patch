+    .bind(query.clone())
+    .fetch_all(&mut *conn)
+    .await
+    .unwrap();
+    drop(conn);
+    // The held second connection forces retrieve and the final inspection onto
+    // the same backend. The production transaction must undo its SET LOCAL.
+    let result = store.retrieve("small", "Sydney", 10).await;
+    let mut conn = pool.acquire().await.unwrap();
+    let restored: (i32, String) =
+        sqlx::query_as("SELECT pg_backend_pid(), current_setting('hnsw.iterative_scan')")
+            .fetch_one(&mut *conn)
+            .await
+            .unwrap();
+    // Run a failing retrieval as well; its transaction must roll back.
+    let query_error = store.retrieve("small", "Sydney", usize::MAX);
+    drop(conn);
+    let failed = query_error.await;
+    let restored_after_error: (i32, String) =
+        sqlx::query_as("SELECT pg_backend_pid(), current_setting('hnsw.iterative_scan')")
+            .fetch_one(pool)
+            .await
+            .unwrap();
+    drop(held);
+    cleanup_shared(&store, admin, schema).await;
+    let plan = plan.into_iter().map(|r| r.0).collect::<Vec<_>>().join("\n");
+    assert!(
+        plan.contains("chunks_embedding_idx"),
+        "HNSW was not exercised: {plan}"
+    );
+    assert!(
+        baseline.len() < 10,
+        "fixture did not discriminate iterative scanning"
+    );
+    let rows = result.unwrap();
+    assert_eq!(rows.len(), 10);
+    assert!(rows.iter().all(|c| c.tenant_id == "small"));
+    assert_eq!(
+        rows.iter().map(|c| c.id.as_str()).collect::<Vec<_>>(),
+        (1..=10).map(|i| format!("b-{i:02}")).collect::<Vec<_>>()
+    );
+    assert_eq!(restored, (pid, "off".into()));
+    assert!(failed.is_err());
+    assert_eq!(restored_after_error, (pid, "off".into()));
+    let compact_plan = plan
+        .lines()
+        .filter(|line| !line.contains("Order By:"))
+        .collect::<Vec<_>>()
+        .join("\n");
+    eprintln!(
+        "HNSW tenant fixture: baseline={} iterative={}\n{compact_plan}",
+        baseline.len(),
+        rows.len()
+    );
+}
diff --git a/arkhe/source/apps/arkhe-ask/tests/support/mod.rs b/arkhe/source/apps/arkhe-ask/tests/support/mod.rs
new file mode 100644
index 00000000..ea62360d
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/tests/support/mod.rs
@@ -0,0 +1,40 @@
+use arkhe_ask::events::PgProofJournal;
+pub async fn fixture() -> (PgProofJournal, sqlx::PgPool, String) {
+    let url = std::env::var("DATABASE_URL").expect("DATABASE_URL");
+    let admin = sqlx::PgPool::connect(&url).await.unwrap();
+    sqlx::query("CREATE EXTENSION IF NOT EXISTS vector")
+        .execute(&admin)
+        .await
+        .unwrap();
+    let schema = format!("ask_event_test_{}", uuid::Uuid::new_v4().simple());
+    sqlx::query(&format!("CREATE SCHEMA {schema}"))
+        .execute(&admin)
+        .await
+        .unwrap();
+    sqlx::query(&format!("CREATE TABLE {schema}.chunks(id TEXT PRIMARY KEY,text TEXT NOT NULL,embedding vector(1536) NOT NULL)"))
+        .execute(&admin).await.unwrap();
+    sqlx::query(&format!("CREATE TABLE {schema}._sqlx_migrations(version BIGINT PRIMARY KEY,description TEXT NOT NULL,installed_on TIMESTAMPTZ NOT NULL DEFAULT now(),success BOOLEAN NOT NULL,checksum BYTEA NOT NULL,execution_time BIGINT NOT NULL)"))
+        .execute(&admin).await.unwrap();
+    let path = format!("SET search_path TO {schema}, public");
+    let pool = sqlx::postgres::PgPoolOptions::new()
+        .max_connections(4)
+        .after_connect(move |conn, _| {
+            let path = path.clone();
+            Box::pin(async move {
+                sqlx::query(&path).execute(conn).await?;
+                Ok(())
+            })
+        })
+        .connect(&url)
+        .await
+        .unwrap();
+    (PgProofJournal::connect(pool).await.unwrap(), admin, schema)
+}
+pub async fn cleanup(journal: &PgProofJournal, admin: sqlx::PgPool, schema: String) {
+    journal.pool().close().await;
+    sqlx::query(&format!("DROP SCHEMA {schema} CASCADE"))
+        .execute(&admin)
+        .await
+        .unwrap();
+    admin.close().await;
+}
diff --git a/arkhe/source/apps/arkhe-ask/tests/telemetry.rs b/arkhe/source/apps/arkhe-ask/tests/telemetry.rs
new file mode 100644
index 00000000..71d84c43
--- /dev/null
+++ b/arkhe/source/apps/arkhe-ask/tests/telemetry.rs
@@ -0,0 +1,165 @@
+use arkhe_ask::{
+    events::ProofJournal,
+    pipeline::{CitationProof, StoredChunk},
+    providers::{EchoProvider, InMemoryStore},
+    router_with_journal,
+};
+use async_trait::async_trait;
+use axum::{
+    body::Body,
+    http::{Request, StatusCode},
+};
+use http_body_util::BodyExt;
+use opentelemetry::{global, trace::TracerProvider};
+use opentelemetry_sdk::{
+    propagation::TraceContextPropagator,
+    trace::{InMemorySpanExporter, SdkTracerProvider},
+};
+use std::sync::Arc;
+use tower::ServiceExt;
+use tracing::instrument::WithSubscriber;
+use tracing_subscriber::layer::SubscriberExt;
+
+struct Journal;
+#[async_trait]
+impl ProofJournal for Journal {
+    async fn record(&self, _: &CitationProof) -> Result<(), String> {
+        Ok(())
+    }
+}
+
+#[tokio::test]
+async fn metrics_and_spans_include_failures_and_pipeline_without_sensitive_labels() {
+    global::set_text_map_propagator(TraceContextPropagator::new());
+    let exporter = InMemorySpanExporter::default();
+    let provider = SdkTracerProvider::builder()
+        .with_simple_exporter(exporter.clone())
+        .build();
+    let subscriber = tracing_subscriber::registry()
+        .with(tracing_opentelemetry::layer().with_tracer(provider.tracer("test")));
+    let app = router_with_journal(
+        Box::new(InMemoryStore {
+            chunks: vec![StoredChunk {
+                tenant_id: "tenant-sensitive".into(),
+                id: "e1".into(),
+                text: "Melbourne is in Victoria.".into(),
+            }],
+        }),
+        Box::new(EchoProvider),
+        None,
+        Arc::new(Journal),
+    );
+    let request = Request::post("/v1/ask?secret_query_marker=1")
+        .header("content-type", "application/json")
+        .header("x-tenant-id", "tenant-sensitive")
+        .header("authorization", "Bearer token-sensitive")
+        .header(
+            "traceparent",
+            "00-0123456789abcdef0123456789abcdef-0123456789abcdef-01",
+        )
+        .body(Body::from(r#"{"query":"body-sensitive"}"#))
+        .unwrap();
+    async {
+        let response = app.clone().oneshot(request).await.unwrap();
+        assert_eq!(response.status(), StatusCode::OK);
+        response.into_body().collect().await.unwrap();
+        let unauthorized = app
+            .clone()
+            .oneshot(
+                Request::post("/v1/ask")
+                    .header("content-type", "application/json")
+                    .body(Body::from(r#"{"query":"x"}"#))
+                    .unwrap(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(unauthorized.status(), StatusCode::UNAUTHORIZED);
+        unauthorized.into_body().collect().await.unwrap();
+        app.clone()
+            .oneshot(
+                Request::get("/unknown/path-sensitive")
+                    .body(Body::empty())
+                    .unwrap(),
+            )
+            .await
+            .unwrap()
+            .into_body()
+            .collect()
+            .await
+            .unwrap();
+        let response = app
+            .oneshot(Request::get("/metrics").body(Body::empty()).unwrap())
+            .await
+            .unwrap();
+        assert_eq!(response.status(), StatusCode::OK);
+        assert!(response.headers()["content-type"]
+            .to_str()
+            .unwrap()
+            .starts_with("text/plain"));
+        let bytes = response.into_body().collect().await.unwrap().to_bytes();
+        let metrics = String::from_utf8(bytes.to_vec()).unwrap();
+        assert!(metrics.contains("axum_http_requests_total"));
+        assert!(metrics.contains("arkhe_gate_decisions_total"));
+        assert!(metrics.contains("status=\"401\""));
+        assert!(metrics.contains("axum_http_requests_duration_seconds_bucket"));
+        assert!(metrics.contains("unmatched"));
+        for secret in [
+            "tenant-sensitive",
+            "token-sensitive",
+            "secret_query_marker",
+            "body-sensitive",
+            "path-sensitive",
+        ] {
+            assert!(!metrics.contains(secret), "metric leaked {secret}");
+        }
+    }
+    .with_subscriber(subscriber)
+    .await;
+    provider.force_flush().unwrap();
+    let spans = exporter.get_finished_spans().unwrap();
+    for expected in [
+        "POST /v1/ask",
+        "arkhe.ask.rag.retrieve",
+        "arkhe.ask.rag.generate",
+        "arkhe.ask.rag.verify",
+        "arkhe.ask.proof.enqueue",
+    ] {
+        assert!(
+            spans.iter().any(|s| s.name == expected),
+            "missing {expected}"
+        );
+    }
+    let traced: Vec<_> = spans
+        .iter()
+        .filter(|s| s.span_context.trace_id().to_string() == "0123456789abcdef0123456789abcdef")
+        .collect();
+    assert_eq!(
+        traced.len(),
+        5,
+        "HTTP and its four pipeline child spans must share the supplied trace"
+    );
+    let root = traced.iter().find(|s| s.name == "POST /v1/ask").unwrap();
+    assert_eq!(root.parent_span_id.to_string(), "0123456789abcdef");
+    for child in traced.iter().filter(|s| s.name != "POST /v1/ask") {
+        assert_eq!(
+            child.parent_span_id,
+            root.span_context.span_id(),
+            "{} is not a sibling under HTTP",
+            child.name
+        );
+    }
+    let attributes = format!(
+        "{:?}",
+        spans.iter().map(|s| &s.attributes).collect::<Vec<_>>()
+    );
+    for secret in [
+        "tenant-sensitive",
+        "token-sensitive",
+        "secret_query_marker",
+        "body-sensitive",
+        "path-sensitive",
+    ] {
+        assert!(!attributes.contains(secret), "span leaked {secret}");
+    }
+    provider.shutdown().unwrap();
+}
