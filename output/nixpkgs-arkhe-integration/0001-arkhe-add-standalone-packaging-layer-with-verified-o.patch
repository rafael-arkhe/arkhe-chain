diff --git a/arkhe/source/integration/arkhe-crm-bridge/src/lib.rs b/arkhe/source/integration/arkhe-crm-bridge/src/lib.rs
new file mode 100644
index 00000000..9b93bd03
--- /dev/null
+++ b/arkhe/source/integration/arkhe-crm-bridge/src/lib.rs
@@ -0,0 +1,148 @@
+use anyhow::{ensure, Result};
+use arkhe_verify_core::mmr::{build_root_and_proof, verify_proof, ProofStep};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+pub mod salesforce;
+pub mod storage;
+pub mod v2;
+
+/// A single field observation, not an attestation by the named source.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ProvenanceRecord {
+    pub org_id: String,
+    pub object: String,
+    pub record_id: String,
+    pub field: String,
+    pub value: Value,
+    pub source_system: String,
+    pub observed_at: String,
+}
+
+impl ProvenanceRecord {
+    pub fn hash(&self) -> Result<Vec<u8>> {
+        for s in [
+            &self.org_id,
+            &self.object,
+            &self.record_id,
+            &self.field,
+            &self.source_system,
+        ] {
+            ensure!(
+                !s.trim().is_empty(),
+                "identity and source fields must be nonempty"
+            );
+        }
+        chrono::DateTime::parse_from_rfc3339(&self.observed_at)?;
+        // Phase 1 accepts Salesforce scalar fields only. This avoids inventing a
+        // cross-language canonicalization scheme for nested JSON and floats.
+        ensure!(
+            matches!(&self.value, Value::Null | Value::Bool(_) | Value::String(_))
+                || self.value.as_i64().is_some()
+                || self.value.as_u64().is_some(),
+            "value must be null, boolean, string or integer"
+        );
+        let mut hasher = blake3::Hasher::new_derive_key("arkhe.crm.provenance.record.v1");
+        hasher.update(&serde_json::to_vec(self)?);
+        Ok(hasher.finalize().as_bytes().to_vec())
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Bundle {
+    pub schema: u32,
+    pub record: ProvenanceRecord,
+    pub record_hash: String,
+    pub leaf_count: usize,
+    pub root: String,
+    pub proof: Vec<ProofStep>,
+}
+
+pub fn anchor(records: &[ProvenanceRecord]) -> Result<Bundle> {
+    ensure!(!records.is_empty(), "empty journal");
+    let leaves = records
+        .iter()
+        .map(ProvenanceRecord::hash)
+        .collect::<Result<Vec<_>>>()?;
+    let (root, proof) = build_root_and_proof(&leaves, records.len() - 1)?;
+    Ok(Bundle {
+        schema: 1,
+        record: records.last().unwrap().clone(),
+        record_hash: hex::encode(leaves.last().unwrap()),
+        leaf_count: leaves.len(),
+        root: hex::encode(root),
+        proof,
+    })
+}
+
+/// Trust must come from a root obtained independently of the untrusted bundle.
+pub fn verify(bundle: &Bundle, trusted_root: &str) -> Result<()> {
+    ensure!(bundle.schema == 1, "unsupported schema");
+    let root: [u8; 32] = hex::decode(trusted_root)?
+        .try_into()
+        .map_err(|_| anyhow::anyhow!("trusted root must be 32 bytes"))?;
+    ensure!(
+        hex::decode(&bundle.root)? == root,
+        "root differs from trusted checkpoint"
+    );
+    let leaf = bundle.record.hash()?;
+    ensure!(
+        hex::encode(&leaf) == bundle.record_hash,
+        "record hash mismatch"
+    );
+    ensure!(
+        verify_proof(&leaf, bundle.leaf_count, &bundle.proof, &root)?,
+        "invalid inclusion proof"
+    );
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn record() -> ProvenanceRecord {
+        serde_json::from_str(include_str!("../fixtures/lead.json")).unwrap()
+    }
+    #[test]
+    fn roundtrip_and_tamper_detection() {
+        let mut records = Vec::new();
+        for i in 0..17 {
+            let mut r = record();
+            r.record_id = format!("lead-{i}");
+            records.push(r);
+            let b = anchor(&records).unwrap();
+            verify(&b, &b.root).unwrap();
+            let mut bad = b.clone();
+            bad.record.value = Value::String("tampered".into());
+            assert!(verify(&bad, &b.root).is_err());
+            let mut bad = b.clone();
+            bad.record.source_system = "forged".into();
+            assert!(verify(&bad, &b.root).is_err());
+            let mut bad = b.clone();
+            bad.root = "00".repeat(32);
+            assert!(verify(&bad, &b.root).is_err());
+            if let Some(step) = bad.proof.first_mut() {
+                step.hash[0] ^= 1;
+            }
+            bad.root = b.root.clone();
+            if !bad.proof.is_empty() {
+                assert!(verify(&bad, &b.root).is_err());
+            }
+        }
+    }
+    #[test]
+    fn rejects_unsupported_values_and_invalid_identity() {
+        let mut r = record();
+        r.value = serde_json::json!({"nested":true});
+        assert!(r.hash().is_err());
+        r = record();
+        r.observed_at = "yesterday".into();
+        assert!(r.hash().is_err());
+        r = record();
+        r.org_id.clear();
+        assert!(r.hash().is_err());
+        assert!(anchor(&[]).is_err());
+    }
+}
diff --git a/arkhe/source/integration/arkhe-crm-bridge/src/main.rs b/arkhe/source/integration/arkhe-crm-bridge/src/main.rs
new file mode 100644
index 00000000..309a5ad8
--- /dev/null
+++ b/arkhe/source/integration/arkhe-crm-bridge/src/main.rs
@@ -0,0 +1,176 @@
+use anyhow::Result;
+use arkhe_crm_bridge_cli::{
+    salesforce::WriteIntent,
+    storage::Store,
+    v2::{self, Bundle, Event, Policy, Request},
+};
+use clap::{Parser, Subcommand};
+use serde::de::DeserializeOwned;
+use std::{
+    fs::{self, OpenOptions},
+    io::Write,
+    path::PathBuf,
+};
+
+#[derive(Parser)]
+#[command(about = "Signed CRM provenance bridge, protocol v2")]
+struct Cli {
+    #[command(subcommand)]
+    command: Command,
+}
+#[derive(Subcommand)]
+enum Command {
+    /// Producer signs the exact Salesforce SystemModstamp, without changing protocol v2.
+    SignWrite {
+        #[arg(long)]
+        proof: PathBuf,
+        #[arg(long)]
+        policy: PathBuf,
+        #[arg(long)]
+        expected_version: String,
+        #[arg(long)]
+        secret: PathBuf,
+    },
+    /// Verify a signed write intent; optionally emit a fresh sandbox approval payload.
+    PrepareWrite {
+        #[arg(long)]
+        input: PathBuf,
+        #[arg(long)]
+        policy: PathBuf,
+        #[arg(long)]
+        org_id: String,
+        #[arg(long)]
+        historical: bool,
+    },
+    /// Create a private key file exclusively; prints only its public key.
+    Keygen {
+        #[arg(long)]
+        secret: PathBuf,
+    },
+    /// Producer-side signing of a versioned event.
+    Sign {
+        #[arg(long)]
+        input: PathBuf,
+        #[arg(long)]
+        secret: PathBuf,
+    },
+    /// Authenticate, authorize and atomically persist an event and checkpoint.
+    Anchor {
+        #[arg(long)]
+        input: PathBuf,
+        #[arg(long)]
+        database: PathBuf,
+        #[arg(long)]
+        policy: PathBuf,
+        #[arg(long)]
+        secret: PathBuf,
+    },
+    /// Offline verification using an independently distributed trust policy.
+    Verify {
+        #[arg(long)]
+        proof: PathBuf,
+        #[arg(long)]
+        policy: PathBuf,
+    },
+    /// Recover a committed response after interrupted delivery.
+    Export {
+        #[arg(long)]
+        event_id: String,
+        #[arg(long)]
+        database: PathBuf,
+        #[arg(long)]
+        policy: PathBuf,
+    },
+}
+fn read<T: DeserializeOwned>(path: PathBuf) -> Result<T> {
+    Ok(serde_json::from_slice(&fs::read(path)?)?)
+}
+fn key(path: PathBuf) -> Result<ed25519_dalek::SigningKey> {
+    v2::signing_key(&fs::read_to_string(path)?)
+}
+fn print<T: serde::Serialize>(value: &T) -> Result<()> {
+    println!("{}", serde_json::to_string_pretty(value)?);
+    Ok(())
+}
+fn main() -> Result<()> {
+    match Cli::parse().command {
+        Command::SignWrite {
+            proof,
+            policy,
+            expected_version,
+            secret,
+        } => {
+            print(&WriteIntent::sign(
+                read(proof)?,
+                expected_version,
+                &key(secret)?,
+                &read(policy)?,
+            )?)?;
+        }
+        Command::PrepareWrite {
+            input,
+            policy,
+            org_id,
+            historical,
+        } => {
+            let intent: WriteIntent = read(input)?;
+            let policy: Policy = read(policy)?;
+            intent.verify(&policy)?;
+            anyhow::ensure!(
+                intent.bundle.request.event.record.org_id == org_id,
+                "wrong org"
+            );
+            if historical {
+                // No approval is emitted on this path: expired evidence cannot authorize a write.
+                println!("verified-historical");
+            } else {
+                let now = std::time::SystemTime::now()
+                    .duration_since(std::time::UNIX_EPOCH)?
+                    .as_secs();
+                print(&intent.approval(&policy, &org_id, now)?)?;
+            }
+        }
+        Command::Keygen { secret } => {
+            let mut bytes = [0u8; 32];
+            getrandom::getrandom(&mut bytes)
+                .map_err(|e| anyhow::anyhow!("OS randomness unavailable: {e}"))?;
+            let key = ed25519_dalek::SigningKey::from_bytes(&bytes);
+            let mut options = OpenOptions::new();
+            options.write(true).create_new(true);
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::OpenOptionsExt;
+                options.mode(0o600);
+            }
+            let mut file = options.open(secret)?;
+            file.write_all(hex::encode(bytes).as_bytes())?;
+            file.sync_all()?;
+            println!("{}", v2::public_key(&key));
+        }
+        Command::Sign { input, secret } => {
+            print(&Request::sign(read::<Event>(input)?, &key(secret)?)?)?
+        }
+        Command::Anchor {
+            input,
+            database,
+            policy,
+            secret,
+        } => {
+            let policy: Policy = read(policy)?;
+            let now = std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)?
+                .as_secs();
+            print(&Store::open(&database)?.anchor(read(input)?, &policy, &key(secret)?, now)?)?;
+        }
+        Command::Verify { proof, policy } => {
+            v2::verify(&read::<Bundle>(proof)?, &read::<Policy>(policy)?)?;
+            println!("valid");
+        }
+        Command::Export {
+            event_id,
+            database,
+            policy,
+        } => print(&Store::open(&database)?.export(&event_id, &read::<Policy>(policy)?)?)?,
+    }
+    Ok(())
+}
diff --git a/arkhe/source/integration/arkhe-crm-bridge/src/salesforce.rs b/arkhe/source/integration/arkhe-crm-bridge/src/salesforce.rs
new file mode 100644
index 00000000..1f3155fd
--- /dev/null
+++ b/arkhe/source/integration/arkhe-crm-bridge/src/salesforce.rs
@@ -0,0 +1,134 @@
+//! A producer-signed write intent binds the Salesforce version to a verified v2 bundle.
+use crate::v2::{self, Bundle, Policy};
+use anyhow::{ensure, Context, Result};
+use ed25519_dalek::{Signature, Signer, SigningKey, VerifyingKey};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct WriteIntent {
+    pub schema: u32,
+    pub bundle: Bundle,
+    pub expected_version: String,
+    pub signature: String,
+}
+
+impl WriteIntent {
+    fn canonical(&self) -> Result<Vec<u8>> {
+        ensure!(self.schema == 1, "unsupported write intent");
+        let stamp = chrono::DateTime::parse_from_rfc3339(&self.expected_version)?;
+        ensure!(
+            stamp.to_rfc3339_opts(chrono::SecondsFormat::Millis, true) == self.expected_version,
+            "expected version must be exact UTC RFC3339 milliseconds ending Z"
+        );
+        let mut bytes = Vec::new();
+        for part in [
+            "arkhe.crm.salesforce.write.v1".to_owned(),
+            self.bundle.request.event.hash()?,
+            self.bundle.checkpoint.hash()?,
+            self.expected_version.clone(),
+        ] {
+            bytes.extend_from_slice(&(part.len() as u64).to_be_bytes());
+            bytes.extend_from_slice(part.as_bytes());
+        }
+        Ok(bytes)
+    }
+
+    pub fn sign(
+        bundle: Bundle,
+        expected_version: String,
+        key: &SigningKey,
+        policy: &Policy,
+    ) -> Result<Self> {
+        let mut intent = Self {
+            schema: 1,
+            bundle,
+            expected_version,
+            signature: String::new(),
+        };
+        intent.signature = hex::encode(key.sign(&intent.canonical()?).to_bytes());
+        intent.verify(policy)?;
+        Ok(intent)
+    }
+
+    /// Historical verification is allowed for reconciliation even after expiry.
+    pub fn verify(&self, policy: &Policy) -> Result<()> {
+        v2::verify(&self.bundle, policy)?;
+        let producer = policy
+            .producers
+            .iter()
+            .find(|p| p.id == self.bundle.request.event.producer_id)
+            .context("unknown write producer")?;
+        ensure!(self.signature.len() == 128, "invalid write signature");
+        VerifyingKey::from_bytes(&v2::bytes32(&producer.public_key)?)?.verify_strict(
+            &self.canonical()?,
+            &Signature::from_slice(&hex::decode(&self.signature)?)?,
+        )?;
+        Ok(())
+    }
+
+    pub fn approval(&self, policy: &Policy, org_id: &str, now: u64) -> Result<Value> {
+        self.verify(policy)?;
+        let event = &self.bundle.request.event;
+        event_request_fresh(&self.bundle, policy, now)?;
+        let record = &event.record;
+        ensure!(record.org_id == org_id, "write targets another org");
+        ensure!(
+            valid_id(org_id, "00D") && valid_id(&record.record_id, "00Q"),
+            "18-character Salesforce IDs required"
+        );
+        ensure!(
+            record.object == "Lead"
+                && [
+                    "LeadSource",
+                    "Arkhe_Test_1__c",
+                    "Arkhe_Test_2__c",
+                    "Arkhe_Test_3__c",
+                    "Arkhe_Test_4__c"
+                ]
+                .contains(&record.field.as_str()),
+            "unsupported Salesforce scope"
+        );
+        ensure!(
+            event.event_id.len() <= 255 && event.producer_id.len() <= 255,
+            "Salesforce identity too long"
+        );
+        ensure!(
+            record.value.is_null()
+                || record
+                    .value
+                    .as_str()
+                    .is_some_and(|s| !s.is_empty() && s.encode_utf16().count() <= 255),
+            "only null or nonempty text up to 255 characters supported"
+        );
+        let expires = chrono::DateTime::from_timestamp(i64::try_from(event.expires_at)?, 0)
+            .context("invalid expiry")?;
+        Ok(
+            json!({"Event_Id__c":event.event_id,"Org_Id__c":org_id,"Target_Lead__c":record.record_id,
+            "Field_API_Name__c":record.field,"New_Value__c":record.value,"Is_Null__c":record.value.is_null(),
+            "Expected_Version__c":self.expected_version,"Expires_At__c":expires.to_rfc3339_opts(chrono::SecondsFormat::Millis,true),
+            "Checkpoint_Hash__c":self.bundle.checkpoint.hash()?,"Request_Hash__c":blake3::hash(&self.canonical()?).to_hex().to_string(),
+            "Producer_Id__c":event.producer_id}),
+        )
+    }
+}
+
+fn event_request_fresh(bundle: &Bundle, policy: &Policy, now: u64) -> Result<()> {
+    bundle.request.fresh_at(policy, now)?;
+    ensure!(
+        bundle.request.event.expires_at > now && bundle.request.event.expires_at - now <= 300,
+        "approval expiry must be within the next five minutes"
+    );
+    ensure!(
+        bundle.checkpoint.issued_at <= now.saturating_add(policy.future_skew_secs),
+        "future checkpoint"
+    );
+    Ok(())
+}
+
+fn valid_id(value: &str, prefix: &str) -> bool {
+    value.len() == 18
+        && value.starts_with(prefix)
+        && value.bytes().all(|b| b.is_ascii_alphanumeric())
+}
diff --git a/arkhe/source/integration/arkhe-crm-bridge/src/storage.rs b/arkhe/source/integration/arkhe-crm-bridge/src/storage.rs
new file mode 100644
index 00000000..09182014
--- /dev/null
+++ b/arkhe/source/integration/arkhe-crm-bridge/src/storage.rs
@@ -0,0 +1,164 @@
+use crate::v2::{self, Bundle, Checkpoint, Policy, Request};
+use anyhow::{ensure, Context, Result};
+use arkhe_verify_core::mmr::build_root_and_proof;
+use ed25519_dalek::SigningKey;
+use rusqlite::{params, Connection, OptionalExtension, TransactionBehavior};
+use std::{path::Path, time::Duration};
+
+pub struct Store {
+    connection: Connection,
+}
+impl Store {
+    pub fn open(path: &Path) -> Result<Self> {
+        let connection = Connection::open(path)?;
+        connection.busy_timeout(Duration::from_secs(10))?;
+        connection.pragma_update(None, "journal_mode", "WAL")?;
+        connection.pragma_update(None, "synchronous", "FULL")?;
+        connection.execute_batch(
+            "CREATE TABLE IF NOT EXISTS bridge_meta (
+                singleton INTEGER PRIMARY KEY CHECK(singleton=1), policy_hash TEXT NOT NULL);
+             CREATE TABLE IF NOT EXISTS bridge_events (
+                sequence INTEGER PRIMARY KEY, event_id TEXT NOT NULL UNIQUE,
+                event_hash TEXT NOT NULL, bundle TEXT NOT NULL);",
+        )?;
+        Ok(Self { connection })
+    }
+    /// Commit event, replay key and response atomically; exact retries return the saved response.
+    pub fn anchor(
+        &mut self,
+        request: Request,
+        policy: &Policy,
+        key: &SigningKey,
+        now: u64,
+    ) -> Result<Bundle> {
+        request.authenticate(policy)?;
+        ensure!(
+            v2::public_key(key) == policy.bridge_public_key,
+            "wrong bridge signing key"
+        );
+        let policy_hash = policy.hash()?;
+        let event_hash = request.event.hash()?;
+        let tx = self
+            .connection
+            .transaction_with_behavior(TransactionBehavior::Immediate)?;
+        let pinned: Option<String> = tx
+            .query_row(
+                "SELECT policy_hash FROM bridge_meta WHERE singleton=1",
+                [],
+                |r| r.get(0),
+            )
+            .optional()?;
+        if let Some(pinned) = pinned {
+            ensure!(
+                pinned == policy_hash,
+                "policy migration requires explicit separate procedure"
+            );
+        } else {
+            tx.execute("INSERT INTO bridge_meta VALUES (1, ?1)", [&policy_hash])?;
+        }
+        let mut leaves = Vec::new();
+        let mut previous = "00".repeat(32);
+        let mut last_time = 0;
+        let mut retry = None;
+        {
+            let mut statement = tx.prepare("SELECT sequence, event_id, event_hash, bundle FROM bridge_events ORDER BY sequence")?;
+            let rows = statement.query_map([], |r| {
+                Ok((
+                    r.get::<_, u64>(0)?,
+                    r.get::<_, String>(1)?,
+                    r.get::<_, String>(2)?,
+                    r.get::<_, String>(3)?,
+                ))
+            })?;
+            for row in rows {
+                let (sequence, id, hash, json) = row?;
+                let saved: Bundle = serde_json::from_str(&json)?;
+                v2::verify(&saved, policy)?;
+                ensure!(
+                    sequence == leaves.len() as u64 + 1 && saved.checkpoint.leaf_count == sequence,
+                    "journal sequence mismatch"
+                );
+                ensure!(
+                    saved.request.event.event_id == id && saved.record_hash == hash,
+                    "journal identity mismatch"
+                );
+                ensure!(
+                    saved.checkpoint.previous_checkpoint_hash == previous
+                        && saved.checkpoint.issued_at >= last_time,
+                    "broken checkpoint chain"
+                );
+                leaves.push(v2::bytes32(&hash)?.to_vec());
+                let (root, _) = build_root_and_proof(&leaves, leaves.len() - 1)?;
+                ensure!(
+                    hex::encode(root) == saved.checkpoint.root,
+                    "journal root mismatch"
+                );
+                previous = saved.checkpoint.hash()?;
+                last_time = saved.checkpoint.issued_at;
+                if id == request.event.event_id {
+                    ensure!(
+                        hash == event_hash && saved.request.signature == request.signature,
+                        "replay conflict: event_id already used"
+                    );
+                    retry = Some(saved);
+                }
+            }
+        }
+        if let Some(bundle) = retry {
+            tx.commit()?;
+            return Ok(bundle);
+        }
+        request.fresh_at(policy, now)?;
+        ensure!(now >= last_time, "bridge clock moved backwards");
+        leaves.push(v2::bytes32(&event_hash)?.to_vec());
+        let (root, proof) = build_root_and_proof(&leaves, leaves.len() - 1)?;
+        let checkpoint = Checkpoint {
+            schema: 2,
+            log_id: policy.log_id.clone(),
+            root: hex::encode(root),
+            leaf_count: leaves.len() as u64,
+            previous_checkpoint_hash: previous,
+            issued_at: now,
+            policy_hash,
+        };
+        let checkpoint_signature = checkpoint.sign(key)?;
+        let bundle = Bundle {
+            schema: 2,
+            request,
+            record_hash: event_hash,
+            checkpoint,
+            checkpoint_signature,
+            proof,
+        };
+        v2::verify(&bundle, policy)?;
+        tx.execute(
+            "INSERT INTO bridge_events VALUES (?1, ?2, ?3, ?4)",
+            params![
+                bundle.checkpoint.leaf_count,
+                bundle.request.event.event_id,
+                bundle.record_hash,
+                serde_json::to_string(&bundle)?
+            ],
+        )?;
+        tx.commit()?;
+        Ok(bundle)
+    }
+    pub fn export(&self, event_id: &str, policy: &Policy) -> Result<Bundle> {
+        let json: String = self
+            .connection
+            .query_row(
+                "SELECT bundle FROM bridge_events WHERE event_id=?1",
+                [event_id],
+                |r| r.get(0),
+            )
+            .optional()?
+            .context("event not found")?;
+        let bundle = serde_json::from_str(&json)?;
+        v2::verify(&bundle, policy)?;
+        ensure!(
+            bundle.request.event.event_id == event_id,
+            "export identity mismatch"
+        );
+        Ok(bundle)
+    }
+}
diff --git a/arkhe/source/integration/arkhe-crm-bridge/src/v2.rs b/arkhe/source/integration/arkhe-crm-bridge/src/v2.rs
new file mode 100644
index 00000000..80d07c07
--- /dev/null
+++ b/arkhe/source/integration/arkhe-crm-bridge/src/v2.rs
@@ -0,0 +1,346 @@
+//! Version 2 uses a length-framed binary canonical contract, not JSON bytes.
+use crate::ProvenanceRecord;
+use anyhow::{ensure, Context, Result};
+use arkhe_verify_core::mmr::{verify_proof, ProofStep};
+use ed25519_dalek::{Signature, Signer, SigningKey, VerifyingKey};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Event {
+    pub schema: u32,
+    pub log_id: String,
+    pub event_id: String,
+    pub producer_id: String,
+    pub issued_at: u64,
+    pub expires_at: u64,
+    pub record: ProvenanceRecord,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    pub event: Event,
+    pub signature: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Producer {
+    pub id: String,
+    pub public_key: String,
+    pub org_id: String,
+    pub source_system: String,
+    pub object: String,
+    pub fields: Vec<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Policy {
+    pub schema: u32,
+    pub log_id: String,
+    pub bridge_public_key: String,
+    pub producers: Vec<Producer>,
+    pub max_age_secs: u64,
+    pub max_ttl_secs: u64,
+    pub future_skew_secs: u64,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Checkpoint {
+    pub schema: u32,
+    pub log_id: String,
+    pub root: String,
+    pub leaf_count: u64,
+    pub previous_checkpoint_hash: String,
+    pub issued_at: u64,
+    pub policy_hash: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Bundle {
+    pub schema: u32,
+    pub request: Request,
+    pub record_hash: String,
+    pub checkpoint: Checkpoint,
+    pub checkpoint_signature: String,
+    pub proof: Vec<ProofStep>,
+}
+
+// Every item is u64be(byte_length) || bytes, including domain and integers.
+fn frame(out: &mut Vec<u8>, bytes: &[u8]) {
+    out.extend_from_slice(&(bytes.len() as u64).to_be_bytes());
+    out.extend_from_slice(bytes);
+}
+fn text(out: &mut Vec<u8>, value: &str) {
+    frame(out, value.as_bytes());
+}
+fn number(out: &mut Vec<u8>, value: u64) {
+    frame(out, &value.to_be_bytes());
+}
+fn domain(name: &str) -> Vec<u8> {
+    let mut out = Vec::new();
+    text(&mut out, name);
+    out
+}
+fn digest(bytes: &[u8]) -> String {
+    blake3::hash(bytes).to_hex().to_string()
+}
+pub fn bytes32(value: &str) -> Result<[u8; 32]> {
+    ensure!(
+        value.len() == 64
+            && value
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+        "expected lowercase 32-byte hex"
+    );
+    hex::decode(value)?
+        .try_into()
+        .map_err(|_| anyhow::anyhow!("expected 32 bytes"))
+}
+pub fn signing_key(value: &str) -> Result<SigningKey> {
+    Ok(SigningKey::from_bytes(&bytes32(value.trim())?))
+}
+pub fn public_key(key: &SigningKey) -> String {
+    hex::encode(key.verifying_key().as_bytes())
+}
+fn signature_check(key: &str, bytes: &[u8], signature: &str) -> Result<()> {
+    let key = VerifyingKey::from_bytes(&bytes32(key)?)?;
+    ensure!(
+        signature.len() == 128
+            && signature
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+        "invalid signature encoding"
+    );
+    key.verify_strict(bytes, &Signature::from_slice(&hex::decode(signature)?)?)
+        .context("invalid Ed25519 signature")
+}
+
+impl Event {
+    pub fn canonical(&self) -> Result<Vec<u8>> {
+        ensure!(self.schema == 2, "unsupported event schema");
+        for s in [
+            &self.log_id,
+            &self.event_id,
+            &self.producer_id,
+            &self.record.org_id,
+            &self.record.object,
+            &self.record.record_id,
+            &self.record.field,
+            &self.record.source_system,
+        ] {
+            ensure!(
+                !s.trim().is_empty() && s.len() <= 1024,
+                "invalid identity length"
+            );
+        }
+        ensure!(
+            self.expires_at >= self.issued_at,
+            "expiry precedes issue time"
+        );
+        let timestamp = chrono::DateTime::parse_from_rfc3339(&self.record.observed_at)?;
+        ensure!(
+            timestamp.to_rfc3339_opts(chrono::SecondsFormat::Secs, true) == self.record.observed_at,
+            "observed_at must be UTC RFC3339 seconds ending Z"
+        );
+        let mut out = domain("arkhe.crm.event.v2");
+        number(&mut out, 2);
+        for s in [&self.log_id, &self.event_id, &self.producer_id] {
+            text(&mut out, s);
+        }
+        number(&mut out, self.issued_at);
+        number(&mut out, self.expires_at);
+        for s in [
+            &self.record.org_id,
+            &self.record.object,
+            &self.record.record_id,
+            &self.record.field,
+        ] {
+            text(&mut out, s);
+        }
+        match &self.record.value {
+            Value::Null => text(&mut out, "null"),
+            Value::Bool(v) => {
+                text(&mut out, "bool");
+                frame(&mut out, &[u8::from(*v)]);
+            }
+            Value::String(v) => {
+                ensure!(v.len() <= 65536, "value too large");
+                text(&mut out, "string");
+                text(&mut out, v);
+            }
+            Value::Number(v) => {
+                ensure!(
+                    v.as_i64().is_some() || v.as_u64().is_some(),
+                    "only integer numbers supported"
+                );
+                text(&mut out, "integer");
+                text(&mut out, &v.to_string());
+            }
+            _ => anyhow::bail!("unsupported value type"),
+        }
+        text(&mut out, &self.record.source_system);
+        text(&mut out, &self.record.observed_at);
+        Ok(out)
+    }
+    pub fn hash(&self) -> Result<String> {
+        Ok(digest(&self.canonical()?))
+    }
+}
+
+impl Request {
+    pub fn sign(event: Event, key: &SigningKey) -> Result<Self> {
+        let signature = hex::encode(key.sign(&event.canonical()?).to_bytes());
+        Ok(Self { event, signature })
+    }
+    pub fn authenticate(&self, policy: &Policy) -> Result<()> {
+        policy.validate()?;
+        ensure!(self.event.log_id == policy.log_id, "wrong log");
+        let producer = policy
+            .producers
+            .iter()
+            .find(|p| p.id == self.event.producer_id)
+            .context("unknown producer")?;
+        let r = &self.event.record;
+        ensure!(
+            producer.org_id == r.org_id
+                && producer.source_system == r.source_system
+                && producer.object == r.object
+                && producer.fields.contains(&r.field),
+            "producer scope denied"
+        );
+        signature_check(
+            &producer.public_key,
+            &self.event.canonical()?,
+            &self.signature,
+        )
+    }
+    pub fn fresh_at(&self, policy: &Policy, now: u64) -> Result<()> {
+        let event = &self.event;
+        ensure!(event.expires_at >= event.issued_at, "invalid time window");
+        ensure!(
+            event.expires_at - event.issued_at <= policy.max_ttl_secs,
+            "TTL exceeds policy"
+        );
+        ensure!(
+            event.issued_at <= now.saturating_add(policy.future_skew_secs),
+            "event from future"
+        );
+        ensure!(
+            now <= event.expires_at && now.saturating_sub(event.issued_at) <= policy.max_age_secs,
+            "expired event"
+        );
+        Ok(())
+    }
+}
+
+impl Policy {
+    pub fn validate(&self) -> Result<()> {
+        ensure!(
+            self.schema == 2 && !self.log_id.trim().is_empty() && self.log_id.len() <= 1024,
+            "invalid policy"
+        );
+        VerifyingKey::from_bytes(&bytes32(&self.bridge_public_key)?)?;
+        ensure!(
+            self.max_age_secs > 0 && self.max_ttl_secs > 0,
+            "invalid time policy"
+        );
+        let mut ids = std::collections::HashSet::new();
+        for p in &self.producers {
+            ensure!(
+                !p.id.trim().is_empty() && ids.insert(&p.id),
+                "duplicate/empty producer id"
+            );
+            VerifyingKey::from_bytes(&bytes32(&p.public_key)?)?;
+            ensure!(!p.fields.is_empty(), "empty producer scope");
+        }
+        Ok(())
+    }
+    pub fn hash(&self) -> Result<String> {
+        self.validate()?;
+        let mut out = domain("arkhe.crm.policy.v2");
+        number(&mut out, 2);
+        text(&mut out, &self.log_id);
+        text(&mut out, &self.bridge_public_key);
+        number(&mut out, self.max_age_secs);
+        number(&mut out, self.max_ttl_secs);
+        number(&mut out, self.future_skew_secs);
+        let mut producers = self.producers.clone();
+        producers.sort_by(|a, b| a.id.cmp(&b.id));
+        number(&mut out, producers.len() as u64);
+        for p in producers {
+            for s in [&p.id, &p.public_key, &p.org_id, &p.source_system, &p.object] {
+                text(&mut out, s);
+            }
+            let mut fields = p.fields;
+            fields.sort();
+            fields.dedup();
+            number(&mut out, fields.len() as u64);
+            for f in fields {
+                text(&mut out, &f);
+            }
+        }
+        Ok(digest(&out))
+    }
+}
+
+impl Checkpoint {
+    pub fn canonical(&self) -> Result<Vec<u8>> {
+        ensure!(
+            self.schema == 2 && self.leaf_count > 0,
+            "invalid checkpoint"
+        );
+        let mut out = domain("arkhe.crm.checkpoint.v2");
+        number(&mut out, 2);
+        text(&mut out, &self.log_id);
+        frame(&mut out, &bytes32(&self.root)?);
+        number(&mut out, self.leaf_count);
+        frame(&mut out, &bytes32(&self.previous_checkpoint_hash)?);
+        number(&mut out, self.issued_at);
+        frame(&mut out, &bytes32(&self.policy_hash)?);
+        Ok(out)
+    }
+    pub fn hash(&self) -> Result<String> {
+        Ok(digest(&self.canonical()?))
+    }
+    pub fn sign(&self, key: &SigningKey) -> Result<String> {
+        Ok(hex::encode(key.sign(&self.canonical()?).to_bytes()))
+    }
+}
+
+pub fn verify(bundle: &Bundle, policy: &Policy) -> Result<()> {
+    ensure!(bundle.schema == 2, "unsupported bundle schema");
+    let cp = &bundle.checkpoint;
+    ensure!(
+        cp.log_id == policy.log_id && cp.policy_hash == policy.hash()?,
+        "checkpoint policy/log mismatch"
+    );
+    signature_check(
+        &policy.bridge_public_key,
+        &cp.canonical()?,
+        &bundle.checkpoint_signature,
+    )?;
+    bundle.request.authenticate(policy)?;
+    bundle.request.fresh_at(policy, cp.issued_at)?;
+    ensure!(
+        bundle.record_hash == bundle.request.event.hash()?,
+        "event hash mismatch"
+    );
+    ensure!(bundle.proof.len() <= 128, "proof too long");
+    let count = usize::try_from(cp.leaf_count)?;
+    ensure!(
+        verify_proof(
+            &bytes32(&bundle.record_hash)?,
+            count,
+            &bundle.proof,
+            &bytes32(&cp.root)?
+        )?,
+        "invalid inclusion proof"
+    );
+    Ok(())
+}
