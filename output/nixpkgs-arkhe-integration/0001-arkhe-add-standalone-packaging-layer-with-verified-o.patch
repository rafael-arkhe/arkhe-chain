diff --git a/arkhe/scripts/check-reproducibility.sh b/arkhe/scripts/check-reproducibility.sh
new file mode 100755
index 00000000..63e9da90
--- /dev/null
+++ b/arkhe/scripts/check-reproducibility.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# Verifica se um pacote reconstrói com o mesmo conteúdo.
+#
+# Uso: ./scripts/check-reproducibility.sh [atributo] [flake-ref]
+#
+# `nix build --rebuild` reconstrói o derivado e compara o conteúdo produzido
+# com o que já está no store. Se o hash mudar, o comando falha.
+set -euo pipefail
+
+attr="${1:-arkhe-verify}"
+flake="${2:-.}"
+
+echo "== build inicial: ${flake}#${attr}"
+out="$(nix build "${flake}#${attr}" --no-link --print-out-paths)"
+first="$(nix hash path "${out}")"
+echo "hash1=${first}"
+
+echo "== rebuild forçado (--rebuild)"
+nix build "${flake}#${attr}" --rebuild --option substitute false --no-link --print-out-paths > /dev/null
+second="$(nix hash path "${out}")"
+echo "hash2=${second}"
+
+if [[ "${first}" != "${second}" ]]; then
+  echo "NAO REPRODUTIVEL: ${attr} (${first} != ${second})" >&2
+  exit 1
+fi
+
+echo "REPRODUZIVEL: ${attr} ${first}"
diff --git a/arkhe/scripts/provenance.sh b/arkhe/scripts/provenance.sh
new file mode 100755
index 00000000..6913f3cf
--- /dev/null
+++ b/arkhe/scripts/provenance.sh
@@ -0,0 +1,55 @@
+#!/usr/bin/env bash
+# Emite um JSON de proveniência para os atributos informados.
+#
+# Uso: ./scripts/provenance.sh [flake-ref] [atributo...]
+#
+# Requer `jq` no PATH. O JSON final contém a versão do Nix, os metadados do
+# flake (incluindo o locked rev) e, por pacote, caminho, hash do conteúdo e
+# endereço CA quando existir.
+set -euo pipefail
+
+flake="${1:-.}"
+shift || true
+
+attrs=("$@")
+if [[ ${#attrs[@]} -eq 0 ]]; then
+  attrs=(arkhe-verify)
+fi
+
+records="$(mktemp)"
+trap 'rm -f "${records}"' EXIT
+
+for attr in "${attrs[@]}"; do
+  echo "== ${attr}" >&2
+  out="$(nix build "${flake}#${attr}" --no-link --print-out-paths)"
+  hash="$(nix hash path "${out}")"
+  ca="$(nix path-info --json "${out}" | jq -r '(if type == "array" then .[0] else to_entries[0].value end) | .ca // ""')"
+
+  jq -n \
+    --arg attr "${attr}" \
+    --arg path "${out}" \
+    --arg hash "${hash}" \
+    --arg ca "${ca}" \
+    '{
+      attr: $attr,
+      path: $path,
+      hash: $hash,
+      ca: (if $ca == "" then null else $ca end)
+    }' >> "${records}"
+done
+
+metadata="$(nix flake metadata "${flake}" --json)"
+
+jq -n \
+  --arg nix "$(nix --version)" \
+  --argjson flake "${metadata}" \
+  --slurpfile packages "${records}" \
+  '{
+    nix: $nix,
+    flake: {
+      url: ($flake.url // null),
+      revision: ($flake.revision // null),
+      locked: ($flake.locked // null)
+    },
+    packages: $packages
+  }'
diff --git a/arkhe/scripts/validate-source.py b/arkhe/scripts/validate-source.py
new file mode 100755
index 00000000..5bb5f072
--- /dev/null
+++ b/arkhe/scripts/validate-source.py
@@ -0,0 +1,16 @@
+#!/usr/bin/env python3
+"""Verify the complete distributed source snapshot against its SHA-256 manifest."""
+import hashlib
+import json
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[1]
+source = root / "source"
+expected = json.loads((root / "source-manifest.json").read_text())["files"]
+actual = {
+    p.relative_to(source).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()
+    for p in source.rglob("*") if p.is_file()
+}
+if actual != expected:
+    raise SystemExit("Source snapshot differs from source-manifest.json")
+print(f"Verified {len(actual)} source files")
diff --git a/arkhe/scripts/verify-content-addressing.sh b/arkhe/scripts/verify-content-addressing.sh
new file mode 100755
index 00000000..b8695a8a
--- /dev/null
+++ b/arkhe/scripts/verify-content-addressing.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# Verifica que uma derivação produzida em modo CA tem endereço de conteúdo.
+#
+# Uso: ./scripts/verify-content-addressing.sh [atributo] [flake-ref]
+#
+# Requer as features experimentais `ca-derivations` e `jq` no PATH.
+set -euo pipefail
+
+attr="${1:-arkhe-verify}"
+flake="${2:-.}"
+
+features="nix-command flakes ca-derivations"
+system="$(nix eval --raw --impure --expr builtins.currentSystem)"
+ref="${flake}#legacyPackages.${system}.ca.${attr}"
+
+echo "== build CA: ${ref}"
+out="$(nix build "${ref}" --no-link --print-out-paths \
+  --extra-experimental-features "${features}")"
+
+ca="$(nix path-info --json "${out}" \
+  --extra-experimental-features "${features}" \
+  | jq -r '(if type == "array" then .[0] else to_entries[0].value end) | .ca // empty')"
+
+if [[ -z "${ca}" ]]; then
+  echo "SEM ENDERECO DE CONTEUDO: ${out}" >&2
+  exit 1
+fi
+
+echo "CONTEUDO ENDERECADO: ${attr} ca=${ca} path=${out}"
