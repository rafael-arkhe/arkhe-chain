+            verifier_id: [3; 32],
+        };
+        assert_eq!(
+            route(a, &[confirmed, confirmed, deterministic], &policy(), true).decision,
+            Decision::AutoAccept
+        );
+        let conflict = Vote {
+            kind: VerifierKind::Replay,
