@@ -0,0 +1,71 @@
+use arkhe_core::work::WorkIntent;
+use arkhe_governance::{PolicyBinding, PolicyResolver};
+use arkhe_kernel::{AuthorizationDecision, ContainmentGate};
+
+pub mod http_routes;
+pub mod preview;
+pub mod portable_wer;
+#[cfg(feature="sqlite-dispatch")]
+pub mod authenticated_dispatch;
+
+pub struct Runtime<R: PolicyResolver> {
+    pub gate: ContainmentGate<R>,
+}
+
+impl<R: PolicyResolver> Runtime<R> {
+    pub fn authorize_proposed_work(
+        &self,
+        intent: &WorkIntent,
+        record: &arkhe_core::worker::WorkerExecutionRecord,
+        policy: &PolicyBinding,
+    ) -> AuthorizationDecision {
+        self.gate.authorize(intent, Some(record), policy)
+    }
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum WorkCommitError {
+    #[error("authorization rejected: {0}")]
+    Rejected(String),
+    #[error("evidence commit failed: {0}")]
+    Storage(String),
+}
+
+/// Returns a receipt only after the complete evidence transaction has committed.
+/// A receipt records authorization; it does not execute external effects.
+impl<R: PolicyResolver> Runtime<R> {
+    pub async fn commit_proposed_work<S: arkhe_core::evidence::WorkEvidenceCommitter>(
+        &self,
+        store: &S,
+        intent: &WorkIntent,
+        record: &arkhe_core::worker::WorkerExecutionRecord,
+        policy: &PolicyBinding,
+    ) -> Result<arkhe_core::Digest32, WorkCommitError> {
+        if record.input_digest != intent.digest() {
+            return Err(WorkCommitError::Rejected(
+                "worker record does not bind this WorkIntent".into(),
+            ));
+        }
+        let authorization_ref = match self.gate.authorize(intent, Some(record), policy) {
+            AuthorizationDecision::Allow { authorization_ref } => authorization_ref,
+            AuthorizationDecision::Reject { reason } => {
+                return Err(WorkCommitError::Rejected(reason))
+            }
+        };
+        store
+            .commit_work(
+                intent,
+                record,
+                arkhe_core::evidence::EvidenceEnvelope {
+                    record_hash: authorization_ref,
+                    kind: "work-authorization".into(),
+                    subject: intent.digest(),
+                    payload_digest: record.digest(),
+                    policy_digest: Some(policy.policy_digest),
+                    causal_parents: record.evidence_refs.clone(),
+                },
+            )
+            .await
+            .map_err(WorkCommitError::Storage)
+    }
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/src/main.rs b/arkhe/source/orchestration/arkhe-runtime/src/main.rs
new file mode 100644
index 00000000..bc3838ac
--- /dev/null
+++ b/arkhe/source/orchestration/arkhe-runtime/src/main.rs
@@ -0,0 +1,192 @@
+use arkhe_core::{
+    evidence::EvidenceReader, work::WorkIntent, worker::WorkerExecutionRecord, Digest32,
+};
+use arkhe_governance::{DevPolicyResolver, PolicyBinding};
+use arkhe_kernel::ContainmentGate;
+use arkhe_runtime::{Runtime, WorkCommitError};
+use arkhe_wormgraph::{postgres::PgWormGraph, retention::RetentionPolicy};
+use axum::{
+    extract::{DefaultBodyLimit, Path, State},
+    http::{HeaderMap, StatusCode},
+    routing::{get, post},
+    Json,
+};
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::{env, sync::Arc};
+
+struct LiveState {
+    runtime: Runtime<DevPolicyResolver>,
+    store: PgWormGraph,
+    policy: PolicyBinding,
+    token: String,
+    actor: String,
+    retention: RetentionPolicy,
+}
+type ApiError = (StatusCode, &'static str);
+fn authenticate(headers: &HeaderMap, state: &LiveState) -> Result<(), ApiError> {
+    let expected = format!("Bearer {}", state.token);
+    if headers.get("authorization").and_then(|v| v.to_str().ok()) != Some(&expected) {
+        return Err((StatusCode::UNAUTHORIZED, "authentication required"));
+    }
+    Ok(())
+}
+fn digest(s: &str) -> Result<Digest32, ApiError> {
+    let bytes = hex::decode(s).map_err(|_| (StatusCode::BAD_REQUEST, "invalid digest"))?;
+    Ok(Digest32(bytes.try_into().map_err(|_| {
+        (StatusCode::BAD_REQUEST, "invalid digest")
+    })?))
+}
+async fn health(
+    State(s): State<Arc<LiveState>>,
+    headers: HeaderMap,
+) -> Result<Json<Value>, ApiError> {
+    authenticate(&headers, &s)?;
+    s.store.health().await.map_err(|_| {
+        (
+            StatusCode::SERVICE_UNAVAILABLE,
+            "evidence store unavailable",
+        )
+    })?;
+    Ok(Json(json!({"status":"ok"})))
+}
+async fn retention(
+    State(s): State<Arc<LiveState>>,
+    headers: HeaderMap,
+) -> Result<Json<Value>, ApiError> {
+    authenticate(&headers, &s)?;
+    Ok(Json(json!({
+        "policy": s.retention,
+        "storage_mode": "append-only-no-purge",
+        "automatic_deletion": false,
+        "external_archive_configured": false,
+        "operational_retention_evidence": "NOT_MEASURED"
+    })))
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ProposedWork {
+    intent: WorkIntent,
+    worker_record: WorkerExecutionRecord,
+}
+async fn commit(
+    State(s): State<Arc<LiveState>>,
+    headers: HeaderMap,
+    Json(work): Json<ProposedWork>,
+) -> Result<Json<Value>, ApiError> {
+    authenticate(&headers, &s)?;
+    if work.intent.requested_by != s.actor {
+        return Err((StatusCode::FORBIDDEN, "request actor mismatch"));
+    }
+    let receipt = s
+        .runtime
+        .commit_proposed_work(&s.store, &work.intent, &work.worker_record, &s.policy)
+        .await
+        .map_err(|e| match e {
+            WorkCommitError::Rejected(_) => (StatusCode::FORBIDDEN, "authorization rejected"),
+            WorkCommitError::Storage(_) => {
+                (StatusCode::SERVICE_UNAVAILABLE, "evidence commit failed")
+            }
+        })?;
+    Ok(Json(
+        json!({"record_hash":receipt.to_hex(),"intent_digest":work.intent.digest().to_hex(),"worker_digest":work.worker_record.digest().to_hex()}),
+    ))
+}
+async fn read(
+    State(s): State<Arc<LiveState>>,
+    headers: HeaderMap,
+    Path(hash): Path<String>,
+) -> Result<Json<arkhe_core::evidence::EvidenceEnvelope>, ApiError> {
+    authenticate(&headers, &s)?;
+    s.store
+        .get(digest(&hash)?)
+        .await
+        .map_err(|_| {
+            (
+                StatusCode::SERVICE_UNAVAILABLE,
+                "evidence store unavailable",
+            )
+        })?
+        .map(Json)
+        .ok_or((StatusCode::NOT_FOUND, "evidence not found"))
+}
+async fn object(
+    State(s): State<Arc<LiveState>>,
+    headers: HeaderMap,
+    Path((kind, hash)): Path<(String, String)>,
+) -> Result<Vec<u8>, ApiError> {
+    authenticate(&headers, &s)?;
+    if !matches!(kind.as_str(), "WorkIntent" | "WorkerExecutionRecord") {
+        return Err((StatusCode::NOT_FOUND, "object type not found"));
+    }
+    s.store
+        .canonical_object(&kind, digest(&hash)?)
+        .await
+        .map_err(|_| {
+            (
+                StatusCode::SERVICE_UNAVAILABLE,
+                "evidence store unavailable",
+            )
+        })?
+        .ok_or((StatusCode::NOT_FOUND, "object not found"))
+}
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    if env::args().nth(1).as_deref() == Some("migrate") {
+        PgWormGraph::migrate(&env::var("DATABASE_URL")?)
+            .await
+            .map_err(std::io::Error::other)?;
+        println!("arkhe-sql migrations applied and checksums verified");
+        return Ok(());
+    }
+    let retention_policy = RetentionPolicy::from_settings(
+        env::var("ARKHE_EVIDENCE_RETENTION_DAYS").ok().as_deref(),
+        env::var("ARKHE_EVIDENCE_IMMEDIATE_DAYS").ok().as_deref(),
+    )
+    .map_err(std::io::Error::other)?;
+    let token = env::var("ARKHE_API_TOKEN")?;
+    if token.len() < 32 {
+        return Err("ARKHE_API_TOKEN must contain at least 32 bytes".into());
+    }
+    let actor = env::var("ARKHE_ACTOR")?;
+    if actor.trim().is_empty() {
+        return Err("ARKHE_ACTOR is required".into());
+    }
+    let store = PgWormGraph::connect(&env::var("DATABASE_URL")?, &env::var("ARKHE_TENANT_ID")?)
+        .await
+        .map_err(std::io::Error::other)?;
+    let policy = PolicyBinding {
+        policy_id: "development-unprotected-v1".into(),
+        version: 1,
+        policy_digest: Digest32::blake3(
+            b"AKG:DEV-POLICY:v0-REF\0",
+            b"DraftDocument|QueryKnowledgeBase|Simulate",
+        ),
+    };
+    let state = Arc::new(LiveState {
+        runtime: Runtime {
+            gate: ContainmentGate::new(DevPolicyResolver),
+        },
+        store,
+        policy,
+        token,
+        actor,
+        retention: retention_policy,
+    });
+    let app = arkhe_runtime::http_routes::versioned_routes(
+        get(health),
+        post(commit),
+        get(read),
+        get(object),
+        get(retention),
+    )
+    .layer(DefaultBodyLimit::max(262144))
+    .with_state(state);
+    let listener = tokio::net::TcpListener::bind(
+        env::var("ARKHE_LISTEN").unwrap_or_else(|_| "127.0.0.1:8788".into()),
+    )
+    .await?;
+    println!("Arkhe runtime listening on {}", listener.local_addr()?);
+    axum::serve(listener, app).await?;
+    Ok(())
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/src/portable_wer.rs b/arkhe/source/orchestration/arkhe-runtime/src/portable_wer.rs
new file mode 100644
index 00000000..57d68006
--- /dev/null
+++ b/arkhe/source/orchestration/arkhe-runtime/src/portable_wer.rs
@@ -0,0 +1,270 @@
+//! Local signed WER journal. Trust and rollback floors come from the verifier.
+//! A host signature is not model/TEE attestation or a trusted wall-clock timestamp.
+use arkhe_core::{
+    canonical::encode_value, work::WorkIntent, worker::WorkerExecutionRecord, CanonicalEncode,
+    Digest32,
+};
+use arkhe_verify_core::mmr::{
+    inclusion::{build_root_and_proof, verify_proof_at, ProofStep},
+    profile::PROFILE_DIGEST_HEX,
+};
+use arkhe_wormgraph::{
+    anchor::{CheckpointTrust, SignedCheckpoint},
+    regenerate::{rebuild, CheckpointBinding},
+};
+use ed25519_dalek::{Signature, Signer, SigningKey, VerifyingKey};
+use serde::{Deserialize, Serialize};
+use serde_json::json;
+use std::{
+    fs::{self, OpenOptions},
+    io::Write,
+    path::{Path, PathBuf},
+};
+
+type Result<T> = std::result::Result<T, String>;
+const DOMAIN: &[u8] = b"AKG:WER:SIGNATURE:v1\0";
+const MAX_LOG_BYTES: u64 = 64 * 1024 * 1024;
+const MAX_LEAVES: usize = 100_000;
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct WerTrust {
+    pub worker_public_key: [u8; 32],
+    pub checkpoint: CheckpointTrust,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SignedWer {
+    pub intent: WorkIntent,
+    pub worker: WorkerExecutionRecord,
+    pub signature_hex: String,
+}
+
+impl SignedWer {
+    fn signing_bytes(&self) -> Vec<u8> {
+        let mut bytes = DOMAIN.to_vec();
+        bytes.extend(self.worker.canonical_bytes());
+        bytes
+    }
+
+    pub fn record_hash(&self) -> Digest32 {
+        Digest32::blake3(
+            b"AKG:WER:SIGNED-RECORD:v1\0",
+            &encode_value(&json!({
+                "intent_digest": self.intent.digest(), "worker_digest": self.worker.digest(),
+                "worker_signature_hex": self.signature_hex,
+            })),
+        )
+    }
+
+    pub fn verify(&self, public_key: &[u8; 32]) -> Result<()> {
+        if self.worker.input_digest != self.intent.digest() || self.worker.execution_id.is_empty() {
+            return Err("WER/intent binding rejected".into());
+        }
+        let key = VerifyingKey::from_bytes(public_key).map_err(|e| e.to_string())?;
+        if key.is_weak() {
+            return Err("weak worker key".into());
+        }
+        let raw = hex::decode(&self.signature_hex).map_err(|e| e.to_string())?;
+        let sig = Signature::from_slice(&raw).map_err(|e| e.to_string())?;
+        key.verify_strict(&self.signing_bytes(), &sig)
+            .map_err(|e| e.to_string())
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PortableWer {
+    pub signed_wer: SignedWer,
+    pub record_hash: Digest32,
+    pub leaf_index: usize,
+    pub proof: Vec<ProofStep>,
+    pub checkpoint: SignedCheckpoint,
+}
+
+impl PortableWer {
+    pub fn verify(&self, trust: &WerTrust) -> Result<()> {
+        self.signed_wer.verify(&trust.worker_public_key)?;
+        if self.record_hash != self.signed_wer.record_hash() {
+            return Err("signed record hash mismatch".into());
+        }
+        self.checkpoint
+            .verify(&self.checkpoint.binding(), &trust.checkpoint)
+            .map_err(|e| e.0)?;
+        let count = usize::try_from(self.checkpoint.leaf_count).map_err(|e| e.to_string())?;
+        if count > MAX_LEAVES {
+            return Err("journal leaf limit exceeded".into());
+        }
+        if !verify_proof_at(
+            &self.record_hash.0,
+            count,
+            self.leaf_index,
+            &self.proof,
+            &self.checkpoint.root,
+        )
+        .map_err(|e| e.to_string())?
+        {
+            return Err("MMR inclusion rejected".into());
+        }
+        Ok(())
+    }
+}
+
+struct Lock(PathBuf);
+impl Drop for Lock {
+    fn drop(&mut self) {
+        let _ = fs::remove_file(&self.0);
+    }
+}
+
+fn read_log(path: &Path, trust: &WerTrust) -> Result<Vec<PortableWer>> {
+    if !path.exists() {
+        return Ok(vec![]);
+    }
+    if fs::metadata(path).map_err(|e| e.to_string())?.len() > MAX_LOG_BYTES {
+        return Err("journal too large".into());
+    }
+    let raw = fs::read_to_string(path).map_err(|e| e.to_string())?;
+    if !raw.is_empty() && !raw.ends_with('\n') {
+        return Err("partial journal tail; manual recovery required".into());
+    }
+    let mut rows: Vec<PortableWer> = Vec::new();
+    let mut hashes = Vec::new();
+    let mut historical_trust = trust.clone();
+    historical_trust.checkpoint.minimum_leaf_count = 1;
+    for line in raw.lines() {
+        if rows.len() >= MAX_LEAVES {
+            return Err("journal leaf limit exceeded".into());
+        }
+        let row: PortableWer = serde_json::from_str(line).map_err(|e| e.to_string())?;
+        row.verify(&historical_trust)?;
+        if row.leaf_index != rows.len() || row.checkpoint.leaf_count != rows.len() as u64 + 1 {
+            return Err("journal sequence mismatch".into());
+        }
+        if rows
+            .iter()
+            .any(|old| old.signed_wer.worker.execution_id == row.signed_wer.worker.execution_id)
+        {
+            return Err("duplicate execution ID".into());
+        }
+        if rows
+            .last()
+            .is_some_and(|old| old.checkpoint.issued_at > row.checkpoint.issued_at)
+        {
+            return Err("checkpoint time regression".into());
+        }
+        hashes.push(row.record_hash);
+        let mmr = rebuild(&hashes).map_err(|e| format!("{e:?}"))?;
+        if row.checkpoint.root != mmr.root.0
+            || row.checkpoint.peaks != mmr.peaks.iter().map(|p| p.0).collect::<Vec<_>>()
+            || row.checkpoint.covered_up_to != row.record_hash.0
+        {
+            return Err("journal prefix mismatch".into());
+        }
+        rows.push(row);
+    }
+    // An externally retained floor detects removal of a previously observed tail.
+    if let Some(last) = rows.last() {
+        last.verify(trust)?;
+    } else if trust.checkpoint.minimum_leaf_count > 1 {
+        return Err("journal below retained floor".into());
+    }
+    Ok(rows)
+}
+
+/// Append only after host-side validation. This records observations, not authority.
+/// A crashed writer can leave a lock/partial tail; neither is repaired automatically.
+pub fn append(
+    path: &Path,
+    intent: WorkIntent,
+    worker: WorkerExecutionRecord,
+    worker_key: &SigningKey,
+    log_key: &SigningKey,
+    trust: &WerTrust,
+    issued_at: u64,
+) -> Result<PortableWer> {
+    if worker_key.verifying_key().to_bytes() != trust.worker_public_key
+        || log_key.verifying_key().to_bytes() != trust.checkpoint.public_key
+    {
+        return Err("signer is not pinned in supplied trust policy".into());
+    }
+    let lock_path = path.with_extension("lock");
+    let _handle = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&lock_path)
+        .map_err(|e| format!("journal lock: {e}"))?;
+    let _lock = Lock(lock_path);
+    let old = read_log(path, trust)?;
+    if old.len() >= MAX_LEAVES
+        || old
+            .iter()
+            .any(|r| r.signed_wer.worker.execution_id == worker.execution_id)
+    {
+        return Err("duplicate execution ID or full journal".into());
+    }
+    if old
+        .last()
+        .is_some_and(|r| issued_at < r.checkpoint.issued_at)
+    {
+        return Err("checkpoint time regression".into());
+    }
+    let mut signed_wer = SignedWer {
+        intent,
+        worker,
+        signature_hex: String::new(),
+    };
+    signed_wer.signature_hex = hex::encode(worker_key.sign(&signed_wer.signing_bytes()).to_bytes());
+    signed_wer.verify(&trust.worker_public_key)?;
+    let record_hash = signed_wer.record_hash();
+    let mut hashes: Vec<Digest32> = old.iter().map(|r| r.record_hash).collect();
+    hashes.push(record_hash);
+    let mmr = rebuild(&hashes).map_err(|e| format!("{e:?}"))?;
+    let binding = CheckpointBinding {
+        tenant_id: trust.checkpoint.tenant_id.clone(),
+        stream_id: trust.checkpoint.stream_id.clone(),
+        leaf_count: mmr.leaf_count,
+        mmr_size: mmr.mmr_size,
+        root: mmr.root,
+        peaks: mmr.peaks,
+        profile_digest: Digest32(hex::decode(PROFILE_DIGEST_HEX).unwrap().try_into().unwrap()),
+        covered_up_to: record_hash,
+    };
+    let mut checkpoint =
+        SignedCheckpoint::from_binding(&binding, trust.checkpoint.log_id, issued_at, String::new());
+    checkpoint.signature_hex = hex::encode(log_key.sign(&checkpoint.signing_bytes()).to_bytes());
+    let leaves: Vec<Vec<u8>> = hashes.iter().map(|h| h.0.to_vec()).collect();
+    let (root, proof) = build_root_and_proof(&leaves, old.len()).map_err(|e| e.to_string())?;
+    if root != checkpoint.root {
+        return Err("MMR implementations disagree".into());
+    }
+    let bundle = PortableWer {
+        signed_wer,
+        record_hash,
+        leaf_index: old.len(),
+        proof,
+        checkpoint,
+    };
+    bundle.verify(trust)?;
+    let mut bytes = serde_json::to_vec(&bundle).map_err(|e| e.to_string())?;
+    bytes.push(b'\n');
+    let existing_len = fs::metadata(path).map(|m| m.len()).unwrap_or(0);
+    if existing_len + bytes.len() as u64 > MAX_LOG_BYTES {
+        return Err("journal too large".into());
+    }
+    let mut file = OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+        .map_err(|e| e.to_string())?;
+    file.write_all(&bytes)
+        .and_then(|_| file.sync_all())
+        .map_err(|e| e.to_string())?;
+    // Read back the durable bytes before returning success.
+    let rows = read_log(path, trust)?;
+    if rows.last().map(|r| r.record_hash) != Some(record_hash) {
+        return Err("journal readback mismatch".into());
+    }
+    Ok(bundle)
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/src/preview.rs b/arkhe/source/orchestration/arkhe-runtime/src/preview.rs
new file mode 100644
index 00000000..25668938
--- /dev/null
+++ b/arkhe/source/orchestration/arkhe-runtime/src/preview.rs
@@ -0,0 +1,472 @@
+//! Preview admission and gated dispatch. No signing keys or implicit production policy.
+//! Signature verification belongs to this host boundary; the gate receives only
+//! authenticated envelopes. Queued admission is not an execution capability.
+use arkhe_core::{
+    canonical::encode_value,
+    evidence::{EvidenceEnvelope, EvidenceReader},
+    review::{
+        HumanReviewEvidence, HumanReviewRecord, HumanVerdict, ReviewDecision, ReviewReason,
+        ReviewVerdict,
+    },
+    work::{ContextEntry, ContextKind, WorkIntent, WorkIntentType},
+    worker::{CognitiveOperation, WorkerExecutionRecord},
+    Digest32,
+};
+use arkhe_governance::{EvidenceKindRequirement, PolicyBinding, PolicyResolver, PolicyVerdict};
+use arkhe_kernel::{AuthorizationDecision, ContainmentGate};
+use async_trait::async_trait;
+use ed25519_dalek::{Signature, VerifyingKey};
+use serde::{Deserialize, Serialize};
+use sqlx::{Postgres, Transaction};
+
+pub mod authority;
+pub mod dispatch;
+pub mod executor;
+pub mod queue;
+
+const REVIEW_MODULE: &str = "arkhe-preview-human-review";
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PreviewSpec {
+    pub version: u16,
+    pub tenant: String,
+    pub baseline_digest: Digest32,
+    pub proposal_digest: Digest32,
+    pub artifact_digest: Digest32,
+    /// Immutable OCI image identifier, never a tag.
+    pub image: String,
+    pub runtime_profile: Digest32,
+    pub module: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub cockpit_binding: Option<Digest32>,
+}
+impl PreviewSpec {
+    pub fn digest(&self) -> Digest32 {
+        Digest32::blake3(
+            b"AKG:PREVIEW:SPEC:v1\0",
+            &encode_value(&serde_json::to_value(self).expect("typed spec")),
+        )
+    }
+}
+
+/// Operator-controlled trust configuration. Never accept it from the model/request.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PreviewTrust {
+    pub tenant: String,
+    pub requested_by: String,
+    pub reviewer: String,
+    pub reviewer_key: [u8; 32],
+    pub supervisor_key: [u8; 32],
+    pub supervisor_module: String,
+    pub supervisor_version: String,
+    pub policy_digest: Digest32,
+    pub image: String,
+    pub runtime_profile: Digest32,
+    pub allowed_modules: Vec<String>,
+    /// Seconds; used for both worker receipt freshness and review duration.
+    pub max_age_seconds: i64,
+    pub emergency_stop: bool,
+}
+
+impl PreviewTrust {
+    /// Binds every configured identity, key and constraint to human approval.
+    /// Emergency stop is a live deny override, never an approval parameter.
+    pub fn digest(&self) -> Digest32 {
+        let mut value = serde_json::to_value(self).expect("typed preview trust");
+        let fields = value.as_object_mut().expect("trust object");
+        fields.remove("policy_digest");
+        fields.remove("emergency_stop");
+        Digest32::blake3(b"AKG:PREVIEW:POLICY:v1\0", &encode_value(&value))
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PreviewRequest {
+    pub spec: PreviewSpec,
+    pub intent: WorkIntent,
+    pub worker: WorkerExecutionRecord,
+    pub completed_at: i64,
+    pub supervisor_signature: String,
+    pub review: HumanReviewRecord,
+    pub reviewer_signature: String,
+}
+impl PreviewRequest {
+    /// A supervisor attests a successful build/test of this exact preview spec.
+    /// The caller must verify the actual build independently before signing.
+    pub fn supervisor_signing_bytes(&self) -> Vec<u8> {
+        signing_bytes(
+            b"AKG:PREVIEW:SUPERVISOR:v1\0",
+            &serde_json::json!({
+                "tenant": self.spec.tenant, "spec": self.spec.digest().to_hex(),
+                "worker": self.worker.digest().to_hex(), "completed_at": self.completed_at,
+                "outcome": "Succeeded"
+            }),
+        )
+    }
+    pub fn reviewer_signing_bytes(&self) -> Vec<u8> {
+        signing_bytes(
+            b"AKG:PREVIEW:HUMAN:v1\0",
+            &serde_json::json!({
+                "tenant": self.spec.tenant, "review": self.review.digest().to_hex()
+            }),
+        )
+    }
+    pub fn route(policy: Digest32) -> ReviewDecision {
+        ReviewDecision {
+            verdict: ReviewVerdict::ReviewRequired,
+            reasons: vec![ReviewReason::HighImpact],
+            review_policy_digest: policy,
+        }
+    }
+    pub fn human_attestation(&self) -> WorkerExecutionRecord {
+        WorkerExecutionRecord {
+            classification: None,
+            operation: Some(CognitiveOperation::Decide),
+            module_id: REVIEW_MODULE.into(),
+            module_version: "1".into(),
+            input_digest: self.worker.digest(),
+            output_digest: self.review.digest(),
+            evidence_refs: vec![self.worker.digest()],
+            confidence_bps: None,
+            uncertainty_note: None,
+            execution_id: self.review.operation_id.to_hex(),
+        }
+    }
+    /// Context is deterministic and contains no caller-selected admission aliases.
+    pub fn expected_context(&self) -> Vec<ContextEntry> {
+        vec![
+            ContextEntry {
+                kind: ContextKind::SourceReport,
+                hash: self.spec.baseline_digest,
+            },
+            ContextEntry {
+                kind: ContextKind::AnalysisRecord,
+                hash: self.worker.digest(),
+            },
+            ContextEntry {
+                kind: ContextKind::ReviewDecision,
+                hash: Self::route(self.review.policy_digest).digest(),
+            },
+            ContextEntry {
+                kind: ContextKind::HumanReview,
+                hash: self.human_attestation().digest(),
+            },
+        ]
+    }
+}
+fn signing_bytes(domain: &[u8], value: &serde_json::Value) -> Vec<u8> {
+    let mut bytes = domain.to_vec();
+    bytes.extend(encode_value(value));
+    bytes
+}
+fn verify_signature(key: &[u8; 32], payload: &[u8], signature: &str) -> Result<(), String> {
+    let key = VerifyingKey::from_bytes(key).map_err(|_| "invalid trust key")?;
+    if key.is_weak() || signature.len() != 128 {
+        return Err("invalid signing key or signature length".into());
+    }
+    let raw = hex::decode(signature).map_err(|_| "invalid signature encoding")?;
+    let signature = Signature::from_slice(&raw).map_err(|_| "invalid signature")?;
+    key.verify_strict(payload, &signature)
+        .map_err(|_| "preview signature rejected".into())
+}
+fn image_is_digest(image: &str) -> bool {
+    image.strip_prefix("sha256:").is_some_and(|s| {
+        s.len() == 64
+            && s.bytes()
+                .all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase())
+    })
+}
+
+/// Constructible only through successful host admission and ContainmentGate.
+/// It is intentionally not deserializable and grants no right to execute.
+pub struct AdmittedPreview {
+    request: PreviewRequest,
+    authorization_ref: Digest32,
+    admitted_at: i64,
+}
+impl AdmittedPreview {
+    pub fn authorization_ref(&self) -> Digest32 {
+        self.authorization_ref
+    }
+    pub fn operation_id(&self) -> Digest32 {
+        self.request.intent.operation_id()
+    }
+    pub fn spec(&self) -> &PreviewSpec {
+        &self.request.spec
+    }
+    pub fn request(&self) -> &PreviewRequest {
+        &self.request
+    }
+}
+
+struct PreviewPolicy {
+    policy: Digest32,
+    worker: String,
+}
+impl PolicyResolver for PreviewPolicy {
+    fn resolve(&self, i: &WorkIntent, p: &PolicyBinding) -> PolicyVerdict {
+        if i.intent_type == WorkIntentType::ReleaseSoftware
+            && p.policy_id == "arkhe-preview/v1"
+            && p.version == 1
+            && p.policy_digest == self.policy
+        {
+            PolicyVerdict::Allow
+        } else {
+            PolicyVerdict::Deny("preview-only policy".into())
+        }
+    }
+    fn review_routing_required(&self, _: &WorkIntent, _: &PolicyBinding) -> bool {
+        true
+    }
+    fn human_review_modules(&self, _: &WorkIntent, _: &PolicyBinding) -> Vec<String> {
+        vec![REVIEW_MODULE.into()]
+    }
+    fn required_worker_evidence(
+        &self,
+        _: &WorkIntent,
+        _: &PolicyBinding,
+    ) -> Option<EvidenceKindRequirement> {
+        Some(EvidenceKindRequirement {
+            allowed_modules: vec![self.worker.clone()],
+            allowed_operations: vec![CognitiveOperation::Execute],
+        })
+    }
+}
+
+struct AdmittedEvidence<'a, E> {
+    source: &'a E,
+    worker: EvidenceEnvelope,
+    human: EvidenceEnvelope,
+}
+#[async_trait]
+impl<E: EvidenceReader> EvidenceReader for AdmittedEvidence<'_, E> {
+    async fn get(&self, hash: Digest32) -> Result<Option<EvidenceEnvelope>, String> {
+        if hash == self.worker.record_hash {
+            return Ok(Some(self.worker.clone()));
+        }
+        if hash == self.human.record_hash {
+            return Ok(Some(self.human.clone()));
+        }
+        self.source.get(hash).await
+    }
+}
+fn envelope(w: &WorkerExecutionRecord, policy: Digest32) -> EvidenceEnvelope {
+    EvidenceEnvelope {
+        record_hash: w.digest(),
+        kind: "WorkerExecutionRecord".into(),
+        subject: w.input_digest,
+        payload_digest: w.digest(),
+        policy_digest: Some(policy),
+        causal_parents: w.evidence_refs.clone(),
+    }
+}
+
+/// `source` must be an independently admitted tenant-scoped reader; a model map
+/// is not a trust root. Time comes from the supervisor, never the request.
+pub async fn admit_preview<E: EvidenceReader>(
+    request: PreviewRequest,
+    trust: &PreviewTrust,
+    source: &E,
+    now: i64,
+) -> Result<AdmittedPreview, String> {
+    verify_preview(request, trust, source, now, true).await
+}
+
+#[derive(Serialize)]
+pub struct PreviewChallenge {
+    pub signing_payload_hex: String,
+    pub reviewer_key: [u8; 32],
+    pub operation_id: String,
+    pub spec: PreviewSpec,
+    pub expires_at: i64,
+}
+pub async fn review_preview<E: EvidenceReader>(
+    request: PreviewRequest,
+    trust: &PreviewTrust,
+    source: &E,
+    now: i64,
+) -> Result<PreviewChallenge, String> {
+    let checked = verify_preview(request, trust, source, now, false).await?;
+    Ok(PreviewChallenge {
+        signing_payload_hex: hex::encode(checked.request.reviewer_signing_bytes()),
+        reviewer_key: trust.reviewer_key,
+        operation_id: checked.operation_id().to_hex(),
+        expires_at: checked.request.review.expires_at,
+        spec: checked.request.spec,
+    })
+}
+// Only admit_preview can return the admitted object; the challenge path discards it.
+async fn verify_preview<E: EvidenceReader>(
+    request: PreviewRequest,
+    trust: &PreviewTrust,
+    source: &E,
+    now: i64,
+    verify_human: bool,
+) -> Result<AdmittedPreview, String> {
+    let s = &request.spec;
+    let i = &request.intent;
+    let w = &request.worker;
+    let r = &request.review;
+    if trust.emergency_stop {
+        return Err("emergency stop".into());
+    }
+    for key in [&trust.supervisor_key, &trust.reviewer_key] {
+        let vk = VerifyingKey::from_bytes(key).map_err(|_| "invalid trust key")?;
+        if vk.is_weak() {
+            return Err("weak trust key".into());
+        }
+    }
+    if trust.tenant.trim().is_empty()
+        || trust.requested_by.trim().is_empty()
+        || trust.reviewer.trim().is_empty()
+        || trust.supervisor_module.trim().is_empty()
+        || trust.supervisor_version.trim().is_empty()
+        || trust.supervisor_key == trust.reviewer_key
+        || trust.max_age_seconds <= 0
+        || trust.max_age_seconds > 86400
+        || trust.policy_digest != trust.digest()
+        || trust.runtime_profile == Digest32::ZERO
+        || !image_is_digest(&trust.image)
+    {
+        return Err("invalid preview trust configuration".into());
+    }
+    if s.version != 1
+        || s.tenant != trust.tenant
+        || i.requested_by != trust.requested_by
+        || s.image != trust.image
+        || s.runtime_profile != trust.runtime_profile
+        || !trust.allowed_modules.contains(&s.module)
+        || s.module.is_empty()
+        || [s.baseline_digest, s.proposal_digest, s.artifact_digest].contains(&Digest32::ZERO)
+        || i.intent_type != WorkIntentType::ReleaseSoftware
+        || i.target != s.baseline_digest
+        || i.parameters_digest != s.digest()
+        || !i.context_refs.is_empty()
+        || i.request_identity.0 == Digest32::ZERO
+    {
+        return Err("preview spec, actor, target or scope mismatch".into());
+    }
+    if now < 0
+        || request.completed_at < 0
+        || request.completed_at > now
+        || now.saturating_sub(request.completed_at) > trust.max_age_seconds
+        || i.claimed_created_at < 0
+        || i.claimed_created_at > request.completed_at
+        || now.saturating_sub(i.claimed_created_at) > trust.max_age_seconds
+        || r.reviewed_at < request.completed_at
+        || r.reviewed_at > now
+        || r.expires_at <= now
+        || r.expires_at.saturating_sub(r.reviewed_at) > trust.max_age_seconds
+    {
+        return Err("stale, future or expired preview evidence".into());
+    }
+    if w.module_id != trust.supervisor_module
+        || w.module_version != trust.supervisor_version
+        || w.operation != Some(CognitiveOperation::Execute)
+        || w.input_digest != s.baseline_digest
+        || w.output_digest != s.digest()
+        || w.execution_id != i.operation_id().to_hex()
+        || w.evidence_refs != vec![s.baseline_digest]
+        || w.classification.is_some()
+        || r.reviewer != trust.reviewer
+        || r.verdict != HumanVerdict::Approve
+        || r.requested_by != i.requested_by
+        || r.operation_id != i.operation_id()
+        || r.parameters_digest != s.digest()
+        || r.analysis_digest != w.digest()
+        || r.policy_digest != trust.policy_digest
+        || r.routing_digest != PreviewRequest::route(trust.policy_digest).digest()
+    {
+        return Err("supervisor or human review binding mismatch".into());
+    }
+    let expected = request.expected_context();
+    if i.context.len() != expected.len()
+        || i.context
+            .iter()
+            .zip(&expected)
+            .any(|(a, b)| a.kind != b.kind || a.hash != b.hash)
+    {
+        return Err("noncanonical preview context".into());
+    }
+    verify_signature(
+        &trust.supervisor_key,
+        &request.supervisor_signing_bytes(),
+        &request.supervisor_signature,
+    )?;
+    if verify_human {
+        verify_signature(
+            &trust.reviewer_key,
+            &request.reviewer_signing_bytes(),
+            &request.reviewer_signature,
+        )?;
+    }
+    let baseline = source
+        .get(s.baseline_digest)
+        .await?
+        .ok_or("baseline not admitted")?;
+    if baseline.record_hash != s.baseline_digest || baseline.payload_digest != s.baseline_digest {
+        return Err("baseline evidence binding mismatch".into());
+    }
+    let human = HumanReviewEvidence {
+        review: r.clone(),
+        attestation: request.human_attestation(),
+    };
+    let admitted = AdmittedEvidence {
+        source,
+        worker: envelope(w, trust.policy_digest),
+        human: envelope(&human.attestation, trust.policy_digest),
+    };
+    let gate = ContainmentGate::new(PreviewPolicy {
+        policy: trust.policy_digest,
+        worker: trust.supervisor_module.clone(),
+    });
+    let binding = PolicyBinding {
+        policy_id: "arkhe-preview/v1".into(),
+        version: 1,
+        policy_digest: trust.policy_digest,
+    };
+    match gate
+        .authorize_routed_admitted(
+            i,
+            w,
+            &binding,
+            &admitted,
+            &PreviewRequest::route(trust.policy_digest),
+            Some(&human),
+            now,
+        )
+        .await
+    {
+        AuthorizationDecision::Reject { reason } => Err(reason),
+        AuthorizationDecision::Allow { authorization_ref } => Ok(AdmittedPreview {
+            request,
+            authorization_ref,
+            admitted_at: now,
+        }),
+    }
+}
+
+/// Both evidence and pending job are written using the caller's transaction.
+/// The caller owns commit/rollback. Restricted roles and SET LOCAL tenant required.
+pub async fn enqueue_preview(
+    tx: &mut Transaction<'_, Postgres>,
+    preview: &AdmittedPreview,
+) -> Result<Digest32, String> {
+    use sqlx::Acquire;
+    // A failed enqueue must not leave only the admission behind, even if the
+    // caller handles the error and commits its unrelated business transaction.
+    let mut savepoint = tx.begin().await.map_err(|e| e.to_string())?;
+    match queue::enqueue(&mut savepoint, preview).await {
+        Ok(digest) => {
+            savepoint.commit().await.map_err(|e| e.to_string())?;
+            Ok(digest)
+        }
+        Err(error) => {
+            savepoint.rollback().await.map_err(|e| e.to_string())?;
+            Err(error)
+        }
+    }
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/src/preview/authority.rs b/arkhe/source/orchestration/arkhe-runtime/src/preview/authority.rs
new file mode 100644
index 00000000..d79b0feb
--- /dev/null
+++ b/arkhe/source/orchestration/arkhe-runtime/src/preview/authority.rs
@@ -0,0 +1,180 @@
+//! External bridge verdict admission. Native HSM/TEE/Sigstore chains are verified
+//! by the designated external bridge, never by trusting self-declared origin labels.
+use super::{executor::read_json, PreviewSpec};
+use arkhe_core::{
+    canonical::encode_value,
+    evidence::{EvidenceEnvelope, EvidenceReader},
+    work::{ContextEntry, ContextKind, RequestIdentity, WorkIntent, WorkIntentType},
+    worker::{CognitiveOperation, WorkerExecutionRecord},
+    Digest32,
+};
+use arkhe_governance::{EvidenceKindRequirement, PolicyBinding, PolicyResolver, PolicyVerdict};
+use arkhe_kernel::{AuthorizationDecision, ContainmentGate};
+use async_trait::async_trait;
+use serde::{Deserialize, Serialize};
+use std::path::PathBuf;
+#[derive(Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct ExternalIdentity {
+    pub source: String,
+    pub issuer: String,
+    pub subject: String,
+    pub measurement: Option<Digest32>,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct AuthorityPolicy {
+    pub root_key: [u8; 32],
+    pub expected: ExternalIdentity,
+    pub admission_file: PathBuf,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct AuthorityAdmission {
+    pub version: u16,
+    pub identity: ExternalIdentity,
+    pub qualification_key: [u8; 32],
+    pub evidence_digest: Digest32,
+    pub issued_at: i64,
+    pub expires_at: i64,
+    pub signature: String,
+}
+impl AuthorityAdmission {
+    pub fn signing_bytes(&self) -> Vec<u8> {
+        let mut v = serde_json::to_value(self).expect("authority projection");
+        v.as_object_mut().unwrap().remove("signature");
+        let mut b = b"AKG:RUNTIME:EXTERNAL-AUTHORITY:v1\0".to_vec();
+        b.extend(encode_value(&v));
+        b
+    }
+    pub fn verify(&self, p: &AuthorityPolicy, key: [u8; 32], now: i64) -> Result<(), String> {
+        if self.version != 1
+            || self.identity != p.expected
+            || self.qualification_key != key
+            || p.root_key == key
+            || self.evidence_digest == Digest32::ZERO
+            || self.issued_at < 0
+            || self.issued_at > now
+            || self.expires_at <= now
+            || self.expires_at.saturating_sub(self.issued_at) > 86400
+            || p.expected.issuer.trim().is_empty()
+            || p.expected.subject.trim().is_empty()
+            || !matches!(
+                p.expected.source.as_str(),
+                "HSM_KMS" | "TEE" | "COSIGN_SIGSTORE"
+            )
+            || (p.expected.source == "TEE"
+                && p.expected.measurement.is_none_or(|v| v == Digest32::ZERO))
+            || (p.expected.source == "COSIGN_SIGSTORE"
+                && p.expected.issuer != "https://token.actions.githubusercontent.com")
+        {
+            return Err("external authority identity, time or provenance binding rejected".into());
+        }
+        super::verify_signature(&p.root_key, &self.signing_bytes(), &self.signature)
+    }
+}
+struct Policy {
+    target: Digest32,
+    parameters: Digest32,
+}
+impl PolicyResolver for Policy {
+    fn resolve(&self, i: &WorkIntent, _: &PolicyBinding) -> PolicyVerdict {
+        if i.intent_type == WorkIntentType::ReleaseSoftware
+            && i.target == self.target
+            && i.parameters_digest == self.parameters
+        {
+            PolicyVerdict::Allow
+        } else {
+            PolicyVerdict::Deny("external authority admission only".into())
+        }
+    }
+    fn required_worker_evidence(
+        &self,
+        _: &WorkIntent,
+        _: &PolicyBinding,
+    ) -> Option<EvidenceKindRequirement> {
+        Some(EvidenceKindRequirement {
+            allowed_modules: vec!["external-runtime-authority-bridge".into()],
+            allowed_operations: vec![CognitiveOperation::Decide],
+        })
+    }
+}
+struct Reader(EvidenceEnvelope);
+#[async_trait]
+impl EvidenceReader for Reader {
+    async fn get(&self, h: Digest32) -> Result<Option<EvidenceEnvelope>, String> {
+        Ok((h == self.0.record_hash).then(|| self.0.clone()))
+    }
+}
+pub async fn admit(
+    policy: &AuthorityPolicy,
+    key: [u8; 32],
+    spec: &PreviewSpec,
+    now: i64,
+) -> Result<Digest32, String> {
+    let a: AuthorityAdmission = read_json(&policy.admission_file)?;
+    a.verify(policy, key, now)?;
+    // Only a successfully authenticated external verdict reaches this private gate policy.
+    let target = Digest32::blake3(b"AKG:RUNTIME:QUALIFIER-KEY:v1\0", &key);
+    let parameters = Digest32::blake3(
+        b"AKG:RUNTIME:AUTHORITY-BINDING:v1\0",
+        &encode_value(
+            &serde_json::json!({"admission":hex::encode(a.signing_bytes()),"tenant":spec.tenant,"profile":spec.runtime_profile,"image":spec.image}),
+        ),
+    );
+    let worker = WorkerExecutionRecord {
+        classification: None,
+        operation: Some(CognitiveOperation::Decide),
+        module_id: "external-runtime-authority-bridge".into(),
+        module_version: "1".into(),
+        input_digest: a.evidence_digest,
+        output_digest: parameters,
+        evidence_refs: vec![a.evidence_digest],
+        confidence_bps: None,
+        uncertainty_note: None,
+        execution_id: parameters.to_hex(),
+    };
+    let intent = WorkIntent {
+        requested_by: a.identity.subject.clone(),
+        intent_type: WorkIntentType::ReleaseSoftware,
+        target,
+        parameters_digest: parameters,
+        context: vec![
+            ContextEntry {
+                kind: ContextKind::SourceReport,
+                hash: a.evidence_digest,
+            },
+            ContextEntry {
+                kind: ContextKind::AnalysisRecord,
+                hash: worker.digest(),
+            },
+        ],
+        context_refs: vec![],
+        request_identity: RequestIdentity::new(&parameters.0),
+        claimed_created_at: now,
+    };
+    let reader = Reader(EvidenceEnvelope {
+        record_hash: worker.digest(),
+        kind: "WorkerExecutionRecord".into(),
+        subject: a.evidence_digest,
+        payload_digest: worker.digest(),
+        policy_digest: Some(parameters),
+        causal_parents: vec![a.evidence_digest],
+    });
+    match ContainmentGate::new(Policy { target, parameters })
+        .authorize_admitted(
+            &intent,
+            &worker,
+            &PolicyBinding {
+                policy_id: "external-runtime-authority/v1".into(),
+                version: 1,
+                policy_digest: parameters,
+            },
+            &reader,
+        )
+        .await
+    {
+        AuthorizationDecision::Allow { authorization_ref } => Ok(authorization_ref),
+        AuthorizationDecision::Reject { reason } => Err(reason),
+    }
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/src/preview/dispatch.rs b/arkhe/source/orchestration/arkhe-runtime/src/preview/dispatch.rs
new file mode 100644
index 00000000..5409e373
--- /dev/null
+++ b/arkhe/source/orchestration/arkhe-runtime/src/preview/dispatch.rs
@@ -0,0 +1,258 @@
+//! Fenced operational leases. Only pre-dispatch failures can retry automatically.
+use super::PreviewRequest;
+use arkhe_core::Digest32;
+use serde::Serialize;
+use sqlx::{PgPool, Postgres, Row, Transaction};
+use uuid::Uuid;
+
+pub struct PreviewQueue {
+    pool: PgPool,
+    tenant: String,
+}
+pub struct Lease {
+    pub request: PreviewRequest,
+    pub bundle_digest: Digest32,
+    pub fence: i64,
+    pub attempts: i32,
+    owner: Uuid,
+}
+#[derive(Debug, Serialize)]
+pub struct DispatchStatus {
+    pub operation_id: String,
+    pub state: String,
+    pub attempts: i32,
+    pub fence: i64,
+    pub result: Option<serde_json::Value>,
+}
+pub enum Completion {
+    Succeeded(serde_json::Value),
+    Failed(String),
+    Unknown(String),
+    Retry(String),
+}
+impl PreviewQueue {
+    pub async fn connect(url: &str, tenant: &str) -> Result<Self, String> {
+        if tenant.trim().is_empty() {
+            return Err("tenant required".into());
+        }
+        let pool = sqlx::postgres::PgPoolOptions::new()
+            .max_connections(6)
+            .acquire_timeout(std::time::Duration::from_secs(5))
+            .connect(url)
+            .await
+            .map_err(|_| "preview database unavailable")?;
+        let privileged: bool = sqlx::query_scalar("SELECT rolsuper OR rolbypassrls OR rolcreatedb OR rolcreaterole FROM pg_roles WHERE rolname=current_user")
+            .fetch_one(&pool).await.map_err(|_|"preview role unavailable")?;
+        if privileged {
+            return Err("preview worker refuses administrative database roles".into());
+        }
+        Ok(Self {
+            pool,
+            tenant: tenant.into(),
+        })
+    }
+    async fn begin(&self) -> Result<Transaction<'_, Postgres>, String> {
+        let mut tx = self.pool.begin().await.map_err(db)?;
+        sqlx::query("SET LOCAL ROLE arkhe_preview_execute")
+            .execute(&mut *tx)
+            .await
+            .map_err(db)?;
+        arkhe_sql::tenant::set_tenant(&mut tx, &self.tenant)
+            .await
+            .map_err(|e| e.to_string())?;
+        Ok(tx)
+    }
+    pub async fn claim(&self, seconds: i32) -> Result<Option<Lease>, String> {
+        self.claim_scoped(None, seconds).await
+    }
+    pub async fn claim_for(&self, actor: &str, seconds: i32) -> Result<Option<Lease>, String> {
+        if actor.trim().is_empty() {
+            return Err("worker actor required".into());
+        }
+        self.claim_scoped(Some(actor), seconds).await
+    }
+    async fn claim_scoped(
+        &self,
+        actor: Option<&str>,
+        seconds: i32,
+    ) -> Result<Option<Lease>, String> {
+        if !(10..=300).contains(&seconds) {
+            return Err("lease must be 10..300 seconds".into());
+        }
+        let mut tx = self.begin().await?;
+        sqlx::query("INSERT INTO preview_dispatches(tenant_id,requested_by,operation_id) SELECT tenant_id,requested_by,operation_id FROM preview_jobs ON CONFLICT DO NOTHING").execute(&mut *tx).await.map_err(db)?;
+        // An expired RUNNING job may have had an effect: never reclaim it.
+        let expired=sqlx::query("UPDATE preview_dispatches SET state=CASE WHEN state='RUNNING' THEN 'UNKNOWN' ELSE 'DEAD' END,owner_token=NULL,lease_until=NULL,result='\"lease expired\"'::jsonb,updated_at=clock_timestamp() WHERE lease_until<=clock_timestamp() AND (state='RUNNING' OR (state='LEASED' AND attempts>=3)) RETURNING requested_by,operation_id,fence,state")
+            .fetch_all(&mut *tx).await.map_err(db)?;
+        for row in expired {
+            event(
+                &mut tx,
+                &self.tenant,
+                row.get("requested_by"),
+                row.get("operation_id"),
+                row.get("fence"),
+                row.get("state"),
+                serde_json::json!({"reason":"lease expired; no automatic redispatch"}),
+            )
+            .await?;
+        }
+        let row=sqlx::query("SELECT requested_by,operation_id FROM preview_dispatches WHERE ($1::text IS NULL OR requested_by=$1) AND attempts<3 AND available_at<=clock_timestamp() AND (state IN ('READY','RETRY') OR (state='LEASED' AND lease_until<=clock_timestamp())) ORDER BY available_at,operation_id FOR UPDATE SKIP LOCKED LIMIT 1")
+            .bind(actor).fetch_optional(&mut *tx).await.map_err(db)?;
+        let Some(row) = row else {
+            tx.commit().await.map_err(db)?;
+            return Ok(None);
+        };
+        let actor: String = row.get("requested_by");
+        let op: Vec<u8> = row.get("operation_id");
+        let owner = Uuid::new_v4();
+        let row=sqlx::query("UPDATE preview_dispatches SET state='LEASED',attempts=attempts+1,fence=fence+1,owner_token=$3,lease_until=clock_timestamp()+make_interval(secs=>$4),updated_at=clock_timestamp(),result=NULL WHERE requested_by=$1 AND operation_id=$2 RETURNING fence,attempts")
+            .bind(&actor).bind(&op).bind(owner).bind(f64::from(seconds)).fetch_one(&mut *tx).await.map_err(db)?;
+        let fence: i64 = row.get("fence");
+        let attempts: i32 = row.get("attempts");
+        let row=sqlx::query("SELECT bundle,bundle_digest FROM preview_admissions WHERE requested_by=$1 AND operation_id=$2").bind(&actor).bind(&op).fetch_one(&mut *tx).await.map_err(db)?;
+        let value: serde_json::Value = row.get("bundle");
+        let request: PreviewRequest =
+            serde_json::from_value(value.clone()).map_err(|_| "corrupt preview request")?;
+        let raw: Vec<u8> = row.get("bundle_digest");
+        let digest = Digest32(raw.try_into().map_err(|_| "invalid bundle digest")?);
+        let actual = Digest32::blake3(
+            b"AKG:PREVIEW:ADMISSION:v1\0",
+            &arkhe_core::canonical::encode_value(&value),
+        );
+        if actual != digest
+            || request.spec.tenant != self.tenant
+            || request.intent.requested_by != actor
+            || request.intent.operation_id().0.as_slice() != op
+        {
+            return Err("stored preview binding mismatch".into());
+        }
+        event(
+            &mut tx,
+            &self.tenant,
+            &actor,
+            &op,
+            fence,
+            "LEASED",
+            serde_json::json!({"attempt":attempts}),
+        )
+        .await?;
+        tx.commit().await.map_err(db)?;
+        Ok(Some(Lease {
+            request,
+            bundle_digest: digest,
+            fence,
+            attempts,
+            owner,
+        }))
+    }
+    pub async fn heartbeat(&self, l: &Lease, seconds: i32) -> Result<bool, String> {
+        if !(10..=300).contains(&seconds) {
+            return Err("invalid lease duration".into());
+        }
+        self.update_lease(l,"UPDATE preview_dispatches SET lease_until=clock_timestamp()+make_interval(secs=>$5),updated_at=clock_timestamp() WHERE requested_by=$1 AND operation_id=$2 AND owner_token=$3 AND fence=$4 AND state IN ('LEASED','RUNNING') AND lease_until>clock_timestamp()",Some(seconds)).await
+    }
+    async fn update_lease(
+        &self,
+        l: &Lease,
+        sql: &str,
+        seconds: Option<i32>,
+    ) -> Result<bool, String> {
+        let mut tx = self.begin().await?;
+        let query = sqlx::query(sql)
+            .bind(&l.request.intent.requested_by)
+            .bind(l.request.intent.operation_id().0.to_vec())
+            .bind(l.owner)
+            .bind(l.fence);
+        let query = if let Some(s) = seconds {
+            query.bind(f64::from(s))
+        } else {
+            query
+        };
+        let n = query.execute(&mut *tx).await.map_err(db)?.rows_affected();
+        tx.commit().await.map_err(db)?;
+        Ok(n == 1)
+    }
+    pub async fn start(&self, l: &Lease) -> Result<bool, String> {
+        let mut tx = self.begin().await?;
+        let n=sqlx::query("UPDATE preview_dispatches SET state='RUNNING',updated_at=clock_timestamp() WHERE requested_by=$1 AND operation_id=$2 AND owner_token=$3 AND fence=$4 AND state='LEASED' AND lease_until>clock_timestamp()")
+            .bind(&l.request.intent.requested_by).bind(l.request.intent.operation_id().0.to_vec()).bind(l.owner).bind(l.fence).execute(&mut *tx).await.map_err(db)?.rows_affected();
+        if n == 1 {
+            event(
+                &mut tx,
+                &self.tenant,
+                &l.request.intent.requested_by,
+                &l.request.intent.operation_id().0,
+                l.fence,
+                "RUNNING",
+                serde_json::json!({"bundle_digest":l.bundle_digest.to_hex()}),
+            )
+            .await?;
+        }
+        tx.commit().await.map_err(db)?;
+        Ok(n == 1)
+    }
+    pub async fn finish(&self, l: &Lease, outcome: Completion) -> Result<bool, String> {
+        let (state, details, retry) = match outcome {
+            Completion::Succeeded(v) => ("SUCCEEDED", v, false),
+            Completion::Failed(e) => ("FAILED", serde_json::json!({"reason":e}), false),
+            Completion::Unknown(e) => ("UNKNOWN", serde_json::json!({"reason":e}), false),
+            Completion::Retry(e) => (
+                if l.attempts >= 3 { "DEAD" } else { "RETRY" },
+                serde_json::json!({"reason":e}),
+                true,
+            ),
+        };
+        let mut tx = self.begin().await?;
+        let n=sqlx::query("UPDATE preview_dispatches SET state=$5,owner_token=NULL,lease_until=NULL,result=$6,available_at=clock_timestamp()+make_interval(secs=>$7),updated_at=clock_timestamp() WHERE requested_by=$1 AND operation_id=$2 AND owner_token=$3 AND fence=$4 AND lease_until>clock_timestamp() AND (state='LEASED' OR (state='RUNNING' AND NOT $8))")
+            .bind(&l.request.intent.requested_by).bind(l.request.intent.operation_id().0.to_vec()).bind(l.owner).bind(l.fence).bind(state).bind(&details).bind(f64::from(2i32.pow(l.attempts as u32))).bind(retry)
+            .execute(&mut *tx).await.map_err(db)?.rows_affected();
+        if n == 1 {
+            event(
+                &mut tx,
+                &self.tenant,
+                &l.request.intent.requested_by,
+                &l.request.intent.operation_id().0,
+                l.fence,
+                state,
+                details,
+            )
+            .await?;
+        }
+        tx.commit().await.map_err(db)?;
+        Ok(n == 1)
+    }
+    pub async fn status(
+        &self,
+        actor: &str,
+        operation: Digest32,
+    ) -> Result<Option<DispatchStatus>, String> {
+        let mut tx = self.begin().await?;
+        let row=sqlx::query("SELECT d.state,d.attempts,d.fence,d.result FROM preview_jobs j LEFT JOIN preview_dispatches d USING(tenant_id,requested_by,operation_id) WHERE j.requested_by=$1 AND j.operation_id=$2").bind(actor).bind(operation.0.to_vec()).fetch_optional(&mut *tx).await.map_err(db)?;
+        let result = row.map(|r| DispatchStatus {
+            operation_id: operation.to_hex(),
+            state: r
+                .get::<Option<String>, _>("state")
+                .unwrap_or("PENDING".into()),
+            attempts: r.get::<Option<i32>, _>("attempts").unwrap_or(0),
+            fence: r.get::<Option<i64>, _>("fence").unwrap_or(0),
+            result: r.get("result"),
+        });
+        tx.commit().await.map_err(db)?;
+        Ok(result)
+    }
+}
+async fn event(
+    tx: &mut Transaction<'_, Postgres>,
+    tenant: &str,
+    actor: &str,
+    op: &[u8],
+    fence: i64,
+    state: &str,
+    details: serde_json::Value,
+) -> Result<(), String> {
+    sqlx::query("INSERT INTO preview_execution_events(tenant_id,requested_by,operation_id,event_id,fence,state,details) VALUES($1,$2,$3,$4,$5,$6,$7)").bind(tenant).bind(actor).bind(op).bind(Uuid::new_v4()).bind(fence).bind(state).bind(details).execute(&mut **tx).await.map_err(db)?;
+    Ok(())
+}
+fn db(_: sqlx::Error) -> String {
+    "preview dispatch database operation failed".into()
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/src/preview/executor.rs b/arkhe/source/orchestration/arkhe-runtime/src/preview/executor.rs
new file mode 100644
index 00000000..646b27d3
--- /dev/null
+++ b/arkhe/source/orchestration/arkhe-runtime/src/preview/executor.rs
@@ -0,0 +1,658 @@
+//! A fixed Podman test executor. Qualification is an independently signed input,
+//! never inferred from successful code execution or a self-reported probe.
+use super::{PreviewSpec, PreviewTrust};
+use arkhe_core::{canonical::encode_value, Digest32};
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::BTreeMap,
+    path::{Path, PathBuf},
+    time::Duration,
+};
+use tokio::{io::AsyncReadExt, process::Command};
+
+pub const VECTORS: [&str; 22] = [
+    "identity",
+    "cgroup-enforcement",
+    "mount-inventory",
+    "socket-local-control",
+    "tcp-egress",
+    "udp-egress",
+    "dns-egress",
+    "image-read-control",
+    "writable-control",
+    "input-read-control",
+    "input-write",
+    "image-write",
+    "outside-mount-canary",
+    "traversal-and-symlink",
+    "subprocess-control",
+    "ffi-control",
+    "mount-capability",
+    "seccomp-inventory",
+    "tmp-noexec",
+    "memory-bounded",
+    "cpu-bounded",
+    "pids-bounded",
+];
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ExecutorConfig {
+    #[serde(default)]
+    pub authority: Option<super::authority::AuthorityPolicy>,
+    pub podman: PathBuf,
+    pub connection: String,
+    pub artifact_store: PathBuf,
+    pub qualification: PathBuf,
+    pub qualification_key: [u8; 32],
+    pub trust_file: PathBuf,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Qualification {
+    pub version: u16,
+    pub image: String,
+    pub runtime_profile: Digest32,
+    pub engine_identity: Digest32,
+    pub executor_digest: Digest32,
+    pub issued_at: i64,
+    pub expires_at: i64,
+    pub evidence_digest: Digest32,
+    pub vectors: BTreeMap<String, String>,
+    pub signature: String,
+}
+impl Qualification {
+    pub fn signing_bytes(&self) -> Vec<u8> {
+        let mut v = serde_json::to_value(self).expect("qualification");
+        v.as_object_mut().unwrap().remove("signature");
+        let mut bytes = b"AKG:PREVIEW:QUALIFICATION:v1\0".to_vec();
+        bytes.extend(encode_value(&v));
+        bytes
+    }
+    pub fn verify(
+        &self,
+        spec: &PreviewSpec,
+        key: &[u8; 32],
+        engine: Digest32,
+        binary: Digest32,
+        now: i64,
+    ) -> Result<(), String> {
+        if self.version != 1
+            || self.image != spec.image
+            || self.runtime_profile != spec.runtime_profile
+            || self.runtime_profile != profile_digest()
+            || self.engine_identity != engine
+            || self.executor_digest != binary
+            || self.evidence_digest == Digest32::ZERO
+            || self.issued_at < 0
+            || self.issued_at > now
+            || self.expires_at <= now
+            || self.expires_at.saturating_sub(self.issued_at) > 86400
+            || self.vectors.len() != 22
+            || VECTORS
+                .iter()
+                .any(|v| self.vectors.get(*v).map(String::as_str) != Some("PASS"))
+        {
+            return Err("executor qualification missing, stale or bound to another runtime".into());
+        }
+        super::verify_signature(key, &self.signing_bytes(), &self.signature)
+    }
+}
+pub fn profile_digest() -> Digest32 {
+    Digest32::blake3(
+        b"AKG:PREVIEW:EXECUTOR:v1\0",
+        &encode_value(&serde_json::json!({
+            "command":"cargo test --locked --offline -p MODULE", "network":"none","read_only":1,
+            "uid":"10001:10001","cap_drop":"ALL","no_new_privileges":1,"memory":1610612736u64,
+            "memory_swap":1610612736u64,"pids":128,"cpus":2,"work_tmpfs":1073741824u64,
+            "tmp_tmpfs":67108864,"tmp_noexec":1,"deadline_seconds":120,"max_output_bytes":1048576
+        })),
+    )
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SourceBundle {
+    pub baseline: BTreeMap<String, String>,
+    pub proposal: BTreeMap<String, String>,
+}
+fn content_digest(bytes: &[u8]) -> String {
+    Digest32::blake3(b"", bytes).to_hex()
+}
+impl SourceBundle {
+    pub fn baseline_digest(&self) -> Digest32 {
+        Digest32::blake3(
+            b"AKG:PREVIEW:BASELINE:v1\0",
+            &encode_value(&serde_json::to_value(&self.baseline).unwrap()),
+        )
+    }
+    pub fn proposal_digest(&self) -> Digest32 {
+        Digest32::blake3(
+            b"AKG:PREVIEW:PROPOSAL:v1\0",
+            &encode_value(&serde_json::to_value(&self.proposal).unwrap()),
+        )
+    }
+    pub fn manifest(&self) -> BTreeMap<String, String> {
+        let mut m = self.baseline.clone();
+        for (p, v) in &self.proposal {
+            m.insert(p.clone(), content_digest(v.as_bytes()));
+        }
+        m
+    }
+    pub fn artifact_digest(&self) -> Digest32 {
+        Digest32::blake3(
+            b"AKG:PREVIEW:ARTIFACT:v1\0",
+            &encode_value(&serde_json::to_value(self.manifest()).unwrap()),
+        )
+    }
+    pub fn verify(&self, spec: &PreviewSpec) -> Result<(), String> {
+        if self.baseline.is_empty()
+            || self.baseline.len() > 5000
+            || self.proposal.is_empty()
+            || self.proposal.len() > 8
+            || self.proposal.values().map(|v| v.len()).sum::<usize>() > 65536
+            || self.baseline_digest() != spec.baseline_digest
+            || self.proposal_digest() != spec.proposal_digest
+            || self.artifact_digest() != spec.artifact_digest
+        {
+            return Err("source bundle binding mismatch".into());
+        }
+        for p in self.baseline.keys().chain(self.proposal.keys()) {
+            safe_path(p)?;
+        }
+        if !spec
+            .module
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+            || spec.module.is_empty()
+        {
+            return Err("invalid Rust module".into());
+        }
+        // Only Rust source/tests within the selected crate may be changed.
+        for p in self.proposal.keys() {
+            let parts: Vec<_> = p.split('/').collect();
+            if parts.len() < 4
+                || parts[1] != spec.module
+                || !matches!(parts[2], "src" | "tests")
+                || !p.ends_with(".rs")
+            {
+                return Err("proposal escapes selected Rust crate".into());
+            }
+        }
+        Ok(())
+    }
+}
+fn safe_path(p: &str) -> Result<(), String> {
+    if p.is_empty()
+        || p.contains('\\')
+        || p.contains(':')
+        || p.split('/').any(|c| c.is_empty() || c == "." || c == "..")
+        || !p
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"-_/.".contains(&b))
+    {
+        return Err("invalid source path".into());
+    }
+    Ok(())
+}
+pub fn read_json<T: serde::de::DeserializeOwned>(path: &Path) -> Result<T, String> {
+    use std::io::Read;
+    let mut f = std::fs::File::open(path).map_err(|_| "configured preview file unavailable")?;
+    if !f
+        .metadata()
+        .map_err(|_| "file metadata unavailable")?
+        .is_file()
+    {
+        return Err("regular file required".into());
+    }
+    let mut bytes = vec![];
+    std::io::Read::by_ref(&mut f)
+        .take(262145)
+        .read_to_end(&mut bytes)
+        .map_err(|_| "preview file read failed")?;
+    if bytes.len() > 262144 {
+        return Err("preview file exceeds 256 KiB".into());
+    }
+    serde_json::from_slice(&bytes).map_err(|_| "invalid preview JSON".into())
+}
+
+pub struct PreparedExecution {
+    config: ExecutorConfig,
+    spec: PreviewSpec,
+    stage: PathBuf,
+    engine: Digest32,
+    binary: Digest32,
+    cleanup_allowed: std::sync::atomic::AtomicBool,
+}
+impl Drop for PreparedExecution {
+    fn drop(&mut self) {
+        if !self
+            .cleanup_allowed
+            .load(std::sync::atomic::Ordering::SeqCst)
+        {
+            return;
+        }
+        // Verify the resolved target immediately before recursive cleanup on Windows.
+        if let (Ok(stage), Ok(temp)) = (
+            self.stage.canonicalize(),
+            std::env::temp_dir().canonicalize(),
+        ) {
+            if stage.parent() == Some(temp.as_path())
+                && stage
+                    .file_name()
+                    .is_some_and(|v| v.to_string_lossy().starts_with("arkhe-preview-sealed-"))
+            {
+                let _ = std::fs::remove_dir_all(stage);
+            }
+        }
+    }
+}
+// stage is created by this process under temp with a UUID. No caller path is removed.
+pub async fn prepare(
+    config: ExecutorConfig,
+    spec: &PreviewSpec,
+    now: i64,
+) -> Result<PreparedExecution, String> {
+    if config.connection.is_empty() || !config.podman.is_absolute() {
+        return Err("absolute Podman path and named connection required".into());
+    }
+    let q: Qualification = read_json(&config.qualification)?;
+    // Reject missing/forged qualification before even invoking the engine.
+    q.verify(
+        spec,
+        &config.qualification_key,
+        q.engine_identity,
+        q.executor_digest,
+        now,
+    )?;
+    let authority = config
+        .authority
+        .as_ref()
+        .ok_or("external qualification authority not admitted")?;
+    super::authority::admit(authority, config.qualification_key, spec, now).await?;
+    let engine = engine_identity(&config).await?;
+    let binary = Digest32::blake3(
+        b"",
+        &std::fs::read(std::env::current_exe().map_err(|_| "executor path unavailable")?)
+            .map_err(|_| "executor bytes unavailable")?,
+    );
+    q.verify(spec, &config.qualification_key, engine, binary, now)?;
+    let dir = config.artifact_store.join(spec.artifact_digest.to_hex());
+    let bundle: SourceBundle = read_json(&dir.join("bundle.json"))?;
+    bundle.verify(spec)?;
+    let stage = std::env::temp_dir().join(format!("arkhe-preview-sealed-{}", uuid::Uuid::new_v4()));
+    std::fs::create_dir(&stage).map_err(|_| "staging unavailable")?;
+    let prepared = PreparedExecution {
+        config,
+        spec: spec.clone(),
+        stage,
+        engine,
+        binary,
+        cleanup_allowed: std::sync::atomic::AtomicBool::new(true),
+    };
+    let source = dir.join("source");
+    let manifest = bundle.manifest();
+    let mut total = 0u64;
+    let mut found = BTreeMap::new();
+    copy_source(&source, &source, &prepared.stage, &mut found, &mut total)?;
+    if found != manifest {
+        return Err("artifact content or file set mismatch".into());
+    }
+    Ok(prepared)
+}
+fn copy_source(
+    root: &Path,
+    current: &Path,
+    dest: &Path,
+    manifest: &mut BTreeMap<String, String>,
+    total: &mut u64,
+) -> Result<(), String> {
+    let meta = std::fs::symlink_metadata(current).map_err(|_| "source missing")?;
+    if meta.is_symlink() {
+        return Err("source symlink rejected".into());
+    }
+    if meta.is_dir() {
+        for e in std::fs::read_dir(current).map_err(|_| "source inventory failed")? {
+            copy_source(
+                root,
+                &e.map_err(|_| "source entry unavailable")?.path(),
+                dest,
+                manifest,
+                total,
+            )?;
+        }
+    } else if meta.is_file() {
+        let relative = current
+            .strip_prefix(root)
+            .map_err(|_| "invalid source root")?
+            .to_str()
+            .ok_or("source path not UTF8")?
+            .replace('\\', "/");
+        safe_path(&relative)?;
+        *total = total.saturating_add(meta.len());
+        if *total > 50 * 1024 * 1024 || manifest.len() >= 5000 {
+            return Err("source limit exceeded".into());
+        }
+        let bytes = std::fs::read(current).map_err(|_| "source read failed")?;
+        let target = dest.join(&relative);
+        std::fs::create_dir_all(target.parent().unwrap())
+            .map_err(|_| "staging directory failed")?;
+        std::fs::write(target, &bytes).map_err(|_| "staging write failed")?;
+        manifest.insert(relative, content_digest(&bytes));
+    } else {
+        return Err("non-regular source rejected".into());
+    }
+    Ok(())
+}
+pub async fn engine_identity(c: &ExecutorConfig) -> Result<Digest32, String> {
+    let (_, bytes) = command(c, &["info", "--format", "json"], 20, 262144).await?;
+    let info: serde_json::Value =
+        serde_json::from_slice(&bytes).map_err(|_| "Podman info invalid")?;
+    let host = &info["host"];
+    if host["security"]["rootless"] != true {
+        return Err("rootless engine required".into());
+    }
+    // uptime is excluded; boot_id obtained inside the engine's own host namespace.
+    #[cfg(not(windows))]
+    let (_, boot) = command(
+        c,
+        &[
+            "machine",
+            "ssh",
+            &c.connection,
+            "cat",
+            "/proc/sys/kernel/random/boot_id",
+        ],
+        20,
+        1024,
+    )
+    .await?;
+    #[cfg(windows)]
+    let boot = {
+        // Podman/WSL distributions use the observed "podman-<machine>" name.
+        // Query the fixed kernel file directly; no SSH key permissions are changed.
+        let exe = PathBuf::from(
+            std::env::var_os("SystemRoot").ok_or("Windows system directory unavailable")?,
+        )
+        .join("System32/wsl.exe");
+        let distro = format!("podman-{}", c.connection);
+        let mut cmd = Command::new(exe);
+        cmd.args([
+            "--distribution",
+            &distro,
+            "--exec",
+            "cat",
+            "/proc/sys/kernel/random/boot_id",
+        ])
+        .env_clear();
+        for k in ["PATH", "USERPROFILE", "SYSTEMROOT", "TEMP", "TMP"] {
+            if let Some(v) = std::env::var_os(k) {
+                cmd.env(k, v);
+            }
+        }
+        cmd.creation_flags(0x08000000);
+        let output = tokio::time::timeout(
+            Duration::from_secs(10),
+            cmd.stdin(std::process::Stdio::null())
+                .kill_on_drop(true)
+                .output(),
+        )
+        .await
+        .map_err(|_| "engine boot observation timed out")?
+        .map_err(|_| "engine boot observation unavailable")?;
+        if !output.status.success() || output.stdout.len() > 128 {
+            return Err("engine boot observation rejected".into());
+        }
+        output.stdout
+    };
+    let boot = String::from_utf8(boot).map_err(|_| "boot identity invalid")?;
+    if boot.trim().len() != 36 {
+        return Err("engine boot identity unavailable".into());
+    }
+    Ok(Digest32::blake3(
+        b"AKG:PREVIEW:ENGINE:v1\0",
+        &encode_value(
+            &serde_json::json!({"connection":c.connection,"boot_id":boot.trim(),"hostname":host["hostname"],"kernel":host["kernel"],"arch":host["arch"],"version":info["version"],"oci_runtime":serde_json::to_string(&host["ociRuntime"]).map_err(|_|"OCI runtime identity invalid")?}),
+        ),
+    ))
+}
+pub async fn revalidate(
+    prepared: &PreparedExecution,
+    trust: &PreviewTrust,
+    now: i64,
+) -> Result<(), String> {
+    let q: Qualification = read_json(&prepared.config.qualification)?;
+    if trust.emergency_stop
+        || prepared.config.qualification_key == trust.supervisor_key
+        || prepared.config.qualification_key == trust.reviewer_key
+        || trust.image != prepared.spec.image
+        || trust.runtime_profile != profile_digest()
+    {
+        return Err("executor policy revoked".into());
+    }
+    let authority = prepared
+        .config
+        .authority
+        .as_ref()
+        .ok_or("external qualification authority missing")?;
+    if authority.root_key == trust.supervisor_key || authority.root_key == trust.reviewer_key {
+        return Err("external root overlaps preview signers".into());
+    }
+    super::authority::admit(
+        authority,
+        prepared.config.qualification_key,
+        &prepared.spec,
+        now,
+    )
+    .await?;
+    if engine_identity(&prepared.config).await? != prepared.engine {
+        return Err("runtime changed after qualification".into());
+    }
+    q.verify(
+        &prepared.spec,
+        &prepared.config.qualification_key,
+        prepared.engine,
+        prepared.binary,
+        now,
+    )
+}
+
+/// All errors after dispatch are conservatively ambiguous unless cleanup is observed.
+pub async fn execute(
+    p: &PreparedExecution,
+    cancel: std::sync::Arc<std::sync::atomic::AtomicBool>,
+) -> Result<serde_json::Value, String> {
+    use std::sync::atomic::Ordering;
+    p.cleanup_allowed.store(false, Ordering::SeqCst);
+    let name = format!("arkhe-preview-{}", uuid::Uuid::new_v4());
+    let volume = format!(
+        "{}:/input:ro",
+        p.stage.to_str().ok_or("staging path invalid")?
+    );
+    let args = [
+        "create",
+        "--name",
+        &name,
+        "--pull=never",
+        "--network=none",
+        "--read-only",
+        "--cap-drop=ALL",
+        "--security-opt=no-new-privileges",
+        "--user=10001:10001",
+        "--pids-limit=128",
+        "--memory=1536m",
+        "--memory-swap=1536m",
+        "--cpus=2",
+        "--tmpfs=/work:rw,exec,size=1073741824,mode=1777",
+        "--tmpfs=/tmp:rw,noexec,size=67108864",
+        "--volume",
+        &volume,
+        "--workdir=/input",
+        "--env=CARGO_HOME=/opt/cargo",
+        "--env=CARGO_TARGET_DIR=/work/target",
+        "--env=CARGO_NET_OFFLINE=true",
+        "--entrypoint=cargo",
+        &p.spec.image,
+        "test",
+        "--locked",
+        "--offline",
+        "-p",
+        &p.spec.module,
+    ];
+    let (_, id) = command(&p.config, &args, 20, 4096)
+        .await
+        .map_err(|_| format!("container creation uncertain; reconcile owned name {name}"))?;
+    let id = String::from_utf8(id)
+        .map_err(|_| "container identity invalid")?
+        .trim()
+        .to_string();
+    if id.len() != 64 || !id.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err("container identity missing; reconciliation required".into());
+    }
+    let result=async{
+        if cancel.load(Ordering::SeqCst){return Err("execution cancelled".into());}
+        let (_,inspect)=command(&p.config,&["inspect",&id],15,262144).await?;
+        let records:serde_json::Value=serde_json::from_slice(&inspect).map_err(|_|"container inspect invalid")?;
+        let c=&records[0];
+        verify_container_policy(c,&p.spec)?;
+        let expected=p.stage.to_str().ok_or("staging path invalid")?.replace('\\',"/");
+        let mapped=if expected.as_bytes().get(1)==Some(&b':') {format!("/mnt/{}/{}",expected[..1].to_ascii_lowercase(),&expected[3..])}else{expected.clone()};
+        let input=c["Mounts"].as_array().and_then(|a|a.iter().find(|m|m["Destination"]=="/input")).and_then(|m|m["Source"].as_str()).ok_or("input mount source unavailable")?.replace('\\',"/");
+        if input!=expected && input!=mapped{return Err("input mount does not bind sealed source".into());}
+        if cancel.load(Ordering::SeqCst){return Err("execution cancelled before start".into());}
+        let start_args=["start","--attach",&id];
+        let execution=command(&p.config,&start_args,120,1048576);
+        tokio::pin!(execution);
+        let output=loop{tokio::select!{r=&mut execution=>break r?,_=tokio::time::sleep(Duration::from_millis(200))=>{if cancel.load(Ordering::SeqCst){return Err("lease lost; execution cancelled".into());}}}};
+        let (_,state)=command(&p.config,&["inspect","--format","{{json .State}}",&id],15,65536).await?;
+        let state:serde_json::Value=serde_json::from_slice(&state).map_err(|_|"container final state invalid")?;
+        if state["Running"]!=false||state["ExitCode"]!=0||!output.0{return Err("preview tests failed".into());}
+        Ok(serde_json::json!({"container_id":id,"image":p.spec.image,"runtime_profile":profile_digest(),"engine_identity":p.engine,"artifact_digest":p.spec.artifact_digest,"output_digest":content_digest(&output.1),"exit_code":0,"scope":"isolated Rust tests; no deploy"}))
+    }.await;
+    command(&p.config, &["rm", "--force", &id], 15, 65536)
+        .await
+        .map_err(|_| "container cleanup uncertain")?;
+    let (code, _) = raw_command(&p.config, &["container", "exists", &id], 10, 4096).await?;
+    if code != 1 {
+        return Err("container absence not established".into());
+    }
+    p.cleanup_allowed.store(true, Ordering::SeqCst);
+    result
+}
+pub fn verify_container_policy(c: &serde_json::Value, spec: &PreviewSpec) -> Result<(), String> {
+    let h = &c["HostConfig"];
+    let config = &c["Config"];
+    let empty = |v: &serde_json::Value| v.as_array().is_some_and(|a| a.is_empty());
+    let security = h["SecurityOpt"]
+        .as_array()
+        .is_some_and(|a| a.iter().any(|s| s == "no-new-privileges"));
+    let drops = h["CapDrop"]
+        .as_array()
+        .ok_or("capability inventory unavailable")?;
+    let caps = [
+        "CAP_CHOWN",
+        "CAP_DAC_OVERRIDE",
+        "CAP_FOWNER",
+        "CAP_FSETID",
+        "CAP_KILL",
+        "CAP_NET_BIND_SERVICE",
+        "CAP_SETFCAP",
+        "CAP_SETGID",
+        "CAP_SETPCAP",
+        "CAP_SETUID",
+        "CAP_SYS_CHROOT",
+    ];
+    let mounts = c["Mounts"]
+        .as_array()
+        .ok_or("mount inventory unavailable")?;
+    let binds: Vec<_> = mounts.iter().filter(|m| m["Type"] == "bind").collect();
+    if c["Image"] != spec.image
+        || config["User"] != "10001:10001"
+        || h["NetworkMode"] != "none"
+        || h["ReadonlyRootfs"] != true
+        || h["Privileged"] != false
+        || !empty(&h["CapAdd"])
+        || !security
+        || caps.iter().any(|cap| !drops.iter().any(|v| v == cap))
+        || h["Memory"] != 1610612736i64
+        || h["MemorySwap"] != 1610612736i64
+        || h["PidsLimit"] != 128
+        || h["CpuQuota"] != 200000
+        || h["CpuPeriod"] != 100000
+        || config["Entrypoint"] != serde_json::json!(["cargo"])
+        || config["Cmd"] != serde_json::json!(["test", "--locked", "--offline", "-p", spec.module])
+        || config["WorkingDir"] != "/input"
+        || binds.len() != 1
+        || binds[0]["Destination"] != "/input"
+        || binds[0]["RW"] != false
+        || mounts
+            .iter()
+            .any(|m| !matches!(m["Destination"].as_str(), Some("/input" | "/tmp" | "/work")))
+        || !h["Tmpfs"]["/tmp"]
+            .as_str()
+            .is_some_and(|s| s.split(',').any(|v| v == "noexec") && s.contains("size=67108864"))
+        || !h["Tmpfs"]["/work"]
+            .as_str()
+            .is_some_and(|s| s.contains("size=1073741824"))
+    {
+        return Err("effective container policy differs from qualified profile".into());
+    }
+    Ok(())
+}
+pub async fn command(
+    c: &ExecutorConfig,
+    args: &[&str],
+    seconds: u64,
+    limit: u64,
+) -> Result<(bool, Vec<u8>), String> {
+    let (code, bytes) = raw_command(c, args, seconds, limit).await?;
+    if code != 0 {
+        return Err("Podman command failed".into());
+    }
+    Ok((true, bytes))
+}
+async fn raw_command(
+    c: &ExecutorConfig,
+    args: &[&str],
+    seconds: u64,
+    limit: u64,
+) -> Result<(i32, Vec<u8>), String> {
+    let mut cmd = Command::new(&c.podman);
+    cmd.args(["--connection", &c.connection])
+        .args(args)
+        .env_clear();
+    for k in ["PATH", "USERPROFILE", "HOME", "SYSTEMROOT", "TEMP", "TMP"] {
+        if let Some(v) = std::env::var_os(k) {
+            cmd.env(k, v);
+        }
+    }
+    #[cfg(windows)]
+    cmd.creation_flags(0x08000000);
+    let mut child = cmd
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .kill_on_drop(true)
+        .spawn()
+        .map_err(|_| "Podman command unavailable")?;
+    let mut stdout = child.stdout.take().unwrap().take(limit + 1);
+    let mut stderr = child.stderr.take().unwrap().take(limit + 1);
+    let mut out = vec![];
+    let mut err = vec![];
+    let output = tokio::time::timeout(Duration::from_secs(seconds), async {
+        let (a, b) = tokio::join!(stdout.read_to_end(&mut out), stderr.read_to_end(&mut err));
+        a.map_err(|_| "stdout unavailable")?;
+        b.map_err(|_| "stderr unavailable")?;
+        if out.len() as u64 > limit || err.len() as u64 > limit {
+            return Err("output limit exceeded");
+        }
+        let status = child
+            .wait()
+            .await
+            .map_err(|_| "Podman status unavailable")?;
+        Ok(status.code().unwrap_or(-1))
+    })
+    .await
+    .map_err(|_| "Podman deadline exceeded")?
+    .map_err(String::from)?;
+    // stderr is not returned to the cockpit; it can contain local deployment details.
+    Ok((output, out))
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/src/preview/queue.rs b/arkhe/source/orchestration/arkhe-runtime/src/preview/queue.rs
new file mode 100644
index 00000000..3fb734c7
--- /dev/null
+++ b/arkhe/source/orchestration/arkhe-runtime/src/preview/queue.rs
@@ -0,0 +1,42 @@
+use super::AdmittedPreview;
+use arkhe_core::{canonical::encode_value, CanonicalEncode, Digest32};
+use sqlx::{Postgres, Transaction};
+
+pub(super) async fn enqueue(
+    tx: &mut Transaction<'_, Postgres>,
+    preview: &AdmittedPreview,
+) -> Result<Digest32, String> {
+    let request = &preview.request;
+    let intent = &request.intent;
+    let value = serde_json::to_value(request).map_err(|e| e.to_string())?;
+    let bundle_digest = Digest32::blake3(b"AKG:PREVIEW:ADMISSION:v1\0", &encode_value(&value));
+    let context: String = sqlx::query_scalar("SELECT arkhe_assert_tenant()")
+        .fetch_one(&mut **tx)
+        .await
+        .map_err(|e| e.to_string())?;
+    if context != request.spec.tenant {
+        return Err("preview transaction tenant mismatch".into());
+    }
+    let fresh: bool = sqlx::query_scalar("SELECT $1::bigint > extract(epoch FROM clock_timestamp()) AND $2::bigint <= extract(epoch FROM clock_timestamp())")
+        .bind(request.review.expires_at).bind(preview.admitted_at)
+        .fetch_one(&mut **tx).await.map_err(|e| e.to_string())?;
+    if !fresh {
+        return Err("preview admission expired or clock mismatch".into());
+    }
+    // A conflict never overwrites the signed bundle for a logical operation.
+    sqlx::query("INSERT INTO preview_admissions(tenant_id,requested_by,operation_id,bundle_digest,authorization_ref,expires_at,intent_cbor,worker_cbor,bundle) VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9) ON CONFLICT DO NOTHING")
+        .bind(&request.spec.tenant).bind(&intent.requested_by).bind(intent.operation_id().0.to_vec())
+        .bind(bundle_digest.0.to_vec()).bind(preview.authorization_ref.0.to_vec()).bind(request.review.expires_at)
+        .bind(intent.canonical_bytes()).bind(request.worker.canonical_bytes()).bind(&value)
+        .execute(&mut **tx).await.map_err(|e| e.to_string())?;
+    let stored: Vec<u8> = sqlx::query_scalar("SELECT bundle_digest FROM preview_admissions WHERE tenant_id=$1 AND requested_by=$2 AND operation_id=$3")
+        .bind(&request.spec.tenant).bind(&intent.requested_by).bind(intent.operation_id().0.to_vec())
+        .fetch_one(&mut **tx).await.map_err(|e| e.to_string())?;
+    if stored != bundle_digest.0 {
+        return Err("preview operation already binds another signed bundle".into());
+    }
+    sqlx::query("INSERT INTO preview_jobs(tenant_id,requested_by,operation_id,bundle_digest) VALUES($1,$2,$3,$4) ON CONFLICT DO NOTHING")
+        .bind(&request.spec.tenant).bind(&intent.requested_by).bind(intent.operation_id().0.to_vec())
+        .bind(bundle_digest.0.to_vec()).execute(&mut **tx).await.map_err(|e| e.to_string())?;
+    Ok(bundle_digest)
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/tests/cognition_conformance.rs b/arkhe/source/orchestration/arkhe-runtime/tests/cognition_conformance.rs
new file mode 100644
index 00000000..12ac2d8d
--- /dev/null
+++ b/arkhe/source/orchestration/arkhe-runtime/tests/cognition_conformance.rs
@@ -0,0 +1,96 @@
+use arkhe_core::{
+    work::{WorkIntent, WorkIntentType},
+    CanonicalEncode, Digest32,
+};
+use arkhe_governance::{PolicyBinding, PolicyResolver, PolicyVerdict};
+use arkhe_kernel::{AuthorizationDecision, ContainmentGate};
+fn intent() -> WorkIntent {
+    WorkIntent {
+        requested_by: "test".into(),
+        intent_type: WorkIntentType::Publish,
+        target: Digest32::ZERO,
+        parameters_digest: Digest32::ZERO,
+        context: vec![],
+        context_refs: vec![],
+        request_identity: arkhe_core::work::RequestIdentity(Digest32::ZERO),
+        claimed_created_at: 0,
+    }
+}
+struct Resolver(PolicyVerdict);
+impl PolicyResolver for Resolver {
+    fn resolve(&self, _: &WorkIntent, _: &PolicyBinding) -> PolicyVerdict {
+        self.0.clone()
+    }
+}
+#[test]
+fn real_modules_and_containment_rejections() {
+    let intent = intent();
+    let policy = PolicyBinding {
+        policy_id: "test".into(),
+        version: 1,
+        policy_digest: Digest32::ZERO,
+    };
+    let (obs, perception) = arkhe_perception::observe(b"observation", Some(intent.digest()));
+    let (response, rag) = arkhe_rag::build_response(
+        b"query",
+        b"answer",
+        vec![arkhe_rag::Citation {
+            source_ref: perception.digest(),
+            chunk_digest: obs.representation_digest,
+        }],
+    );
+    let (_, meta) =
+        arkhe_metacognition::assess(rag.input_digest, response.answer_digest, vec![rag.digest()]);
+    let (forecast, world) = arkhe_world_model::simulate(b"scenario");
+    let learning = arkhe_learning::propose(arkhe_learning::Proposal {
+        baseline_ref: world.digest(),
+        candidate_ref: forecast.forecast_digest,
+        evaluation_ref: meta.digest(),
+        rollback_ref: perception.digest(),
+    });
+    let (_, agent) = arkhe_agent::plan(
+        &intent,
+        vec![arkhe_agent::PlanStep {
+            step_id: "1".into(),
+            action: "publish".into(),
+            protected: true,
+        }],
+    );
+    assert_eq!(agent.input_digest, intent.digest());
+    assert_eq!(meta.output_digest, rag.output_digest);
+    assert_eq!(rag.evidence_refs, vec![perception.digest()]);
+    assert_eq!(
+        learning.evidence_refs,
+        vec![meta.digest(), perception.digest()]
+    );
+    for record in [perception, rag, meta, world, learning, agent] {
+        assert_eq!(record.digest(), record.object_digest());
+        assert_ne!(record.digest(), Digest32::ZERO);
+        let allow = ContainmentGate::new(Resolver(PolicyVerdict::Allow));
+        assert!(matches!(
+            allow.authorize(&intent, None, &policy),
+            AuthorizationDecision::Reject { .. }
+        ));
+        assert!(matches!(
+            allow.authorize(&intent, Some(&record), &policy),
+            AuthorizationDecision::Reject { reason }
+                if reason == "integration requires admitted evidence lookup"
+        ));
+        for verdict in [
+            PolicyVerdict::Deny("denied".into()),
+            PolicyVerdict::Inconclusive("unknown".into()),
+        ] {
+            let gate = ContainmentGate::new(Resolver(verdict));
+            assert!(matches!(
+                gate.authorize(&intent, Some(&record), &policy),
+                AuthorizationDecision::Reject { .. }
+            ));
+        }
+        let mut stopped = ContainmentGate::new(Resolver(PolicyVerdict::Allow));
+        stopped.set_emergency_stop(true);
+        assert!(matches!(
+            stopped.authorize(&intent, Some(&record), &policy),
+            AuthorizationDecision::Reject { .. }
+        ));
+    }
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/tests/http_versioning.rs b/arkhe/source/orchestration/arkhe-runtime/tests/http_versioning.rs
new file mode 100644
index 00000000..1d8d4fab
--- /dev/null
+++ b/arkhe/source/orchestration/arkhe-runtime/tests/http_versioning.rs
@@ -0,0 +1,78 @@
+//! HTTP route contract with test handlers; no assertion about PostgreSQL uptime.
+use arkhe_runtime::http_routes::versioned_routes;
+use axum::{
+    body::{to_bytes, Body},
+    http::{HeaderMap, Request, StatusCode},
+    routing::{get, post},
+};
+use tower::ServiceExt;
+
+async fn guarded(headers: HeaderMap) -> Result<&'static str, StatusCode> {
+    if headers.get("authorization").and_then(|v| v.to_str().ok()) != Some("Bearer synthetic-token")
+    {
+        return Err(StatusCode::UNAUTHORIZED);
+    }
+    Ok("same handler")
+}
+
+#[tokio::test]
+async fn v1_and_legacy_routes_share_method_and_authentication_contract() {
+    let app = versioned_routes(
+        get(guarded),
+        post(guarded),
+        get(guarded),
+        get(guarded),
+        get(guarded),
+    );
+    for (method, path) in [
+        ("GET", "/health"),
+        ("GET", "/v1/health"),
+        ("POST", "/work"),
+        ("POST", "/v1/work"),
+        ("GET", "/evidence/hash"),
+        ("GET", "/v1/evidence/hash"),
+        ("GET", "/objects/WorkIntent/hash"),
+        ("GET", "/v1/objects/WorkIntent/hash"),
+        ("GET", "/v1/retention"),
+    ] {
+        let denied = app
+            .clone()
+            .oneshot(
+                Request::builder()
+                    .method(method)
+                    .uri(path)
+                    .body(Body::empty())
+                    .unwrap(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(denied.status(), StatusCode::UNAUTHORIZED, "{path}");
+        let accepted = app
+            .clone()
+            .oneshot(
+                Request::builder()
+                    .method(method)
+                    .uri(path)
+                    .header("authorization", "Bearer synthetic-token")
+                    .body(Body::empty())
+                    .unwrap(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(accepted.status(), StatusCode::OK, "{path}");
+        assert_eq!(
+            to_bytes(accepted.into_body(), 1024).await.unwrap(),
+            "same handler"
+        );
+    }
+    let missing = app
+        .oneshot(
+            Request::builder()
+                .uri("/v2/health")
+                .body(Body::empty())
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(missing.status(), StatusCode::NOT_FOUND);
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/tests/portable_wer.rs b/arkhe/source/orchestration/arkhe-runtime/tests/portable_wer.rs
