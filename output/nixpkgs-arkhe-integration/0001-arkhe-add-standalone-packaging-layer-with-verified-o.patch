+//! Production host factory for migrated legacy dispatch. Registry/policy inputs
+//! must come from operator configuration, never the HTTP/model request.
+use arkhe_governance::{authenticated::AuthenticatedResolver, PolicyResolver};
+use arkhe_kernel::{
+    broker::{CapabilityBroker, CapabilityExecutor},
+    broker_sqlite::SqliteDispatchJournal,
+    ContainmentGate,
+};
+use arkhe_verify_core::policy::Context;
+pub fn open<R: PolicyResolver, X: CapabilityExecutor>(
+    resolver: R,
+    context: Context,
+    path: &std::path::Path,
+    executor: X,
+) -> Result<CapabilityBroker<AuthenticatedResolver<R>, SqliteDispatchJournal, X>, String> {
+    let journal = SqliteDispatchJournal::open(path)?;
+    Ok(CapabilityBroker::new(
+        ContainmentGate::new(AuthenticatedResolver::new(resolver, context)),
+        journal,
+        executor,
+    ))
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/src/bin/arkhe-preview-worker.rs b/arkhe/source/orchestration/arkhe-runtime/src/bin/arkhe-preview-worker.rs
new file mode 100644
index 00000000..fad20fa4
--- /dev/null
+++ b/arkhe/source/orchestration/arkhe-runtime/src/bin/arkhe-preview-worker.rs
@@ -0,0 +1,166 @@
+use arkhe_runtime::preview::{
+    admit_preview,
+    dispatch::{Completion, PreviewQueue},
+    executor::{self, read_json, ExecutorConfig},
+};
+use arkhe_wormgraph::postgres::PgWormGraph;
+use clap::Parser;
+use std::{
+    path::PathBuf,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    },
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+#[derive(Parser)]
+#[command(about = "Process at most one signed preview using a qualified Podman executor")]
+struct Args {
+    #[arg(long)]
+    executor: PathBuf,
+}
+fn now() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|v| v.as_secs() as i64)
+        .unwrap_or(-1)
+}
+#[tokio::main]
+async fn main() {
+    if let Err(e) = run().await {
+        eprintln!("preview worker: {e}");
+        std::process::exit(1)
+    }
+}
+async fn run() -> Result<(), String> {
+    let args = Args::parse();
+    let config: ExecutorConfig = read_json(&args.executor)?;
+    let trust: arkhe_runtime::preview::PreviewTrust = read_json(&config.trust_file)?;
+    let url = std::env::var("ARKHE_PREVIEW_DATABASE_URL")
+        .map_err(|_| "ARKHE_PREVIEW_DATABASE_URL required")?;
+    let queue = Arc::new(PreviewQueue::connect(&url, &trust.tenant).await?);
+    let Some(lease) = queue.claim_for(&trust.requested_by, 30).await? else {
+        println!("{{\"state\":\"IDLE\"}}");
+        return Ok(());
+    };
+    let lease = Arc::new(lease);
+    let cancel = Arc::new(AtomicBool::new(false));
+    let done = Arc::new(AtomicBool::new(false));
+    let task = {
+        let queue = queue.clone();
+        let lease = lease.clone();
+        let cancel = cancel.clone();
+        let done = done.clone();
+        let config = config.clone();
+        tokio::spawn(async move {
+            while !done.load(Ordering::SeqCst) {
+                tokio::time::sleep(Duration::from_secs(5)).await;
+                if done.load(Ordering::SeqCst) {
+                    break;
+                }
+                let active = read_json::<arkhe_runtime::preview::PreviewTrust>(&config.trust_file)
+                    .is_ok_and(|t| {
+                        !t.emergency_stop
+                            && t.digest() == lease.request.review.policy_digest
+                            && t.policy_digest == t.digest()
+                    });
+                let qualification = read_json::<executor::Qualification>(&config.qualification)
+                    .is_ok_and(|q| {
+                        q.verify(
+                            &lease.request.spec,
+                            &config.qualification_key,
+                            q.engine_identity,
+                            q.executor_digest,
+                            now(),
+                        )
+                        .is_ok()
+                    });
+                let authority = if let Some(policy) = &config.authority {
+                    arkhe_runtime::preview::authority::admit(
+                        policy,
+                        config.qualification_key,
+                        &lease.request.spec,
+                        now(),
+                    )
+                    .await
+                    .is_ok()
+                } else {
+                    false
+                };
+                if !active
+                    || !qualification
+                    || !authority
+                    || !queue.heartbeat(&lease, 30).await.unwrap_or(false)
+                {
+                    cancel.store(true, Ordering::SeqCst);
+                    break;
+                }
+            }
+        })
+    };
+    let result: Result<&str, String> = async {
+        let graph = PgWormGraph::connect(&url, &trust.tenant)
+            .await
+            .map_err(|_| "preview evidence unavailable")?;
+        if let Err(e) = admit_preview(lease.request.clone(), &trust, &graph, now()).await {
+            if !queue.finish(&lease, Completion::Failed(e)).await? {
+                return Err("lease lost while recording rejection".into());
+            }
+            return Ok("FAILED");
+        }
+        let prepared = match executor::prepare(config.clone(), &lease.request.spec, now()).await {
+            Ok(p) => p,
+            Err(e) => {
+                if !queue.finish(&lease, Completion::Retry(e)).await? {
+                    return Err("lease lost while recording preflight failure".into());
+                }
+                return Ok("RETRY_OR_DEAD");
+            }
+        };
+        // Reload current policy and signatures immediately before dispatch.
+        let active = read_json(&config.trust_file)?;
+        admit_preview(lease.request.clone(), &active, &graph, now()).await?;
+        executor::revalidate(&prepared, &active, now()).await?;
+        if cancel.load(Ordering::SeqCst) || !queue.start(&lease).await? {
+            return Err("lease lost before dispatch".into());
+        }
+        let outcome = executor::execute(&prepared, cancel.clone()).await;
+        let (state, result) = match outcome {
+            Ok(receipt) => {
+                let current: Result<(), String> = async {
+                    if cancel.load(Ordering::SeqCst) {
+                        return Err("lease cancelled".into());
+                    }
+                    let active = read_json(&config.trust_file)?;
+                    admit_preview(lease.request.clone(), &active, &graph, now()).await?;
+                    executor::revalidate(&prepared, &active, now()).await
+                }
+                .await;
+                if current.is_ok() {
+                    ("SUCCEEDED", Completion::Succeeded(receipt))
+                } else {
+                    (
+                        "UNKNOWN",
+                        Completion::Unknown(
+                            "active admission or qualification lost before completion".into(),
+                        ),
+                    )
+                }
+            }
+            Err(e) => ("UNKNOWN", Completion::Unknown(e)),
+        };
+        if !queue.finish(&lease, result).await? {
+            return Err("fenced completion rejected; reconcile UNKNOWN state".into());
+        }
+        Ok(state)
+    }
+    .await;
+    done.store(true, Ordering::SeqCst);
+    task.abort();
+    let _ = task.await;
+    println!(
+        "{}",
+        serde_json::json!({"operation_id":lease.request.intent.operation_id().to_hex(),"fence":lease.fence,"attempts":lease.attempts,"state":result?,"production_release":false})
+    );
+    Ok(())
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/src/bin/arkhe-preview.rs b/arkhe/source/orchestration/arkhe-runtime/src/bin/arkhe-preview.rs
new file mode 100644
index 00000000..04594868
--- /dev/null
+++ b/arkhe/source/orchestration/arkhe-runtime/src/bin/arkhe-preview.rs
@@ -0,0 +1,120 @@
+//! Explicit local admission CLI. Never invokes an executor or accepts private keys.
+use arkhe_runtime::preview::{
+    admit_preview, dispatch::PreviewQueue, enqueue_preview, executor::read_json, review_preview,
+    PreviewRequest, PreviewTrust,
+};
+use arkhe_wormgraph::postgres::PgWormGraph;
+use clap::Parser;
+use std::{
+    path::PathBuf,
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+#[derive(Parser)]
+#[command(about = "Verify signed preview evidence and optionally enqueue it; no execution")]
+struct Args {
+    /// Trusted operator-owned configuration; never model-generated.
+    #[arg(long)]
+    trust: PathBuf,
+    #[arg(long)]
+    request: Option<PathBuf>,
+    /// Commit admission and pending outbox entry atomically. Default is verification only.
+    #[arg(long)]
+    enqueue: bool,
+    #[arg(long, conflicts_with_all=["enqueue","status"])]
+    review_payload: bool,
+    #[arg(long, conflicts_with_all=["enqueue","review_payload"])]
+    status: bool,
+    #[arg(long, requires = "status")]
+    operation: Option<String>,
+}
+#[tokio::main]
+async fn main() {
+    if let Err(error) = run().await {
+        eprintln!("preview rejected: {error}");
+        std::process::exit(1);
+    }
+}
+async fn run() -> Result<(), String> {
+    let args = Args::parse();
+    let trust: PreviewTrust = read_json(&args.trust)?;
+    let url = std::env::var("ARKHE_PREVIEW_DATABASE_URL")
+        .map_err(|_| "ARKHE_PREVIEW_DATABASE_URL required")?;
+    if args.status {
+        let raw = hex::decode(args.operation.ok_or("--operation required with --status")?)
+            .map_err(|_| "invalid operation")?;
+        let op = arkhe_core::Digest32(raw.try_into().map_err(|_| "invalid operation length")?);
+        let queue = PreviewQueue::connect(&url, &trust.tenant).await?;
+        println!(
+            "{}",
+            serde_json::json!({"dispatch":queue.status(&trust.requested_by,op).await?})
+        );
+        return Ok(());
+    }
+    let request: PreviewRequest = read_json(&args.request.ok_or("--request required")?)?;
+    // Refuses administrative/RLS-bypass credentials. Database errors are deliberately
+    // not printed: a driver error can contain deployment/connection details.
+    let graph = PgWormGraph::connect(&url, &trust.tenant)
+        .await
+        .map_err(|_| "preview evidence database unavailable or role rejected")?;
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| "invalid clock")?
+        .as_secs();
+    if args.review_payload {
+        let challenge = review_preview(
+            request,
+            &trust,
+            &graph,
+            i64::try_from(now).map_err(|_| "clock overflow")?,
+        )
+        .await?;
+        println!(
+            "{}",
+            serde_json::to_string(&challenge).map_err(|_| "challenge encoding failed")?
+        );
+        return Ok(());
+    }
+    let admitted = admit_preview(
+        request,
+        &trust,
+        &graph,
+        i64::try_from(now).map_err(|_| "clock overflow")?,
+    )
+    .await?;
+    let bundle = if args.enqueue {
+        let pool = sqlx::postgres::PgPoolOptions::new()
+            .max_connections(1)
+            .connect(&url)
+            .await
+            .map_err(|_| "preview queue database unavailable")?;
+        let mut tx = pool
+            .begin()
+            .await
+            .map_err(|_| "preview transaction unavailable")?;
+        sqlx::query("SET LOCAL ROLE arkhe_preview_enqueue")
+            .execute(&mut *tx)
+            .await
+            .map_err(|_| "preview enqueue role unavailable")?;
+        arkhe_sql::tenant::set_tenant(&mut tx, &trust.tenant)
+            .await
+            .map_err(|_| "preview tenant unavailable")?;
+        let bundle = enqueue_preview(&mut tx, &admitted)
+            .await
+            .map_err(|_| "preview enqueue rejected; transaction rolled back")?;
+        tx.commit()
+            .await
+            .map_err(|_| "preview commit failed; reconcile before retry")?;
+        Some(bundle.to_hex())
+    } else {
+        None
+    };
+    println!(
+        "{}",
+        serde_json::json!({"status": if args.enqueue {"ADMITTED_PENDING"} else {"VERIFIED_ONLY"},
+        "operation_id": admitted.operation_id().to_hex(), "authorization_ref": admitted.authorization_ref().to_hex(),
+        "bundle_digest": bundle, "execution_authority": false, "executed": false,
+        "scope": "preview admission v1; not a WormGraph inclusion receipt or production release"})
+    );
+    Ok(())
+}
diff --git a/arkhe/source/orchestration/arkhe-runtime/src/http_routes.rs b/arkhe/source/orchestration/arkhe-runtime/src/http_routes.rs
