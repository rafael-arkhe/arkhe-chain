+            .execute_triage(&report.report_id, params(), request)
+            .await,
+        Err(Error::Uncertain)
+    ));
+    assert_eq!(failed.client.calls.load(Ordering::SeqCst), 1);
+    println!(
+        "PASS INV-WER-07: failure logged; no successful execution WER; uncertain retry blocked"
+    );
+}
