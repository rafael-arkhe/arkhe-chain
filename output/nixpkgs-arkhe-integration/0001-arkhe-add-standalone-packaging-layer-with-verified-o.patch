+++ b/arkhe/source/verification/crates/arkhe-verify-core/src/policy.rs
@@ -0,0 +1,268 @@
+//! Authenticated policy profile, shared by native tests and the production WASM.
+//! Host-owned trust/context is mandatory. Pure admission does not consume a nonce;
+//! replay/dispatch atomicity remains the responsibility of the operation journal.
+use ed25519_dalek::{Signature, VerifyingKey};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::collections::{BTreeMap, BTreeSet};
+
+pub type Hash = [u8; 32];
+
+/// Migrated executors receive this exact typed action, not independent parameters.
+pub fn legacy_parameters_digest(action: &Action) -> arkhe_core::Digest32 {
+    arkhe_core::Digest32::blake3(
+        b"AKG:LEGACY:POLICY:PARAMETERS:v1\0",
+        &action.canonical_bytes(),
+    )
+}
+pub fn verify_legacy(
+    request: &Request,
+    ctx: &Context,
+    intent: &arkhe_core::work::WorkIntent,
+    worker: &arkhe_core::worker::WorkerExecutionRecord,
+    binding: arkhe_core::Digest32,
+) -> Result<(), String> {
+    evaluate(request, ctx).map_err(|e| e.to_string())?;
+    if request.signed_intent.intent.principal_id != intent.requested_by
+        || request.action.operation_id != intent.operation_id().to_hex()
+        || request.action.module_id != worker.module_id
+        || request.action.module_version != worker.module_version
+        || legacy_parameters_digest(&request.action) != intent.parameters_digest
+        || binding.0 != ctx.policy.digest()
+    {
+        return Err("authenticated action does not bind legacy intent/worker/policy".into());
+    }
+    Ok(())
+}
+fn hash(bytes: &[u8]) -> Hash {
+    Sha256::digest(bytes).into()
+}
+fn field(out: &mut Vec<u8>, bytes: &[u8]) {
+    out.extend_from_slice(&(bytes.len() as u64).to_be_bytes());
+    out.extend_from_slice(bytes);
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Action {
+    pub operation_id: String,
+    pub amount_cents: u64,
+    pub module_id: String,
+    pub module_version: String,
+    pub payload: Vec<u8>,
+}
+impl Action {
+    pub fn canonical_bytes(&self) -> Vec<u8> {
+        let mut out = b"AKG:POLICY:ACTION:v1\0".to_vec();
+        field(&mut out, self.operation_id.as_bytes());
+        out.extend_from_slice(&self.amount_cents.to_be_bytes());
+        field(&mut out, self.module_id.as_bytes());
+        field(&mut out, self.module_version.as_bytes());
+        field(&mut out, &self.payload);
+        out
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Policy {
+    pub policy_id: String,
+    pub max_amount_cents: u64,
+    /// Module/version pairs, not independent lists allowing a cross product.
+    pub allowed: BTreeSet<(String, String)>,
+}
+impl Policy {
+    pub fn digest(&self) -> Hash {
+        let mut out = b"AKG:POLICY:RULES:v1\0".to_vec();
+        field(&mut out, self.policy_id.as_bytes());
+        out.extend_from_slice(&self.max_amount_cents.to_be_bytes());
+        out.extend_from_slice(&(self.allowed.len() as u64).to_be_bytes());
+        for (module, version) in &self.allowed {
+            field(&mut out, module.as_bytes());
+            field(&mut out, version.as_bytes());
+        }
+        hash(&out)
+    }
+    pub fn permits_action(&self, action: &Action) -> bool {
+        action.amount_cents <= self.max_amount_cents
+            && self
+                .allowed
+                .contains(&(action.module_id.clone(), action.module_version.clone()))
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Intent {
+    pub principal_id: String,
+    pub audience: String,
+    pub policy_digest: Hash,
+    pub not_before: i64,
+    pub expires_at: i64,
+    pub action: Action,
+}
+impl Intent {
+    pub fn signed_message(&self) -> Vec<u8> {
+        let mut out = b"AKG:POLICY:INTENT:v1\0".to_vec();
+        field(&mut out, self.principal_id.as_bytes());
+        field(&mut out, self.audience.as_bytes());
+        out.extend_from_slice(&self.policy_digest);
+        out.extend_from_slice(&self.not_before.to_be_bytes());
+        out.extend_from_slice(&self.expires_at.to_be_bytes());
+        field(&mut out, &self.action.canonical_bytes());
+        out
+    }
+    pub fn digest(&self) -> Hash {
+        hash(&self.signed_message())
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SignedIntent {
+    pub intent: Intent,
+    pub signature: Vec<u8>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct WorkerRecord {
+    pub worker_id: String,
+    pub action: Action,
+    pub intent_digest: Hash,
+    pub signature: Vec<u8>,
+}
+impl WorkerRecord {
+    pub fn signed_message(&self) -> Vec<u8> {
+        let mut out = b"AKG:POLICY:WORKER:v1\0".to_vec();
+        field(&mut out, self.worker_id.as_bytes());
+        field(&mut out, &self.action.canonical_bytes());
+        out.extend_from_slice(&self.intent_digest);
+        out
+    }
+    pub fn digest(&self) -> Hash {
+        hash(&self.signed_message())
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    pub action: Action,
+    pub parameters_digest: Hash,
+    pub record_hash: Hash,
+    pub worker_record: WorkerRecord,
+    pub signed_intent: SignedIntent,
+}
+
+/// Trusted input from the host, never accepted as authority from an agent.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Context {
+    pub policy: Policy,
+    pub principal_keys: BTreeMap<String, Hash>,
+    pub worker_keys: BTreeMap<String, Hash>,
+    pub audience: String,
+    pub now: i64,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, thiserror::Error)]
+pub enum Rejection {
+    #[error("principal not authorized")]
+    Principal,
+    #[error("invalid principal signature")]
+    IntentSignature,
+    #[error("wrong audience or policy")]
+    Context,
+    #[error("intent not currently valid")]
+    Time,
+    #[error("request differs from authenticated intent")]
+    IntentBinding,
+    #[error("worker not authorized")]
+    Worker,
+    #[error("invalid worker signature")]
+    WorkerSignature,
+    #[error("worker record differs from request or intent")]
+    RecordBinding,
+    #[error("record hash mismatch")]
+    RecordHash,
+    #[error("action outside policy")]
+    Policy,
+}
+
+fn signature_ok(key: &Hash, message: &[u8], signature: &[u8]) -> bool {
+    let Ok(key) = VerifyingKey::from_bytes(key) else {
+        return false;
+    };
+    let Ok(sig) = Signature::from_slice(signature) else {
+        return false;
+    };
+    key.verify_strict(message, &sig).is_ok()
+}
+
+pub fn evaluate(request: &Request, ctx: &Context) -> Result<(), Rejection> {
+    let signed = &request.signed_intent;
+    let intent = &signed.intent;
+    let key = ctx
+        .principal_keys
+        .get(&intent.principal_id)
+        .ok_or(Rejection::Principal)?;
+    if !signature_ok(key, &intent.signed_message(), &signed.signature) {
+        return Err(Rejection::IntentSignature);
+    }
+    if intent.audience != ctx.audience || intent.policy_digest != ctx.policy.digest() {
+        return Err(Rejection::Context);
+    }
+    if intent.not_before > ctx.now
+        || intent.expires_at <= ctx.now
+        || intent.expires_at <= intent.not_before
+    {
+        return Err(Rejection::Time);
+    }
+    if request.action != intent.action || request.parameters_digest != intent.digest() {
+        return Err(Rejection::IntentBinding);
+    }
+    let record = &request.worker_record;
+    let worker_key = ctx
+        .worker_keys
+        .get(&record.worker_id)
+        .ok_or(Rejection::Worker)?;
+    if !signature_ok(worker_key, &record.signed_message(), &record.signature) {
+        return Err(Rejection::WorkerSignature);
+    }
+    if record.action != request.action || record.intent_digest != intent.digest() {
+        return Err(Rejection::RecordBinding);
+    }
+    if request.record_hash != record.digest() {
+        return Err(Rejection::RecordHash);
+    }
+    if !ctx.policy.permits_action(&request.action) {
+        return Err(Rejection::Policy);
+    }
+    Ok(())
+}
+
+/// Migration evidence is separate from runtime permissions. Reasons grant no access.
+#[derive(Debug, Clone)]
+pub struct VersionRestriction {
+    pub old_policy: Hash,
+    pub new_policy: Hash,
+    pub module_id: String,
+    pub removed_version: String,
+    pub reason: String,
+}
+pub fn compatible_for(
+    old: &Policy,
+    new: &Policy,
+    action: &Action,
+    reasons: &[VersionRestriction],
+) -> bool {
+    !old.permits_action(action) || new.permits_action(action) || reasons.iter().any(|r| {
+        !r.reason.trim().is_empty() && r.old_policy == old.digest() && r.new_policy == new.digest()
+            && r.module_id == action.module_id && r.removed_version == action.module_version
+            // Only a version removal is explained; lowered spending limits are not.
+            && new.max_amount_cents >= action.amount_cents
+            && old.allowed.contains(&(r.module_id.clone(), r.removed_version.clone()))
+            && !new.allowed.contains(&(r.module_id.clone(), r.removed_version.clone()))
+    })
+}
diff --git a/arkhe/source/verification/crates/arkhe-verify-core/src/rbb/header.rs b/arkhe/source/verification/crates/arkhe-verify-core/src/rbb/header.rs
new file mode 100644
index 00000000..2aa7d1bd
--- /dev/null
+++ b/arkhe/source/verification/crates/arkhe-verify-core/src/rbb/header.rs
@@ -0,0 +1,249 @@
+use super::{keccak, Error};
+use serde::{Deserialize, Serialize};
+
+pub const HEADER_LEN: usize = 27 * 32;
+pub const ENVELOPE_LEN: usize = 3488;
+pub const DOMAIN: &[u8] = b"AKG:CHECKPOINT:HEADER:v3\0";
+pub const MLDSA_CONTEXT: &[u8] = b"ARKHE_RBB_EVIDENCE_V3";
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Header {
+    pub protocol_version: u8,
+    pub profile_id: u16,
+    pub anchor_chain_id: [u8; 32],
+    pub anchor_genesis_hash: [u8; 32],
+    pub registry_address: [u8; 20],
+    pub anchor_address: [u8; 20],
+    pub org_id: [u8; 32],
+    pub power: u8,
+    pub stream_id: [u8; 32],
+    pub sequence: u64,
+    pub prev_checkpoint_id: [u8; 32],
+    pub first_leaf_index: u64,
+    pub batch_leaf_count: u64,
+    pub total_leaf_count: u64,
+    pub mmr_root: [u8; 32],
+    pub batch_manifest_digest: [u8; 32],
+    pub policy_digest: [u8; 32],
+    pub declared_signed_at: u64,
+    pub source_kind: u8,
+    pub source_network_id: [u8; 32],
+    pub source_manifest_digest: [u8; 32],
+    pub ed25519_key_id: [u8; 32],
+    pub mldsa_key_id: [u8; 32],
+    pub keyset_version: u64,
+    pub prev_present: bool,
+    pub source_manifest_present: bool,
+    pub mmr_profile_digest: [u8; 32],
+}
+
+impl Header {
+    pub fn validate(&self) -> Result<(), Error> {
+        if self.protocol_version != 3 {
+            return Err(Error::Header("version"));
+        }
+        if self.profile_id != 1 {
+            return Err(Error::Profile);
+        }
+        if !(1..=3).contains(&self.power) || !(1..=4).contains(&self.source_kind) {
+            return Err(Error::Header("enum"));
+        }
+        if self.sequence == 0 || self.keyset_version == 0 || self.declared_signed_at == 0 {
+            return Err(Error::Header("zero counter or timestamp"));
+        }
+        if self.batch_leaf_count == 0
+            || self.first_leaf_index.checked_add(self.batch_leaf_count)
+                != Some(self.total_leaf_count)
+        {
+            return Err(Error::Header("leaf interval"));
+        }
+        if self.prev_present != (self.sequence > 1)
+            || self.prev_present != (self.prev_checkpoint_id != [0; 32])
+            || (self.sequence == 1 && self.first_leaf_index != 0)
+        {
+            return Err(Error::Header("predecessor"));
+        }
+        if self.source_manifest_present != (self.source_manifest_digest != [0; 32])
+            || (self.source_kind == 2 && !self.source_manifest_present)
+        {
+            return Err(Error::Header("source manifest"));
+        }
+        for id in [
+            &self.anchor_chain_id,
+            &self.anchor_genesis_hash,
+            &self.org_id,
+            &self.stream_id,
+            &self.mmr_root,
+            &self.batch_manifest_digest,
+            &self.policy_digest,
+            &self.source_network_id,
+            &self.ed25519_key_id,
+            &self.mldsa_key_id,
+            &self.mmr_profile_digest,
+        ] {
+            if *id == [0; 32] {
+                return Err(Error::Header("zero identifier"));
+            }
+        }
+        if self.registry_address == [0; 20] || self.anchor_address == [0; 20] {
+            return Err(Error::Header("zero address"));
+        }
+        Ok(())
+    }
+
+    pub fn encode(&self) -> Result<Vec<u8>, Error> {
+        self.validate()?;
+        let mut out = Vec::with_capacity(HEADER_LEN);
+        out.extend(word(self.protocol_version as u64));
+        out.extend(word(self.profile_id as u64));
+        out.extend(self.anchor_chain_id);
+        out.extend(self.anchor_genesis_hash);
+        for address in [&self.registry_address, &self.anchor_address] {
+            out.extend([0; 12]);
+            out.extend(address);
+        }
+        out.extend(self.org_id);
+        out.extend(word(self.power as u64));
+        out.extend(self.stream_id);
+        out.extend(word(self.sequence));
+        out.extend(self.prev_checkpoint_id);
+        out.extend(word(self.first_leaf_index));
+        out.extend(word(self.batch_leaf_count));
+        out.extend(word(self.total_leaf_count));
+        out.extend(self.mmr_root);
+        out.extend(self.batch_manifest_digest);
+        out.extend(self.policy_digest);
+        out.extend(word(self.declared_signed_at));
+        out.extend(word(self.source_kind as u64));
+        out.extend(self.source_network_id);
+        out.extend(self.source_manifest_digest);
+        out.extend(self.ed25519_key_id);
+        out.extend(self.mldsa_key_id);
+        out.extend(word(self.keyset_version));
+        out.extend(word(self.prev_present as u64));
+        out.extend(word(self.source_manifest_present as u64));
+        out.extend(self.mmr_profile_digest);
+        Ok(out)
+    }
+
+    pub fn decode(bytes: &[u8]) -> Result<Self, Error> {
+        if bytes.len() != HEADER_LEN {
+            return Err(Error::NonCanonical);
+        }
+        let d = |i: usize| -> [u8; 32] {
+            bytes[i * 32..(i + 1) * 32]
+                .try_into()
+                .expect("fixed ABI word")
+        };
+        let n = |i| read_u64(&d(i));
+        let a = |i| -> Result<[u8; 20], Error> {
+            let w = d(i);
+            if w[..12] != [0; 12] {
+                return Err(Error::NonCanonical);
+            }
+            Ok(w[12..].try_into().expect("address length"))
+        };
+        let b = |i| match n(i)? {
+            0 => Ok(false),
+            1 => Ok(true),
+            _ => Err(Error::NonCanonical),
+        };
+        let header = Self {
+            protocol_version: n(0)?.try_into().map_err(|_| Error::NonCanonical)?,
+            profile_id: n(1)?.try_into().map_err(|_| Error::NonCanonical)?,
+            anchor_chain_id: d(2),
+            anchor_genesis_hash: d(3),
+            registry_address: a(4)?,
+            anchor_address: a(5)?,
+            org_id: d(6),
+            power: n(7)?.try_into().map_err(|_| Error::NonCanonical)?,
+            stream_id: d(8),
+            sequence: n(9)?,
+            prev_checkpoint_id: d(10),
+            first_leaf_index: n(11)?,
+            batch_leaf_count: n(12)?,
+            total_leaf_count: n(13)?,
+            mmr_root: d(14),
+            batch_manifest_digest: d(15),
+            policy_digest: d(16),
+            declared_signed_at: n(17)?,
+            source_kind: n(18)?.try_into().map_err(|_| Error::NonCanonical)?,
+            source_network_id: d(19),
+            source_manifest_digest: d(20),
+            ed25519_key_id: d(21),
+            mldsa_key_id: d(22),
+            keyset_version: n(23)?,
+            prev_present: b(24)?,
+            source_manifest_present: b(25)?,
+            mmr_profile_digest: d(26),
+        };
+        if header.encode()? != bytes {
+            return Err(Error::NonCanonical);
+        }
+        Ok(header)
+    }
+
+    pub fn checkpoint_id(&self) -> Result<[u8; 32], Error> {
+        let mut bytes = keccak(DOMAIN).to_vec();
+        bytes.extend(self.encode()?);
+        Ok(keccak(&bytes))
+    }
+}
+
+pub(crate) fn word(value: u64) -> [u8; 32] {
+    let mut w = [0; 32];
+    w[24..].copy_from_slice(&value.to_be_bytes());
+    w
+}
+
+fn read_u64(w: &[u8; 32]) -> Result<u64, Error> {
+    if w[..24] != [0; 24] {
+        return Err(Error::NonCanonical);
+    }
+    Ok(u64::from_be_bytes(w[24..].try_into().expect("u64 length")))
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Envelope {
+    pub header: Header,
+    pub ed25519_signature: Vec<u8>,
+    pub mldsa_signature: Vec<u8>,
+}
+
+impl Envelope {
+    pub fn encode(&self) -> Result<Vec<u8>, Error> {
+        if self.ed25519_signature.len() != 64 || self.mldsa_signature.len() != 2420 {
+            return Err(Error::SignatureLength);
+        }
+        let mut out = self.header.encode()?;
+        out.extend(word(928));
+        out.extend(word(1024));
+        out.extend(word(64));
+        out.extend(&self.ed25519_signature);
+        out.extend(word(2420));
+        out.extend(&self.mldsa_signature);
+        out.extend([0; 12]);
+        Ok(out)
+    }
+
+    pub fn decode(bytes: &[u8]) -> Result<Self, Error> {
+        if bytes.len() != ENVELOPE_LEN {
+            return Err(Error::NonCanonical);
+        }
+        let envelope = Self {
+            header: Header::decode(&bytes[..HEADER_LEN])?,
+            ed25519_signature: bytes[960..1024].to_vec(),
+            mldsa_signature: bytes[1056..3476].to_vec(),
+        };
+        if envelope.encode()? != bytes {
+            return Err(Error::NonCanonical);
+        }
+        Ok(envelope)
+    }
+
+    pub fn commitment(&self) -> Result<[u8; 32], Error> {
+        Ok(keccak(&self.encode()?))
+    }
+}
diff --git a/arkhe/source/verification/crates/arkhe-verify-core/src/rbb/mmr.rs b/arkhe/source/verification/crates/arkhe-verify-core/src/rbb/mmr.rs
new file mode 100644
index 00000000..509bfbc9
--- /dev/null
+++ b/arkhe/source/verification/crates/arkhe-verify-core/src/rbb/mmr.rs
@@ -0,0 +1,194 @@
+use super::Error;
+use serde::{Deserialize, Serialize};
+
+fn hash(domain: &[u8], parts: &[&[u8]]) -> [u8; 32] {
+    let mut h = blake3::Hasher::new();
+    h.update(domain);
+    for part in parts {
+        h.update(part);
+    }
+    *h.finalize().as_bytes()
+}
+fn leaf(index: u64, record: &[u8; 32]) -> [u8; 32] {
+    hash(b"AKG:MMR:LEAF:v3\0", &[&index.to_be_bytes(), record])
+}
+fn node(left: &[u8; 32], right: &[u8; 32]) -> [u8; 32] {
+    hash(b"AKG:MMR:NODE:v3\0", &[left, right])
+}
+
+pub fn profile_digest() -> [u8; 32] {
+    // This is a new profile. It never aliases arkhe-mmr v1.
+    *blake3::hash(b"arkhe-rbb-mmr-v3:blake3-256;leaf=index-u64be+record32;node=left+right;bag=right-fold;root=count-u64be+bag;domains=AKG:MMR:{LEAF,NODE,BAG,ROOT}:v3:NUL").as_bytes()
+}
+
+fn mountains(count: u64) -> Vec<(u64, u32)> {
+    let mut start = 0;
+    let mut result = Vec::new();
+    for height in (0..64).rev() {
+        if count & (1u64 << height) != 0 {
+            result.push((start, height));
+            start += 1u64 << height;
+        }
+    }
+    result
+}
+
+fn root_from_peaks(count: u64, peaks: &[[u8; 32]]) -> Result<[u8; 32], Error> {
+    if count == 0 || peaks.len() != count.count_ones() as usize {
+        return Err(Error::Mmr);
+    }
+    let mut bag = *peaks.last().ok_or(Error::Mmr)?;
+    for peak in peaks.iter().rev().skip(1) {
+        bag = hash(b"AKG:MMR:BAG:v3\0", &[peak, &bag]);
+    }
+    Ok(hash(b"AKG:MMR:ROOT:v3\0", &[&count.to_be_bytes(), &bag]))
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Frontier {
+    pub count: u64,
+    pub peaks: Vec<[u8; 32]>,
+}
+
+impl Frontier {
+    pub fn validate(&self) -> Result<(), Error> {
+        if self.peaks.len() != self.count.count_ones() as usize {
+            return Err(Error::Mmr);
+        }
+        Ok(())
+    }
+    pub fn append(&mut self, record: &[u8; 32]) -> Result<u64, Error> {
+        self.validate()?;
+        let next_count = self.count.checked_add(1).ok_or(Error::ResourceLimit)?;
+        let index = self.count;
+        let mut current = leaf(index, record);
+        for _ in 0..self.count.trailing_ones() {
+            current = node(&self.peaks.pop().ok_or(Error::Mmr)?, &current);
+        }
+        self.peaks.push(current);
+        self.count = next_count;
+        Ok(index)
+    }
+    pub fn root(&self) -> Result<[u8; 32], Error> {
+        root_from_peaks(self.count, &self.peaks)
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Proof {
+    pub leaf_index: u64,
+    pub leaf_count: u64,
+    pub siblings: Vec<[u8; 32]>,
+    pub other_peaks: Vec<[u8; 32]>,
+}
+
+pub fn verify(
+    record: &[u8; 32],
+    proof: &Proof,
+    signed_count: u64,
+    expected_root: &[u8; 32],
+) -> Result<(), Error> {
+    if proof.siblings.len() > 63 || proof.other_peaks.len() > 63 {
+        return Err(Error::ResourceLimit);
+    }
+    if signed_count == 0 || proof.leaf_count != signed_count || proof.leaf_index >= signed_count {
+        return Err(Error::Mmr);
+    }
+    let shape = mountains(signed_count);
+    let target = shape
+        .iter()
+        .position(|(start, height)| {
+            proof.leaf_index >= *start && proof.leaf_index - start < (1u64 << height)
+        })
+        .ok_or(Error::Mmr)?;
+    let (start, height) = shape[target];
+    if proof.siblings.len() != height as usize || proof.other_peaks.len() + 1 != shape.len() {
+        return Err(Error::Mmr);
+    }
+    let mut current = leaf(proof.leaf_index, record);
+    let mut local = proof.leaf_index - start;
+    for sibling in &proof.siblings {
+        current = if local & 1 == 0 {
+            node(&current, sibling)
+        } else {
+            node(sibling, &current)
+        };
+        local >>= 1;
+    }
+    let mut peaks = proof.other_peaks.clone();
+    peaks.insert(target, current);
+    if root_from_peaks(signed_count, &peaks)? != *expected_root {
+        return Err(Error::Mmr);
+    }
+    Ok(())
+}
+
+/// Proof construction is bounded to local batches; persistent services retain historical nodes.
+pub fn prove(records: &[[u8; 32]], index: usize) -> Result<Proof, Error> {
+    if records.len() > 4096 {
+        return Err(Error::ResourceLimit);
+    }
+    if index >= records.len() {
+        return Err(Error::Mmr);
+    }
+    let mut peaks = Vec::new();
+    let mut siblings = Vec::new();
+    for (start, height) in mountains(records.len() as u64) {
+        let end = start as usize + (1usize << height);
+        let target = (start as usize..end).contains(&index);
+        let mut level: Vec<_> = (start as usize..end)
+            .map(|i| leaf(i as u64, &records[i]))
+            .collect();
+        let mut local = index.saturating_sub(start as usize);
+        while level.len() > 1 {
+            if target {
+                siblings.push(level[local ^ 1]);
+                local /= 2;
+            }
+            level = level
+                .chunks_exact(2)
+                .map(|pair| node(&pair[0], &pair[1]))
+                .collect();
+        }
+        if !target {
+            peaks.push(level[0]);
+        }
+    }
+    Ok(Proof {
+        leaf_index: index as u64,
+        leaf_count: records.len() as u64,
+        siblings,
+        other_peaks: peaks,
+    })
+}
+
+/// Recompute the extension from an authenticated previous frontier and bounded new records.
+pub fn verify_extension(
+    previous: &Frontier,
+    previous_root: &[u8; 32],
+    records: &[[u8; 32]],
+    expected_count: u64,
+    expected_root: &[u8; 32],
+) -> Result<(), Error> {
+    if records.is_empty() || records.len() > 4096 {
+        return Err(Error::ResourceLimit);
+    }
+    previous.validate()?;
+    if previous.count == 0 {
+        if *previous_root != [0; 32] {
+            return Err(Error::Mmr);
+        }
+    } else if previous.root()? != *previous_root {
+        return Err(Error::Mmr);
+    }
+    let mut next = previous.clone();
+    for record in records {
+        next.append(record)?;
+    }
+    if next.count != expected_count || next.root()? != *expected_root {
+        return Err(Error::Mmr);
+    }
+    Ok(())
+}
diff --git a/arkhe/source/verification/crates/arkhe-verify-core/src/rbb/mod.rs b/arkhe/source/verification/crates/arkhe-verify-core/src/rbb/mod.rs
new file mode 100644
index 00000000..f5d3f95d
--- /dev/null
+++ b/arkhe/source/verification/crates/arkhe-verify-core/src/rbb/mod.rs
@@ -0,0 +1,36 @@
+//! Arkhe-RBB v3 candidate revision 2. Isolated from the existing frozen MMR profile.
+mod header;
+pub mod mmr;
+#[cfg(feature = "rbb-pqc")]
+pub mod trust;
+
+pub use header::*;
+
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+pub enum Error {
+    #[error("non-canonical ABI")]
+    NonCanonical,
+    #[error("invalid header: {0}")]
+    Header(&'static str),
+    #[error("unsupported cryptographic profile")]
+    Profile,
+    #[error("invalid signature length")]
+    SignatureLength,
+    #[error("invalid hybrid signature")]
+    Signature,
+    #[error("untrusted or mismatched institutional binding")]
+    Binding,
+    #[error("insufficient or conflicting witness votes")]
+    Quorum,
+    #[error("invalid temporal evidence")]
+    Time,
+    #[error("invalid MMR proof")]
+    Mmr,
+    #[error("resource limit exceeded")]
+    ResourceLimit,
+}
+
+pub fn keccak(data: &[u8]) -> [u8; 32] {
+    use sha3::{Digest, Keccak256};
+    Keccak256::digest(data).into()
+}
diff --git a/arkhe/source/verification/crates/arkhe-verify-core/src/rbb/trust.rs b/arkhe/source/verification/crates/arkhe-verify-core/src/rbb/trust.rs
new file mode 100644
index 00000000..3384fddf
--- /dev/null
+++ b/arkhe/source/verification/crates/arkhe-verify-core/src/rbb/trust.rs
@@ -0,0 +1,358 @@
+//! Offline verification in TRUSTED_ATTESTATION mode. Trust is supplied by the host,
+//! never bootstrapped from witness keys or configuration inside an untrusted bundle.
+use super::{keccak, Envelope, Error, MLDSA_CONTEXT};
+use ed25519_dalek::{Signature, VerifyingKey};
+use fips204::{
+    ml_dsa_44,
+    traits::{SerDes, Verifier},
+};
+use serde::{Deserialize, Serialize};
+use std::collections::HashSet;
+
+pub const ATTEST_CONTEXT: &[u8] = b"ARKHE_RBB_ATTEST_V1";
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct HybridKey {
+    pub ed25519: [u8; 32],
+    pub mldsa: Vec<u8>,
+}
+
+pub fn verify_hybrid(
+    key: &HybridKey,
+    digest: &[u8; 32],
+    ed: &[u8],
+    ml: &[u8],
+    ctx: &[u8],
+) -> Result<(), Error> {
+    if ed.len() != 64 || ml.len() != 2420 || key.mldsa.len() != 1312 {
+        return Err(Error::SignatureLength);
+    }
+    let ed_key = VerifyingKey::from_bytes(&key.ed25519).map_err(|_| Error::Signature)?;
+    let ed_sig = Signature::from_slice(ed).map_err(|_| Error::Signature)?;
+    ed_key
+        .verify_strict(digest, &ed_sig)
+        .map_err(|_| Error::Signature)?;
+    let pk = ml_dsa_44::PublicKey::try_from_bytes(
+        key.mldsa
+            .as_slice()
+            .try_into()
+            .map_err(|_| Error::SignatureLength)?,
+    )
+    .map_err(|_| Error::Signature)?;
+    let sig: [u8; 2420] = ml.try_into().map_err(|_| Error::SignatureLength)?;
+    if !pk.verify(digest, &sig, ctx) {
+        return Err(Error::Signature);
+    }
+    Ok(())
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Keyset {
+    pub org_id: [u8; 32],
+    pub version: u64,
+    pub key: HybridKey,
+    pub registered_block: u64,
+    pub valid_from: u64,
+    pub valid_until: u64,
+    pub revoked_at: Option<u64>,
+}
+
+// Small canonical-CBOR writer for the closed assessment schema. No generic map/float serialization.
+fn uint(out: &mut Vec<u8>, major: u8, value: u64) {
+    match value {
+        0..=23 => out.push(major << 5 | value as u8),
+        24..=255 => out.extend([major << 5 | 24, value as u8]),
+        256..=65535 => {
+            out.push(major << 5 | 25);
+            out.extend((value as u16).to_be_bytes());
+        }
+        65536..=4294967295 => {
+            out.push(major << 5 | 26);
+            out.extend((value as u32).to_be_bytes());
+        }
+        _ => {
+            out.push(major << 5 | 27);
+            out.extend(value.to_be_bytes());
+        }
+    }
+}
+fn bytes(out: &mut Vec<u8>, value: &[u8]) {
+    uint(out, 2, value.len() as u64);
+    out.extend(value);
+}
+fn array(out: &mut Vec<u8>, n: u64) {
+    uint(out, 4, n);
+}
+fn number(out: &mut Vec<u8>, n: u64) {
+    uint(out, 0, n);
+}
+fn digest(domain: &[u8], payload: &[u8]) -> [u8; 32] {
+    let mut h = blake3::Hasher::new();
+    h.update(domain);
+    h.update(payload);
+    *h.finalize().as_bytes()
+}
+
+impl Keyset {
+    pub fn digest(&self) -> Result<[u8; 32], Error> {
+        if self.key.mldsa.len() != 1312 {
+            return Err(Error::SignatureLength);
+        }
+        let mut out = Vec::new();
+        array(&mut out, 8);
+        bytes(&mut out, &self.org_id);
+        number(&mut out, self.version);
+        bytes(&mut out, &self.key.ed25519);
+        bytes(&mut out, &self.key.mldsa);
+        number(&mut out, self.registered_block);
+        number(&mut out, self.valid_from);
+        number(&mut out, self.valid_until);
+        match self.revoked_at {
+            Some(t) => number(&mut out, t),
+            None => out.push(0xf6),
+        }
+        Ok(digest(b"AKG:KEYSET:SNAPSHOT:v1\0", &out))
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct Witness {
+    pub id: [u8; 32],
+    pub key: HybridKey,
+}
+
+/// All values in this structure must come from the application's pinned, authenticated configuration.
+#[derive(Debug, Clone)]
+pub struct Trust {
+    pub config_digest: [u8; 32],
+    pub epoch: u64,
+    pub chain_id: [u8; 32],
+    pub genesis: [u8; 32],
+    pub registry: [u8; 20],
+    pub anchor: [u8; 20],
+    pub registry_code_hash: [u8; 32],
+    pub anchor_code_hash: [u8; 32],
+    pub policy_catalog_digest: [u8; 32],
+    pub mmr_profile_digest: [u8; 32],
+    pub witnesses: Vec<Witness>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Assessment {
+    pub config_digest: [u8; 32],
+    pub epoch: u64,
+    pub block_number: u64,
+    pub block_hash: [u8; 32],
+    pub state_root: [u8; 32],
+    pub registry_code_hash: [u8; 32],
+    pub anchor_code_hash: [u8; 32],
+    pub envelope_commitment: [u8; 32],
+    pub evidence_manifest_digest: [u8; 32],
+    pub keyset_digest: [u8; 32],
+    pub policy_catalog_digest: [u8; 32],
+    pub watermark: u64,
+    pub expected_events: u64,
+    pub present_events: u64,
+    pub gaps: u64,
+    /// Bits 0..5: institution, signatures, anchor, temporal evidence, policy binding, continuity.
+    pub verified_properties: u8,
+    pub issued_at: u64,
+    pub expires_at: u64,
+    pub first_anchored_at: u64,
+    pub first_anchored_block: u64,
+    pub previous_accepted_id: [u8; 32],
+}
+
+impl Assessment {
+    pub fn canonical_cbor(&self, env: &Envelope) -> Result<Vec<u8>, Error> {
+        let h = &env.header;
+        let mut out = Vec::new();
+        uint(&mut out, 5, 14);
+        number(&mut out, 0);
+        number(&mut out, 1);
+        number(&mut out, 1);
+        array(&mut out, 2);
+        bytes(&mut out, &self.config_digest);
+        number(&mut out, self.epoch);
+        number(&mut out, 2);
+        array(&mut out, 2);
+        bytes(&mut out, &h.anchor_chain_id);
+        bytes(&mut out, &h.anchor_genesis_hash);
+        number(&mut out, 3);
+        array(&mut out, 5);
+        number(&mut out, self.block_number);
+        bytes(&mut out, &self.block_hash);
+        bytes(&mut out, &self.state_root);
+        number(&mut out, self.first_anchored_at);
+        number(&mut out, self.first_anchored_block);
+        number(&mut out, 4);
+        array(&mut out, 4);
+        bytes(&mut out, &h.registry_address);
+        bytes(&mut out, &h.anchor_address);
+        bytes(&mut out, &self.registry_code_hash);
+        bytes(&mut out, &self.anchor_code_hash);
+        number(&mut out, 5);
+        array(&mut out, 4);
+        bytes(&mut out, &h.org_id);
+        bytes(&mut out, &h.stream_id);
+        number(&mut out, h.sequence);
+        bytes(&mut out, &h.checkpoint_id()?);
+        number(&mut out, 6);
+        array(&mut out, 2);
+        bytes(&mut out, &self.envelope_commitment);
+        bytes(&mut out, &self.evidence_manifest_digest);
+        number(&mut out, 7);
+        bytes(&mut out, &self.keyset_digest);
+        number(&mut out, 8);
+        bytes(&mut out, &self.policy_catalog_digest);
+        number(&mut out, 9);
+        array(&mut out, 4);
+        number(&mut out, self.watermark);
+        number(&mut out, self.expected_events);
+        number(&mut out, self.present_events);
+        number(&mut out, self.gaps);
+        number(&mut out, 10);
+        number(&mut out, self.verified_properties as u64);
+        number(&mut out, 11);
+        array(&mut out, 2);
+        number(&mut out, self.issued_at);
+        number(&mut out, self.expires_at);
+        number(&mut out, 12);
+        number(&mut out, h.source_kind as u64);
+        number(&mut out, 13);
+        bytes(&mut out, &self.previous_accepted_id);
+        Ok(out)
+    }
+    pub fn digest(&self, env: &Envelope) -> Result<[u8; 32], Error> {
+        Ok(digest(b"AKG:ASSESSMENT:v1\0", &self.canonical_cbor(env)?))
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Vote {
+    pub witness_id: [u8; 32],
+    pub ed25519_signature: Vec<u8>,
+    pub mldsa_signature: Vec<u8>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CheckpointReport {
+    pub checkpoint_id: [u8; 32],
+    pub reference_block: u64,
+    pub fresh: Option<bool>,
+    pub coverage_complete: bool,
+    pub trust_mode: &'static str,
+}
+
+/// Verifies checkpoint identity, hybrid signatures and attested institutional/anchor binding.
+/// Does not claim to verify a WER or MMR inclusion: use mmr::verify for those properties.
+pub fn verify_attested_checkpoint(
+    env: &Envelope,
+    keyset: &Keyset,
+    assessment: &Assessment,
+    votes: &[Vote],
+    trust: &Trust,
+    now: Option<u64>,
+) -> Result<CheckpointReport, Error> {
+    let h = &env.header;
+    h.validate()?;
+    if trust.witnesses.len() != 4 || votes.len() > 4 {
+        return Err(Error::Quorum);
+    }
+    let mut identities = HashSet::new();
+    let mut ed_keys = HashSet::new();
+    let mut ml_keys = HashSet::new();
+    for witness in &trust.witnesses {
+        if !identities.insert(witness.id)
+            || !ed_keys.insert(witness.key.ed25519)
+            || !ml_keys.insert(keccak(&witness.key.mldsa))
+        {
+            return Err(Error::Quorum);
+        }
+    }
+    if h.anchor_chain_id != trust.chain_id
+        || h.anchor_genesis_hash != trust.genesis
+        || h.registry_address != trust.registry
+        || h.anchor_address != trust.anchor
+        || h.mmr_profile_digest != trust.mmr_profile_digest
+        || assessment.config_digest != trust.config_digest
+        || assessment.epoch != trust.epoch
+        || assessment.registry_code_hash != trust.registry_code_hash
+        || assessment.anchor_code_hash != trust.anchor_code_hash
+        || assessment.policy_catalog_digest != trust.policy_catalog_digest
+        || assessment.envelope_commitment != env.commitment()?
+        || assessment.keyset_digest != keyset.digest()?
+        || keyset.org_id != h.org_id
+        || keyset.version != h.keyset_version
+        || keccak(&keyset.key.ed25519) != h.ed25519_key_id
+        || keccak(&keyset.key.mldsa) != h.mldsa_key_id
+        || keyset.registered_block > assessment.first_anchored_block
+        || assessment.first_anchored_block > assessment.block_number
+        || assessment.previous_accepted_id != h.prev_checkpoint_id
+        || assessment.verified_properties != 0x3f
+        || assessment.block_hash == [0; 32]
+        || assessment.state_root == [0; 32]
+        || assessment.evidence_manifest_digest == [0; 32]
+    {
+        return Err(Error::Binding);
+    }
+    if keyset.valid_from > h.declared_signed_at
+        || h.declared_signed_at >= keyset.valid_until
+        || assessment.first_anchored_at < h.declared_signed_at
+        || assessment.first_anchored_at >= keyset.valid_until
+        || assessment.first_anchored_at > assessment.issued_at
+        || keyset
+            .revoked_at
+            .is_some_and(|t| assessment.first_anchored_at >= t)
+        || assessment.expires_at < assessment.issued_at
+        || assessment.expires_at - assessment.issued_at > 86400
+    {
+        return Err(Error::Time);
+    }
+    if let Some(now) = now {
+        if assessment.issued_at > now.saturating_add(300) {
+            return Err(Error::Time);
+        }
+    }
+    verify_hybrid(
+        &keyset.key,
+        &h.checkpoint_id()?,
+        &env.ed25519_signature,
+        &env.mldsa_signature,
+        MLDSA_CONTEXT,
+    )?;
+    let digest = assessment.digest(env)?;
+    let mut seen = HashSet::new();
+    for vote in votes {
+        if !seen.insert(vote.witness_id) {
+            return Err(Error::Quorum);
+        }
+        let witness = trust
+            .witnesses
+            .iter()
+            .find(|w| w.id == vote.witness_id)
+            .ok_or(Error::Quorum)?;
+        verify_hybrid(
+            &witness.key,
+            &digest,
+            &vote.ed25519_signature,
+            &vote.mldsa_signature,
+            ATTEST_CONTEXT,
+        )?;
+    }
+    if seen.len() < 3 {
+        return Err(Error::Quorum);
+    }
+    Ok(CheckpointReport {
+        checkpoint_id: h.checkpoint_id()?,
+        reference_block: assessment.block_number,
+        fresh: now.map(|n| n >= assessment.issued_at && n < assessment.expires_at),
+        coverage_complete: assessment.gaps == 0
+            && assessment.expected_events == assessment.present_events,
+        trust_mode: "TRUSTED_ATTESTATION",
+    })
+}
diff --git a/arkhe/source/verification/crates/arkhe-verify-core/src/reconciliation.rs b/arkhe/source/verification/crates/arkhe-verify-core/src/reconciliation.rs
