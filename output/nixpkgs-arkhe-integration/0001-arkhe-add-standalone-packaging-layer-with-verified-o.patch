+[package]
+name = "arkhe-rag"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+
+[dependencies]
+arkhe-cognition-sdk = { path = "../arkhe-cognition-sdk" }
+
+serde.workspace = true
+serde_json.workspace = true
+llguidance = "1.2"
+# C++ binding: server target only, behind a feature so the default build
+# (and WASM) never needs CMake/C++. Compilation budget guard against
+# CVE-2025-57809-style blowups lives in `decoder.rs`.
+xgrammar = { version = "0.5", optional = true }
+
+[features]
+default = []
+server = ["dep:xgrammar"]
+
+[dev-dependencies]
+# e2e: the verified PolicyBinding from governance is the policy_digest the
+# NCM harness anchors under. No cycle: governance does not depend on rag.
+arkhe-governance = { path = "../../governance/arkhe-governance" }
+ed25519-dalek.workspace = true
+
+[lints.rust]
+# `cargo kani` sets this cfg; registered per-crate as elsewhere in the workspace.
+unexpected_cfgs = { level = "warn", check-cfg = ['cfg(kani)'] }
diff --git a/arkhe/source/cognition/arkhe-rag/src/citation.rs b/arkhe/source/cognition/arkhe-rag/src/citation.rs
new file mode 100644
index 00000000..83fd2a5a
--- /dev/null
+++ b/arkhe/source/cognition/arkhe-rag/src/citation.rs
@@ -0,0 +1,272 @@
+//! AKG-CITE-0001 — Citation verification with exact entity matching.
+//!
+//! The NCM tokenizer swaps named entities and numerals ("Sydney" → "Melbourne",
+//! "1956" → "1957"). Keyword overlap alone does not detect this. This module
+//! adds a second layer: exact, case-sensitive substring verification of every
+//! entity (proper noun, acronym, numeral) against the evidence chunk that the
+//! claim cites.
+//!
+//! Two layers, both fail-closed:
+//! 1. Entity exactness — every entity in a claim must occur literally in the
+//!    cited chunk (case-sensitive, no normalization).
+//! 2. Keyword overlap — generic claims must share enough non-stopword tokens
+//!    with the cited chunk (Jaccard).
+//!
+//! Hand-rolled tokenizer. No `regex`. No new dependencies.
+//!
+//! This is support verification, not truth verification: a chunk that contains
+//! "Sydney" may still be factually wrong; this module only proves the claim
+//! did not invent the entity. Truth remains the corpus's and the RAG's
+//! responsibility.
+
+use std::collections::HashSet;
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum CitationError {
+    UnknownEvidence(String),
+    EntityNotInEvidence { entity: String, chunk: String },
+    InsufficientSupport { claim: String, score: f64 },
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum EntityKind {
+    ProperNoun,
+    Acronym,
+    Numeral,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Entity {
+    pub kind: EntityKind,
+    pub text: String,
+}
+
+/// A view over a retrieval chunk. Decoupled from `RetrievalChunk` so the
+/// verifier can be tested without the full `arkhe-rag` types.
+#[derive(Debug, Clone, Copy)]
+pub struct Evidence<'a> {
+    pub id: &'a str,
+    pub text: &'a str,
+}
+
+/// A claim extracted from a `RagResponse`. Borrows from the response.
+#[derive(Debug, Clone, Copy)]
+pub struct Claim<'a> {
+    pub text: &'a str,
+    pub evidence_id: &'a str,
+}
+
+pub trait CitationVerifier: Send + Sync {
+    fn verify(&self, claims: &[Claim<'_>], evidence: &[Evidence<'_>]) -> Result<(), CitationError>;
+}
+
+pub struct OverlapVerifier {
+    pub min_keyword_overlap: f64,
+}
+
+impl Default for OverlapVerifier {
+    fn default() -> Self {
+        Self {
+            min_keyword_overlap: 0.5,
+        }
+    }
+}
+
+// ---- Tokenizer (hand-rolled) ----
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Token {
+    Word(String),
+    Numeral(String),
+    Punct(char),
+}
+
+fn tokenize(input: &str) -> Vec<Token> {
+    let chars: Vec<char> = input.chars().collect();
+    let mut tokens = Vec::new();
+    let mut i = 0;
+    while i < chars.len() {
+        let ch = chars[i];
+        let is_num_start = ch.is_ascii_digit()
+            || (ch == '-' && i + 1 < chars.len() && chars[i + 1].is_ascii_digit());
+        if is_num_start {
+            let start = i;
+            i += 1;
+            while i < chars.len() {
+                let c = chars[i];
+                if c.is_ascii_digit() {
+                    i += 1;
+                } else if (c == '.' || c == ',')
+                    && i + 1 < chars.len()
+                    && chars[i + 1].is_ascii_digit()
+                {
+                    i += 2;
+                } else {
+                    break;
+                }
+            }
+            tokens.push(Token::Numeral(chars[start..i].iter().collect()));
+        } else if ch.is_alphanumeric() || ch == '_' {
+            let start = i;
+            i += 1;
+            while i < chars.len() && (chars[i].is_alphanumeric() || chars[i] == '_') {
+                i += 1;
+            }
+            tokens.push(Token::Word(chars[start..i].iter().collect()));
+        } else {
+            tokens.push(Token::Punct(ch));
+            i += 1;
+        }
+    }
+    tokens
+}
+
+// ---- Entity extraction ----
+
+const CAPITALIZED_STOPWORDS: &[&str] = &[
+    "The",
+    "This",
+    "That",
+    "These",
+    "Those",
+    "However",
+    "Therefore",
+    "In",
+    "On",
+    "At",
+    "For",
+    "But",
+    "And",
+    "Or",
+    "A",
+    "An",
+    "It",
+    "We",
+    "They",
+    "He",
+    "She",
+    "I",
+    "You",
+    "If",
+    "When",
+    "While",
+    "Although",
+    "Because",
+    "Since",
+    "After",
+    "Before",
+    "During",
+    "As",
+    "By",
+    "Of",
+    "To",
+    "With",
+    "From",
+    "Not",
+    "No",
+    "Yes",
+];
+
+pub fn extract_entities(claim_text: &str) -> Vec<Entity> {
+    let mut entities = Vec::new();
+    for tok in tokenize(claim_text) {
+        match tok {
+            Token::Numeral(n) => entities.push(Entity {
+                kind: EntityKind::Numeral,
+                text: n,
+            }),
+            Token::Word(w) => {
+                let first = match w.chars().next() {
+                    Some(c) => c,
+                    None => continue,
+                };
+                if !first.is_uppercase() {
+                    continue;
+                }
+                if CAPITALIZED_STOPWORDS.contains(&w.as_str()) {
+                    continue;
+                }
+                let alpha: Vec<char> = w.chars().filter(|c| c.is_alphabetic()).collect();
+                let is_all_caps = alpha.len() >= 2 && alpha.iter().all(|c| c.is_uppercase());
+                let kind = if is_all_caps && alpha.len() <= 6 {
+                    EntityKind::Acronym
+                } else {
+                    EntityKind::ProperNoun
+                };
+                entities.push(Entity { kind, text: w });
+            }
+            Token::Punct(_) => {}
+        }
+    }
+    entities
+}
+
+// ---- Keyword overlap ----
+
+const STOPWORDS_LOWER: &[&str] = &[
+    "the", "a", "an", "is", "are", "was", "were", "be", "been", "being", "of", "to", "in", "on",
+    "at", "for", "with", "by", "from", "as", "and", "or", "but", "not", "no", "if", "then", "than",
+    "that", "this", "it", "its", "we", "they", "he", "she", "i", "you", "his", "her", "their",
+    "our", "your", "my", "me", "us", "them", "him",
+];
+
+fn keyword_set(text: &str) -> HashSet<String> {
+    tokenize(text)
+        .into_iter()
+        .filter_map(|t| match t {
+            Token::Word(w) => Some(w.to_lowercase()),
+            _ => None,
+        })
+        .filter(|w| !STOPWORDS_LOWER.contains(&w.as_str()))
+        .collect()
+}
+
+pub fn keyword_overlap(a: &str, b: &str) -> f64 {
+    let sa = keyword_set(a);
+    let sb = keyword_set(b);
+    let union = sa.union(&sb).count();
+    if union == 0 {
+        return 0.0;
+    }
+    let inter = sa.intersection(&sb).count();
+    inter as f64 / union as f64
+}
+
+// ---- Verifier ----
+
+impl CitationVerifier for OverlapVerifier {
+    fn verify(&self, claims: &[Claim<'_>], evidence: &[Evidence<'_>]) -> Result<(), CitationError> {
+        for claim in claims {
+            // 1. Resolve the cited chunk.
+            let chunk = evidence
+                .iter()
+                .find(|e| e.id == claim.evidence_id)
+                .ok_or_else(|| CitationError::UnknownEvidence(claim.evidence_id.to_string()))?;
+
+            // 2. Entity exactness — case-sensitive, no normalization.
+            for entity in extract_entities(claim.text) {
+                if !chunk.text.contains(&entity.text) {
+                    return Err(CitationError::EntityNotInEvidence {
+                        entity: entity.text,
+                        chunk: chunk.id.to_string(),
+                    });
+                }
+            }
+
+            // 3. Keyword overlap for generic claims.
+            let score = keyword_overlap(claim.text, chunk.text);
+            if score < self.min_keyword_overlap {
+                return Err(CitationError::InsufficientSupport {
+                    claim: claim.text.to_string(),
+                    score,
+                });
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Adapter from raw parts, for callers that do not have `Evidence` literals.
+pub fn evidence_from_chunk<'a>(id: &'a str, text: &'a str) -> Evidence<'a> {
+    Evidence { id, text }
+}
diff --git a/arkhe/source/cognition/arkhe-rag/src/decoder.rs b/arkhe/source/cognition/arkhe-rag/src/decoder.rs
new file mode 100644
index 00000000..48e38afa
--- /dev/null
+++ b/arkhe/source/cognition/arkhe-rag/src/decoder.rs
@@ -0,0 +1,143 @@
+//! AKG-NCM-0002 — Constrained decoding backends for the NCM harness.
+//!
+//! Backend selection is deterministic:
+//! - `llguidance` (pure Rust, compiles to wasm32): used for both targets by
+//!   `for_schema`. It is also the only correct choice for schemas with
+//!   `anyOf`/`oneOf` branches sharing a first-byte class (`integer` vs
+//!   `number`, two `string` branches, …), where XGrammar has a known
+//!   over-rejection bug, and it fails loudly where XGrammar does not.
+//! - `xgrammar` (C++ binding, feature `server`): explicit opt-in for the
+//!   server target on schemas without shared-prefix alternatives, where it
+//!   is faster on plain JSON. Behind a feature so the default build (and
+//!   WASM) never needs CMake/C++. In xgrammar 0.5 the raw-vocab
+//!   `TokenizerInfo` constructor is private, so the caller must supply a
+//!   real tokenizer info (`from_path`/`from_pretrained`/`from_backend_str`)
+//!   — which for Arkhe is the deployment's NCM tokenizer, not an empty
+//!   vocab.
+//!
+//! The compilation budget on the xgrammar path is a post-hoc detector, not a
+//! preemptive guard: compilation has already run when it fires. The actual
+//! prevention for CVE-2025-57809-style blowups is running a fixed upstream
+//! version; the detector refuses to admit a matcher whose compilation took
+//! unreasonably long.
+
+use llguidance::toktrie::TokEnv;
+use serde_json::Value;
+#[cfg(feature = "server")]
+use std::time::{Duration, Instant};
+
+#[cfg(feature = "server")]
+use xgrammar::TokenizerInfo as XgTokenizerInfo;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Target {
+    Wasm,
+    Server,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum DecoderError {
+    TokenEnv(String),
+    Grammar(String),
+    Schema(String),
+    CompilationTimeout,
+}
+
+pub enum ConstrainedDecoder {
+    LlGuidance(llguidance::Matcher),
+    #[cfg(feature = "server")]
+    XGrammar(xgrammar::GrammarMatcher),
+    /// Test fallback: no constraint is applied.
+    NoOp,
+}
+
+impl ConstrainedDecoder {
+    /// Deterministic selection. `llguidance` for both targets: it is the
+    /// only backend that compiles to WASM and the only one known-correct on
+    /// shared-prefix alternatives. Deployments wanting the xgrammar fast
+    /// path on plain JSON opt in explicitly via [`for_xgrammar`] after
+    /// checking [`has_shared_prefix_alternatives`] themselves.
+    pub fn for_schema(
+        schema: &Value,
+        _target: Target,
+        tok_env: &TokEnv,
+    ) -> Result<Self, DecoderError> {
+        Self::llguidance(schema, tok_env)
+    }
+
+    fn llguidance(schema: &Value, tok_env: &TokEnv) -> Result<Self, DecoderError> {
+        use llguidance::{api::TopLevelGrammar, Matcher, ParserFactory};
+        let grammar = TopLevelGrammar::from_json_schema(schema.clone());
+        let factory =
+            ParserFactory::new_simple(tok_env).map_err(|e| DecoderError::Grammar(e.to_string()))?;
+        let parser = factory
+            .create_parser(grammar)
+            .map_err(|e| DecoderError::Grammar(e.to_string()))?;
+        Ok(Self::LlGuidance(Matcher::new(Ok(parser))))
+    }
+
+    /// Server-only opt-in to the xgrammar C++ backend. The caller supplies
+    /// the deployment's real tokenizer info; do not call this for schemas
+    /// where [`has_shared_prefix_alternatives`] is true.
+    #[cfg(feature = "server")]
+    pub fn for_xgrammar(
+        schema: &Value,
+        tokenizer_info: &XgTokenizerInfo,
+    ) -> Result<Self, DecoderError> {
+        use xgrammar::{Grammar, GrammarCompiler, GrammarMatcher};
+        let schema_str =
+            serde_json::to_string(schema).map_err(|e| DecoderError::Schema(e.to_string()))?;
+        let grammar = Grammar::from_json_schema(
+            &schema_str,
+            Some(true),                               // any_whitespace
+            None,                                     // indent
+            Some((",".to_string(), ":".to_string())), // separators
+            Some(true),                               // strict_mode
+            None,                                     // max_whitespace_cnt
+            Some(false),                              // print_converted_ebnf
+        )
+        .map_err(|e| DecoderError::Grammar(e.to_string()))?;
+        let compiler = GrammarCompiler::new(tokenizer_info);
+        let start = Instant::now();
+        let compiled = compiler
+            .compile_grammar(&grammar)
+            .map_err(|e| DecoderError::Grammar(e.to_string()))?;
+        if start.elapsed() > Duration::from_secs(2) {
+            return Err(DecoderError::CompilationTimeout);
+        }
+        Ok(Self::XGrammar(GrammarMatcher::new(&compiled)))
+    }
+}
+
+/// True if the schema contains `anyOf`/`oneOf` where two branches share a
+/// first-byte class (`integer` vs `number`, two branches of the same type,
+/// …) — the shape that triggers XGrammar's over-rejection bug. Recursive:
+/// nested `properties`, `items`, `allOf`, … are checked. Only branches that
+/// declare a `type` are compared; untyped branches are conservatively not
+/// flagged (llguidance handles them correctly either way).
+pub fn has_shared_prefix_alternatives(schema: &Value) -> bool {
+    if let Some(alts) = schema.get("anyOf").or_else(|| schema.get("oneOf")) {
+        if let Some(arr) = alts.as_array() {
+            let types: Vec<&str> = arr
+                .iter()
+                .filter_map(|b| b.get("type").and_then(|t| t.as_str()))
+                .collect();
+            for i in 0..types.len() {
+                for j in (i + 1)..types.len() {
+                    if first_byte_shared(types[i], types[j]) {
+                        return true;
+                    }
+                }
+            }
+        }
+    }
+    match schema {
+        Value::Object(map) => map.values().any(has_shared_prefix_alternatives),
+        Value::Array(arr) => arr.iter().any(has_shared_prefix_alternatives),
+        _ => false,
+    }
+}
+
+fn first_byte_shared(a: &str, b: &str) -> bool {
+    a == b || matches!((a, b), ("integer", "number") | ("number", "integer"))
+}
diff --git a/arkhe/source/cognition/arkhe-rag/src/lib.rs b/arkhe/source/cognition/arkhe-rag/src/lib.rs
