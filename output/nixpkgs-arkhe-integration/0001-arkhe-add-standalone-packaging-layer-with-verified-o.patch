@@ -0,0 +1,107 @@
+# Perfil `arkhe-node`: runtime HTTP do kernel Arkhe.
+#
+# Requer o overlay deste repositório:
+#   nixpkgs.overlays = [ inputs.nixpkgs-arkhe.overlays.default ];
+{ config, lib, pkgs, ... }:
+
+let
+  cfg = config.services.arkheNode;
+in
+{
+  options.services.arkheNode = {
+    enable = lib.mkEnableOption "runtime Arkhe (perfil arkhe-node)";
+
+    package = lib.mkOption {
+      type = lib.types.package;
+      default = pkgs.arkhe.arkhe-runtime;
+      defaultText = lib.literalExpression "pkgs.arkhe.arkhe-runtime";
+      description = ''
+        Pacote do runtime. Exige o overlay do nixpkgs-arkhe
+        (`nixpkgs.overlays = [ inputs.nixpkgs-arkhe.overlays.default ];`).
+      '';
+    };
+
+    listen = lib.mkOption {
+      type = lib.types.str;
+      default = "127.0.0.1:8788";
+      description = "Endereço de escuta, exportado como ARKHE_LISTEN.";
+    };
+
+    port = lib.mkOption {
+      type = lib.types.port;
+      default = 8788;
+      description = "Porta TCP aberta quando `openFirewall` está ativo.";
+    };
+
+    environmentFile = lib.mkOption {
+      type = lib.types.nullOr lib.types.str;
+      default = null;
+      description = ''
+        Arquivo com DATABASE_URL, ARKHE_API_TOKEN, ARKHE_ACTOR e
+        ARKHE_TENANT_ID. Obrigatório quando o serviço está habilitado.
+      '';
+    };
+
+    openFirewall = lib.mkOption {
+      type = lib.types.bool;
+      default = false;
+      description = "Abrir `port` no firewall.";
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    assertions = [
+      {
+        assertion = cfg.environmentFile != null;
+        message = "services.arkheNode.environmentFile é obrigatório.";
+      }
+    ];
+
+    users.groups.arkhe = { };
+
+    users.users.arkhe = {
+      isSystemUser = true;
+      group = "arkhe";
+      home = "/var/lib/arkhe";
+    };
+
+    systemd.services.arkhe-runtime = {
+      description = "Arkhe runtime";
+      wantedBy = [ "multi-user.target" ];
+      after = [ "network-online.target" ];
+      wants = [ "network-online.target" ];
+
+      environment = {
+        ARKHE_LISTEN = cfg.listen;
+        RUST_LOG = "info";
+      };
+
+      serviceConfig = {
+        ExecStart = "${cfg.package}/bin/arkhe-runtime";
+        User = "arkhe";
+        Group = "arkhe";
+        StateDirectory = "arkhe";
+        EnvironmentFile = lib.mkIf (cfg.environmentFile != null) cfg.environmentFile;
+        Restart = "on-failure";
+        RestartSec = 5;
+
+        NoNewPrivileges = true;
+        PrivateTmp = true;
+        ProtectSystem = "strict";
+        ProtectHome = true;
+        ReadWritePaths = [ "/var/lib/arkhe" ];
+        RestrictAddressFamilies = [
+          "AF_INET"
+          "AF_INET6"
+          "AF_UNIX"
+        ];
+        SystemCallArchitectures = "native";
+        CapabilityBoundingSet = "";
+        LockPersonality = true;
+        MemoryDenyWriteExecute = true;
+      };
+    };
+
+    networking.firewall.allowedTCPPorts = lib.optional cfg.openFirewall cfg.port;
+  };
+}
diff --git a/arkhe/nixpkgs/README.md b/arkhe/nixpkgs/README.md
new file mode 100644
index 00000000..b91fa21c
--- /dev/null
+++ b/arkhe/nixpkgs/README.md
@@ -0,0 +1,37 @@
+# Submissão ao nixpkgs
+
+`by-name/` contém o template no formato exigido pelo nixpkgs atual:
+`pkgs/by-name/<duas primeiras letras>/<nome>/package.nix`.
+
+## Por que é um template
+
+O nixpkgs exige que a fonte seja baixada de uma URL fixa e verificada por hash.
+Este repositório ainda não tem uma tag de release pública com hash calculável,
+então o template usa `lib.fakeHash` — ele falha de forma explícita, em vez de
+esconder um hash inventado.
+
+## Passos para abrir o PR
+
+1. Publicar uma tag `v0.1.0` do monorepo Arkhe.
+2. Calcular o hash da fonte:
+   ```bash
+   nix-prefetch-github rafael-arkhe arkhe --rev v0.1.0
+   ```
+3. Substituir `lib.fakeHash` pelo valor SRI em
+   `by-name/ar/arkhe-verify/package.nix`.
+4. Copiar o diretório para um checkout do nixpkgs e validar:
+   ```bash
+   nix-build -A arkhe-verify
+   nixpkgs-review pr <numero>
+   ```
+5. Adicionar um mantenedor real em `meta.maintainers` (o nixpkgs exige uma
+   entrada em `maintainers/maintainer-list.nix`) e uma entrada em
+   `pkgs/top-level/all-packages.nix` **não é necessária** no layout `by-name`.
+
+## Escopo
+
+Somente `arkhe-verify` está preparado para submissão. Os demais pacotes
+(`arkhe-runtime`, `arkhe-ask`, `arkhe-sql-migrate`, `arkhe-twin`,
+`arkhe-ollama`, `arkhe-crm-bridge`, `arkhe-python-gate`) dependem de serviços
+externos em tempo de execução e ainda não têm testes herméticos que justifiquem
+entrar no nixpkgs.
diff --git a/arkhe/nixpkgs/by-name/ar/arkhe-verify/package.nix b/arkhe/nixpkgs/by-name/ar/arkhe-verify/package.nix
new file mode 100644
index 00000000..034a1c3c
--- /dev/null
+++ b/arkhe/nixpkgs/by-name/ar/arkhe-verify/package.nix
@@ -0,0 +1,55 @@
+# Template de submissão ao nixpkgs (layout `by-name`).
+#
+# Este arquivo NÃO é importado pelo flake deste repositório: ele contém
+# `lib.fakeHash` de propósito, para falhar de forma explícita até que o hash da
+# fonte real seja calculado.
+#
+# Preencha com:
+#
+#   nix-prefetch-github rafael-arkhe arkhe --rev v0.1.0
+#
+# e substitua `hash` pelo valor SRI retornado.
+{
+  lib,
+  rustPlatform,
+  fetchFromGitHub,
+}:
+
+rustPlatform.buildRustPackage (finalAttrs: {
+  pname = "arkhe-verify";
+  version = "0.1.0";
+
+  src = fetchFromGitHub {
+    owner = "rafael-arkhe";
+    repo = "arkhe";
+    tag = "v${finalAttrs.version}";
+    hash = lib.fakeHash; # TODO: substituir pelo hash real
+  };
+
+  cargoLock = {
+    lockFile = "${finalAttrs.src}/Cargo.lock";
+    allowBuiltinFetchGit = false;
+  };
+
+  cargoBuildFlags = [
+    "--locked"
+    "-p"
+    "arkhe-verify-cli"
+    "--bin"
+    "arkhe-verify"
+  ];
+
+  cargoTestFlags = [ "-p" "arkhe-verify-cli" ];
+
+  SOURCE_DATE_EPOCH = 315532800;
+
+  meta = {
+    description = "Offline verifier for Arkhe envelopes, MMR proofs and checkpoints";
+    homepage = "https://github.com/rafael-arkhe/nixpkgs-arkhe";
+    license = lib.licenses.asl20;
+    mainProgram = "arkhe-verify";
+    maintainers = [ ];
+    platforms = lib.platforms.linux;
+    sourceProvenance = [ lib.sourceTypes.fromSource ];
+  };
+})
diff --git a/arkhe/overlay.nix b/arkhe/overlay.nix
new file mode 100644
index 00000000..00b1a5ae
--- /dev/null
+++ b/arkhe/overlay.nix
@@ -0,0 +1,27 @@
+# Overlay Nix.
+#
+#   nixpkgs.overlays = [ inputs.nixpkgs-arkhe.overlays.default ];
+#   environment.systemPackages = [ pkgs.arkhe.arkhe-verify ];
+#
+# Para derivar com endereçamento por conteúdo:
+#
+#   nixpkgs.overlays = [
+#     (import inputs.nixpkgs-arkhe { contentAddressed = true; })
+#   ];
+{
+  src ? ./source,
+  contentAddressed ? false,
+  rustPlatform ? null,
+}:
+final: prev:
+let
+  arkhe = import ./default.nix {
+    pkgs = final;
+    inherit src contentAddressed;
+    rustPlatform = if rustPlatform == null then final.rustPlatform else rustPlatform;
+  };
+in
+{
+  inherit arkhe;
+  arkhePackages = arkhe;
+}
