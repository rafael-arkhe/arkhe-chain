diff --git a/arkhe/source/integration/arkhe-bugbounty/examples/persistence_probe.rs b/arkhe/source/integration/arkhe-bugbounty/examples/persistence_probe.rs
new file mode 100644
index 00000000..e337d7a9
--- /dev/null
+++ b/arkhe/source/integration/arkhe-bugbounty/examples/persistence_probe.rs
@@ -0,0 +1,77 @@
+//! Explicit synthetic probe run in separate processes before/after PostgreSQL restart.
+use arkhe_bugbounty::{
+    postgres::{PgKernel, PgOperations, WorkerVerifier},
+    Claim, Journal, Kernel,
+};
+use arkhe_core::{
+    evidence::EvidenceReader,
+    work::{RequestIdentity, WorkIntent, WorkIntentType},
+    worker::{CognitiveOperation, WorkerExecutionRecord},
+    CanonicalEncode, Digest32,
+};
+use async_trait::async_trait;
+struct Pinned(Digest32);
+#[async_trait]
+impl WorkerVerifier for Pinned {
+    async fn verify(&self, r: &WorkerExecutionRecord) -> Result<(), String> {
+        if r.digest() == self.0 {
+            Ok(())
+        } else {
+            Err("probe receipt mismatch".into())
+        }
+    }
+}
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let url = std::env::var("DATABASE_URL")?;
+    let tenant = std::env::var("ARKHE_PROBE_TENANT")?;
+    let mode = std::env::args().nth(1).ok_or("seed or check required")?;
+    let i = WorkIntent {
+        requested_by: "synthetic-restart-probe".into(),
+        intent_type: WorkIntentType::TriageReport,
+        target: Digest32::blake3(b"probe-target", b"1"),
+        parameters_digest: Digest32::blake3(b"probe-params", b"1"),
+        context: vec![],
+        context_refs: vec![],
+        request_identity: RequestIdentity::new(b"probe-request"),
+        claimed_created_at: 0,
+    };
+    let r = WorkerExecutionRecord {
+        classification: None,
+        module_id: "synthetic-restart-probe".into(),
+        module_version: "1".into(),
+        operation: Some(CognitiveOperation::Execute),
+        input_digest: i.target,
+        output_digest: i.parameters_digest,
+        evidence_refs: vec![],
+        confidence_bps: None,
+        uncertainty_note: Some("synthetic storage probe; no external operation".into()),
+        execution_id: i.operation_id().to_hex(),
+    };
+    let j = PgOperations::connect(&url, &tenant).await?;
+    let k = PgKernel::connect(&url, &tenant, Pinned(r.digest())).await?;
+    if mode == "seed" {
+        let owner = match j.claim(&i).await? {
+            Claim::Acquired(o) => o,
+            _ => return Err("probe tenant was not empty".into()),
+        };
+        k.admit(&r).await?;
+        j.mark_dispatched(&i, owner).await?;
+        j.complete(&i, owner, &r).await?;
+    } else if mode == "check" {
+        match j.claim(&i).await? {
+            Claim::Replay(w) if w.digest() == r.digest() => (),
+            _ => return Err("journal did not survive restart".into()),
+        }
+        if k.get(r.digest()).await?.is_none()
+            || k.canonical_worker(r.digest()).await?.as_deref()
+                != Some(r.canonical_bytes().as_slice())
+        {
+            return Err("evidence did not survive restart".into());
+        }
+    } else {
+        return Err("seed or check required".into());
+    }
+    println!("PASS {mode}: journal and verified evidence {tenant}");
+    Ok(())
+}
diff --git a/arkhe/source/integration/arkhe-bugbounty/examples/worker_differential.rs b/arkhe/source/integration/arkhe-bugbounty/examples/worker_differential.rs
new file mode 100644
index 00000000..2d1ed475
--- /dev/null
+++ b/arkhe/source/integration/arkhe-bugbounty/examples/worker_differential.rs
@@ -0,0 +1,139 @@
+//! Bounded mutation campaign over the actual SignedWorkerVerifier; TEST keys only.
+use arkhe_bugbounty::{postgres::WorkerVerifier, provenance::*};
+use arkhe_core::{
+    evidence::{EvidenceEnvelope, EvidenceReader},
+    worker::{CognitiveOperation, WorkerExecutionRecord},
+    Digest32,
+};
+use async_trait::async_trait;
+use ed25519_dalek::{Signer, SigningKey};
+use serde_json::json;
+struct NoEvidence;
+#[async_trait]
+impl EvidenceReader for NoEvidence {
+    async fn get(&self, _: Digest32) -> Result<Option<EvidenceEnvelope>, String> {
+        Ok(None)
+    }
+}
+struct Receipts(SignedWorkerReceipt);
+#[async_trait]
+impl ReceiptReader for Receipts {
+    async fn receipts(&self, _: Digest32) -> Result<Vec<SignedWorkerReceipt>, String> {
+        Ok(vec![self.0.clone()])
+    }
+}
+#[tokio::main]
+async fn main() {
+    let count: usize = std::env::args()
+        .nth(1)
+        .unwrap_or_else(|| "4096".into())
+        .parse()
+        .expect("case count");
+    assert!((16..=65536).contains(&count));
+    let key = SigningKey::from_bytes(&[37; 32]);
+    for i in 0..count {
+        let mut record = WorkerExecutionRecord {
+            classification: None,
+            operation: Some(CognitiveOperation::Decide),
+            module_id: "gov-verifier".into(),
+            module_version: "1".into(),
+            input_digest: Digest32::ZERO,
+            output_digest: Digest32::blake3(b"mutation", &i.to_be_bytes()),
+            evidence_refs: vec![],
+            confidence_bps: None,
+            uncertainty_note: None,
+            execution_id: format!("case-{i}"),
+        };
+        let mut trust = TrustedWorkerKey {
+            key_id: "test-worker".into(),
+            public_key: key.verifying_key().to_bytes(),
+            module_id: "gov-verifier".into(),
+            module_version: "1".into(),
+            allowed_operations: vec![CognitiveOperation::Decide],
+            require_admitted_input: false,
+            active: true,
+        };
+        let mode = i % 16;
+        if mode == 1 {
+            record.execution_id.push_str("-before-sign");
+        }
+        if mode == 8 {
+            record.module_version = "unauthorized".into();
+        }
+        if mode == 9 {
+            trust.active = false;
+        }
+        if mode == 11 {
+            record.operation = None;
+        }
+        if mode == 13 {
+            record.evidence_refs.push(Digest32([3; 32]));
+        }
+        if mode == 14 {
+            trust.require_admitted_input = true;
+        }
+        if mode == 15 {
+            record.execution_id = format!("日本語-ação-{i}");
+        }
+        let mut receipt = SignedWorkerReceipt {
+            version: 1,
+            tenant: "gov-synthetic".into(),
+            key_id: "test-worker".into(),
+            record_hash: record.digest(),
+            completed_at_ms: 1000,
+            outcome: ExecutionOutcome::Succeeded,
+            signature_hex: String::new(),
+        };
+        if mode == 2 {
+            receipt.tenant = "another-tenant".into();
+        }
+        if mode == 3 {
+            receipt.version = 2;
+        }
+        if mode == 4 {
+            receipt.outcome = ExecutionOutcome::Failed;
+        }
+        if mode == 5 {
+            receipt.completed_at_ms = -1;
+        }
+        if mode == 10 {
+            receipt.key_id = "unknown".into();
+        }
+        receipt.signature_hex = hex::encode(
+            if mode == 12 {
+                SigningKey::from_bytes(&[38; 32]).sign(&receipt.signing_bytes())
+            } else {
+                key.sign(&receipt.signing_bytes())
+            }
+            .to_bytes(),
+        );
+        if mode == 1 {
+            record.execution_id.push_str("-after-sign");
+        }
+        if mode == 6 {
+            let mut signature = hex::decode(&receipt.signature_hex).unwrap();
+            signature[(i / 16) % 64] ^= 1 << ((i / 1024) % 8);
+            receipt.signature_hex = hex::encode(signature);
+        }
+        if mode == 7 {
+            receipt.signature_hex = "invalid-hex".into();
+        }
+        let verifier = SignedWorkerVerifier::new(
+            "gov-synthetic".into(),
+            vec![trust.clone()],
+            Receipts(receipt.clone()),
+            NoEvidence,
+        )
+        .unwrap();
+        let actual = verifier.verify(&record).await.is_ok();
+        assert_eq!(
+            actual,
+            mode == 0 || mode == 15,
+            "mutation mode {mode}, case {i}"
+        );
+        println!(
+            "{}",
+            json!({"case":i,"mode":mode,"record":record,"recordDigest":record.digest().to_hex(),"receipt":receipt,"trust":trust,"signingBytesHex":hex::encode(receipt.signing_bytes()),"nativeAccepted":actual})
+        );
+    }
+}
diff --git a/arkhe/source/integration/arkhe-bugbounty/src/bin/export_checkpoint.rs b/arkhe/source/integration/arkhe-bugbounty/src/bin/export_checkpoint.rs
new file mode 100644
index 00000000..7a538b8c
--- /dev/null
+++ b/arkhe/source/integration/arkhe-bugbounty/src/bin/export_checkpoint.rs
@@ -0,0 +1,66 @@
+//! Export a persisted tenant snapshot and MMR proof for offline anchoring.
+use arkhe_core::{canonical::encode_value, Digest32};
+use arkhe_verify_core::mmr::{
+    build_root_and_proof,
+    profile::{mmr_size, PROFILE_DIGEST_HEX},
+};
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let url = std::env::var("DATABASE_URL")?;
+    let tenant = std::env::var("ARKHE_TENANT_ID")?;
+    let output = std::env::args().nth(1).ok_or("output file required")?;
+    let graph = arkhe_wormgraph::postgres::PgWormGraph::connect(&url, &tenant).await?;
+    graph.health().await?;
+    let pool = sqlx::PgPool::connect(&url).await?;
+    let mut tx = pool.begin().await?;
+    sqlx::query("SET LOCAL ROLE arkhe_append")
+        .execute(&mut *tx)
+        .await?;
+    arkhe_sql::tenant::set_tenant(&mut tx, &tenant).await?;
+    sqlx::query("SELECT pg_advisory_xact_lock(hashtextextended($1,0))")
+        .bind(format!("arkhe:wormgraph:{tenant}"))
+        .execute(&mut *tx)
+        .await?;
+    let leaves: Vec<Vec<u8>> = sqlx::query_scalar(
+        "SELECT record_hash FROM wormgraph_records WHERE tenant_id=$1 ORDER BY append_sequence",
+    )
+    .bind(&tenant)
+    .fetch_all(&mut *tx)
+    .await?;
+    if leaves.is_empty() {
+        return Err("no persisted WormGraph evidence to anchor".into());
+    }
+    let n = leaves.len();
+    let (root, proof) = build_root_and_proof(&leaves, n - 1)?;
+    let mut peaks = Vec::new();
+    let mut start = 0;
+    for bit in (0..usize::BITS).rev() {
+        let width = 1usize << bit;
+        if n & width != 0 {
+            peaks.push(
+                build_root_and_proof(&leaves[start..start + width], 0)?
+                    .0
+                    .to_vec(),
+            );
+            start += width;
+        }
+    }
+    let checkpoint = serde_json::json!({"version":1,"tenant_id":tenant,"stream_id":"wormgraph-records-v1","leaf_count":n,"mmr_size":mmr_size(n as u64),"mmr_root":hex::encode(root),"profile_digest":PROFILE_DIGEST_HEX,"covered_up_to_hash":hex::encode(&leaves[n-1])});
+    let canonical = encode_value(&checkpoint);
+    let digest = Digest32::blake3(b"AKG:CHECKPOINT:v1\0", &canonical);
+    // The snapshot is retained in the existing append-only checkpoint table.
+    sqlx::query("INSERT INTO mmr_checkpoints(tenant_id,stream_id,leaf_count,mmr_size,mmr_root,peaks,profile_digest,covered_up_to_hash) VALUES($1,'wormgraph-records-v1',$2,$3,$4,$5,$6,$7) ON CONFLICT DO NOTHING")
+ .bind(&tenant).bind(n as i64).bind(mmr_size(n as u64) as i64).bind(root.to_vec()).bind(peaks).bind(hex::decode(PROFILE_DIGEST_HEX)?).bind(&leaves[n-1]).execute(&mut *tx).await?;
+    let stored:Vec<u8>=sqlx::query_scalar("SELECT mmr_root FROM mmr_checkpoints WHERE tenant_id=$1 AND stream_id='wormgraph-records-v1' AND leaf_count=$2").bind(&tenant).bind(n as i64).fetch_one(&mut *tx).await?;
+    if stored != root {
+        return Err("checkpoint conflict".into());
+    }
+    tx.commit().await?;
+    let bundle = serde_json::json!({"checkpoint":checkpoint,"checkpoint_cbor_hex":hex::encode(canonical),"checkpoint_digest":digest.to_hex(),"leaf_hex":hex::encode(&leaves[n-1]),"proof":proof});
+    std::fs::write(output, serde_json::to_vec_pretty(&bundle)?)?;
+    println!(
+        "Exported persisted checkpoint: {n} leaves, digest {}",
+        digest.to_hex()
+    );
+    Ok(())
+}
