@@ -0,0 +1,36 @@
+//! Arkhe-RBB v3 candidate revision 2. Isolated from the existing frozen MMR profile.
+mod header;
+pub mod mmr;
+#[cfg(feature = "rbb-pqc")]
+pub mod trust;
+
+pub use header::*;
+
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+pub enum Error {
+    #[error("non-canonical ABI")]
+    NonCanonical,
+    #[error("invalid header: {0}")]
+    Header(&'static str),
+    #[error("unsupported cryptographic profile")]
+    Profile,
+    #[error("invalid signature length")]
+    SignatureLength,
+    #[error("invalid hybrid signature")]
+    Signature,
+    #[error("untrusted or mismatched institutional binding")]
+    Binding,
+    #[error("insufficient or conflicting witness votes")]
+    Quorum,
+    #[error("invalid temporal evidence")]
+    Time,
+    #[error("invalid MMR proof")]
+    Mmr,
+    #[error("resource limit exceeded")]
+    ResourceLimit,
+}
+
+pub fn keccak(data: &[u8]) -> [u8; 32] {
+    use sha3::{Digest, Keccak256};
+    Keccak256::digest(data).into()
+}
diff --git a/arkhe/protocol/src/rbb/trust.rs b/arkhe/protocol/src/rbb/trust.rs
new file mode 100644
index 0000000..3384fdd
--- /dev/null
+++ b/arkhe/protocol/src/rbb/trust.rs
@@ -0,0 +1,358 @@
+//! Offline verification in TRUSTED_ATTESTATION mode. Trust is supplied by the host,
+//! never bootstrapped from witness keys or configuration inside an untrusted bundle.
+use super::{keccak, Envelope, Error, MLDSA_CONTEXT};
+use ed25519_dalek::{Signature, VerifyingKey};
+use fips204::{
+    ml_dsa_44,
+    traits::{SerDes, Verifier},
+};
+use serde::{Deserialize, Serialize};
+use std::collections::HashSet;
+
+pub const ATTEST_CONTEXT: &[u8] = b"ARKHE_RBB_ATTEST_V1";
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct HybridKey {
+    pub ed25519: [u8; 32],
+    pub mldsa: Vec<u8>,
+}
+
+pub fn verify_hybrid(
+    key: &HybridKey,
+    digest: &[u8; 32],
+    ed: &[u8],
+    ml: &[u8],
+    ctx: &[u8],
+) -> Result<(), Error> {
+    if ed.len() != 64 || ml.len() != 2420 || key.mldsa.len() != 1312 {
+        return Err(Error::SignatureLength);
+    }
+    let ed_key = VerifyingKey::from_bytes(&key.ed25519).map_err(|_| Error::Signature)?;
+    let ed_sig = Signature::from_slice(ed).map_err(|_| Error::Signature)?;
+    ed_key
+        .verify_strict(digest, &ed_sig)
+        .map_err(|_| Error::Signature)?;
+    let pk = ml_dsa_44::PublicKey::try_from_bytes(
+        key.mldsa
+            .as_slice()
+            .try_into()
+            .map_err(|_| Error::SignatureLength)?,
+    )
+    .map_err(|_| Error::Signature)?;
+    let sig: [u8; 2420] = ml.try_into().map_err(|_| Error::SignatureLength)?;
+    if !pk.verify(digest, &sig, ctx) {
+        return Err(Error::Signature);
+    }
+    Ok(())
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Keyset {
+    pub org_id: [u8; 32],
+    pub version: u64,
+    pub key: HybridKey,
+    pub registered_block: u64,
+    pub valid_from: u64,
+    pub valid_until: u64,
+    pub revoked_at: Option<u64>,
+}
+
+// Small canonical-CBOR writer for the closed assessment schema. No generic map/float serialization.
+fn uint(out: &mut Vec<u8>, major: u8, value: u64) {
+    match value {
+        0..=23 => out.push(major << 5 | value as u8),
+        24..=255 => out.extend([major << 5 | 24, value as u8]),
+        256..=65535 => {
+            out.push(major << 5 | 25);
+            out.extend((value as u16).to_be_bytes());
+        }
+        65536..=4294967295 => {
+            out.push(major << 5 | 26);
+            out.extend((value as u32).to_be_bytes());
+        }
+        _ => {
+            out.push(major << 5 | 27);
+            out.extend(value.to_be_bytes());
+        }
+    }
+}
+fn bytes(out: &mut Vec<u8>, value: &[u8]) {
+    uint(out, 2, value.len() as u64);
+    out.extend(value);
+}
+fn array(out: &mut Vec<u8>, n: u64) {
+    uint(out, 4, n);
+}
+fn number(out: &mut Vec<u8>, n: u64) {
+    uint(out, 0, n);
+}
+fn digest(domain: &[u8], payload: &[u8]) -> [u8; 32] {
+    let mut h = blake3::Hasher::new();
+    h.update(domain);
+    h.update(payload);
+    *h.finalize().as_bytes()
+}
+
+impl Keyset {
+    pub fn digest(&self) -> Result<[u8; 32], Error> {
+        if self.key.mldsa.len() != 1312 {
+            return Err(Error::SignatureLength);
+        }
+        let mut out = Vec::new();
+        array(&mut out, 8);
+        bytes(&mut out, &self.org_id);
+        number(&mut out, self.version);
+        bytes(&mut out, &self.key.ed25519);
+        bytes(&mut out, &self.key.mldsa);
+        number(&mut out, self.registered_block);
+        number(&mut out, self.valid_from);
+        number(&mut out, self.valid_until);
+        match self.revoked_at {
+            Some(t) => number(&mut out, t),
+            None => out.push(0xf6),
+        }
+        Ok(digest(b"AKG:KEYSET:SNAPSHOT:v1\0", &out))
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct Witness {
+    pub id: [u8; 32],
+    pub key: HybridKey,
+}
+
+/// All values in this structure must come from the application's pinned, authenticated configuration.
+#[derive(Debug, Clone)]
+pub struct Trust {
+    pub config_digest: [u8; 32],
+    pub epoch: u64,
+    pub chain_id: [u8; 32],
+    pub genesis: [u8; 32],
+    pub registry: [u8; 20],
+    pub anchor: [u8; 20],
+    pub registry_code_hash: [u8; 32],
+    pub anchor_code_hash: [u8; 32],
+    pub policy_catalog_digest: [u8; 32],
+    pub mmr_profile_digest: [u8; 32],
+    pub witnesses: Vec<Witness>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Assessment {
+    pub config_digest: [u8; 32],
+    pub epoch: u64,
+    pub block_number: u64,
+    pub block_hash: [u8; 32],
+    pub state_root: [u8; 32],
+    pub registry_code_hash: [u8; 32],
+    pub anchor_code_hash: [u8; 32],
+    pub envelope_commitment: [u8; 32],
+    pub evidence_manifest_digest: [u8; 32],
+    pub keyset_digest: [u8; 32],
+    pub policy_catalog_digest: [u8; 32],
+    pub watermark: u64,
+    pub expected_events: u64,
+    pub present_events: u64,
+    pub gaps: u64,
+    /// Bits 0..5: institution, signatures, anchor, temporal evidence, policy binding, continuity.
+    pub verified_properties: u8,
+    pub issued_at: u64,
+    pub expires_at: u64,
+    pub first_anchored_at: u64,
+    pub first_anchored_block: u64,
+    pub previous_accepted_id: [u8; 32],
+}
+
+impl Assessment {
+    pub fn canonical_cbor(&self, env: &Envelope) -> Result<Vec<u8>, Error> {
+        let h = &env.header;
+        let mut out = Vec::new();
+        uint(&mut out, 5, 14);
+        number(&mut out, 0);
+        number(&mut out, 1);
+        number(&mut out, 1);
+        array(&mut out, 2);
+        bytes(&mut out, &self.config_digest);
+        number(&mut out, self.epoch);
+        number(&mut out, 2);
+        array(&mut out, 2);
+        bytes(&mut out, &h.anchor_chain_id);
+        bytes(&mut out, &h.anchor_genesis_hash);
+        number(&mut out, 3);
+        array(&mut out, 5);
+        number(&mut out, self.block_number);
+        bytes(&mut out, &self.block_hash);
+        bytes(&mut out, &self.state_root);
+        number(&mut out, self.first_anchored_at);
+        number(&mut out, self.first_anchored_block);
+        number(&mut out, 4);
+        array(&mut out, 4);
+        bytes(&mut out, &h.registry_address);
+        bytes(&mut out, &h.anchor_address);
+        bytes(&mut out, &self.registry_code_hash);
+        bytes(&mut out, &self.anchor_code_hash);
+        number(&mut out, 5);
+        array(&mut out, 4);
+        bytes(&mut out, &h.org_id);
+        bytes(&mut out, &h.stream_id);
+        number(&mut out, h.sequence);
+        bytes(&mut out, &h.checkpoint_id()?);
+        number(&mut out, 6);
+        array(&mut out, 2);
+        bytes(&mut out, &self.envelope_commitment);
+        bytes(&mut out, &self.evidence_manifest_digest);
+        number(&mut out, 7);
+        bytes(&mut out, &self.keyset_digest);
+        number(&mut out, 8);
+        bytes(&mut out, &self.policy_catalog_digest);
+        number(&mut out, 9);
+        array(&mut out, 4);
+        number(&mut out, self.watermark);
+        number(&mut out, self.expected_events);
+        number(&mut out, self.present_events);
+        number(&mut out, self.gaps);
+        number(&mut out, 10);
+        number(&mut out, self.verified_properties as u64);
+        number(&mut out, 11);
+        array(&mut out, 2);
+        number(&mut out, self.issued_at);
+        number(&mut out, self.expires_at);
+        number(&mut out, 12);
+        number(&mut out, h.source_kind as u64);
+        number(&mut out, 13);
+        bytes(&mut out, &self.previous_accepted_id);
+        Ok(out)
+    }
+    pub fn digest(&self, env: &Envelope) -> Result<[u8; 32], Error> {
+        Ok(digest(b"AKG:ASSESSMENT:v1\0", &self.canonical_cbor(env)?))
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Vote {
+    pub witness_id: [u8; 32],
+    pub ed25519_signature: Vec<u8>,
+    pub mldsa_signature: Vec<u8>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CheckpointReport {
+    pub checkpoint_id: [u8; 32],
+    pub reference_block: u64,
+    pub fresh: Option<bool>,
+    pub coverage_complete: bool,
+    pub trust_mode: &'static str,
+}
+
+/// Verifies checkpoint identity, hybrid signatures and attested institutional/anchor binding.
+/// Does not claim to verify a WER or MMR inclusion: use mmr::verify for those properties.
+pub fn verify_attested_checkpoint(
+    env: &Envelope,
+    keyset: &Keyset,
+    assessment: &Assessment,
+    votes: &[Vote],
+    trust: &Trust,
+    now: Option<u64>,
+) -> Result<CheckpointReport, Error> {
+    let h = &env.header;
+    h.validate()?;
+    if trust.witnesses.len() != 4 || votes.len() > 4 {
+        return Err(Error::Quorum);
+    }
+    let mut identities = HashSet::new();
+    let mut ed_keys = HashSet::new();
+    let mut ml_keys = HashSet::new();
+    for witness in &trust.witnesses {
+        if !identities.insert(witness.id)
+            || !ed_keys.insert(witness.key.ed25519)
+            || !ml_keys.insert(keccak(&witness.key.mldsa))
+        {
+            return Err(Error::Quorum);
+        }
+    }
+    if h.anchor_chain_id != trust.chain_id
+        || h.anchor_genesis_hash != trust.genesis
+        || h.registry_address != trust.registry
+        || h.anchor_address != trust.anchor
+        || h.mmr_profile_digest != trust.mmr_profile_digest
+        || assessment.config_digest != trust.config_digest
+        || assessment.epoch != trust.epoch
+        || assessment.registry_code_hash != trust.registry_code_hash
+        || assessment.anchor_code_hash != trust.anchor_code_hash
+        || assessment.policy_catalog_digest != trust.policy_catalog_digest
+        || assessment.envelope_commitment != env.commitment()?
+        || assessment.keyset_digest != keyset.digest()?
+        || keyset.org_id != h.org_id
+        || keyset.version != h.keyset_version
+        || keccak(&keyset.key.ed25519) != h.ed25519_key_id
+        || keccak(&keyset.key.mldsa) != h.mldsa_key_id
+        || keyset.registered_block > assessment.first_anchored_block
+        || assessment.first_anchored_block > assessment.block_number
+        || assessment.previous_accepted_id != h.prev_checkpoint_id
+        || assessment.verified_properties != 0x3f
+        || assessment.block_hash == [0; 32]
+        || assessment.state_root == [0; 32]
+        || assessment.evidence_manifest_digest == [0; 32]
+    {
+        return Err(Error::Binding);
+    }
+    if keyset.valid_from > h.declared_signed_at
+        || h.declared_signed_at >= keyset.valid_until
+        || assessment.first_anchored_at < h.declared_signed_at
+        || assessment.first_anchored_at >= keyset.valid_until
+        || assessment.first_anchored_at > assessment.issued_at
+        || keyset
+            .revoked_at
+            .is_some_and(|t| assessment.first_anchored_at >= t)
+        || assessment.expires_at < assessment.issued_at
+        || assessment.expires_at - assessment.issued_at > 86400
+    {
+        return Err(Error::Time);
+    }
+    if let Some(now) = now {
+        if assessment.issued_at > now.saturating_add(300) {
+            return Err(Error::Time);
+        }
+    }
+    verify_hybrid(
+        &keyset.key,
+        &h.checkpoint_id()?,
+        &env.ed25519_signature,
+        &env.mldsa_signature,
+        MLDSA_CONTEXT,
+    )?;
+    let digest = assessment.digest(env)?;
+    let mut seen = HashSet::new();
+    for vote in votes {
+        if !seen.insert(vote.witness_id) {
+            return Err(Error::Quorum);
+        }
+        let witness = trust
+            .witnesses
+            .iter()
+            .find(|w| w.id == vote.witness_id)
+            .ok_or(Error::Quorum)?;
+        verify_hybrid(
+            &witness.key,
+            &digest,
+            &vote.ed25519_signature,
+            &vote.mldsa_signature,
+            ATTEST_CONTEXT,
+        )?;
+    }
+    if seen.len() < 3 {
+        return Err(Error::Quorum);
+    }
+    Ok(CheckpointReport {
+        checkpoint_id: h.checkpoint_id()?,
+        reference_block: assessment.block_number,
+        fresh: now.map(|n| n >= assessment.issued_at && n < assessment.expires_at),
+        coverage_complete: assessment.gaps == 0
+            && assessment.expected_events == assessment.present_events,
+        trust_mode: "TRUSTED_ATTESTATION",
+    })
+}
diff --git a/arkhe/protocol/tests/rbb_protocol.rs b/arkhe/protocol/tests/rbb_protocol.rs
new file mode 100644
index 0000000..488ca39
--- /dev/null
+++ b/arkhe/protocol/tests/rbb_protocol.rs
@@ -0,0 +1,175 @@
+use arkhe_rbb_core::rbb::{self, mmr, Envelope, Error, Header};
+use serde_json::Value;
+
+fn vector() -> Value {
+    serde_json::from_str(include_str!(
+        "../../fixtures/protocol-v3.json"
+    ))
+    .unwrap()
+}
+fn header() -> Header {
+    serde_json::from_value(vector()["header"].clone()).unwrap()
+}
+fn envelope() -> Envelope {
+    Envelope {
+        header: header(),
+        ed25519_signature: vec![0x55; 64],
+        mldsa_signature: vec![0xaa; 2420],
+    }
+}
+
+#[test]
+fn python_abi_keccak_and_rust_match_byte_for_byte() {
+    let v = vector();
+    let h = header();
+    let e = envelope();
+    assert_eq!(
+        hex::encode(h.encode().unwrap()),
+        v["header_abi_hex"].as_str().unwrap()
+    );
+    assert_eq!(
+        hex::encode(h.checkpoint_id().unwrap()),
+        v["checkpoint_id_hex"].as_str().unwrap()
+    );
+    assert_eq!(
+        hex::encode(e.encode().unwrap()),
+        v["envelope_abi_hex"].as_str().unwrap()
+    );
+    assert_eq!(
+        hex::encode(e.commitment().unwrap()),
+        v["envelope_commitment_hex"].as_str().unwrap()
+    );
+    assert_eq!(Header::decode(&h.encode().unwrap()).unwrap(), h);
+    assert_eq!(Envelope::decode(&e.encode().unwrap()).unwrap(), e);
+}
+
+#[test]
+fn rejects_padding_offsets_trailing_data_and_oversized_input() {
+    let raw = envelope().encode().unwrap();
+    for i in [0, 32, 4 * 32, 24 * 32, 864, 896, 928, 1024, 3487] {
+        let mut bad = raw.clone();
+        bad[i] ^= 0x80;
+        assert!(Envelope::decode(&bad).is_err(), "byte {i}");
+    }
+    let mut extra = raw.clone();
+    extra.push(0);
+    assert_eq!(Envelope::decode(&extra), Err(Error::NonCanonical));
+    assert!(Envelope::decode(&raw[..raw.len() - 1]).is_err());
+    assert!(Header::decode(&vec![0; 1_000_000]).is_err());
+}
+
+#[test]
+fn rejects_invalid_intervals_flags_algorithms_and_zero_identifiers() {
+    let mut bad = header();
+    bad.first_leaf_index = u64::MAX;
+    bad.batch_leaf_count = 2;
+    assert!(bad.validate().is_err());
+    let mut bad = header();
+    bad.sequence = 0;
+    assert!(bad.validate().is_err());
+    let mut bad = header();
+    bad.prev_present = true;
+    assert!(bad.validate().is_err());
+    let mut bad = header();
+    bad.source_kind = 2;
+    assert!(bad.validate().is_err());
+    let mut bad = header();
+    bad.profile_id = 4;
+    assert_eq!(bad.validate(), Err(Error::Profile));
+    let mut bad = header();
+    bad.ed25519_key_id = [0; 32];
+    assert!(bad.validate().is_err());
+    let mut bad = envelope();
+    bad.mldsa_signature.pop();
+    assert_eq!(bad.encode(), Err(Error::SignatureLength));
+}
+
+#[test]
+fn identity_changes_with_every_header_word_and_is_independent_of_signature_randomness() {
+    let h = header();
+    let raw = h.encode().unwrap();
+    let id = h.checkpoint_id().unwrap();
+    for word in 0..27 {
+        let mut altered = raw.clone();
+        altered[word * 32 + 31] ^= 1;
+        if let Ok(changed) = Header::decode(&altered) {
+            assert_ne!(changed.checkpoint_id().unwrap(), id);
+        }
+    }
+    let e = envelope();
+    let mut changed = e.clone();
+    changed.mldsa_signature[0] ^= 1;
+    assert_eq!(changed.header.checkpoint_id().unwrap(), id);
+    assert_ne!(changed.commitment().unwrap(), e.commitment().unwrap());
+    assert_ne!(rbb::keccak(b"a"), rbb::keccak(b"b"));
+}
+
+#[test]
+fn mmr_matches_independent_python_and_checks_every_position() {
+    let v = vector();
+    for item in v["mmr"].as_array().unwrap() {
+        let n = item["count"].as_u64().unwrap() as usize;
+        let records: Vec<_> = (0..n).map(|i| [(i + 1) as u8; 32]).collect();
+        let mut frontier = mmr::Frontier::default();
+        for (i, r) in records.iter().enumerate() {
+            assert_eq!(frontier.append(r).unwrap(), i as u64);
+        }
+        let root = frontier.root().unwrap();
+        assert_eq!(hex::encode(root), item["root_hex"].as_str().unwrap());
+        for (i, r) in records.iter().enumerate() {
+            let proof = mmr::prove(&records, i).unwrap();
+            mmr::verify(r, &proof, n as u64, &root).unwrap();
+            let mut bad = proof.clone();
+            bad.leaf_count += 1;
+            assert!(mmr::verify(r, &bad, n as u64, &root).is_err());
+            let mut bad = proof.clone();
+            bad.siblings.push([0; 32]);
+            assert!(mmr::verify(r, &bad, n as u64, &root).is_err());
+            let mut bad = proof.clone();
+            bad.other_peaks.push([0; 32]);
+            assert!(mmr::verify(r, &bad, n as u64, &root).is_err());
+            assert!(mmr::verify(&[255; 32], &proof, n as u64, &root).is_err());
+        }
+    }
+}
+
+#[test]
+fn mmr_extension_requires_authenticated_previous_frontier_and_exact_count() {
+    let records: Vec<_> = (1..=13).map(|i| [i; 32]).collect();
+    let mut previous = mmr::Frontier::default();
+    for r in &records[..5] {
+        previous.append(r).unwrap();
+    }
+    let old = previous.root().unwrap();
+    let mut next = previous.clone();
+    for r in &records[5..] {
+        next.append(r).unwrap();
+    }
+    mmr::verify_extension(&previous, &old, &records[5..], 13, &next.root().unwrap()).unwrap();
+    assert!(mmr::verify_extension(
+        &previous,
+        &[0; 32],
+        &records[5..],
+        13,
+        &next.root().unwrap()
+    )
+    .is_err());
+    assert!(
+        mmr::verify_extension(&previous, &old, &records[5..], 12, &next.root().unwrap()).is_err()
+    );
+    let mut invalid = previous.clone();
+    invalid.peaks.clear();
+    assert!(invalid.append(&[0; 32]).is_err());
+    let mut max = mmr::Frontier {
+        count: u64::MAX,
+        peaks: vec![[1; 32]; 64],
+    };
+    assert_eq!(max.append(&[2; 32]), Err(Error::ResourceLimit));
+}
+
+proptest::proptest! {
+    #[test]
+    fn arbitrary_bytes_do_not_panic(raw in proptest::collection::vec(proptest::num::u8::ANY, 0..4000)) {
+        let _=Header::decode(&raw); let _=Envelope::decode(&raw);
+    }
+}
diff --git a/arkhe/protocol/tests/rbb_trust.rs b/arkhe/protocol/tests/rbb_trust.rs
new file mode 100644
index 0000000..e090f0a
--- /dev/null
+++ b/arkhe/protocol/tests/rbb_trust.rs
@@ -0,0 +1,296 @@
+#![cfg(feature = "rbb-pqc")]
+use arkhe_rbb_core::rbb::trust::*;
+use arkhe_rbb_core::rbb::{keccak, mmr, Envelope, Error, Header, MLDSA_CONTEXT};
+use ed25519_dalek::{Signer as _, SigningKey};
+use fips204::{
+    ml_dsa_44,
+    traits::{KeyGen, SerDes, Signer as _},
+};
+
+fn material(seed: u8) -> (HybridKey, SigningKey, ml_dsa_44::PrivateKey) {
+    let ed = SigningKey::from_bytes(&[seed; 32]);
+    let (pk, sk) = ml_dsa_44::KG::keygen_from_seed(&[seed; 32]);
+    (
+        HybridKey {
+            ed25519: ed.verifying_key().to_bytes(),
+            mldsa: pk.into_bytes().to_vec(),
+        },
+        ed,
+        sk,
+    )
+}
+fn signatures(seed: u8, digest: &[u8; 32], context: &[u8]) -> (Vec<u8>, Vec<u8>) {
+    let (_, ed, ml) = material(seed);
+    (
+        ed.sign(digest).to_bytes().to_vec(),
+        ml.try_sign_with_seed(&[seed.wrapping_add(1); 32], digest, context)
+            .unwrap()
+            .to_vec(),
+    )
+}
+fn votes(a: &Assessment, e: &Envelope) -> Vec<Vote> {
+    (10..14)
+        .map(|seed| {
+            let (ed, ml) = signatures(seed, &a.digest(e).unwrap(), ATTEST_CONTEXT);
+            Vote {
+                witness_id: [seed; 32],
+                ed25519_signature: ed,
+                mldsa_signature: ml,
+            }
+        })
+        .collect()
+}
+fn fixture() -> (Envelope, Keyset, Assessment, Vec<Vote>, Trust) {
+    let raw: serde_json::Value = serde_json::from_str(include_str!(
+        "../../fixtures/protocol-v3.json"
+    ))
+    .unwrap();
+    let mut header: Header = serde_json::from_value(raw["header"].clone()).unwrap();
+    let (key, _, _) = material(7);
+    header.ed25519_key_id = keccak(&key.ed25519);
+    header.mldsa_key_id = keccak(&key.mldsa);
+    let (ed, ml) = signatures(7, &header.checkpoint_id().unwrap(), MLDSA_CONTEXT);
+    let env = Envelope {
+        header: header.clone(),
+        ed25519_signature: ed,
+        mldsa_signature: ml,
+    };
+    let keys = Keyset {
+        org_id: header.org_id,
+        version: 1,
+        key,
+        registered_block: 2,
+        valid_from: 1600000000,
+        valid_until: 1900000000,
+        revoked_at: None,
+    };
+    let trust = Trust {
+        config_digest: [42; 32],
+        epoch: 1,
+        chain_id: header.anchor_chain_id,
+        genesis: header.anchor_genesis_hash,
+        registry: header.registry_address,
+        anchor: header.anchor_address,
+        registry_code_hash: [1; 32],
+        anchor_code_hash: [2; 32],
+        policy_catalog_digest: [3; 32],
+        mmr_profile_digest: mmr::profile_digest(),
+        witnesses: (10..14)
+            .map(|seed| Witness {
+                id: [seed; 32],
+                key: material(seed).0,
+            })
+            .collect(),
+    };
+    let assessment = Assessment {
+        config_digest: trust.config_digest,
+        epoch: 1,
+        block_number: 100,
+        block_hash: [4; 32],
+        state_root: [5; 32],
+        registry_code_hash: trust.registry_code_hash,
+        anchor_code_hash: trust.anchor_code_hash,
+        envelope_commitment: env.commitment().unwrap(),
+        evidence_manifest_digest: [6; 32],
+        keyset_digest: keys.digest().unwrap(),
+        policy_catalog_digest: trust.policy_catalog_digest,
+        watermark: 1,
+        expected_events: 1,
+        present_events: 1,
+        gaps: 0,
+        verified_properties: 0x3f,
+        issued_at: 1700000100,
+        expires_at: 1700003700,
+        first_anchored_at: 1700000050,
+        first_anchored_block: 50,
+        previous_accepted_id: [0; 32],
+    };
+    let v = votes(&assessment, &env);
+    (env, keys, assessment, v, trust)
+}
+
+#[test]
+fn real_ed25519_and_mldsa44_verify_three_of_four_pinned_witnesses() {
+    let (e, k, a, v, t) = fixture();
+    let report = verify_attested_checkpoint(&e, &k, &a, &v[..3], &t, Some(1700000200)).unwrap();
+    assert_eq!(report.fresh, Some(true));
+    assert!(report.coverage_complete);
+    assert_eq!(report.trust_mode, "TRUSTED_ATTESTATION");
+    assert_eq!(report.reference_block, 100);
+}
+
+#[test]
+fn two_votes_duplicate_votes_unknown_signers_and_reused_keys_do_not_form_quorum() {
+    let (e, k, a, v, t) = fixture();
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &a, &v[..2], &t, None),
+        Err(Error::Quorum)
+    );
+    let duplicate = vec![v[0].clone(), v[0].clone(), v[1].clone()];
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &a, &duplicate, &t, None),
+        Err(Error::Quorum)
+    );
+    let mut unknown = v[..3].to_vec();
+    unknown[2].witness_id = [99; 32];
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &a, &unknown, &t, None),
+        Err(Error::Quorum)
+    );
+    let mut same = t.clone();
+    same.witnesses[3].key = same.witnesses[0].key.clone();
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &a, &v[..3], &same, None),
+        Err(Error::Quorum)
+    );
+}
+
+#[test]
+fn valid_attestation_cannot_be_reused_with_altered_snapshot_or_assessment() {
+    let (e, k, a, v, t) = fixture();
+    let mut forged = k.clone();
+    forged.valid_until += 1;
+    assert_eq!(
+        verify_attested_checkpoint(&e, &forged, &a, &v[..3], &t, None),
+        Err(Error::Binding)
+    );
+    let mut forged = a.clone();
+    forged.block_hash = [99; 32];
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &forged, &v[..3], &t, None),
+        Err(Error::Signature)
+    );
+    let mut forged = a.clone();
+    forged.epoch += 1;
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &forged, &v[..3], &t, None),
+        Err(Error::Binding)
+    );
+    let mut changed = e.clone();
+    changed.header.org_id = [99; 32];
+    assert_eq!(
+        verify_attested_checkpoint(&changed, &k, &a, &v[..3], &t, None),
+        Err(Error::Binding)
+    );
+}
+
+#[test]
+fn attackers_self_signed_keyset_and_votes_do_not_replace_external_trust() {
+    let (mut e, mut k, mut a, _, t) = fixture();
+    k.key = material(99).0;
+    e.header.ed25519_key_id = keccak(&k.key.ed25519);
+    e.header.mldsa_key_id = keccak(&k.key.mldsa);
+    let (ed, ml) = signatures(99, &e.header.checkpoint_id().unwrap(), MLDSA_CONTEXT);
+    e.ed25519_signature = ed;
+    e.mldsa_signature = ml;
+    a.keyset_digest = k.digest().unwrap();
+    a.envelope_commitment = e.commitment().unwrap();
+    let (ed, ml) = signatures(99, &a.digest(&e).unwrap(), ATTEST_CONTEXT);
+    let attacker = Vote {
+        witness_id: [99; 32],
+        ed25519_signature: ed,
+        mldsa_signature: ml,
+    };
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &a, &[attacker], &t, None),
+        Err(Error::Quorum)
+    );
+}
+
+#[test]
+fn hybrid_requires_both_signatures_and_the_exact_mldsa_context() {
+    let (e, k, _, _, _) = fixture();
+    let id = e.header.checkpoint_id().unwrap();
+    let mut ed = e.ed25519_signature.clone();
+    ed[0] ^= 1;
+    assert_eq!(
+        verify_hybrid(&k.key, &id, &ed, &e.mldsa_signature, MLDSA_CONTEXT),
+        Err(Error::Signature)
+    );
+    let mut ml = e.mldsa_signature.clone();
+    ml[100] ^= 1;
+    assert_eq!(
+        verify_hybrid(&k.key, &id, &e.ed25519_signature, &ml, MLDSA_CONTEXT),
+        Err(Error::Signature)
+    );
+    assert_eq!(
+        verify_hybrid(
+            &k.key,
+            &id,
+            &e.ed25519_signature,
+            &e.mldsa_signature,
+            ATTEST_CONTEXT
+        ),
+        Err(Error::Signature)
+    );
+    assert_eq!(
+        verify_hybrid(
+            &k.key,
+            &id,
+            &e.ed25519_signature,
+            &e.mldsa_signature[..5],
+            MLDSA_CONTEXT
+        ),
+        Err(Error::SignatureLength)
+    );
+}
+
+#[test]
+fn revocation_and_registration_block_prevent_backdated_acceptance() {
+    let (e, mut k, mut a, _, t) = fixture();
+    k.revoked_at = Some(1700000025);
+    a.keyset_digest = k.digest().unwrap();
+    let v = votes(&a, &e);
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &a, &v[..3], &t, None),
+        Err(Error::Time)
+    );
+    k.revoked_at = None;
+    k.registered_block = 51;
+    a.keyset_digest = k.digest().unwrap();
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &a, &v[..3], &t, None),
+        Err(Error::Binding)
+    );
+}
+
+#[test]
+fn offline_and_stale_attestations_do_not_claim_current_freshness() {
+    let (e, k, a, v, t) = fixture();
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &a, &v[..3], &t, None)
+            .unwrap()
+            .fresh,
+        None
+    );
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &a, &v[..3], &t, Some(a.expires_at))
+            .unwrap()
+            .fresh,
+        Some(false)
+    );
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &a, &v[..3], &t, Some(a.issued_at - 301)),
+        Err(Error::Time)
+    );
+    let mut changed = a.clone();
+    changed.expires_at = changed.issued_at + 86401;
+    assert_eq!(
+        verify_attested_checkpoint(&e, &k, &changed, &v[..3], &t, None),
+        Err(Error::Time)
+    );
+}
+
+#[test]
+fn coverage_gaps_are_reported_separately_from_checkpoint_authenticity() {
+    let (e, k, mut a, _, t) = fixture();
+    a.gaps = 1;
+    a.expected_events = 2;
+    let v = votes(&a, &e);
+    assert!(
+        !verify_attested_checkpoint(&e, &k, &a, &v[..3], &t, None)
+            .unwrap()
+            .coverage_complete
+    );
+    assert_eq!(a.canonical_cbor(&e).unwrap()[0], 0xae);
+}
diff --git a/arkhe/python/reference_vectors.py b/arkhe/python/reference_vectors.py
new file mode 100644
index 0000000..4cf0859
--- /dev/null
+++ b/arkhe/python/reference_vectors.py
@@ -0,0 +1,73 @@
+"""Independent eth-abi/PyCryptodome/BLAKE3 oracle; fixed public test data only."""
+from pathlib import Path
+import argparse
+import json
+import eth_abi
+from Crypto.Hash import keccak
+import blake3
+
+ROOT = Path(__file__).resolve().parents[1]
+FIELDS = [
+    ('protocol_version','uint8'), ('profile_id','uint16'), ('anchor_chain_id','uint256'),
+    ('anchor_genesis_hash','bytes32'), ('registry_address','address'), ('anchor_address','address'),
+    ('org_id','bytes32'), ('power','uint8'), ('stream_id','bytes32'), ('sequence','uint64'),
+    ('prev_checkpoint_id','bytes32'), ('first_leaf_index','uint64'), ('batch_leaf_count','uint64'),
+    ('total_leaf_count','uint64'), ('mmr_root','bytes32'), ('batch_manifest_digest','bytes32'),
+    ('policy_digest','bytes32'), ('declared_signed_at','uint64'), ('source_kind','uint8'),
+    ('source_network_id','bytes32'), ('source_manifest_digest','bytes32'),
+    ('ed25519_key_id','bytes32'), ('mldsa_key_id','bytes32'), ('keyset_version','uint64'),
+    ('prev_present','bool'), ('source_manifest_present','bool'), ('mmr_profile_digest','bytes32'),
+]
+HEADER_TYPE = '(' + ','.join(t for _, t in FIELDS) + ')'
+def k(data):
+    h = keccak.new(digest_bits=256); h.update(data); return h.digest()
+def h(domain, *parts):
+    return blake3.blake3(domain + b''.join(parts)).digest()
+def build_mmr(records):
+    peaks = []
+    for index, record in enumerate(records):
+        current = h(b'AKG:MMR:LEAF:v3\0', index.to_bytes(8,'big'), record)
+        height = 0
+        while peaks and peaks[-1][0] == height:
+            current = h(b'AKG:MMR:NODE:v3\0', peaks.pop()[1], current); height += 1
+        peaks.append((height,current))
+    bag = peaks[-1][1]
+    for _, peak in reversed(peaks[:-1]): bag = h(b'AKG:MMR:BAG:v3\0', peak, bag)
+    return h(b'AKG:MMR:ROOT:v3\0', len(records).to_bytes(8,'big'), bag)
+def vectors():
+    profile = blake3.blake3(b'arkhe-rbb-mmr-v3:blake3-256;leaf=index-u64be+record32;node=left+right;bag=right-fold;root=count-u64be+bag;domains=AKG:MMR:{LEAF,NODE,BAG,ROOT}:v3:NUL').digest()
+    header = {}
+    for i, (name, typ) in enumerate(FIELDS):
+        if typ == 'bytes32': header[name] = bytes([i+1])*32
+        elif typ == 'address': header[name] = bytes([i+1])*20
+        elif typ == 'bool': header[name] = False
+        else: header[name] = 1
+    header.update(protocol_version=3, profile_id=1, anchor_chain_id=1337,
+        prev_checkpoint_id=bytes(32), first_leaf_index=0, batch_leaf_count=1,
+        total_leaf_count=1, declared_signed_at=1700000000, source_manifest_digest=bytes(32),
+        source_kind=1, mmr_profile_digest=profile)
+    value = tuple(header[name] for name,_ in FIELDS)
+    raw = eth_abi.encode([HEADER_TYPE], [value])
+    domain = k(b'AKG:CHECKPOINT:HEADER:v3\0')
+    envelope = eth_abi.encode([HEADER_TYPE,'bytes','bytes'], [value, bytes([0x55])*64, bytes([0xaa])*2420])
+    assert len(raw) == 864 and len(envelope) == 3488
+    decoded = eth_abi.decode([HEADER_TYPE,'bytes','bytes'], envelope)
+    assert eth_abi.encode([HEADER_TYPE,'bytes','bytes'], decoded) == envelope
+    serialized = {name: list(v) if isinstance(v,bytes) else v for name,v in header.items()}
+    serialized['anchor_chain_id'] = list((1337).to_bytes(32,'big'))
+    mmr = [{'count':n, 'root_hex':build_mmr([bytes([i+1])*32 for i in range(n)]).hex()} for n in [1,2,3,5,7,8,9,13]]
+    return {'format':'arkhe-evidence/3-candidate-rev2', 'fixture_only':True,
+        'header':serialized, 'abi_types':[t for _,t in FIELDS],
+        'header_abi_hex':raw.hex(), 'checkpoint_id_hex':k(domain+raw).hex(),
+        'envelope_abi_hex':envelope.hex(), 'envelope_commitment_hex':k(envelope).hex(),
+        'mmr_profile_digest_hex':profile.hex(), 'mmr':mmr}
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(); parser.add_argument('--write',action='store_true'); args=parser.parse_args()
+    path = ROOT/'fixtures'/'protocol-v3.json'; actual=vectors()
+    if args.write:
+        path.parent.mkdir(parents=True,exist_ok=True)
+        path.write_text(json.dumps(actual,indent=2)+'\n',encoding='utf-8')
+    else:
+        assert json.loads(path.read_text(encoding='utf-8')) == actual, 'reference vector mismatch'
+    print('PASS: independent Python ABI, Keccak and eight MMR reference vectors')
