{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic citation predictions",
  "type": "array",
  "maxItems": 36,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "label"],
    "properties": {
      "id": {"type": "string", "pattern": "^C[0-9]{3}$"},
      "label": {"enum": ["SUPPORTED", "CONTRADICTED", "INSUFFICIENT", "ABSTAIN"]}
    }
  }
}
