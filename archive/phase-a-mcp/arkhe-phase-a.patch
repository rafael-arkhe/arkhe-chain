diff -ruN a/crates/arkhe-provenance-mcp/src/tools/provenance.rs b/crates/arkhe-provenance-mcp/src/tools/provenance.rs
--- a/crates/arkhe-provenance-mcp/src/tools/provenance.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/arkhe-provenance-mcp/src/tools/provenance.rs	2026-10-13 10:52:17.442674593 +0000
@@ -0,0 +1,123 @@
+use crate::{metering::UsageEvent, preflight::VerifyProvenanceArgs, server::ArkheMcp};
+use chrono::Utc;
+use rmcp::{
+    handler::server::wrapper::Parameters,
+    model::{CallToolResult, ContentBlock},
+    ErrorData as McpError,
+};
+use serde_json::json;
+use std::time::Instant;
+use uuid::Uuid;
+
+impl ArkheMcp {
+    pub(crate) async fn verify_provenance_impl(
+        &self,
+        Parameters(args): Parameters<VerifyProvenanceArgs>,
+    ) -> Result<CallToolResult, McpError> {
+        if args.tenant_id.trim().is_empty() || args.idempotency_key.trim().is_empty() {
+            return Err(McpError::invalid_params(
+                "tenant_id and idempotency_key are required",
+                None,
+            ));
+        }
+
+        match self
+            .usage
+            .seen_idempotency_key(&args.tenant_id, &args.idempotency_key)
+            .await
+        {
+            Ok(Some(existing)) => {
+                return Ok(CallToolResult::error(vec![ContentBlock::text(format!(
+                    "idempotency key already used; original request_id={existing}"
+                ))]));
+            }
+            Ok(None) => {}
+            Err(e) => {
+                tracing::error!(error = ?e, "usage ledger lookup failed");
+                return Ok(CallToolResult::error(vec![ContentBlock::text(
+                    "metering unavailable; request rejected fail-closed",
+                )]));
+            }
+        }
+
+        let started_at = Utc::now();
+        let timer = Instant::now();
+        let input_bytes = serde_json::to_vec(&args).map(|v| v.len()).unwrap_or(0) as i64;
+        let request_id = Uuid::new_v4();
+
+        let outcome = self.preflight.verify(&args).await;
+        let (tool_result, result_label, verification_level, evidence_hash, bytes_out, metadata) =
+            match outcome {
+                Ok(verified) => {
+                    let evidence = verified.evidence;
+                    let verification_level = if evidence.result == "PASS" {
+                        Some(if evidence.mode == "release" {
+                            "release_verified".to_owned()
+                        } else {
+                            "sanity_valid".to_owned()
+                        })
+                    } else {
+                        Some("verification_failed".to_owned())
+                    };
+                    let text = serde_json::to_string_pretty(&evidence)
+                        .unwrap_or_else(|_| "{\"result\":\"FAIL\"}".to_owned());
+                    (
+                        CallToolResult::success(vec![ContentBlock::text(text)]),
+                        evidence.result.clone(),
+                        verification_level,
+                        Some(verified.wire_sha256),
+                        verified.wire_len as i64,
+                        json!({
+                            "mode": evidence.mode,
+                            "verifier_version": evidence.verifier_version,
+                            "verifier_sha256": evidence.verifier_sha256,
+                            "hard_failures": evidence.hard_failures,
+                            "onchain_write": false,
+                            "solana_tx_count": 0
+                        }),
+                    )
+                }
+                Err(e) => {
+                    let message = format!("provenance verification failed to execute: {e}");
+                    (
+                        CallToolResult::error(vec![ContentBlock::text(message.clone())]),
+                        "ERROR".to_owned(),
+                        None,
+                        None,
+                        message.len() as i64,
+                        json!({"error": e.to_string()}),
+                    )
+                }
+            };
+
+        let event = UsageEvent {
+            request_id,
+            idempotency_key: args.idempotency_key,
+            tenant_id: args.tenant_id,
+            tool: "verify_provenance".to_owned(),
+            price_book_version: self.usage.price_book_version().to_owned(),
+            pricing_rule_id: "phase-a-free-verify-provenance-v1".to_owned(),
+            sol_price_usd_at_event: self.config.sol_price_usd.clone(),
+            started_at,
+            duration_ms: timer.elapsed().as_millis().min(i64::MAX as u128) as i64,
+            bytes_in: input_bytes,
+            bytes_out,
+            result: result_label,
+            verification_level,
+            estimated_cost_usd: self.config.verify_cost_usd.clone(),
+            billable_units: 1,
+            billable_amount_usd: "0".to_owned(),
+            evidence_hash,
+            metadata,
+        };
+
+        if let Err(e) = self.usage.append(&event).await {
+            tracing::error!(error = ?e, request_id = %request_id, "usage ledger append failed");
+            return Ok(CallToolResult::error(vec![ContentBlock::text(
+                "verification completed but metering commit failed; response withheld fail-closed",
+            )]));
+        }
+
+        Ok(tool_result)
+    }
+}
diff -ruN a/crates/arkhe-provenance-mcp/src/tools/royalty.rs b/crates/arkhe-provenance-mcp/src/tools/royalty.rs
--- a/crates/arkhe-provenance-mcp/src/tools/royalty.rs	2026-10-13 10:53:23.616693477 +0000
+++ b/crates/arkhe-provenance-mcp/src/tools/royalty.rs	2026-10-13 10:48:38.550873905 +0000
@@ -0,0 +1,108 @@
+use crate::{metering::UsageEvent, royalty::RoyaltyStatusArgs, server::ArkheMcp};
+use chrono::Utc;
+use rmcp::{
+    handler::server::wrapper::Parameters,
+    model::{CallToolResult, ContentBlock},
+    ErrorData as McpError,
+};
+use serde_json::json;
+use sha2::{Digest, Sha256};
+use std::time::Instant;
+use uuid::Uuid;
+
+impl ArkheMcp {
+    pub(crate) async fn get_royalty_status_impl(
+        &self,
+        Parameters(args): Parameters<RoyaltyStatusArgs>,
+    ) -> Result<CallToolResult, McpError> {
+        if args.tenant_id.trim().is_empty()
+            || args.idempotency_key.trim().is_empty()
+            || args.work_id.trim().is_empty()
+        {
+            return Err(McpError::invalid_params(
+                "tenant_id, idempotency_key, and work_id are required",
+                None,
+            ));
+        }
+
+        match self
+            .usage
+            .seen_idempotency_key(&args.tenant_id, &args.idempotency_key)
+            .await
+        {
+            Ok(Some(existing)) => {
+                return Ok(CallToolResult::error(vec![ContentBlock::text(format!(
+                    "idempotency key already used; original request_id={existing}"
+                ))]));
+            }
+            Ok(None) => {}
+            Err(e) => {
+                tracing::error!(error = ?e, "usage ledger lookup failed");
+                return Ok(CallToolResult::error(vec![ContentBlock::text(
+                    "metering unavailable; request rejected fail-closed",
+                )]));
+            }
+        }
+
+        let started_at = Utc::now();
+        let timer = Instant::now();
+        let input_bytes = serde_json::to_vec(&args).map(|v| v.len()).unwrap_or(0) as i64;
+        let request_id = Uuid::new_v4();
+
+        let outcome = self.royalties.get(&args.work_id).await;
+        let (tool_result, result_label, evidence_hash, bytes_out, metadata) = match outcome {
+            Ok(status) => {
+                let body = serde_json::to_vec(&status).unwrap_or_default();
+                let evidence_hash = hex::encode(Sha256::digest(&body));
+                let text = serde_json::to_string_pretty(&status).unwrap_or_else(|_| "{}".into());
+                (
+                    CallToolResult::success(vec![ContentBlock::text(text)]),
+                    if status.found { "FOUND" } else { "NOT_FOUND" }.to_owned(),
+                    Some(evidence_hash),
+                    body.len() as i64,
+                    json!({"found": status.found}),
+                )
+            }
+            Err(e) => {
+                let message = format!("royalty lookup failed: {e}");
+                (
+                    CallToolResult::error(vec![ContentBlock::text(message.clone())]),
+                    "ERROR".to_owned(),
+                    None,
+                    message.len() as i64,
+                    json!({"error": e.to_string()}),
+                )
+            }
+        };
+
+        let event = UsageEvent {
+            request_id,
+            idempotency_key: args.idempotency_key,
+            tenant_id: args.tenant_id,
+            tool: "get_royalty_status".to_owned(),
+            price_book_version: self.usage.price_book_version().to_owned(),
+            pricing_rule_id: "phase-a-free-royalty-status-v1".to_owned(),
+            sol_price_usd_at_event: self.config.sol_price_usd.clone(),
+            started_at,
+            duration_ms: timer.elapsed().as_millis().min(i64::MAX as u128) as i64,
+            bytes_in: input_bytes,
+            bytes_out,
+            result: result_label,
+            verification_level: None,
+            estimated_cost_usd: self.config.royalty_lookup_cost_usd.clone(),
+            billable_units: 1,
+            billable_amount_usd: "0".to_owned(),
+            evidence_hash,
+            metadata,
+        };
+
+        if let Err(e) = self.usage.append(&event).await {
+            tracing::error!(error = ?e, request_id = %request_id, "usage ledger append failed");
+            return Ok(CallToolResult::error(vec![ContentBlock::text(
+                "lookup completed but metering commit failed; response withheld fail-closed",
+            )]));
+        }
+
+        Ok(tool_result)
+    }
+}
diff -ruN a/database/migrations/003_phase_a_metering.sql b/database/migrations/003_phase_a_metering.sql
--- a/database/migrations/003_phase_a_metering.sql	1970-01-01 00:00:00.000000000 +0000
+++ b/database/migrations/003_phase_a_metering.sql	2026-10-13 10:52:17.442898921 +0000
@@ -0,0 +1,60 @@
+-- Phase A: append-only usage ledger + read-only royalty status projection.
+-- No billing or payment mutation is introduced in this migration.
+
+CREATE TABLE IF NOT EXISTS usage_events (
+    request_id UUID PRIMARY KEY,
+    idempotency_key TEXT NOT NULL,
+    tenant_id TEXT NOT NULL,
+    tool TEXT NOT NULL,
+    price_book_version TEXT NOT NULL,
+    pricing_rule_id TEXT NOT NULL,
+    sol_price_usd_at_event NUMERIC(20, 8),
+    started_at TIMESTAMPTZ NOT NULL,
+    duration_ms BIGINT NOT NULL CHECK (duration_ms >= 0),
+    bytes_in BIGINT NOT NULL CHECK (bytes_in >= 0),
+    bytes_out BIGINT NOT NULL CHECK (bytes_out >= 0),
+    result TEXT NOT NULL,
+    verification_level TEXT,
+    estimated_cost_usd NUMERIC(20, 10) CHECK (estimated_cost_usd IS NULL OR estimated_cost_usd >= 0),
+    billable_units BIGINT NOT NULL CHECK (billable_units >= 0),
+    billable_amount_usd NUMERIC(20, 10) NOT NULL CHECK (billable_amount_usd >= 0),
+    evidence_hash TEXT,
+    metadata JSONB NOT NULL DEFAULT '{}'::jsonb,
+    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    CONSTRAINT usage_events_idempotency UNIQUE (tenant_id, idempotency_key),
+    CONSTRAINT usage_events_evidence_hash_format CHECK (
+        evidence_hash IS NULL OR evidence_hash ~ '^[0-9a-f]{64}$'
+    )
+);
+
+CREATE INDEX IF NOT EXISTS idx_usage_events_tenant_started
+    ON usage_events (tenant_id, started_at DESC);
+CREATE INDEX IF NOT EXISTS idx_usage_events_tool_started
+    ON usage_events (tool, started_at DESC);
+
+CREATE OR REPLACE FUNCTION arkhe_reject_usage_event_mutation()
+RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    RAISE EXCEPTION 'usage_events is append-only';
+END;
+$$;
+
+DROP TRIGGER IF EXISTS usage_events_no_update ON usage_events;
+CREATE TRIGGER usage_events_no_update
+BEFORE UPDATE ON usage_events
+FOR EACH ROW EXECUTE FUNCTION arkhe_reject_usage_event_mutation();
+
+DROP TRIGGER IF EXISTS usage_events_no_delete ON usage_events;
+CREATE TRIGGER usage_events_no_delete
+BEFORE DELETE ON usage_events
+FOR EACH ROW EXECUTE FUNCTION arkhe_reject_usage_event_mutation();
+
+-- Projection populated by the existing/future indexer. The MCP tool is read-only.
+CREATE TABLE IF NOT EXISTS royalty_status (
+    work_uuid UUID PRIMARY KEY REFERENCES works(uuid) ON DELETE RESTRICT,
+    state TEXT NOT NULL CHECK (state IN ('unknown', 'registered', 'claimable', 'settled', 'disputed', 'frozen')),
+    split JSONB,
+    currency TEXT,
+    source TEXT NOT NULL DEFAULT 'indexer',
+    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
