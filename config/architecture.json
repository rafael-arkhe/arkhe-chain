  "unpinned_client": {
    "path": "models/pins/unpinned.toml",
    "id": "unpinned",
    "snapshot": "",
    "weights_in_git": false,
    "may_sign": false,
    "authority": false
  },
  "eval_task": {
    "path": "eval/tasks/none.json",
    "id": "none",
    "frozen": false,
    "human_hours": null,
    "write_set_excludes": ["eval/tasks", "eval/verifiers"]
  },
  "formal_proof": {
    "path": "formal/proof/NONE",
    "must_contain": "No checker has accepted the hardware bridge"
  },
  "receipt": {
    "file": "orchestration/arkhe-runtime/src/lib.rs",
    "function": "commit_proposed_work",
    "forbids": ["Command", "std::process", "tokio::process", "arkhe_barrier", "arkhe_gate", "arkhe_state"]
  },
  "unwired_sources": {
    "trees": ["kernel/arkhe-kernel/src", "kernel/arkhe-core/src", "governance/arkhe-governance/src"],
    "forbids": ["arkhe_barrier", "arkhe_gate", "arkhe_state"]
  },
  "process_launch": {
    "tree": "orchestration/arkhe-runtime/src",
    "token": "Command::new",
    "allowed": ["orchestration/arkhe-runtime/src/preview/executor.rs"]
  },
  "event_decision": {
    "file": "kernel/arkhe-kernel/src/lib.rs",
    "function": "decide_event",
    "requires": ["reason == DecisionReason::RuleAllowed", "Decision::Allow", "Decision::Reject", "self.emergency_stop"]
  },
  "authorization_allow": {
    "file": "kernel/arkhe-kernel/src/lib.rs",
    "function": "authorize_checked_with_proof",
    "construct": "AuthorizationDecision::Allow {"
  },
  "emergency_stop": {
    "file": "kernel/arkhe-kernel/src/lib.rs",
    "field": "emergency_stop: bool",
    "setter": "set_emergency_stop",
    "tree": "kernel/arkhe-kernel/src",
    "forbids": ["SIGSTOP", "SIGKILL", "Command::new", "libc::kill"]
  },
  "unsigned_producers": {
    "prefixes": ["cognition/"],
    "token": "SigningKey"
  },
  "pure_verifier": {
    "member": "verification/crates/arkhe-verify-core",
    "forbid_dependencies": ["reqwest", "tokio", "sqlx", "chrono", "rusqlite", "arkhe-sql", "arkhe-kernel"],
    "src_forbids": ["std::fs", "std::net", "std::time", "SystemTime", "AuthorizationDecision::Allow", "Decision::Allow"]
  },
  "formal_spec": {
    "path": "formal/spec/admit.tla",
    "requires": ["TLC has not checked", "Unmediated", "No theorem is discharged"],
    "forbids": ["= \"Released\""]
  },
  "skeleton_texts": [
    {
      "path": "barrier/arkhe-barrier/src/preempt.rs",
      "requires": ["NotImplemented"],
      "forbids": ["SIGSTOP", "SIGKILL", "Command::new", "libc::kill"]
    },
    {
      "path": "formal/spec/resume.tla",
      "requires": ["TLC has not checked", "NotImplemented", "No theorem is discharged"],
      "forbids": ["= \"Resumed\""]
    },
    {
      "path": "formal/spec/decide.tla",
      "requires": ["TLC has not checked", "RuleAllowed", "No theorem is discharged"],
      "forbids": ["= \"AlwaysAllow\""]
    },
    {
      "path": "formal/refine/state.txt",
      "requires": ["TLC has not checked"],
      "forbids": ["theorem accepted"]
    },
    {
      "path": "formal/refine/decide.txt",
      "requires": ["TLC has not checked", "RuleAllowed"],
      "forbids": ["theorem accepted"]
    },
    {
      "path": "eval/verifiers/refuse.py",
      "requires": ["not scored"],
      "forbids": ["score ="]
    }
  ],
  "model_client": {
    "path": "models/client.toml",
    "pin": "pins/unpinned.toml",
    "holds_keys": false,
    "writes_evidence": false,
    "releases_effect": false
  },
  "eval_verifier": {
    "path": "eval/verifiers/FROZEN",
    "must_contain": "The agent write set excludes this directory."
  },
  "mmr_reexport": {
    "reexport": "storage/sql/crates/arkhe-sql/src/mmr/profile.rs",
    "defines": ["pub const PROFILE_ID", "pub const PROFILE_VERSION", "pub const PROFILE_DIGEST_HEX", "pub fn mmr_size"],
    "names": ["mmr_size", "PROFILE_DIGEST_HEX", "PROFILE_ID", "PROFILE_VERSION"],
    "tree": "storage/sql/crates/arkhe-sql/src",
    "forbid_local": ["pub const PROFILE_ID", "pub const PROFILE_VERSION", "pub const PROFILE_DIGEST_HEX", "pub fn mmr_size"]
  },
  "health_scaffold": {
    "file": "integrations/mcp-server/src/index.js",
    "requires": ["authority: \"none\"", "createHealthServer"],
    "forbids": ["decide_event", "AuthorizationDecision"]
  },
  "work_identity": {
    "types": {
      "WorkIntent": "kernel/arkhe-core/src/work.rs",
      "WorkerExecutionRecord": "kernel/arkhe-core/src/worker.rs"
    },
    "canonical": "kernel/arkhe-core/src/canonical.rs",
    "canonical_marker": "AKG-CBOR-v1",
    "operational": ["scripts/live_runtime.py", "ops/runtime/Dockerfile"]
  },
  "policy_verdict": {
    "definition": "governance/arkhe-governance/src/lib.rs",
    "silent_prefixes": ["cognition/", "evidence/", "verification/crates/", "state/", "barrier/", "kernel/arkhe-gate"]
  },
  "source_maps": [
    "docs/architecture/moves.json",
    "docs/architecture/additional-moves.json",
    "docs/architecture/operational-moves.json"
  ],
