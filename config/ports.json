{
  "version": 1,
  "scope": "Local Arkhe services; unrelated listeners are not modified",
  "ports": [
    {
      "port": 7473,
      "service": "Chladni dashboard",
      "protocol": "HTTP",
      "component": "legacy-installed",
      "authority": false,
      "required_binding": "127.0.0.1"
    },
    {
      "port": 7474,
      "service": "Telegraph reference bus",
      "protocol": "WebSocket",
      "component": "legacy-installed",
      "authority": false,
      "required_binding": "127.0.0.1"
    },
    {
      "port": 7475,
      "service": "Chladni observer/preview",
      "protocol": "HTTP",
      "component": "apps/chladni-dashboard",
      "authority": false,
      "required_binding": "127.0.0.1"
    },
    {
      "port": 8788,
      "service": "Rust admission and evidence API",
      "protocol": "HTTP",
      "component": "orchestration/arkhe-runtime",
      "authority": true,
      "required_binding": "127.0.0.1"
    },
    {
      "port": 55432,
      "service": "PostgreSQL 16",
      "protocol": "PostgreSQL",
      "component": "storage/sql",
      "authority": true,
      "required_binding": "127.0.0.1"
    },
    {
      "port": 8787,
      "service": "MCP operational health only",
      "protocol": "HTTP",
      "component": "integrations/mcp-server",
      "authority": false,
      "required_binding": "127.0.0.1"
    },
    {
      "port": 9090,
      "service": "Prometheus",
      "protocol": "HTTP",
      "component": "ops/prometheus",
      "authority": false,
      "required_binding": "127.0.0.1"
    },
    {
      "port": 3002,
      "service": "Grafana",
      "protocol": "HTTP",
      "component": "ops/grafana",
      "authority": false,
      "required_binding": "127.0.0.1"
    },
    {
      "port": 6379,
      "service": "Redis",
      "protocol": "Redis",
      "component": "docker-compose.yml",
      "authority": false,
      "required_binding": "127.0.0.1"
    },
    {
      "port": 3000,
      "service": "Preflight UI",
      "protocol": "HTTP",
      "component": "apps/preflight",
      "authority": false,
      "required_binding": "127.0.0.1"
    },
    {
      "port": 3001,
      "service": "Melodic UI",
      "protocol": "HTTP",
      "component": "apps/melodic-lab",
      "authority": false,
      "required_binding": "127.0.0.1"
    },
    {
      "port": 3003,
      "service": "Arkhe-Intra fullstack",
      "protocol": "HTTP",
      "component": "apps/arkhe-intra",
      "authority": false,
      "required_binding": "127.0.0.1"
    }
  ]
}
