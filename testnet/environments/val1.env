NODE_ID=val1
NODE_KEY_FILE=/etc/arkhe/keys/val1.key
GENESIS_FILE=/etc/arkhe/genesis.txt
PEER_FILE=/etc/arkhe/peers.txt
DATA_DIR=/var/lib/arkhe
LISTEN_ADDR=/ip4/0.0.0.0/tcp/30333
# val1 is the only sealing process. Create the inbox directory first.
EXTRA_ARGS=--seal --time 1794000000 --inbox /var/lib/arkhe/inbox
