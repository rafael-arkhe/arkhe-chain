FROM rust:1.96.0-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --locked --release -p agi-coder-cli \
    && cp target/release/agi target/release/agi-coder
FROM debian:bookworm-slim
RUN useradd --uid 10001 --create-home agi
COPY --from=build /src/target/release/agi /usr/local/bin/agi
COPY --from=build /src/target/release/agi-coder /usr/local/bin/agi-coder
USER 10001
ENTRYPOINT ["agi"]
CMD ["--help"]
