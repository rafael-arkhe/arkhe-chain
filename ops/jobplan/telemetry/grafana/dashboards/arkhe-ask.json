{
  "uid": "arkhe-ask-ops",
  "title": "Arkhe Ask — RED and PostgreSQL USE",
  "schemaVersion": 40,
  "version": 2,
  "tags": [
    "arkhe",
    "verified-rag"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ask — Requests/s",
      "description": "RED: HTTP request rate, including authentication rejections.",
      "datasource": {
        "type": "prometheus",
        "uid": "arkhe-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(axum_http_requests_total{endpoint=\"/v1/ask\"}[5m]))",
          "legendFormat": "{{decision}}{{status}}{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ask — HTTP 5xx/s",
      "description": "RED: server errors. Citation refusals (422) are shown separately by the support gate.",
      "datasource": {
        "type": "prometheus",
        "uid": "arkhe-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(axum_http_requests_total{endpoint=\"/v1/ask\",status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "{{decision}}{{status}}{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ask — Latency p95",
      "description": "RED: measured p95 HTTP duration. NaN/null is displayed as Sem tráfego; the original PromQL value is preserved.",
      "datasource": {
        "type": "prometheus",
        "uid": "arkhe-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(axum_http_requests_duration_seconds_bucket{endpoint=\"/v1/ask\"}[5m])))",
          "legendFormat": "{{decision}}{{status}}{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem tráfego",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Sem tráfego",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Citation support gate — Decisions/s",
      "description": "Accepted/refused describe citation support checks, not factual truth or persistence success.",
      "datasource": {
        "type": "prometheus",
        "uid": "arkhe-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(decision)(rate(arkhe_gate_decisions_total[5m]))",
          "legendFormat": "{{decision}}{{status}}{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Postgres — Connection utilization",
      "description": "USE proxy: connections as a fraction of max_connections; not database CPU utilization.",
      "datasource": {
        "type": "prometheus",
        "uid": "arkhe-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_activity_count{datname=\"arkhe\"}) / on() group_left() max(pg_settings_max_connections)",
          "legendFormat": "{{decision}}{{status}}{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Postgres — Waiting locks",
      "description": "USE saturation proxy: ungranted lock requests across this PostgreSQL instance, including other databases.",
      "datasource": {
        "type": "prometheus",
        "uid": "arkhe-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "arkhe_pg_waiting_locks{job=\"arkhe-postgres\"}",
          "legendFormat": "{{decision}}{{status}}{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Postgres — Deadlocks/s",
      "description": "USE errors proxy: deadlocks, not a count of all SQL errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "arkhe-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_deadlocks{datname=\"arkhe\"}[5m])) or vector(0)",
          "legendFormat": "{{decision}}{{status}}{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Monitoring — Scrape health",
      "description": "Monitoring transport status, independent of business correctness.",
      "datasource": {
        "type": "prometheus",
        "uid": "arkhe-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"arkhe-ask|arkhe-postgres\"}",
          "legendFormat": "{{decision}}{{status}}{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}