# Build context: generated by scripts/prepare_enterprise_container.py.
FROM docker.io/library/rust:1.96-bookworm AS anchor
WORKDIR /src
COPY . .
RUN cargo build --release --locked -p arkhe-wormgraph --bin arkhe-representation-anchor

FROM docker.io/library/node:24-bookworm-slim AS build
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /src
RUN npm install --global pnpm@11.25.0 --ignore-scripts
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml Cargo.toml ./
COPY apps/arkhe-intra/package.json ./apps/arkhe-intra/package.json
RUN pnpm install --filter @arkhe/intra --frozen-lockfile --ignore-scripts
COPY apps/arkhe-intra ./apps/arkhe-intra
COPY config/architecture.json ./config/architecture.json
COPY verification/crates/arkhe-verify-wasm/pkg ./verification/crates/arkhe-verify-wasm/pkg
COPY scripts/e01_solana_transport.mjs scripts/e02_verify.mjs scripts/e02_mmr.mjs scripts/e02_memo_commitment.mjs ./scripts/
WORKDIR /src/apps/arkhe-intra
RUN node scripts/build.mjs

FROM docker.io/library/node:24-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3003 ARKHE_INSTALL_ROOT=/app ARKHE_INTRA_DATA_DIR=/data ARKHE_REPRESENTATION_ANCHOR_EXECUTABLE=/app/bin/arkhe-representation-anchor
WORKDIR /app
COPY --from=build /src/apps/arkhe-intra/.next/standalone ./
COPY --from=build /src/apps/arkhe-intra/.next/static ./apps/arkhe-intra/.next/static
COPY --from=build /src/apps/arkhe-intra/public ./apps/arkhe-intra/public
COPY --from=build /src/verification/crates/arkhe-verify-wasm/pkg ./verification/crates/arkhe-verify-wasm/pkg
COPY --from=build /src/scripts ./scripts
COPY --from=anchor /src/target/release/arkhe-representation-anchor ./bin/arkhe-representation-anchor
COPY apps/arkhe-intra/scripts/setup.mjs ./apps/arkhe-intra/scripts/setup.mjs
COPY apps/arkhe-intra/scripts/backup.mjs ./apps/arkhe-intra/scripts/backup.mjs
COPY apps/arkhe-intra/lib/paths.mjs ./apps/arkhe-intra/lib/paths.mjs
COPY scripts/enterprise_container_entry.mjs ./entry.mjs
COPY scripts/enterprise_server_supervisor.mjs ./enterprise_server_supervisor.mjs
RUN mkdir /data && chown node:node /data
USER node
EXPOSE 3003
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:3003/api/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "entry.mjs"]
