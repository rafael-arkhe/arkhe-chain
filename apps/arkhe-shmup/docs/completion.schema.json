{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arkhe:shmup:completion:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "match_id", "seed", "rules_hash", "ticks", "waves", "absorbed", "bosses", "final_hash", "claimed_base_points", "replay_base64", "human_proof_base64"],
  "properties": {
    "protocol_version": {"const": 1},
    "match_id": {"type": "string", "format": "uuid"},
    "seed": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "description": "Adapter additionally checks <= u64::MAX"},
    "rules_hash": {"$ref": "#/$defs/hash"},
    "ticks": {"type": "integer", "minimum": 1, "maximum": 108000},
    "waves": {"type": "integer", "minimum": 0, "maximum": 108000},
    "absorbed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "bosses": {"type": "integer", "minimum": 0, "maximum": 108000},
    "final_hash": {"$ref": "#/$defs/hash"},
    "claimed_base_points": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "replay_base64": {"type": "string", "maxLength": 1333336, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "human_proof_base64": {"type": "string", "maxLength": 174764, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
